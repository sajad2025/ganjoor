      },
      {
        "id": 2659367,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سجلست او به صدر دیوانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659368,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست معلوم او که در خدمت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من می‌دانم که او در خدمت من است و من از هیچ‌کس هیچ‌گونه پاداشی نمی‌طلبم."
      },
      {
        "id": 2659369,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من ز کس هیچ مزد نستانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659370,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خواستم شغلکی که شغلی هست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: می‌خواستم برای خودم کار و شغفی پیدا کنم که با آنچه من می‌دانم هم‌خوانی داشته باشد."
      },
      {
        "id": 2659371,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست از آنسان که من همی دانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659372,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتی آن شغل را به قوت این",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گفتی که با قدرت و تلاش امروز می‌توانم آن کار را دوباره تازه و زنده کنم."
      },
      {
        "id": 2659373,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز سر امروز تازه گردانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659374,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون بگفتندش اهتزاز نمود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی به او گفتند که باید شاداب و سرزنده باشد، او به زیبایی گفت که خوب بودن برای او بسیار زیاد است."
      },
      {
        "id": 2659375,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیکویی گفت بس فراوانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659376,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با همه کس بگفتم این قصه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من این داستان را با همه کس در میان گذاشته‌ام که من فرزند و نماینده دیوانم."
      },
      {
        "id": 2659377,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که من از نایبان دیوانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659358,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کردم از همت و مروت او",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از تلاش و منش نیک او آن‌قدر سپاسگزاری کردم که فقط من از آن آگاه‌ام."
      },
      {
        "id": 2659357,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شکرهایی چنانکه من دانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659356,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خواستم تا قباله بنویسم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: می‌خواستم سندی تهیه کنم تا یک شخص را به مقام و مسئولیت خاصی منصوب کنم."
      },
      {
        "id": 2659345,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نایبی را به شغل بنشانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659337,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون به منشور نامه آمد کار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که نامه‌ای به سرنوشت و تقدیر رسید، کارها به پایان می‌رسد و گفتن چیزهایی که نمی‌توانم، بی‌فایده می‌شود."
      },
      {
        "id": 2659338,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رفت چیزی که گفت نتوانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659339,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتم آخر که بیش صبر نماند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گفتم دیگر این درد و غصه را نمی‌توانم در دل تحمل کنم و باید راهی برای فرار از آن پیدا کنم."
      },
      {
        "id": 2659340,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در دل این غصه را بپیچانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659341,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تیز در ریش و کفل درگه شد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: سختی و مشکلات باعث شده که لحظات شاد را فراموش کنیم و حالا دیگر نمی‌توانیم بخندیم و شادی کنیم."
      },
      {
        "id": 2659342,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خنده ها رفت بر بروتانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659343,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سرد شد گرم گشته امیدم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: امیدم که روزگاری گرم و پرنشاط بود، حالا سرد شده است. دندان‌هایم که روزگاری تیز و قوی بودند، اکنون کند و ضعیف شده‌اند."
      },
      {
        "id": 2659344,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کند شد تیز گشته دندانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659346,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه کنم قصه زرد شد رویم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من چه کار کنم که رنگ رویم زرد شده و چطور می‌توانم درد و رنجی را که جانم را آزار می‌دهد توصیف کنم؟"
      },
      {
        "id": 2659355,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه دهم شرح رنجه شد جانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659347,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خجل و تیره ام ز دشمن و دوست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از دشمن و دوست، خجالت‌زده و ناامیدم. به شدت رنج می‌برم و در وضعیتی سخت و گیج‌کننده قرار دارم."
      },
      {
        "id": 2659348,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیک رنجور و سخت حیرانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659349,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون ز مهتر آمد اجنبیی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی غریبه‌ای از بزرگان وارد شد، نمی‌دانم حالا چطور باید خود را نشان دهم."
      },
      {
        "id": 2659350,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خیره اکنون زنخ چه جنبانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659351,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خواجه طاهر تو طبع من دانی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من طبع و ذاتی دارم که فراتر از جنس و هر چیز عادی است و تو به خوبی این را می‌دانی."
      },
      {
        "id": 2659352,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که نه جنس فلان و بهمانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659353,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر کریمی مرا به جان بخرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر تو انسان بزرگ‌منشی هستی و بخواهی جانم را با چیزی بخری، بدان که من بسیار ارزان‌تر از آن چیزی هستم که فکر می‌کنی."
      },
      {
        "id": 2659354,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو چنان دان که من بس ارزانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659291,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گرچه هستم چو لاله سوخته دل",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هرچند که مانند لاله‌ای پژمرده و غمگین هستم، اما به مانند گلی تازه شکفته، شاد و خندان به نظر می‌رسم."
      },
      {
        "id": 2659290,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون گل نوشکفته خندانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659289,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کار کن تر بسی ز خایسکم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بیشتر تلاش کن و سختی‌های بیشتری را تحمل کن، زیرا این کار ارزشمندتر از رنجی است که از سنگین بودن بار بر دوش می‌کشی."
      },
      {
        "id": 2659288,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رنج بردارتر ز سندانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659225,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خسته زخم های گردونم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از درد و رنجی که زمانه بر من تحمیل کرده، خسته و زانوشکسته‌ام و بارهای زندگی مثل باران بر دوشم سنگینی می‌کند."
      },
      {
        "id": 2659226,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بسته حملهای کیوانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659227,
        "vOrder": 47,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر من آن گفت بس اثر نکند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گفتن این که آنچه بر من می‌گویند تأثیری ندارد، چون من با مفهوم ناکامی و فقدان آشنا شده‌ام."
      },
      {
        "id": 2659228,
        "vOrder": 48,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که به تن آشنای حرمانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659229,
        "vOrder": 49,
        "coupletIndex": 24,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در غم چیز دل نیاویزم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در اندوه چیز دل را به شوق نمی‌افکنم و تن خود را آزار نمی‌زنم."
      },
      {
        "id": 2659230,
        "vOrder": 50,
        "coupletIndex": 24,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به دم حرص تن نرنجانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2659231,
        "vOrder": 51,
        "coupletIndex": 25,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تن سپرده به حکم دادارم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من بدنم را به تصمیم خداوند سپرده‌ام و قلبم را به لطف و رحمت خداوند متعال اعتماد کرده‌ام."
      },
      {
        "id": 2659232,
        "vOrder": 52,
        "coupletIndex": 25,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل نهاده به فضل یزدانم",
        "languageId": null,
        "coupletSummary": null
      }
    ],
