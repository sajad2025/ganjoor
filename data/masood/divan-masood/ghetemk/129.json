        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که منم یک جهان به تنهایی",
        "languageId": null,
        "coupletSummary": null
      },
