        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن رشیدی رشید را مطلق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من باید تمام چیزهایی را که لازم است به آن مرد رشید بگویم."
      },
