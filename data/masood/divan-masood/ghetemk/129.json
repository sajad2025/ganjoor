        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کاسمان جاه و مشتری رایی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2661682,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خشک رودی چرا کنی بر من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چرا با من مانند یک رود خشک رفتار می‌کنی، در حالی که تو طبیعتی مانند دریا داری؟"
      },
