        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خلق جهان را فرا نمایم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر تو به من توجه کنی، می‌توانم تمام آفرینش را به نمایش بگذارم."
      },
      {
        "id": 2661347,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
