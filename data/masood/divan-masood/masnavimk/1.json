        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نشود همچو چوب خشک دهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2662603,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جام باده بجوشد اندر کف",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که جام شراب در دست می‌جنبند، مانند سر دیگ به جوش می‌آید و کف نمی‌آورد. این اشاره به لذت و هیجان شراب نوشی دارد، که شادی و سرخوشی را به همراه می‌آورد بدون اینکه به اوج و افراط برسد."
      },
