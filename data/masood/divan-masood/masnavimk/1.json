        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رنگ طبعی نکو به کار بری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2662571,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو بدین حمله ای که افکندی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو با این حمله‌ای که انجام دادی، به خشکی و بی‌بارانی زمین آسیب زدی و آن را از ریشه برداشت کردی."
      },
