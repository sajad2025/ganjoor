        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پس ازین جز امید سرما نیست",
