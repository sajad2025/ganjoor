        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیخ خشکی ز خاک برکندی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2662569,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تیر بگذشت ناگهان بر ما",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ناگهان، تیر گرما بر ما فرود آمد و لشکر گرما در هم شکست."
