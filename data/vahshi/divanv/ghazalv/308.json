    "verses": [
      {
        "id": 2526613,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه‌ها با جان خود دور از رخ جانان خود کردم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من چه کارهایی را با وجود خود و دور از چهره محبوبم انجام دادم، آیا این کارها را دشمن برایم ترتیب داده است که من این‌گونه با خودم رفتار کردم؟"
      },
      {
        "id": 2526614,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مگر دشمن کند این‌ها که من با جان خود کردم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2526615,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "طبیبم گفت درمانی ندارد درد مهجوری",
        "languageId": null,
        "coupletSummary": "پزشکم گفت که به هیچ دارویی درد دوری از محبوب درمان نمی‌شود، اما من خودم را کشتم و با این کار درد خود را درمان کردم."
      },
      {
        "id": 2526616,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "غلط می‌گفت خود را کشتم و درمان خود کردم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2526637,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مگو وقتی دل صد پاره‌ای بودت کجا بردی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نگو که وقتی دل من پاره پاره بود، کجا بردی و من کجا رفتم. من در دامان خودم به تنگنای دلم افتادم."
      },
      {
        "id": 2526710,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کجا بردم ز راه دیده در دامان خود کردم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2526711,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز سر بگذشت آب دیده‌اش از سرگذشت من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او با چشمان خود اشک‌هایش را از سر گذرانده و من هر بار که با کسی درباره‌ی درد و غم خود صحبت کردم، همچنان در حال گریه بودم."
      },
      {
        "id": 2526712,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به هر کس شرح آب دیدهٔ گریان خود کردم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2526804,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز حرف گرم وحشی آتشی در سینه افکندم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از صحبت‌های دلنشین و جذاب او، آتشی در دل من جان گرفت و به او احساسات و دردهای درونم را نشان دادم."
      },
      {
        "id": 2526805,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به او اظهار سوز سینهٔ سوزان خود کردم",
        "languageId": null,
        "coupletSummary": null
      }
