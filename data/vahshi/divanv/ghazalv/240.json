    "verses": [
      {
        "id": 2527595,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ترک ما کردی برو هم‌صحبت اغیار باش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو ما را رها کردی، حالا برابری با دیگران، در حالی که ما دیگر یاری نداریم. با هر کسی که می‌خواهی دوست باش، چون در کنار ما نیستی."
      },
      {
        "id": 2527596,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یار ما چون نیستی با هر که خواهی یار باش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2527597,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مست حسنی با رقیبان میل می خوردن مکن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از شراب زیبایی و لذت‌های زندگی با رقبا و دشمنان خود نمی‌توانی استفاده کنی، زیرا آن‌ها رقبای بدی هستند. به تو هشدار می‌دهم که حواست را جمع کن."
      },
      {
        "id": 2527598,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بد حریفانند آنها گفتمت هشیار باش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2527600,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنکه ما را هیچ برخورداری از وصلش نبود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آن کسی که ما هیچ بهره‌ای از وصالش نداشتیم، از درخت وصل او، غیر از بی‌نصیب بودن نمی‌توانیم انتظار داشته باشیم."
      },
      {
        "id": 2527607,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از نهال وصل او گو غیر برخوردار باش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2527601,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گرچه می‌دانم که دشوار است صبر از روی دوست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: با اینکه می‌دانم تحمل کردن سخت است، به خاطر دوستم چند روزی صبر می‌کنم، هرچند این کار دشوار باشد."
      },
      {
        "id": 2527602,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چند روزی صبر خواهم کرد گو دشوار باش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2527603,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صبر خواهم کرد وحشی در غم نادیدنش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من برای دیدن او که نیست، صبر خواهم کرد، حتی اگر این دل‌تنگی من را به مرگ بکشاند."
      },
