    "verses": [
      {
        "id": 2528381,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تکیه کردم بر وفای او غلط کردم، غلط",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به او اعتماد کردم و فکر کردم که می‌توانم به وفاداری‌اش تکیه کنم، اما در واقع اشتباه کردم. با عشق به او، همه چیز را باختم و دوباره فهمیدم که خطا کردم."
      },
      {
        "id": 2528382,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "باختم جان در هوای او غلط کردم، غلط",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2528383,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عمر کردم صرف او فعلی عبث کردم، عبث",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من عمرم را صرف او کردم و کار بیهوده‌ای انجام دادم. جانم را برای او فدای چیزهایی کردم که اشتباه بودند و به اشتباه رفتم."
      },
      {
        "id": 2528384,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ساختم جان را فدای او غلط کردم، غلط",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2528385,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل به داغش مبتلا کردم خطا کردم، خطا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من به خاطر دلتنگی و غم از دست دادن او، خودم را در درد و ناراحتی فرو بردم و به اشتباه این کار را کردم. در واقع برای عشق او، خودم را سوزاندم و به خاطر این تصمیم نادرست پشیمانم."
      },
      {
        "id": 2528386,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سوختم خود را برای او غلط کردم، غلط",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2528387,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اینکه دل بستم به مهر عارضش بد بود، بد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من به زیبایی چهره‌اش علاقه‌مند شدم و این کار به نظر اشتباه آمد. حالا که جانم را در آرزوی او گذاشتم، متوجه شدم که اشتباه کرده‌ام."
      },
      {
        "id": 2528388,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جان که دادم در هوای او غلط کردم، غلط",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2528389,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همچو وحشی رفت جانم در هوایش حیف، حیف",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: جانم به یاد آن محبوب رفته است و افسوس که با ظلم و ستم او آشنا شدم. اشتباه کردم، اشتباه."
      },
      {
        "id": 2528390,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خو گرفتم با جفای او غلط کردم، غلط",
        "languageId": null,
        "coupletSummary": null
      }
