        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ساعد او مباد رنجه شود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کمک او نباشد که دچار زحمت شود و آثاری از درد بر دستان لطیفش بماند."
      },
      {
        "id": 2524417,
        "vOrder": 10,
        "coupletIndex": 4,
