        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر آن شوخ قصد این دارد",
        "languageId": null,
        "coupletSummary": null
      },
      {
