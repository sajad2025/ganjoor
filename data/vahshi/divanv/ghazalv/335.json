    "verses": [
      {
        "id": 2526522,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پیش تو بسی از همه کس خوارترم من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من در حضور تو از همه کس حقیرترم، زیرا که در میان دیگران بیشتر گرفتار تو هستم."
      },
      {
        "id": 2526523,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زان روی که از جمله گرفتارترم من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2526524,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "روزی که نماند دگری بر سر کویت",
        "languageId": null,
        "coupletSummary": "زمانی که دیگر کسی در دور و اطراف تو نماند، می‌فهمی که من از دیگران به تو وفادارترم."
      },
      {
        "id": 2526525,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دانی که ز اغیار وفادارترم من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2526510,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر بی کسی من نگر و چارهٔ من کن",
        "languageId": null,
        "coupletSummary": " به تنهایی و بی‌کسی من نگاه کن و راه حلی برای مشکلات من پیدا کن، زیرا من از همه‌ کس تنهاتر و بدون یار و یاور هستم."
      },
      {
        "id": 2526509,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زان کز همه کس بی کس و بی‌یارترم من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2526508,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیداد کنی پیشه و چون از تو کنم داد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر تو ظالمی و ستم می‌کنی، وقتی من از تو شکایت می‌کنم و فریاد می‌زنم، تو مرا از بی‌خودیت می‌کشی، پس من چه کنم که تو از من ستمگرتر هستی؟"
      },
      {
        "id": 2526499,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زارم بکشی کز که ستمکارترم من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2526493,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وحشی به طبیب من بیچاره که گوید",
        "languageId": null,
        "coupletSummary": "وحشی! چه کسی به طبیب(پزشک) من بیچاره بگوید، که امروز از دیروز حالم خراب‌تر است و زار تر هستم؟"
      },
      {
        "id": 2526494,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کامروز ز دیروز بسی زارترم من",
        "languageId": null,
        "coupletSummary": null
      }
