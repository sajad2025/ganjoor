        "sectionIndex4": null,
        "text": "نور رخ تو قمر ندارد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نور چهره تو به اندازه نور ماه زیبا نیست و شیرینی تو به اندازه شیرینی شکر نمی‌باشد."
      },
      {
        "id": 2474552,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شیرینی تو شکر ندارد",
        "languageId": null,
        "coupletSummary": null
      },
      {
