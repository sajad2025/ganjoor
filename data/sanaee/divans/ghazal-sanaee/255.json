        "id": 2477457,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کی بود که کنی کم از دهانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2477458,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر با تو به دوزخ اندر آیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر با تو به جهنم بروم، حقیقتاً اینجا بهتر از بهشت برایم خواهد بود."
      },
      {
        "id": 2477459,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حقا که بود به از جنانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2477460,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا چند چهار میخ داری",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چقدر می‌خواهی در این فضای تنگ و محدود به کارهایت ادامه دهی؟ بیایید تغییر ایجاد کنیم."
      },
      {
        "id": 2477461,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در حجرهٔ تنگ کن فکانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2477462,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا چند فسرده روح داری",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چقدر طول می‌کشی که در سایهٔ زمان، دلت شاد و روحی سرزنده داشته باشی؟"
      },
      {
        "id": 2477463,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در سایهٔ دامن زمانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2477464,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی هیچ بخر مرا هم از من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هرچند که شاید ارزش من زیاد باشد، اما هیچ چیزی مانع از این نیست که تو مرا به دست آوری، حتی اگر باید بهایی بابت آن بپردازی."
      },
      {
        "id": 2477465,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر چند برایگان گرانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2477466,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مانند میان خود کنم نیست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به هیچ وجه نمی‌توانم میان خود را به عنوان مرجع قرار دهم چون هنوز در درونم وجود دارد."
      },
      {
        "id": 2477441,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زیرا که هنوز در میانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2477467,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با تن چکنم نه از زمینم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: با بدنم نه از خاک جدا می‌شوم و نه با روح و جانم می‌توانم به آسمان پرواز کنم."
      },
      {
        "id": 2477440,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با جان چکنم نه آسمانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2477438,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من سایه شدم تو آفتابی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من به مثل سایه‌ای شدم، در حالی که تو مانند خورشید درخشان هستی. تنها کافی است یک قدم برداری تا من دیگر تنها نمانم."
      },
      {
        "id": 2477413,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یک راه برآی تا نمانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2477414,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بگشای نقاب تا ببینم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این جمله به معنای درخواست از کسی است تا چهره‌اش را نمایان کند و زیبایی‌اش را نشان دهد، به گونه‌ای که گویا گوینده می‌خواهد با دیدن چهره، معرفت بیشتری پیدا کند و زیبایی واقعی را درک کند."
      },
      {
        "id": 2477415,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بنمای جمال تا بدانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2477416,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خواننده تو باش سوی خویشم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به سراغ من بیا و مرا هدایت کن تا من بتوانم سوار بر مرکبی که وفادار نیست، حرکت کنم."
      },
      {
        "id": 2477417,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا مرکب پی بریده رانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2477418,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در دیده به جای دیده بنشین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در چشم من به جای اینکه فقط ببینی، حضور داشته باش تا بتوانم نامه‌ای که هنوز نوشته نشده را بخوانم."
      },
      {
        "id": 2477419,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا نامهٔ نانبشته خوانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2477420,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو عاشق هست و نیست خواهی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر تو عاشقی و نمی‌خواهی این را بپذیری، باید قبول کنی که من هم همین گونه هستم."
      },
      {
        "id": 2477421,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بپذیر مرا که من چنانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2477422,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در دیده ز بیم غیرت تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در چشمان من بخاطر غیرت تو اکنون هیچ شان و منزلتی ندارم."
      },
      {
        "id": 2477423,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اکنون نه سناییم سنانم",
        "languageId": null,
        "coupletSummary": null
      }
