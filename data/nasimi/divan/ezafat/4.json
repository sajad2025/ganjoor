        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دشمن ز تیغت سینه چاک",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دشمن از ضربه‌های تند تو زخم خورده و به خاطر درد و غم، هلاک شده است."
      },
      {
        "id": 4524784,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از تیغ غم بادا هلاک",
        "languageId": null,
        "coupletSummary": null
