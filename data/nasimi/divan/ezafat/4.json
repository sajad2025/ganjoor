        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیگر ندارد هیچ باک",
