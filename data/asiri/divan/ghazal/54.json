        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای وصل تو منتهی المطالب",
        "languageId": null,
        "coupletSummary": null
      },
