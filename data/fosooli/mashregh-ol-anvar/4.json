      {
        "id": 5304579,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "استعانت از تو می‌جویم در آن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304580,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هرچه گویم نسبتش بر من خطاست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304581,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مارَمَیتَ اِذرَمیتَ اینجا گواست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304582,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هرچه هست از تست، ما را چیز نیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304583,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عقل ما را قوّهٔ تمییز نیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304584,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر نکو گوییم، از تو می‌رسد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304585,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ور خطا باشد، خطا از ما سِزد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304586,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از خطای گفتهٔ ما عفو کن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304587,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ناروا از نامهٔ ما محو کن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304588,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سالکان را بخش فرما، نورِ جان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304589,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا نگردند از بیانم، بدگمان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304590,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حالیا این دَم گَهِ گفتار شد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304591,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "طوطی نُطّاق، شکّر بار شد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304592,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در پس پرده است و پرده در شده",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304593,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وز پس آئینه جان پرور شده",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304594,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لیک هم سربسته می‌گوید سخن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304595,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌نهد سرپوش بر راز کهن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304596,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا که نامحرم نیابد رازِ یار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304597,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حالیا برگفتهٔ او گوش دار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304598,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عقلِ کامل، عین عشق کامل است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304599,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرد عاشق، در حقیقت عاقل است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304600,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عقل و عشق اندر حقیقت، نی دواَند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304601,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در نیابد این سخن جز هوشمند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304602,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عقل، عشق و عشق، عقل رهبر است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304603,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لیک هریک را مقامی دیگر است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304604,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از ره جانان نشانی می‌دهند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304605,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رهنمای سالک اندر یک رَهند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304606,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در مقام اَشرَفیّت خود یکند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304607,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لیک دو، از بهر کارِ سالکند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304608,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از دوئیت نیست خود این همسری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304609,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هم بود این جنگ، جنگ زرگری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304610,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اندر این ره، چون بسی باشد خطر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304611,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هم امید اَفسر و هم بیم سر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304612,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عقلِ خود آرا، طریق بیم اوست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304613,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عشق بی‌پروا، ره تسلیم اوست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304614,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عقل، هول راه می‌گوید همی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304615,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عشق، تسلیم و رضا جوید همی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304616,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عقلت آگه می‌کند از خوی عشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304617,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌نماید رسم و راه کوی عشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304618,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رازِ خود می‌گوید او، نی رازِ غیر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304619,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لیک با اندیشه‌های شَرّ و خِیر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304620,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون مقام عشق را اندیشه نیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304621,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خیر و شَرّ اندیشی او را پیشه ‌نیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304622,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عقل از این اندیشه آگاهت کند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304623,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زین جهت طبل دوئیّت می‌زند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304624,
        "vOrder": 47,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عشق را چون مقصدی جز یار نیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304625,
        "vOrder": 48,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "باصلاح و با فسادش، کار نیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304626,
        "vOrder": 49,
        "coupletIndex": 24,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 26,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سرکش و سودائی و دیوانه است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304627,
        "vOrder": 50,
        "coupletIndex": 24,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 26,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از همه اندیشه‌ها بیگانه است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304628,
        "vOrder": 51,
        "coupletIndex": 25,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 27,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آتش سوزانی است و پُر شرار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304629,
        "vOrder": 52,
        "coupletIndex": 25,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 27,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌بسوزد هرچه بیند غیر یار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304630,
        "vOrder": 53,
        "coupletIndex": 26,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 28,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عقل از اَهوال خود اِخبارت کند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304631,
        "vOrder": 54,
        "coupletIndex": 26,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 28,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از پی ارشاد، اِنذارت کند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304632,
        "vOrder": 55,
        "coupletIndex": 27,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 29,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اولِ عشق است، عقل راهبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304633,
        "vOrder": 56,
        "coupletIndex": 27,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 29,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌دهد از سرکشیّ خود خبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304634,
        "vOrder": 57,
        "coupletIndex": 28,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 30,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا مگر زین سرکشی دل خون شوی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304635,
        "vOrder": 58,
        "coupletIndex": 28,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 30,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر نه‌ای مَرد، از درش بیرون شوی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304636,
        "vOrder": 59,
        "coupletIndex": 29,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 31,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عشق از اول سرکش و خونی بود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304637,
        "vOrder": 60,
        "coupletIndex": 29,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 31,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا گریزد هر که بیرونی بود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304638,
        "vOrder": 61,
        "coupletIndex": 30,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 32,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون قوی شد پایه‌ات از فضل دوست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304639,
        "vOrder": 62,
        "coupletIndex": 30,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 32,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رو نهادی در طریق وصل دوست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304640,
        "vOrder": 63,
        "coupletIndex": 31,
