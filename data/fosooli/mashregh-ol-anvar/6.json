        "text": "در سلوک‌ این هردو را حُکمی ‌است‌ تام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304663,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن کند حفظ رَه، این حفظ مقام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304664,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون به مقصد گاه ‌این ‌مسلک شوند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304665,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از دوئی بیرون روند و یک شوند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304666,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌رهند از قید و مطلق می‌شوند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304667,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هم به اصل خویش ملحق می‌شوند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304668,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی مقامی را دگر شایسته‌اند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304669,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از تَجرُّد و از علائق رَسته‌اند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304670,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نور عقل و عشق، اینجا یک شود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304671,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مانده ‌اینجا، جبرئیل‌ از تک شود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304672,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گوید او که نیست حّدِ این سَرم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304673,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لو دَنوتُ اَنمَلة سوزد پَرم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304674,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌شود هم، لاحِق و ملحوق یک",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304675,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عقل و عشق و عاشق و معشوق یک",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304676,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هم بود آن نور، نورِ احمدی (ص)",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304677,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر ز سِرّ این سخن آگه شدی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304678,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حالی اینجا شوری آمد بر سرم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304679,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شد خیال دیگری در خاطرم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304680,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خواستم شرحی دهم از نام عشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304681,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گویم از آغاز بی‌انجام عشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304682,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پرده‌ای بردارم از راز نهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304683,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آتش اندازم بجان عاشقان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304684,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هیبت عشقم همی گفتا، خموش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304685,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیش ازین در آتش حیرت مجوش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304686,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شهپر بافَرِّ جبریلِ خرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304687,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سوزد ارگامی در این وادی نهد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304688,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خود نه دستور است که ‌اینجا، دم‌زنی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304689,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "محفل آزادگان برهم زنی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304690,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پرتوِ نورِخورِ عشق منیر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304691,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سست بنیان را کُند کور و ضریر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304692,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هرکه را اسرار حق آموختند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304693,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مهُر کردند و دهانش دوختند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304694,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مُهرها زد بر دهانم این پیام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304695,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بس کنم اینجا سخن را والسّلام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304696,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خود اگر در خانهٔ رِندان کس است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304697,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بس کنم یک حرف دانا را بس ‌است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304698,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر تو نوری یافتی زان آفتاب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304699,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از درون خویشتن آنرا بیاب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304700,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پیش از اینها شورش و غوغا مکن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304701,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیش از اینم بی‌خود و رسوا مکن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304702,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیگر از من شرح این سودا مجو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304703,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرد عشق ا رنیستی این ره مپو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304704,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عقل تو زین داستان حیران شود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304705,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "واله و شیدا و سرگردان شود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304706,
        "vOrder": 47,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در تو نبود احتمال و اِصطبار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304707,
        "vOrder": 48,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آب در غَربال کی گیرد قرار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304708,
        "vOrder": 49,
        "coupletIndex": 24,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 26,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیش از این در قُلزُم حِیرت مرو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304709,
        "vOrder": 50,
        "coupletIndex": 24,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 26,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "قصهٔ نزدیکتر از ما شنو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304710,
        "vOrder": 51,
        "coupletIndex": 25,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 27,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بشنو این را، گر نیوشیدی سخن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304711,
        "vOrder": 52,
        "coupletIndex": 25,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 27,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بو کزان یابی تو اسرار کهن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304712,
        "vOrder": 53,
        "coupletIndex": 26,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 28,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست آن گنجینهٔ اسرار عشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304713,
        "vOrder": 54,
        "coupletIndex": 26,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 28,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چیست گَنجورش همه اَطوار عشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304714,
        "vOrder": 55,
        "coupletIndex": 27,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 29,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "قصّه عشاق، دل خون می‌کند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304715,
        "vOrder": 56,
        "coupletIndex": 27,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 29,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خاصه عاشق را که مجنون می‌کند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304716,
        "vOrder": 57,
        "coupletIndex": 28,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 30,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شورها دارد که خود شوریدگان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304717,
        "vOrder": 58,
        "coupletIndex": 28,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 30,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زان به شور آیند نَز گفت و بیان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304718,
        "vOrder": 59,
        "coupletIndex": 29,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 31,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شور سودائی که مر عُشاق راست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304719,
        "vOrder": 60,
        "coupletIndex": 29,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 31,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کی کتاب و دفتر و اوراق راست؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304720,
        "vOrder": 61,
        "coupletIndex": 30,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 32,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چیست این اوراق، جز سر پوش کار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304721,
        "vOrder": 62,
        "coupletIndex": 30,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 32,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پردهٔ پندار بر اسرار یار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304722,
        "vOrder": 63,
        "coupletIndex": 31,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 33,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از درون پرده، عاشق آگه است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5304723,
        "vOrder": 64,
        "coupletIndex": 31,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 33,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دست نامحرم، از آنجا کوته است",
