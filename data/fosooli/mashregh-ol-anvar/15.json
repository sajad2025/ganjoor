        "text": "در سَبق گه بُرد، کوی قُرب شاه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305592,
        "vOrder": 4,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رُتبه و جاهش برِ شَه درفُزود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305593,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آتشی افتاد در جان حَسود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305594,
        "vOrder": 6,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اَللّه الَلّه از حسود بدسِرشت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305595,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کز شئامت عالمی را کرده زشت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305596,
        "vOrder": 8,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از حسد کابلیس را با آدم است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305597,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از پی اغوای نسلش هر دم است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305598,
        "vOrder": 10,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت او لِاغوَیَنَّهُم اَجمَعین",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305599,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عَن طریق الحَقّ اِلّاالمُخلِصین",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305600,
        "vOrder": 12,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همچنانکه سجدهٔ من، ناوردمی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305601,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کی گذارم سجده آرد آدمی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305602,
        "vOrder": 14,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زین حسد از ره بَرَد بسیار را",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305603,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دام آنها سازد استکبار را",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305604,
        "vOrder": 16,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو مگو از سجده کس را عار نیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305605,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هیچکس را بر حق استکبار نیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305606,
        "vOrder": 18,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چیست استکبارِ ترک امر حق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305607,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با وَلیِّ او نمودن طَعن و دَق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305608,
        "vOrder": 20,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سجدهٔ حق اِتّباع اولیاست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305609,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که پدید از رویشان نور خداست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305610,
        "vOrder": 22,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چونکه پا از حُکمشان بیرون نهی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305611,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عار و استکبار کردی زِابلهی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305612,
        "vOrder": 24,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر تو راه راست خواهی بی‌محن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305613,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دست بر دامان ایشان درفکن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305614,
        "vOrder": 26,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اهل حق، راه حقند ای راه رو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305615,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زین طریق ای دل، به مقصدگاه رو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305616,
        "vOrder": 28,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اُدخُلو الاَبیاتَ مِن اَبوابِها",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305617,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وَاطلُبوا الاَشیاءَ مِن اَسبابِها",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305618,
        "vOrder": 30,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از نُبی دل را برو آگاه کن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305619,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حّل مشکل زان کتاب اللّه کن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305620,
        "vOrder": 32,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر سه قسم آمد صِراط پر ز بیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305621,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ضال و مَغضوب و صِراط مستقیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305622,
        "vOrder": 34,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ضال نصرانیّ و مغضوب، آن یهود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305623,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دین صراط المستقیم است ای وَدود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305624,
        "vOrder": 36,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خود، نصاریُّ و یهودان را بیاب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305625,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از لُباب و عقل، نِی از این کتاب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305626,
        "vOrder": 38,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هان و هان اینجا مشو تو بدگمان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305627,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اِنَّ بَعضَ الظَنِّ اِثمُ را بخوان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305628,
        "vOrder": 40,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بود مقصودم حسود نابکار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305629,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "باشیاطین دگر ما را چه کار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305630,
        "vOrder": 42,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این حسد دردی است ‌بس‌سخت ‌و مُری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305631,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بلکه کفر است آن، چه نیکو بنگری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305632,
        "vOrder": 44,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون حسود خیره، زین وَصف ذَمیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305633,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در عِناد افتاده با عدل حکیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305634,
        "vOrder": 46,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "او همی خواهد زوال نعمتی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305635,
        "vOrder": 47,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که به بنده داده حق از حکمتی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305636,
        "vOrder": 48,
        "coupletIndex": 24,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر بداند قابل آن محسود را",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305637,
        "vOrder": 49,
        "coupletIndex": 24,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پس زوالش نقص باشد برخدا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305638,
        "vOrder": 50,
        "coupletIndex": 25,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 26,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ورنه پس آن بی‌خرد برآن سر است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305639,
        "vOrder": 51,
        "coupletIndex": 25,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 26,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر خدا بر حال او داناتر است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305640,
        "vOrder": 52,
        "coupletIndex": 26,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 27,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این دو کُفر است و از این چون بگذری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305641,
        "vOrder": 53,
        "coupletIndex": 26,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 27,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خود کجا بُرد از حسد، حاسد بری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305642,
        "vOrder": 54,
        "coupletIndex": 27,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 28,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بلکه در رنج است دائم آن دغل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305643,
        "vOrder": 55,
        "coupletIndex": 27,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 28,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون نیابد ره به مقصود و امل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305644,
        "vOrder": 56,
        "coupletIndex": 28,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 29,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هم بجز خواری از آنش نیست سود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305645,
        "vOrder": 57,
        "coupletIndex": 28,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 29,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زانکه گفتند الحَسودُ لایَسود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305646,
        "vOrder": 58,
        "coupletIndex": 29,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 30,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حاصل او این غم و اندوه اوست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305647,
        "vOrder": 59,
        "coupletIndex": 29,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 30,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سوزش دل غُصّهٔ انبوه اوست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305648,
        "vOrder": 60,
        "coupletIndex": 30,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 31,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بَل اَقَلُّ الناسِ لَذَّةَ آن فقیر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305649,
        "vOrder": 61,
        "coupletIndex": 30,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 31,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اَلحَذَر زین درد درمان ناپذیر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305650,
        "vOrder": 62,
        "coupletIndex": 31,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 32,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هرچه گویم زان حسد افزون تر است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5305651,
        "vOrder": 63,
        "coupletIndex": 31,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 32,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کی حسودی را تو دیدی حق پرست",
        "languageId": null,
        "coupletSummary": null
      }
    ],
    "recitations": [],
