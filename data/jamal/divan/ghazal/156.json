        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتی از دست غمم جان نبری",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو گفتی که از دست غم من نجات نخواهی یافت، این حالتی است که در آن سخن می‌گویی."
      },
      {
        "id": 4042780,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنچنانست که میفرمائی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4042781,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
