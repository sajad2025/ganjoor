        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر ازو یک نوا بیاموزم",
        "languageId": null,
        "coupletSummary": null
      },
      {
