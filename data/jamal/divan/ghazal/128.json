        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پرده عالمی دریده شود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر تنها یک نوا از او بیاموزم، پرده‌های عالم را کنار می‌زنم."
      },
      {
        "id": 4042398,
        "vOrder": 10,
