        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "طبع رخ اوست دل ربودن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: خوی و ذات او باعث جلب توجه دل‌هاست و رفتار نرم و دلنشین او، به نوازش دل‌ها معروف است."
      },
      {
        "id": 4042750,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
