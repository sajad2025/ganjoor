        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر یکی حاکمی علی الاطلاق",
        "languageId": null,
        "coupletSummary": null
      },
