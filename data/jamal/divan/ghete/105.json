        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شعله ها تا بآسمان دیدم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4040275,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "غیبت تو نه آن اثرها کرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: غیبت تو تاثیری ندارد که بشود مانند آن را دید یا توصیف کرد."
      },
      {
        "id": 4040276,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که توان گفت مثل آن دیدم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4040277,
        "vOrder": 11,
