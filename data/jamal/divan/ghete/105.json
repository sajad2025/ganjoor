        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کاندران روی دوستان دیدم",
