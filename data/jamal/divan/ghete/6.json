        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر بخدمت همیرود تقصیر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر به خدمت تو بیایم، تقصیر ما عفو و صبر توست که اینجا بهانه‌ای برای ما شده است."
      },
      {
        "id": 4039050,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
