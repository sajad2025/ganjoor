        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که بود رای خاکساران ظلم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4040223,
        "vOrder": 13,
        "coupletIndex": 6,
