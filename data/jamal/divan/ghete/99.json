      },
      {
        "id": 4040214,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیست خرد از بزرگواران ظلم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4040215,
        "vOrder": 5,
