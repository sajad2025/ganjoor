        "text": "حله بالای یکدگر پوشم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4040295,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کی گمان بودم اینکه همچون ابر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هرگز فکر نمی‌کردم که روزی مانند ابر ببارم و این چنین سرنوشت من را در پوشش غم و اندوه قرار دهد."
      },
      {
        "id": 4040296,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آب نبتی شو دز بر پوشم",
        "languageId": null,
        "coupletSummary": null
      },
      {
