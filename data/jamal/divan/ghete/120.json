        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چرا بهر تیمار هر بنده",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چرا برای درمان هر بنده‌ای، تو باید برای من زحمت به وجود بیاوری؟"
      },
      {
        "id": 4040440,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
