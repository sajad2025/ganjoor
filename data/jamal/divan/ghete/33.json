        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون پس از انتظار یکساله",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی بعد از یک سال انتظار مرا سیراب کنی، حس و حال من چه خواهد بود؟"
      },
      {
        "id": 4039438,
        "vOrder": 12,
