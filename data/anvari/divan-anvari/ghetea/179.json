        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون پلنگان فسادی انگیزد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2687391,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر کجا در دل زمین موشی است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر جایی که در دل زمین موشی وجود دارد، سارها بر آسمان می‌رقصند."
      },
      {
