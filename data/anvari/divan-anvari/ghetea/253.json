        "sectionIndex4": null,
        "text": "بر کار جهان دل منه ایرا که نشاید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به دنیا دل نبند، زیرا این دنیا پایدار نیست و خوبی و بدی در آن مدت زیادی دوام نخواهد داشت."
      },
      {
        "id": 2691326,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کین خوبی و ناخوبی هم دیر نپاید",
        "languageId": null,
        "coupletSummary": null
      },
