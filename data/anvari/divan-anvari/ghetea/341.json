        "sectionIndex4": null,
        "text": "اگر کبک ضعیفم بازگردم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2691991,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به دیدار تو هستم آرزومند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من منتظر دیدار تو هستم و آرزو می‌کنم که بتوانم وارد شوم یا اینکه ناچار شوم از در بازگردم."
      },
