        "coupletSummary": null
      },
      {
        "id": 2688220,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کیست بحری که موج بخشش اوی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چه کسی است این دریا که امواج بخشش او، کیسه‌ دریا را پر می‌کند؟"
      },
      {
        "id": 2688240,
        "vOrder": 6,
