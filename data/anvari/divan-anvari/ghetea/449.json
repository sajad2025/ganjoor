        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خاک بوسد عظام حاتم طی",
        "languageId": null,
        "coupletSummary": null
      },
