        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کم ده به تبر ز شاخ دسته",
        "languageId": null,
        "coupletSummary": null
      },
      {
