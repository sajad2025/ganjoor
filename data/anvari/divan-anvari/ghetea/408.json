        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با شومی جهل هرکه در ساخت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر کسی در کار ناپاکی و نادانی خطر نکند، سرنوشت خوبی برای او رقم خواهد خورد."
      },
      {
        "id": 2689751,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
