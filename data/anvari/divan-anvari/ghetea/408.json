        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در مجلس روزگارت این بس",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در زندگی‌ات تنها همین کافی است که از سختی‌ها و مشکلات عبور کرده‌ای و به جمعی از مردم رسیده‌ای."
      },
