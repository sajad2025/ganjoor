        "sectionIndex4": null,
        "text": "چون به آب حیات ذوالقرنین",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2689841,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
