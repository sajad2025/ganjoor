        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2689839,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای سلامت به صحبتت عطشان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای سلامت! هنگامی که با تو صحبت می‌کنم، مثل کسی هستم که به آب زندگی‌بخش و حیات‌بخش ذوالقرنین نیاز دارد و تشنه‌ام."
      },
      {
