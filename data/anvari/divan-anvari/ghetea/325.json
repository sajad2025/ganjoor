        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شاید ار ایمن نباشد از اجل",
        "languageId": null,
        "coupletSummary": null
      },
      {
