        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هان تا به خیال بد چو دونان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تا زمانی که خیال‌های ناپسند در دل انسان وجود دارد، او در زندگی دنیوی به سر می‌برد."
      },
      {
        "id": 2690251,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
