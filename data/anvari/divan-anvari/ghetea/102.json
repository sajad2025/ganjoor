    "verses": [
      {
        "id": 2688701,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نشنیده‌ای که زیر چناری کدو بنی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آیا نشنیده‌ای که در سایه چنار، کدو درشت و برجسته‌ای روییده و در روز بیستم، به سرعت رشد کرده و به بیرون رفته است؟"
      },
      {
        "id": 2688702,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برجست و بر دوید برو بر به روز بیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2688703,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پرسید از چنار که تو چند روزه‌ای",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: یکی از درختان چنار را پرسیدند که چند ساله‌ای، و چنار در پاسخ گفت که عمر من بیشتر از دویست سال است."
      },
      {
        "id": 2688704,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتا چنار عمر من افزون‌تر از دویست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2688705,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتا به بیست روز من از تو فزون شدم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او گفت: \"پس از بیست روز، توانستم از تو بالاتر بروم. این تنبلی را برایم توضیح بده که برای چه چیزی است؟\""
      },
      {
        "id": 2688706,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این کاهلی بگوی که آخر ز بهر چیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2688707,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتا چنار نیست مرا با تو هیچ جنگ",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گفت که من با تو هیچ‌گونه دعوا و دشمنی ندارم، چرا که نه امروز زمان جنگ است و نه وقتی برای قضاوت و جدال."
      },
      {
        "id": 2688687,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کاکنون نه روز جنگ و نه هنگام داوریست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2688686,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فردا که بر من و تو وزد باد مهرگان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: فردا که باد مهرگان بوزد، مشخص می‌شود که مردان واقعی و نامردان چه کسانی هستند."
      },
      {
        "id": 2688685,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنگه شود پدید که نامرد و مرد کیست",
        "languageId": null,
        "coupletSummary": null
      }
