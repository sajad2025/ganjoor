        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مگر بر خون من منشور دارد",
        "languageId": null,
        "coupletSummary": null
      }
