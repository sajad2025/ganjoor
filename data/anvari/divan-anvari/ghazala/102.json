        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگرچه پیش یاران گویم از شرم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هرچند که در حضور دوستان از او سخن می‌گویم، اما در دل می‌دانم که هیچ کس به خوبی او نیست."
