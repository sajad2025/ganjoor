        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به هرجو سنگ خرواری نباشد",
        "languageId": null,
        "coupletSummary": null
      },
      {
