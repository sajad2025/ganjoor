        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو تو یا کم ز تو یاری توان جست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر کسی مانند تو یا حتی کمتر از تو یاری پیدا شود، چه اهمیتی دارد اگر ستمکاری وجود نداشته باشد؟"
      },
      {
        "id": 2667355,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
