        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر من ز تو ای نگار بیداد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2669332,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
