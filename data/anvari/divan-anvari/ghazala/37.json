    "verses": [
      {
        "id": 2668547,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جمالت بر سر خوبی کلاهست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زیبایی تو، با کلاهی از خوبی بر سر دارد، نه به خاطر چهره‌ات، بلکه به خاطر ماهی که در وجودت نهفته است."
      },
      {
        "id": 2668546,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بنامیزد نه رویست آن که ماهست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2668545,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تویی کز زلف و رخ در عالم حسن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو آنی که زیبایی و جذابیتت در دل شب و هنگام صبح فرقی ندارد."
      },
      {
        "id": 2668544,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ترا هم نیم شب هم چاشتگاهست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2668543,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بسا خرمن که آتش در زدی باش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بسیاری از خوشبختی‌ها و نعمت‌ها را که خودت به دست آوردی، ممکن است بر اثر بی‌دقتی و ناپختگی نابود کنی؛ اما هنوز هم فرصت خوبی در دسترس توست که می‌توانی از آن بهره ببری."
      },
      {
        "id": 2668542,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هنوزت آب خوبی زیر کاهست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2668541,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پی عهدت نیاید جز در آن راه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به توفیق و وفای خود از راهی می‌آیم که برای آن صد سال انتظار کشیده‌ام."
      },
      {
        "id": 2668540,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کز آنجا تا وفا صد ساله راهست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2668539,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز عشوت روز عمرم در شب افتاد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از عشق تو، روزهای عمرم به شب تبدیل شده و به خاطر این ناراحتی، در دلم روزهای تیره و تار حاکم شده است."
      },
      {
        "id": 2668538,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وزین غم بر دلم روز سیاهست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2668537,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پس از چندی صبوری داد باشد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بعد از مدتی انتظار ممکن است بگویم که بوسه‌ای مثل صبح زود است."
      },
      {
        "id": 2668536,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که گویم بوسه‌ای گویی پگاهست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2668535,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شبی قصد لبت کردم از آن شب",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: یک شب تصمیم گرفتم به لبت نزدیک شوم، اما چشمان تو به قدری زیبا و دلرباست که مانند سپاهی من را احاطه کرده است."
      },
      {
        "id": 2668837,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سپاه کین چشمت در سپاهست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2668906,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به تیر غمزه مژگانت انوری را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به دلیل زیبایی و جذابیت نگاه تو، بسیاری از دل‌ها تحت تأثیر قرار گرفته و عاشق شده‌اند. این یک واقعیت در میان مردم است."
      },
      {
        "id": 2669378,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بکشتند و برین شهری گواهست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2668907,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لبت را گو که تدبیر دیت کن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به لبانت بگو که مواظب باشند و از پیچ و تاب زلفت دور نمانند، زیرا که بی‌گناه و بی‌خطرند."
      },
      {
        "id": 2669274,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
