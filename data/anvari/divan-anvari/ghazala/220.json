        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتمت تا به جان به فرمانم",
        "languageId": null,
        "coupletSummary": null
