        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کافری می‌کنی در این معنی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر به این معنا کافر می‌شوی، پس من هم کافر هستم، حتی اگر اکنون مسلمان باشم."
      },
      {
        "id": 2671177,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کافرم گر کنون مسلمانم",
        "languageId": null,
        "coupletSummary": null
