        "coupletSummary": "هوش مصنوعی: تو در کار من مشغولی و دقت نمی‌کنی که این کار چقدر به من ظلم کرده است و مدت‌هاست که ادامه دارد."
      },
      {
        "id": 2670358,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کان به عمری کند ستمکاری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2670392,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
