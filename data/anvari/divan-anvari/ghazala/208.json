        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر دلم گو غمت جهان بفروش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای دل، به من بگو که اگر غمت را به دنیا بفروشی، من با تمام وجود می‌خواهم آن را بخرم."
      },
      {
        "id": 2671579,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با چنین صد غمت خریدارم",
        "languageId": null,
        "coupletSummary": null
      },
