        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سرگشتهٔ عالم هوای تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر روز دل پریشان من به خاطر تو از دنیایی به دنیای دیگر می‌خیزد و سرگردان است."
      },
      {
        "id": 2667799,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر روز ز عالم دگر خیزد",
        "languageId": null,
        "coupletSummary": null
      },
