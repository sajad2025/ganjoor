        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خورشید فلک به فرق سر خیزد",
        "languageId": null,
        "coupletSummary": null
      },
      {
