        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون پای غم تو در میان آمد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2667510,
        "vOrder": 7,
