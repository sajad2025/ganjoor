        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا گرفتم آشنایی با غمت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هنگامی که با غم تو آشنا شدم، در این دنیا هیچ آشنا و خویشاوندی برایم باقی نماند."
      },
      {
        "id": 2667476,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
