        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون کنم تدبیر کارت چون کنم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چطور می‌توانم برای کار تو تدبیر کنم، وقتی دل خودم دیگر توان تدبیر ندارد؟"
      },
      {
