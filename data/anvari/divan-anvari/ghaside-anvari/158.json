        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "باد قوی اختر طغرل تکین",
        "languageId": null,
        "coupletSummary": null
      },
