        "id": 2680330,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عزم قضا پیکر طغرل تکین",
        "languageId": null,
        "coupletSummary": null
