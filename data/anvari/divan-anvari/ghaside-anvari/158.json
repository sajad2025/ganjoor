        "id": 2680331,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پیشرو کارکنان قضا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: پیشوای کارگزاران سرنوشت، اراده‌ی سرنوشت در وجود طغرل استوار است."
      },
