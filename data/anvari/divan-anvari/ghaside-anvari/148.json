        "text": "هیچ دیار در دیار جهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2684893,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از وقوفت نهان نیارد شد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هیچ چیز در این جهان وجود ندارد که از سرنوشت یا تقدیر پنهان بماند؛ نه چیزهایی که مخفی‌اند و نه آن‌هایی که در معرض دید قرار دارند."
      },
      {
        "id": 2684892,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه نهان و نه آشکار جهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2684903,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جنبش رایت تو داند داد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: حرکت و جنبش تو علت شناخت و آگاهی است، که از هر هفته‌ای به زندگی و ثبات جهان افزوده می‌شود."
      },
      {
        "id": 2684917,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بکم از هفته‌ای قرار جهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2684918,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر محک جلالت تو زدند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بر اساس بزرگی و عظمت تو، نشانی گذاشتند که نشان دهنده این باشد که ارزش‌های دنیا کمتر شده است."
      },
      {
        "id": 2684919,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مهر تا کم شد از عیار جهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2684944,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر جهان خواستار تو نبدی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر دنیا به دنبال تو نبود، تو هم هرگز خواهان دنیا نمی‌شدی."
      },
      {
        "id": 2684943,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نشدی امن خواستار جهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2684942,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر بداند که اختیار تو چیست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر او بداند که اختیار تو چه چیزی است، همه چیز همانند آنچه تو می‌خواهی خواهد بود."
      },
      {
        "id": 2684941,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همه آن باشد اختیار جهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2684940,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رو که سیمرغ همت تو نشد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر تلاش و اراده تو مانند سیمرغ باشد، هرگز فریب آرزوهای بیهوده را نخواهی خورد و در دام مشکلات جهان گرفتار نخواهی شد."
      },
      {
        "id": 2684939,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به فریب امل شکار جهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2684938,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر نظر کردیی به آفاقش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر به دنیای بیرون توجه کنی، به راحتی می‌توانی در کنار تمام تجربیات و زیبایی‌های زندگی قرار بگیری."
      },
      {
        "id": 2684937,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در میان آمدی کنار جهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2684936,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کم کند گر خدای چرخ سخات",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر خداوند اراده کند که کسی را از زندگی دنیوی دور کند، این از مدت زمانی که او در این جهان بوده است، کم می‌شود."
      },
      {
        "id": 2684935,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بکم از مدتی کنار جهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2684934,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دشمنت کز عداد مردم نیست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر دشمنت زیاد نیست، نترس؛ چرا که چرخ دنیا شمارش همه را انجام می‌دهد."
      },
      {
        "id": 2684933,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ناردش چرخ در شمار جهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2684932,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کیست او تا چو مردمان بندد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کیست که مانند دیگران، شتر خود را در صف و صفوف زندگی این جهان ببندد؟"
      },
      {
        "id": 2684931,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ناقهٔ خویش در قطار جهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2684930,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا سپهر از مدار خالی نیست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تا زمانی که آسمان از چرخش باز نایستاده، بر تو بادا که مدیریت و تدبیر کارهای دنیا را در دست داشته باشی."
      },
      {
        "id": 2684929,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر تو بادا مدار کار جهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2684928,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر مراد تو دار و گیر قضا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به خواسته تو دست یاب و سرنوشتت را در دست خود داشته باش که زندگی و کارهای دنیا بر وفق مراد تو باشد."
      },
      {
        "id": 2684927,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر بساط تو کار و بار جهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2684926,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حافظت باد هرکجا باشی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر جا که باشی، مراقب خودت باش که خدای جهان همیشه ناظر بر توست."
      },
      {
        "id": 2684925,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گاه و بیگاه کردگار جهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2684924,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بودن اندر جهان شعار تو باد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وجود تو در این جهان نشانه و علامت تو باد، تا وقتی که گذر از این دنیا علامت جهان باشد."
      },
      {
        "id": 2684923,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا گذشتن بود شعار جهان",
        "languageId": null,
        "coupletSummary": null
      }
