      {
        "id": 2717600,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر چه خواهی درو توان دیدن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2717583,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بشناسی درو که شاه کجاست؟",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بفهمی که پادشاه کجا زندگی می‌کند؟ محل او کجاست و مسیر رسیدن به او چگونه است؟"
      },
      {
        "id": 2717564,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "منزل او کدام و راه کجاست؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2717562,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دشمن شاهرا شکست از چیست؟",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چرا دشمن شاه را شکست می‌دهد؟ رنج دیوانه و خواب مست به چه دلیل است؟"
      },
      {
        "id": 2717561,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رنج دیوانه، خواب مست از چیست؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2717560,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در این خانه را که یافت کلید؟",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کیست که در این خانه را باز کرده و کلیدش را یافته است؟ و چه کسی چهره این خانه را از پشت پرده دیده است؟"
      },
      {
        "id": 2717559,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رخ این خانگی ز پرده که دید؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2717558,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه مسافت ز گنج تا به طلسم؟",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چقدر فاصله است بین گنج و طلسم؟ و چقدر دور است از معنای واقعی به نام."
      },
      {
        "id": 2717557,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وز مسمی چه مایه راه به اسم؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2717563,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "باز دانی مقید از مطلق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی متوجه شوی که محدودیت‌ها و قواعد می‌توانند کمک کنند تا حق را از باطل تشخیص دهی، می‌توانی به درستی از اشتباهات و انحرافات دوری کنی."
      },
      {
        "id": 2717556,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "راه باطل جدا کنی از حق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2717554,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هیچ دیوت ز ره نیندازد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هیچ دیوی نمی‌تواند به تو آسیب برساند، پس غول وحشتت نیز به چه دلیل باید تو را بترساند؟"
      },
      {
        "id": 2717553,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "غول رختت به چه نیندازد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2717552,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دور باشی ز مکرهای خفی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر از فریب‌های پنهان دور باشی، می‌توانی به راهی درست و صحیح دست یابی."
      },
      {
        "id": 2717551,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "راه یابی به ملت حنفی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2717550,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بتو گوید که آدمی چه بود؟",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به تو می‌گوید که انسان چیست؟ مرد چگونه است و انسانیت چیست؟"
      },
      {
        "id": 2717549,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرد چونست، و مردمی چه بود؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2717555,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سخره و رام هر دغل نشوی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به هیچ‌وجه نباید فریب کسانی را که نقشه می‌کشند و دروغ می‌گویند، بخوری و خودت را به راهی که آنها می‌خواهند، هدایت کنی. نباید مانند بقیه شوی و به سرنوشت بد دچار شوی."
      },
      {
        "id": 2717565,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به ضلال مبین مثل نشوی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2717573,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مالت از دزد در امان ماند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دارایی‌ات از دزد محافظت شده و حال و احوالت به خاطر دانش و علم، قطعا امن و مطمئن است."
      },
      {
        "id": 2717566,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حالت از علم بی‌گمان ماند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2717580,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "باز فکر تو چشم باز کند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: فکر تو مثل چشم باز می‌شود و روح را به حرکت در می‌آورد."
      },
      {
        "id": 2717579,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "موکب روح ترک تاز کند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2717578,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گول گشتت نباشد از چپ و راست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: فریب نخور و تحت تأثیر اطراف خود قرار نگیر، چون باید بدانیم که واقعاً جایگاه تو کجاست."
      },
      {
        "id": 2717577,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بازیابی که منزل تو کجاست؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2717576,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیدهٔ عبرتت گشاده شود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چشمانت باز می‌شود و از دیدهٔ عبرت‌آموز با دل پاکت متوجه زیبایی‌های واقعی می‌شوی."
      },
      {
        "id": 2717575,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلت از نقش غیر ساده شود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2717581,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو به فتحی چنین شوی واصل",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو به مقام و حالتی نائل می‌شوی که اوحدی به ثواب‌ها و پاداش‌های عظیم دست یافته است."
      },
      {
        "id": 2717574,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "و اوحدی را ثوابها حاصل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2717572,
        "vOrder": 47,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر نشاید که عذر ما خواهی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر نتوانی عذر ما را بپذیری، پس از خداوند خواسته‌های خود را طلب کن."
      },
      {
        "id": 2717571,
        "vOrder": 48,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دولت خواجه از خدا خواهی",
        "languageId": null,
        "coupletSummary": null
      }
    ],
    "recitations": [],
