        "text": "تو نیز، ار طالب آن یار نغزی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر تو هم به دنبال آن معشوق زیبا هستی، قدم‌هایت را درست بردار تا از مسیر خارج نشوی."
      },
      {
        "id": 2712386,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
