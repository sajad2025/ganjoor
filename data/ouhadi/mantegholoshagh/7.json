      },
      {
        "id": 2712778,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به پای خود در افتادم به دامت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به خاطر تو و محبتت به سجده افتادم و احساس می‌کنم که از خودم رها شده‌ام، ای کسی که من به خدمت تو درآمده‌ام."
      },
      {
        "id": 2712776,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو آزاد از منی، ای من غلامت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2712775,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل اندر روی رنگین تو بستم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل خود را به زیبایی‌های تو سپردم، اما نمی‌دانم نتیجه‌اش چه خواهد شد و چه رنگ و حالی به من خواهد داد."
      },
      {
        "id": 2712774,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ندانم تا چه رنگ آید به دستم؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2712773,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تنم پرتاب و دل پرجوش تا کی؟",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تنم آشفته و دل شاداب است، تا کی؟ زبانم پر از سخن است ولی لب‌هایم سکوت دارند، تا کی؟"
      },
      {
        "id": 2712772,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زبان پر حرف و لب خاموش تا کی؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2712771,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلی رنجور و جانی خسته دارم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل من مریض و جانم خسته است و از این درد و رنج، زبانم ناتوان شده است."
      },
      {
        "id": 2712770,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وزین محنت زبان چون بسته دارم؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2712769,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "توانم ساخت، چون جانم نباشد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: می‌توانم هر کاری انجام دهم، حتی اگر جانم در خطر باشد، اما طاقت دوری و جدایی را ندارم."
      },
      {
        "id": 2712768,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ولیکن تاب هجرانم نباشد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2712767,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو درمانم، به کار آرم صبوری",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که درمان می‌شوم، صبوری به کار می‌گیرم، اما در زمان جدایی، صبرم از دست می‌رود."
      },
      {
        "id": 2712766,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ولی صبرم نباشد وقت دوری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2712765,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "غمت را تا توانستم نهفتم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من تا جایی که توانستم غم تو را پنهان کردم، اما زمانی که زمان صحبت کردن فرارسید، آن را با تو در میان گذاشتم."
      },
      {
        "id": 2712764,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو وقت گفتن آمد با تو گفتم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2712777,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کنون تا خود ترا فرمان چه باشد؟",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: حالا بگو ببینم چه دستوری برای من داری؟ نمی‌گویی که درمان من چیست؟"
      },
      {
        "id": 2712793,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نگویی تا: مرا درمان چه باشد؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2712794,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دوایی کن مرا، کین دردم از تست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مرا درمان کن، چرا که درد من از وجود توست. دل من شکسته و رنگ رخسارم از غم توست."
      },
      {
        "id": 2712795,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل بریان و روی زردم از تست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2712824,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نگفتم تاکنون احوال با کس",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من تا به حال با کسی درباره حال خودم صحبت نکرده‌ام، و اگر هم او می‌دانست که من چه احساسی دارم، کافی بود."
      },
      {
        "id": 2712823,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو حال من بدانستی، ازین بس",
        "languageId": null,
        "coupletSummary": null
      }
    ],
