        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر کجا رو آورم جای منست",
        "languageId": null,
        "coupletSummary": null
