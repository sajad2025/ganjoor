        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون به درویشان تولای منست",
        "languageId": null,
        "coupletSummary": null
      },
      {
