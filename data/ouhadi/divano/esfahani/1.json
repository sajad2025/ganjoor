    "verses": [
      {
        "id": 4789811,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "او ذیر و راذه دیم تارو",
        "languageId": 7,
        "coupletSummary": "هوش مصنوعی: بوی تو همچون تارو از جنس احساسات من است و صبح به صبح با یاد تو زنده می‌شود."
      },
      {
        "id": 4789812,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از بوی تو و اذصبح تارو",
        "languageId": 7,
        "coupletSummary": null
      },
      {
        "id": 4789813,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اندوه تو تا و دل در مه",
        "languageId": 7,
        "coupletSummary": "هوش مصنوعی: غم و اندوه تو تا قبل از اینکه دل را به جهان بالا برسانی، در من نشسته است."
      },
      {
        "id": 4789814,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نش هشت که دل و ماورابو",
        "languageId": 7,
        "coupletSummary": null
      },
      {
        "id": 4789815,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کر ژیرک عالمت بوینو",
        "languageId": 7,
        "coupletSummary": "هوش مصنوعی: اگر به دنیا نگاه کنی، می‌بینی که در آن چه چیزهایی وجود دارند و چقدر عجیب و غریب هستند. به خودت بیاندیش که هر کجای این دنیا باشی، همواره با چالش‌ها و مسائل مختلفی روبرو خواهی شد."
      },
      {
        "id": 4789816,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سن کژ بیو که کژه خارو",
        "languageId": 7,
        "coupletSummary": null
      },
      {
        "id": 4789817,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیم تو خورو و چشم موتر",
        "languageId": 7,
        "coupletSummary": "هوش مصنوعی: شما به خوبی با تلاش و دقت می‌دانید که در چه شرایطی و با چه زمانی از زندگی خود برخوردارید."
      },
      {
        "id": 4789818,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هشکش ویکروان خوزارو",
        "languageId": 7,
        "coupletSummary": null
      },
      {
        "id": 4789819,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا کی و کی انتظار فردا",
        "languageId": 7,
        "coupletSummary": "هوش مصنوعی: این بیت به معنای این است که تا چه زمانی باید منتظر آینده باشیم؟ بهتر است به آرامی از خود بپرسیم که آیا امروز می‌توانیم به آنچه می‌خواهیم دست یابیم یا خیر."
      },
      {
        "id": 4789820,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آروم بپرس آرو آرو",
        "languageId": 7,
        "coupletSummary": null
      },
      {
        "id": 4789821,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زلف تودکرد کیخ دیمت",
        "languageId": 7,
        "coupletSummary": "هوش مصنوعی: زیبایی موهای تو مرا به یاد روزهای خوب می‌اندازد و دلم را به تنگ می‌کند."
      },
      {
        "id": 4789822,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ماریوسیا که دل نمارو",
        "languageId": 7,
        "coupletSummary": null
      },
      {
        "id": 4789823,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برتش دل ویست شارواهنن",
        "languageId": 7,
        "coupletSummary": "هوش مصنوعی: دلبر من، آن عشق که فردا خواهد آمد، بی‌تابم می‌کند و من دائم در دل دلم برای او می‌تپد."
      },
      {
        "id": 4789824,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فردا کرو کر که دل دل دارو",
        "languageId": 7,
        "coupletSummary": null
      },
      {
        "id": 4789825,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل کت پرذر و غم و دی کرت",
        "languageId": 7,
        "coupletSummary": "هوش مصنوعی: دل پر از درد و اندوه و غم است، آن را با ناله و زاری بیامیز که بسیار تلخ و گرانبار است."
      },
      {
        "id": 4789826,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جاریش ببر که سخت زارو",
        "languageId": 7,
        "coupletSummary": null
      },
      {
        "id": 4789827,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ویدا ذکر همیشه آخر",
        "languageId": 7,
        "coupletSummary": "هوش مصنوعی: زندگی همیشه به یادآوری کارهای ناتمام مربوط می‌شود و باید به این فکر کنیم که این کار چه معنایی دارد."
      },
      {
        "id": 4789828,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کاری وه کر که این چه کارو",
        "languageId": 7,
        "coupletSummary": null
      }
