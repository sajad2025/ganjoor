        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نگوید به ترک تو اوحدی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نمی‌توانم بگویم که اوحدی به خاطر ترک تو، اگرچه دین و دنیایش آسیب ببیند، چیزی گفت."
      },
      {
        "id": 2697184,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
