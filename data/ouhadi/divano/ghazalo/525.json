        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با حریفان ، عجب، ار پند کسی بپذیرم!",
        "languageId": null,
        "coupletSummary": null
      }
