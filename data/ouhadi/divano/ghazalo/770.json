    "verses": [
      {
        "id": 2702323,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر تو سری میکشی تا نکنی آشتی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر تو به دلخوری ادامه می‌دهی و تصمیم به آشتی نمی‌گیری، ما هم در مقابل تو به همان اندازه سرکش و مقاوم هستیم. پس تو چه تصوری از این وضعیت داری؟"
      },
      {
        "id": 2702322,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ما ز تو سرکش‌تریم،پس تو چه پنداشتی؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2702321,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ما دل صد آشنا بهر تو بگذاشتیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما برای تو دل‌های زیادی را فدای تو کردیم، اما تو حتی یک ذره از بیگانگی‌ات را کنار نگذاشتی."
      },
      {
        "id": 2702320,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای که ز بیگانگی هیچ بنگذاشتی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2702319,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با تو چه سودی نداشت صلح، به جنگ آمدیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اینکه با تو صلح کردیم فایده‌ای نداشت و به جنگ روی آوردیم. زمانی که کار به مشکل می‌خورد، جنگ بهتر از آشتی است."
      },
      {
        "id": 2702318,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کار چو مشکل شود جنگ به از آشتی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2702317,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شاخ ستم کشته‌ای، بار جفایی بچین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: شاخی که از ظلم و ستم شکسته شده، حالا تو می‌توانی بار سنگینی از بی‌وفایی و خیانت را بر دوش بکشی. این نتیجه‌ای است که خودت ایجاد کرده‌ای با کارهایت."
      },
      {
        "id": 2702316,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هم تو توانی درود تخم که خود کاشتی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2702315,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دوش فرستاده‌ای: کز تو ندارم خبر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: شب گذشته پیامی از تو رسید که هیچ اطلاعی از حالت نداشتم. حالا خودت بگو، تو از چه کسی خبر داشتی؟"
      },
      {
        "id": 2702314,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خود بنگویی که: تو از که خبر داشتی؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2702326,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با دگران مر ترا هر چه میسر نشد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو با دیگران هر چه نتوانستی به دست بیاوری، از درد و رنج و سختی بر دل من گذاشتی."
      },
      {
        "id": 2702313,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از غم و رنج و جفا بر دلم انباشتی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2702311,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شغل تو گر خواجگیست، در پی آن روز، که هست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر شغل تو خدمت دربار است، امیدوار باش به روزی که من و اوحدی در خیالات و راز و رمزهایمان به سر ببریم و تو از این حرف‌ها بی‌خبر باشی."
      },
      {
        "id": 2702310,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کار من و اوحدی رندی و ناداشتی",
        "languageId": null,
        "coupletSummary": null
      }
    ],
