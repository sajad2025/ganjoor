        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نامه‌ای ننوشته‌ای هرگز، خطا می‌کرده‌ای",
        "languageId": null,
        "coupletSummary": null
      }
