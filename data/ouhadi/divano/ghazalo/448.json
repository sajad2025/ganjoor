    "verses": [
      {
        "id": 2706795,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز حسن تو پیدا شد آیین عشق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زیبایی تو، اصول عشق را روشن کرد و لب‌هایت عشق را به من آموخت."
      },
      {
        "id": 2706796,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خرد را لبت کرد تلقین عشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2706793,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برین رقعه ننهاد شاهی قدم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در این متن به این نکته اشاره می‌شود که یک شاه کیفری یا پیامی فرستاده و از کسی که به شدت درگیر عشق و محبت است، انتظار دارد که دچار شکست عاطفی نشود و به همین خاطر او را در قالبی از عشق امیدوار ساخته است. به نوعی نشان می‌دهد که عشق و احساسات عاطفی می‌تواند انسان را در موقعیت‌های حساسی قرار دهد."
      },
      {
        "id": 2706794,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که ماتش نکردی به فرزین عشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2706791,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ازین بیشه شیری نیامد برون",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در این جنگل، هیچ شیری بیرون نمی‌آید مگر اینکه تو او را با تیر عشق نکشی."
      },
      {
        "id": 2706792,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که او را نکشتی به زوبین عشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2706789,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز بهر شکاردل خستگان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به خاطر دردی که دل خستگان را آزار می‌دهد، تو بر اسب مصیبت زین عشق را گذاشته‌ای."
      },
      {
        "id": 2706790,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر اسب بلا بسته‌ای زین عشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2706787,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کسی با خیالت نخسبد دمی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هیچ‌کس نمی‌تواند در خیال تو آرام بگیرد، مگر آن‌که نام عشق را بر او بخوانند."
      },
      {
        "id": 2706788,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که بر وی نخوانند یاسین عشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2706786,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برین آستان دعوت هیچ کس",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در این مکان، فقط افرادی که با عشق آمده‌اند می‌توانند پذیرفته شوند و هیچ کس دیگر نمی‌تواند وارد شود."
      },
      {
        "id": 2706798,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نگردد روا جز به آیین عشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2706783,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من آن باد را خاک خواهم شدن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من به اندازه‌ای به تو علاقه دارم که دوست دارم مانند بادی بشوم که عطرت را از سرزمین عشق به همراه می‌آورد."
      },
      {
        "id": 2706785,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که بوی تو می‌آرد از چین عشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2706781,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو ای عالم شهر، اگر عاقلی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای عالمی که در این شهر به سر می‌بری، اگر به حقیقت عقل و درستی فکر می‌کنی، به دور از دیوانگان عشق زندگی کن."
      },
      {
        "id": 2706782,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سکونت مجوی از مجانین عشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2706779,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر این خلق هر کس به دینی روند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر هر کس از این مردم به مذهب و دینی روی آورد، مبادا که اوحدی را جز دین عشق بشناسد."
      },
      {
        "id": 2706780,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مباد اوحدی را به جز دین عشق",
        "languageId": null,
        "coupletSummary": null
      }
