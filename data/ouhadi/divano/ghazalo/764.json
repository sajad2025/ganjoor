        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کدامین مؤمن از بت باز رستی؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2702179,
        "vOrder": 9,
