        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2703571,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برآنی که بر من کنی رحمتی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر بر من رحمی کنی، چه فایده‌ای برای من دارد؟ اگر این کار را اکنون انجام ندهی."
