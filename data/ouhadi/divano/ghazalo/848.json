        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به صحرا دوانی و مجنون کنی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2703575,
        "vOrder": 5,
