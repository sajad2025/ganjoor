        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از تنم رسم آن کمر برزد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از بدنم نشانهٔ کمر بر افتاد و از دلم قول و قراری به زبان آمد."
      },
      {
        "id": 2700804,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وز دلم نسخهٔ دهان برداشت",
        "languageId": null,
        "coupletSummary": null
      },
