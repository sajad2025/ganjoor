        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بنشست و قلم روان برداشت",
        "languageId": null,
        "coupletSummary": null
      },
