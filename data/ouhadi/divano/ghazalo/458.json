        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گوش می‌دار که: صیدت نکند باز ای دل",
        "languageId": null,
        "coupletSummary": null
      },
      {
