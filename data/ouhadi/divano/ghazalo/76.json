        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وز کف موی تو نخواهیم رست",
        "languageId": null,
        "coupletSummary": null
      },
