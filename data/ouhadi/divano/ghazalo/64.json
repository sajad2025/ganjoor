    "verses": [
      {
        "id": 2698060,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بگذاشته‌ام، تا چه کند نرگس مستت؟",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ترک کرده‌ام، ببینم نرگس دلربایت چه خواهد کرد. با یاری که از نظر من پسندیده است و پیمان محبتش را نخواهم فراموش کرد."
      },
      {
        "id": 2698059,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با یار پسندیده که پیمان نواستت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2698058,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رای دو دلی کردن و آهنگ جدایی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نگرانی از دو دلی و تصمیم به جدایی باعث می‌شود که بگویی که من هیچ‌چیز ندارم، اما در عوض تو را می‌بینم و وجودت را حس می‌کنم."
      },
      {
        "id": 2698057,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتی که: ندارم من و می‌بینم و هستت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2698056,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پیوند تو افزون شو و بسیار بگفتند:",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ارتباط تو با دیگران در حال افزایش است و بسیاری هم این را می‌گویند: سریع عهد خود را بشکن، چون این پیمان تو را متضرر کرده است."
      },
      {
        "id": 2698055,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عهدش بشکن زود، که پیمان بشکستت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2698054,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا جان ندهم جای جراحت ننماید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تا زمانی که جانم را ندهی، تیر زخم بر دلم را نشان نخواهد داد. این تیر که اکنون از دست تو به دلم افتاده، اثر خود را نشان نمی‌دهد."
      },
      {
        "id": 2698053,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تیری که کنون بر دلم افتاد ز دستت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2698065,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از دست برفتم من و بر دست نه ای تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من از دست رفته‌ام و تو دیگر در دسترس نیستی، پس چه باید بکنم اگر از دست تو چیزی به من نرسد؟"
      },
      {
        "id": 2698052,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیگر چه کنم، گر ندرم جامه ز دستت؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2698050,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی‌یاد تو هرگز ننشینیم بر کس",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما هرگز نمی‌توانیم بدون یاد تو بر جای دیگری بنشینیم، حتی اگر خودمان هم کسی را نبینیم که نشسته باشد."
      },
      {
        "id": 2698049,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر چند بر خویش ندیدیم نشستت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2698048,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بس دام که در راه تو آهو بره کردند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در مسیر عشق تو، تعداد زیادی آهوان و بره‌ها در دام افتادند، اما تو هرگز در دام نیفتادی و هیچ‌کس هم نتوانست تو را از دام رهایی بخشد."
      },
      {
        "id": 2698047,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در دام نرفتی و کس از دام نرستت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2698046,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر بر سر ما تیغ زنی روی نپیچیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر بر سر ما تیغ نکشی و به ما حمله کنی، ما سرمان را نمی‌پیچیم و این نشان از بی‌وفایی توست که از دام تو فرار می‌کند."
      },
      {
        "id": 2698045,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن سست وفا بود که از دام بجستت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2698044,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای اوحدی، از عشق ندیدم که گشودی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای اوحدی، تا کنون از عشق ندیدم که چشمانت را تا صبح باز کردی، چه کسی بود که باعث شد اینگونه چشم‌هایت را ببندی؟"
      },
      {
        "id": 2698043,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا سحر که بود این که چنین دیده ببستت؟",
        "languageId": null,
        "coupletSummary": null
      }
    ],
