        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بوسه‌ای زان روی چون ماهم بده",
        "languageId": null,
        "coupletSummary": null
      },
      {
