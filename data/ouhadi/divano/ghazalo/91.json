        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نغمهٔ شیرین مرغان سحر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: صدای دل‌انگیز پرندگان صبحگاهی، شور و شوقی را در دل مست‌ها ایجاد کرده و آنها را به خواب می‌برد."
      },
      {
        "id": 2698542,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شور در مستان خواب انداختست",
        "languageId": null,
        "coupletSummary": null
      },
      {
