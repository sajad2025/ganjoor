        "coupletSummary": null
      },
      {
        "id": 2698189,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چشم تو آنجا که دست برد به دستان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چشم تو در جایی است که وقتی به دست‌ها دست می‌زنند، زیرکانی با فکر و تدبیر به بلادت احترام می‌گذارند."
      },
