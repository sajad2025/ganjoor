        "text": "تا شمع بیندت که چنین خوش نشسته‌ای",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2701641,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
