        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صد گلبن شکفته و صد لاله دسته‌ای",
        "languageId": null,
        "coupletSummary": null
      },
      {
