        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کورا به فدا باد ابونا وابوه!",
        "languageId": null,
        "coupletSummary": null
      },
