      },
      {
        "id": 2705493,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ما را به جفا گذاشتن تا کی؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2705492,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شاخ طرب از زمین جانها تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: شاخه‌های شادی از دل‌هایت برداشت می‌کنی و به جایش غم می‌کاری، این کار تا کی ادامه خواهد داشت؟"
      },
      {
        "id": 2705491,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برکندن و غصه کاشتن تا کی؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2705490,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در حسرت خویش گونهای ما",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما چقدر باید در حسرت خود بمانیم و این حالتمان را به قلم بنویسیم؟"
      },
      {
        "id": 2705489,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زینگونه به خون نگاشتن تا کی؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2705488,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از لطف بما نگاه کن روزی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به ما لطف کن و به رازهای خودت نگاه داشتن را ادامه نده، تا چه زمانی می‌خواهی این کار را بکنی؟"
      },
      {
        "id": 2705487,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "راز تو نگاهداشتن تا کی؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2705486,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر یک دل مستمند سر گردان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به یک دل بیچاره و سرگردان، تا کی باید بارها و درد و رنج قرار داد؟"
      },
      {
        "id": 2705485,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صد درد و بلا گماشتن تا کی؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2705484,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در پای ستم چو خاک ره ما را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما را مانند خاک پای ستم زیر پا می‌گذارند و هیچ‌وقت ما را برنمی‌دارند، تا کی باید این وضعیت ادامه داشته باشد؟"
      },
      {
        "id": 2705483,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "افگندن و برنداشتن تا کی؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2705482,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر اوحدی شکسته، چون گردون",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بر انسانی که دلش شکسته است، تا چه زمانی باید به او ستم کرد و از سر بی‌رحمی او را آزرد؟"
      },
