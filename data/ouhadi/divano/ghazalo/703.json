      {
        "id": 2703361,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی‌دلان به بوسه کام بده",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2703360,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
