    "verses": [
      {
        "id": 2701211,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای عید روزه‌داران ابروی چون هلالت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای عید خوشحال‌کننده روزه‌داران، ابروهای خوش‌حالت همچون هلال ماه و موی سیاهت که انگار سحرگاهان در زلف‌هایت نشسته است."
      },
      {
        "id": 2701210,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وی شام صبح خیزان زلف سیاه و خالت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2701209,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خورشید چرخ خوبی عکس فلک نوردت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: خورشید درخشان آرایش خوبی از آسمان به تصویر می‌کشد، ناهید که در آن درخشش حضور دارد، به مانند خوشحالی و زیبایی یک ماه است که تو را به یاد می‌آورد."
      },
      {
        "id": 2701179,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ناهید برج شادی روی قمر مثالت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2701177,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پشت فلک شکسته مهر قضا توانت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: سرنوشت و تقدیر همچون دیواری محکم، نمی‌گذارد که عشق و محبت تو را در زمین نگه دارد و تو را از آزادی و رشد بازدارد. موانع فراوانی در پیش روی تو قرار دارد، اما عشق هنوز هم قدرتی برای ادامه مسیر و تلاش دارد."
      },
      {
        "id": 2701176,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "روی زمین گرفته عشق قدر مجالت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2701175,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عمر منی، وفا کن، تا برخوردم ز وصلت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عمر من، لطفی کن و به من وفا کن. وقتی به من ملحق می‌شوی، مرا آزاد کن تا با بال تو پرواز کنم."
      },
      {
        "id": 2701174,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرغ توام، رها کن، تا می‌پرم به بالت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2701173,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دردا! که در فراقت خرمن به باد دادم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آه! چه غم‌انگیز است که به خاطر جدایی‌ات تمام تلاش و زحمتم را هدر دادم، و هنوز هم نتوانستم ذره‌ای از حاصل عشق‌ات را ببینم."
      },
      {
        "id": 2701172,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وانگه ندیده یک جو از خرمن وصالت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2701171,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتی مرا که: داری میلی به جانب من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو به من گفتی که به سمت تو تمایل دارم و این تمایل بسیار زیاد است، اما در عین حال می‌ترسم که از ملالت و خستگی رنج ببرم."
      },
      {
        "id": 2701170,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "میلم بسیست لیکن، لیکن می‌ترسم از ملالت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2701169,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کی چون خیال گشتی از ناخوشی تن او!؟",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کی از ناخوشی بدن او جدا شدی که چون خیال به سراغت آمد؟ اگر اوحدی را در خواب خوش خیال خود ندیدی، چه کسی را دیده‌ای؟"
      },
      {
        "id": 2701168,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر اوحدی ندیدی در خواب خوش خیالت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2701167,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیچاره اوحدی را ملکی نبود و مالی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اوحدی بیچاره، هیچ‌گونه مقام و ثروتی نداشت؛ وگرنه تو می‌توانستی با ثروتت او را از کناری بفریبی."
      },
      {
        "id": 2701166,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ورنه هم از کناری بفریفتی به مالت",
        "languageId": null,
        "coupletSummary": null
      }
    ],
