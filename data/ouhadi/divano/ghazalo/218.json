        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که فتنه زآن سر زلف به تاب می‌ریزد",
        "languageId": null,
        "coupletSummary": null
