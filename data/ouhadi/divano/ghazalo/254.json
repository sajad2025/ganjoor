        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از اوحدی شنو، که درین درد پیر شد",
        "languageId": null,
        "coupletSummary": null
      }
