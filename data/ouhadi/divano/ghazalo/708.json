        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دوست را آشکار در پرده",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2703486,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرو، ار پرده در میان بینی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نرو، اگر پرده را در میان ببینی، چه نیازی به پرده دیدن داری؟"
