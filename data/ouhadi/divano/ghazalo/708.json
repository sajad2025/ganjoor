        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نظر جهل چون تواند دید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چطور می‌تواند نادانی یار را در غار ببیند در حالی که خود غار در پرده است؟"
      },
      {
