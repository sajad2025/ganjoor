        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خویشتن را مدار در پرده",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2703488,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پردهٔ خویش را بسوز و ببین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: پرده‌ات را کنار بزن و دوست را به وضوح و بدون هیچ پوششی ببین."
