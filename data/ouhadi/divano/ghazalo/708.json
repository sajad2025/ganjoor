        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیدهٔ اعتبار در پرده",
        "languageId": null,
        "coupletSummary": null
      },
      {
