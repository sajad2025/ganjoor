        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نهلد پود و تار در پرده",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2703327,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پرده زان دیده‌ای، که هست ترا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این چشم توست که پرده‌ای را کنار زده، و به تو نشان می‌دهد که تو چه ارزشی داری."
      },
      {
