        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پرده بین را چکار در پرده؟",
        "languageId": null,
        "coupletSummary": null
