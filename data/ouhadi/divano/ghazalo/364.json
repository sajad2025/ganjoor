        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به امید صلح و کنار تو خواهم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به امید صلح، کنار تو خواهم بود، اما هر شب در دل من جنگی با تو رخ می‌دهد."
      },
      {
        "id": 2696979,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
