    "verses": [
      {
        "id": 2708591,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا بر آن عارض زیبا نظر انداخته‌ایم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که به آن چهرهٔ زیبا نگاه کرده‌ایم، مانند این است که تمام فکر و عقل خود را به یک باره کنار گذاشته‌ایم."
      },
      {
        "id": 2708590,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خانهٔ عقل به یک بار برانداخته‌ایم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2708589,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر دل ما دگر آن یار کمان ابرو تیر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل ما دیگر تاب تحمل تیرهای محبت آن یار را ندارد. او هر چه می‌خواهد انجام دهد، زیرا ما خود از عشق و احساسات‌مان دست کشیده‌ایم و دیگر مقاومتی نداریم."
      },
      {
        "id": 2708588,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گو: مینداز، که ما خود سپر انداخته‌ایم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2708587,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هیچ شک نیست که: روزی اثری خواهد کرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هیچ تردیدی وجود ندارد که روزی تاثیر خود را خواهد گذاشت، بر نتایجی که از اشک و غم و ناله‌ای که در صبحگاه داشته‌ایم."
      },
      {
        "id": 2708586,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تیر آهی که به وقت سحر انداخته‌ایم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2708585,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای که قصد سر ما داری، اگر لایق تست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای کسی که به سراغ ما آمده‌ای، اگر شایسته‌ات می‌دانیم، بپذیر ما به خاطر تو جان خود را فدای تو کرده‌ایم."
      },
      {
        "id": 2708597,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بپذیرش، که به پای تو در انداخته‌ایم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2708612,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به جفا از در خود دور مگردان ما را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: خواهش می‌کنیم که ما را از در خود دور نکن، تا بتوانیم دلی را که به آن عشق ورزیده‌ایم، پیدا کنیم."
      },
      {
        "id": 2708613,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا بجوییم دلی را که در انداخته‌ایم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2708614,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "قدر خاک درت اینها چه شناسند؟ که آن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این شعر به این موضوع اشاره دارد که دیگران قادر به درک و ارزش‌گذاری مناسبی از مقام و عظمت تو نیستند. آن‌ها مانند افرادی هستند که فقط از یک دوربین تنگ‌نظر به زیبایی‌های زندگی نگاه می‌کنند و نمی‌توانند زیبایی واقعی را ببینند. در واقع، این توصیف به محدودیت‌های بینش دیگران اشاره دارد و نشان می‌دهد که ارزش‌ها و جواهرات واقعی با چشم غیرمسلح قابل مشاهده نیستند."
      },
      {
        "id": 2708641,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "توتیاییست که ما در بصر انداخته‌ایم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2708640,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اوحدی راز خود از خلق نمی‌پوشاند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اوحدی به دیگران می‌گوید که من رازهایم را از مردم پنهان نمی‌کنم و برعکس، این شما هستید که پرده‌پوشی کرده‌اید و حقیقت را نمی‌بینید."
      },
      {
        "id": 2708639,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گو: ببینید که: ما پرده در انداخته‌ایم",
        "languageId": null,
        "coupletSummary": null
      }
