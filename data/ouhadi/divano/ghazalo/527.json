    "verses": [
      {
        "id": 2705674,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به غم خویش چنان شیفته کردی بازم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو به گونه‌ای مرا در غم خود فرو بردی که حتی به خودم نیز دیگر توجهی ندارم و فقط در خیال تو غرق شده‌ام."
      },
      {
        "id": 2705673,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کز خیال تو به خود نیز نمی‌پردازم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2705672,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر که از نالهٔ شبگیر من آگاه شود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هرکسی که از پژواک ناله‌هایم در آستانهٔ dawn باخبر شود، بدون شک، به خوبی می‌فهمد که رازهایم را در روز می‌دانم."
      },
      {
        "id": 2705671,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هیچ شک نیست که چون روز بداند رازم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2705670,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفته بودی: خبری ده، که ز هجرم چونی؟",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گفته بودی که از حال و احوالم بگو و بپرس که در نبود تو چطورم. من آنقدر در دردم غرق هستم که حتی اگر ببینی‌ام، نمی‌توانی بفهمی که چقدر رنج می‌برم."
      },
      {
        "id": 2705669,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن چنانم که ببینی و ندانی بازم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2705668,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عهد کردی که: نسوزی به غم خویش مرا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو قول داده بودی که به خاطر غم خودت ناراحت نشوی، اما برای من هیچ نگرانی وجود ندارد. تو در آتش غمت بسوز، چون من با این وضعیت کنار می‌آیم."
      },
      {
        "id": 2705680,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هیچ غم نیست، تو می‌سوز، که من میسازم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2705667,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بعد ازین با رخ خوب تو نظر خواهم باخت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از این به بعد، با زیبایی چهره‌ات می‌نگرم و به همه می‌گویم که: من دوباره شاهدی زیبا دارم."
      },
      {
        "id": 2705665,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گو: همه شهر بدانند که: شاهد بازم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2705664,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن چنان بر دل من ناز تو خوش می‌آید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ناز و دلربایی تو چنان برای قلب من لذت‌بخش است که حتی اگر بخواهی با ناز و کرشمه‌ات مرا از پا درآوری، باز هم نمی‌توانم تو را ببخشم."
      },
      {
        "id": 2705663,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که حلالت نکنم گر نکشی از نازم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2705662,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر از دام خودم نیز خلاصی بخشی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر از گرفتاریم هم نجات بیابم، باز هم تنها آرزویم پرواز و رفتن به سرزمین توست."
      },
      {
        "id": 2705661,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هم به خاک سر کوی تو بود پروازم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2705660,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اوحدی گر نه چو پروانه بسوزد روزی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر اوحدی روزی مثل پروانه بسوزد، من هم همچون شمعی در شب، برای تو گداز خواهم شد."
      },
      {
        "id": 2705659,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پیش روی تو چو شمعش به شبی بگدازم",
        "languageId": null,
        "coupletSummary": null
      }
    ],
