        "sectionIndex4": null,
        "text": "به بوی گل عارض او دل خود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به عطر گل‌های صورت او، دل خود را در آن موهای تاب دارش قرار دادم."
      },
      {
        "id": 2707049,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در آن زلف چون سنبل تر نهادم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2707048,
        "vOrder": 9,
        "coupletIndex": 4,
