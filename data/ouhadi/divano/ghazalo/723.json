        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2701952,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گرم دستگاه گل و لاله بودی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر در دنیای زیبا و رنگارنگ گل و لاله بودی، به خاطر ارزش بالای آن‌ها، هرگز نمی‌گذارم به سادگی از دست بروند."
      },
      {
        "id": 2701951,
        "vOrder": 14,
