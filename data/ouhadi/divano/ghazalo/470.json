        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای هلاک دلم پسندیده",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای محبوب من، اگر دل من به آن حلاوت و قدرتی که از تو بر می‌خیزد، گرفتار شود، این قدرت و زیبایی را دوست دارم."
      },
      {
        "id": 2706649,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
