      },
      {
        "id": 2708617,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همچون دهان او دل خود تنگ دیده‌ایم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2708616,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیرون شد اختیار دل و دین ز چنگ ما",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل و ایمان ما دیگر در کنترل ما نیستند، زیرا در دنیای عشق و خوشی‌های مادی غرق شده‌ایم و به میگساری و نواهای دلنشین توجه داریم."
      },
      {
        "id": 2708615,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا ساغر شراب و دف و چنگ دیده‌ایم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2708584,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن دل، که دلبران جهانش نیافتند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل‌هایی که در این دنیا محبوبان را نیافته‌اند، همان کسانی هستند که تحت تأثیر زلف‌های پیچیده و جذاب زیبایی قرار گرفته‌اند و دیده شده‌اند."
      },
      {
        "id": 2708583,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زان زلفهای تافته آونگ دیده‌ایم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2708582,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چنگ حسود ما چه گریبان که پاره کرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: حسادت ما چه تاثیری دارد که به آن چیزی که در دست داریم آسیب بزند، در حالی که ما چیزهای ارزشمندی را در دامن خود داریم که به آن‌ها دست یافته‌ایم."
      },
      {
        "id": 2708552,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زین دامن مراد که در چنگ دیده‌ایم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2708550,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فرسنگ را شمار جدا کن ز راه ما",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: فاصله را از مسیر ما جدا کن، چرا که راه او را به اندازه فرسنگ‌ها ندیده‌ایم."
      },
      {
        "id": 2708549,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زیرا که راه او نه به فرسنگ دیده‌ایم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2708548,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "راهی که نیست بر در او، سهو یافته",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: راهی که در آن ورودی نیست، به اشتباه پیاده‌روی کرده‌ایم. و راهی که در آن رد پایی نیست، با دیدی نادرست به آن نگاه کرده‌ایم."
      },
      {
        "id": 2708547,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پایی که نیست بر پی او، لنگ دیده‌ایم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2708546,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از قول اوحدی منگر، کین ترانها",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به خاطر داشته باش که این صدا و نوای دلنشین تنها در ظاهر است و حقیقت عمیق‌تری را در خود دارد."
      },
      {
        "id": 2708545,
        "vOrder": 14,
