        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خوردست باده، لیک ز جام الست عشق",
        "languageId": null,
        "coupletSummary": null
      }
