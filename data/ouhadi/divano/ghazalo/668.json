      },
      {
        "id": 2702921,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سوگند سخت من به دل همچو سنگ تو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2702920,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در دهر سوکوار نباشد به حال من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در این دنیا هیچ کس به حال من توجهی ندارد و در این شهر که پر از غم و اندوه است، بی‌وجود تو هیچ دلخوشی ندارم."
      },
      {
        "id": 2702919,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در شهر غمگسار نباشد بی‌نگ تو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2702918,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پیش رخت ز شرم بریزند رنگها",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که تو در برابر کسی ظاهر می‌شوی، به خاطر زیبایی‌ات، تمام رنگ‌ها از شرم محو می‌شوند و هنرمندان چهره‌نگاری که تو را می‌بینند، رنگ صورتشان به خاطر جلوه‌ی تو تغییر می‌کند."
      },
      {
        "id": 2702930,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صورتگران چین چو ببینند رنگ تو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2702917,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر زان دل چو سنگ و بر همچو سیم خام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر دلی به سختی سنگ داشته باشد و مانند نقره‌ی خام باشد، تنها کسی آن را می‌شکند که نقره را در برابر سنگ بریزد."
      },
      {
        "id": 2702915,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنکس خورد، که سیم بریزد به سنگ تو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2702914,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مپسند کشتن من مسکین، که بعد ازین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از کشتن من بیچاره خوشنود نباش، زیرا پس از من دیگر کسی مانند من به دام تو نخواهد افتاد."
      },
      {
        "id": 2702913,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مانند من شکار نیفتد به چنگ تو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2702912,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اکنون سپر چه سود؟ که بر دل گذار کرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اکنون داشتن سپر چه فایده‌ای دارد؟ وقتی پیکان تیر زخم‌زننده چشمان تو بر دل فرود آمده است."
      },
      {
        "id": 2702911,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پیکان تیر غمزهٔ همچون خدنگ تو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2702910,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "میدان فراخ یافته‌ای، اوحدی،ولی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اوحدی، تو در دنیای وسیع و بزرگ زندگی می‌کنی، اما عجیب است که دست تو که محدود است، چگونه می‌تواند به وصل و ارتباط با او برسد!"
      },
      {
        "id": 2702909,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در وصل او عجب که رسد دست تنگ تو!",
        "languageId": null,
        "coupletSummary": null
      }
