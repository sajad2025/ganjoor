        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای که گفتی: چاره می‌دانم ترا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای کسی که ادعا کردی راه حل تو را می‌دانم، بدان که اوحدی هم به این اندازه نادان نبود."
      },
