        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نام من گم کرد و رخت ما ببرد",
        "languageId": null,
        "coupletSummary": null
      },
