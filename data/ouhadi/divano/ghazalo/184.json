        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر نهان آمد، مرا پیدا ببرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2699939,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دانش و دین مرا آن چشم ترک",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: علوم و باورهای دینی من از آن چشم زیبای لبنانی دچار آسیب و غارت شدند و همه چیز را از من گرفت."
      },
