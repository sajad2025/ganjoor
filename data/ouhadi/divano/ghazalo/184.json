        "sectionIndex4": null,
        "text": "روز غارت بود، در یغما ببرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2699786,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از دل من بود هر غوغا که بود",
