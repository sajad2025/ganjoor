        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اوحدی را ز درد درمان کن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: فردی را که در رنج و درد است بهبود ببخش، چرا که او به خاطر درد و درمانش به فریاد درآمده است."
