        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عهد بستیم و نیستی راضی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما پیمان بستیم و در برابر نبودن، دل خود را راضی کردیم و اکنون احساس پشیمانی می‌کنیم."
      },
      {
        "id": 2703954,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
