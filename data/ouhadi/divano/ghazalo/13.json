        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز دل و جان نشانه ساخته‌ام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از دل و جانم علامتی برای تو ساخته‌ام، تیرکمان چشم بازیگوش و شادانت."
      },
      {
        "id": 2699110,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ناوک چشم شوخ شنگ ترا",
        "languageId": null,
        "coupletSummary": null
      },
      {
