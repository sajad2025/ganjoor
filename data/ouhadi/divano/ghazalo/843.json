      },
      {
        "id": 2703970,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پرورش مشکل توان کرد از چنین پروردنی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2703969,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دوش فرمودی که خواهم کشتن آن شوریده را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دیروز به من گفتی که می‌خواهم آن دیوانه را پس از یک سال بکشمت. حیف که یادآوری این موضوع خوب و خوشایند نیست!"
      },
      {
        "id": 2703968,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از پس سالی عف‌الله! نیک یاد آوردنی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2703967,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سر ز شمشیرت نمی‌پیچم، که اندر دین من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من از تیغه‌ی شمشیر تو نمی‌گریزم، چون در دین من برکت و قدرتی وجود دارد که همانند شمشیری در گردن دشمنان است."
      },
      {
        "id": 2703966,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دولت تیزست شمشیری چنان در گردنی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2703965,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر هزارم بار خون دل بریزی حاکمی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر هزار بار هم از غصه دل خون بگریی، هیچ حاکمی به تو آسیبی نمی‌زند. پس چرا باید به خاطر آزار دیگران خود را آزار دهی؟"
      },
      {
        "id": 2703964,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از تو من آزار چون گیرم بهر آزردنی؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2703963,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز آستانت بر نخواهم داشتن سر بعد ازین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من دیگر سرم را از درگاه تو برنمی‌دارم؛ حتی اگر ناچار شوم در مسیر تو جان بدهم."
      },
      {
        "id": 2703962,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هم سر کوی تو گر ناچار باشد مردنی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2703810,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل چنان خو کرد با رویت که تن با خاک پاک",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل به چهره‌ی تو آن‌قدر عادت کرده که حالا ترس دارم بدنم با خاک پاک هم از چنین عادت کردن آسیب ببیند."
      },
      {
        "id": 2703809,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "راستی بیم هلاکست از چنان خو کردنی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2703808,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اوحدی، گر آرزو داری که کام دل بری",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر می‌خواهی به آرزوهایت برسی و دلخوشی را تجربه کنی، ناچار باید بار ناملایمات و انتقادها را به دوش بکشی."
      },
