        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "داروی دردی که هست از در غیری مخواه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دردی که داری را از کسی جز خودت نخواه، زیرا تو خودت درمان و راه چاره‌ی این درد هستی."
      },
      {
        "id": 2704227,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
