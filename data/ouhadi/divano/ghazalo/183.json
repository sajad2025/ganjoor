        "sectionIndex4": null,
        "text": "از دل من شاخ پر گزند بر آرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2700102,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اوحدی از بند هر دو کون برآید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر دل او freed شود، اوحدی از قید و بند این دنیا و آخرت رهایی می‌یابد."
      },
