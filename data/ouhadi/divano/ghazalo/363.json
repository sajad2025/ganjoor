        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر خوبان گیتی را کنی جمع",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر تمام نیکان دنیا را دور هم جمع کنی، با نام من، فقط ظلم و ستمی برمی‌خیزد."
      },
      {
        "id": 2697033,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
