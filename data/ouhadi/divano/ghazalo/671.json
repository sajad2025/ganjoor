      {
        "id": 2702903,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنها که به مویی بفروشند بهشتی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کسانی که برای به دست آوردن چیزی کم ارزش، چیزهای باارزش را از دست می‌دهند، در واقع تنها بخشی از وجود خود را فدای چیزهایی می‌کنند که ارزش چندانی ندارند."
      },
      {
