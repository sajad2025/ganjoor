        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مویی به جهانی بخرند از بدن تو",
        "languageId": null,
        "coupletSummary": null
      },
      {
