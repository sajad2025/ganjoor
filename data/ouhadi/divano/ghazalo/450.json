        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه بر آیینهٔ کس از ما زنگ",
        "languageId": null,
        "coupletSummary": null
      },
      {
