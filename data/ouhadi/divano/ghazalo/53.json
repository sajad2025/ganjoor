    "verses": [
      {
        "id": 2699402,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یا بپوش آن روی زیبا در نقاب",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: یا چهره‌ی زیبا و دلربایت را بپوشان، یا مثل آفتاب از جلوی چشم ما دور نشو."
      },
      {
        "id": 2699401,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یا دگر بیرون مرو چون آفتاب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2699400,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بند کن زلف جهان آشوب را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر نمی‌خواهی که جهان به هم بریزد و نابود شود، زلف آشفته و پر از همهمه‌ی دنیا را آرایش کن و مرتب کن."
      },
      {
        "id": 2699399,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر نمی‌خواهی جهانی را خراب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2699411,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رنج من زان چشم خواب‌آلود تست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: رنج من به خاطر چشمانت که خواب‌آلود هستند است. چگونه می‌توانم از این درد رهایی یابم وقتی که تو در خواب به سر می‌بری؟"
      },
      {
        "id": 2699426,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون کنم، کندر نمی‌آید ز خواب؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2699427,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زلف را وقتی اگر تابی دهی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر موهای خود را بی‌تاب کنی، این را خودت می‌دانی، اما لطفاً چهره‌ات را از من دور نکن."
      },
      {
        "id": 2699428,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن تو دانی، روی را از من متاب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2699455,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من که خود میمیرم از هجران تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من که از دوری تو ناراحت و ناآرامم، دیگر چرا به دنبال نابودی من می‌گردی؟"
      },
      {
        "id": 2699454,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر هلاک من چه می‌جویی شتاب؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2699453,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا نرفتی در نیامد تیره شب",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تا زمانی که تو نروی، شب تاریک باقی می‌ماند و وقتی تو نیایی، نور آفتاب هم نخواهد تابید."
      },
      {
        "id": 2699452,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا نیایی بر نیاید آفتاب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2699451,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حال هجران تو من دانم، که من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من از حال غم و دوری تو خبر دارم، چرا که در سینه‌ام احساس سوزشی مانند آتش کباب را دارم."
      },
      {
        "id": 2699450,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سینه‌ای دارم پر از آتش کباب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2699449,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عاشقم، روزی بر آویزم بتو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عاشق تو هستم و روزی به تو نزدیک می‌شوم. به قدری به تو نیاز دارم که خود را به آب می‌زنم."
      },
      {
        "id": 2699448,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تشنه‌ام، خود را در اندازم به آب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2699447,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اوحدی کامروز هجران تو دید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اوحدی می‌گوید: امروز از دوری تو رنج می‌برم، اما نمی‌دانم خداوند در آینده چه سرنوشتی برای من در نظر گرفته و آیا عذابی خواهد بود یا نه."
      },
      {
        "id": 2699446,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ایزدش فردا نفرماید عذاب",
        "languageId": null,
        "coupletSummary": null
      }
    ],
