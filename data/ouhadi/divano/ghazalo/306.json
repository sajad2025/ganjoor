        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر آنگهی که سر زلف را به شانه کند",
        "languageId": null,
        "coupletSummary": null
