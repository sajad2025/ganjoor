      },
      {
        "id": 2695960,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به خورخانه نسیم هوای میکده بس",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2695957,
        "vOrder": 3,
