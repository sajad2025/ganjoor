        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هیچ ندارم، که نترسیده‌ام",
        "languageId": null,
        "coupletSummary": null
      },
      {
