        "text": "گر بدانستی که: پروین درسها خواهد نهاد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2700011,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
