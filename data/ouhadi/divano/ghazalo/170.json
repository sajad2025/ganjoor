        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چرخ را شرم آمدی کوکب نمایی با رخت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چرخ (آسمان) شرم کرد که ستاره‌ای را با لباس خود زیباتر نشان دهد اگر می‌دانست که پروین (ستاره‌ای خاص در آسمان) درس‌هایی را خواهد آموخت."
      },
