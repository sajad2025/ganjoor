        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گل رعنا به خانه باز رسید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گل زیبا به خانه برگشت و بلبل سرحال و با آرامش به آنجا آمد."
