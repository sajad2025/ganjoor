        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که یکی گر بشد هزار آمد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2695414,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از چمن نکهت صبا بدمید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نسیم صبحگاهی از چمن وزیدن گرفت و بوی خوش زلف محبوب در فضا پخش شد."
      },
