        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زلف تو قلم در شب دیجور کشیده",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2703249,
        "vOrder": 3,
