        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که من به خاک سر کوی او نشست کنم",
        "languageId": null,
        "coupletSummary": null
      }
