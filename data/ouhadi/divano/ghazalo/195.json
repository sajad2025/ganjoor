        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر چه هست از دل به در خواهیم کرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
