        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این قاعدهٔ نیازمندی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این قانون نیازمندی در زمان تو باعث شد که من بی‌نیاز شوم."
      },
