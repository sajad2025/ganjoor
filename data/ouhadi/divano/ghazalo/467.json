        "text": "چون بپوشیم راز؟ کاوردیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چگونه می‌توانیم راز را پنهان کنیم؟ در حالی که طبل را در کوچه نواخته‌ایم و پرچم را بر بام برافراشته‌ایم."
      },
      {
        "id": 2706506,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "طبل در کوچه و علم بر بام",
        "languageId": null,
        "coupletSummary": null
      },
