        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جهان پر نوحه و پر ماتم از من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2708233,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چنان رسوا شدم در عالم این بار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این بار به حدی رسوا شدم که گویی تمام جهان پر از تأثیرات من شده است."
      },
      {
        "id": 2708232,
