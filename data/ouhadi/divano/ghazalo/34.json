        "id": 2699475,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حدیث ما تو بگوی، اوحدی که مشغولست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بگو از داستان ما، اوحدی که به یاد دوستش مشغول است و دلش با وجود ما سرشار از حضور است."
      },
