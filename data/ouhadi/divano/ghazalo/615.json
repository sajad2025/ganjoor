      {
        "id": 2707726,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به گاه شیوه‌گری لعل بر شکر بستن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2707725,
        "vOrder": 3,
