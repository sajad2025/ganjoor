    "verses": [
      {
        "id": 2697778,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ماهی، که لبش بجای جانست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ماهی که لبش به جای جانش اهمیت دارد، اگر ناز کند، به جای آن اهمیت بیشتری دارد."
      },
      {
        "id": 2697777,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر ناز کند،به جای آن است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2697776,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از چشم دلم نمی‌شود دور",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هیچ‌گاه نمی‌توانم از یاد او بروم، هرچند که از دیدگانم دور است و نادیده‌ام."
      },
      {
        "id": 2697775,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر چند ز چشم سرنهانست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2697774,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر در طلبت هزار باشند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر برای به دست آوردن تو هزاران نفر تلاش کنند، من احساس غیرت نمی‌کنم، زیرا تو بی‌نشان هستی."
      },
      {
        "id": 2697773,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "غیرت نبرم، که بی‌نشانست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2697772,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن کو به یقین نبیند او را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر کسی به صداقت شخصی یقین نداشته باشد، اما با دقت به او نگاه کند و رفتار او را زیر نظر بگیرد، ممکن است در دلش به او شک کند."
      },
      {
        "id": 2697771,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون نیک نگه کند گمانست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2697770,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای دیده من اول زمانت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای چشمان من، در ابتدای زمان خود را بشناس و درک کن که اکنون به انتهای زمان رسیده‌ایم."
      },
      {
        "id": 2697769,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دریاب، که آخر زمانست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2697768,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر یاد تو جامه پاره کردم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در یاد تو لباس خود را پاره کرده‌ام، اکنون برگرد که در میان این پاره‌جامه، یاد تو نهفته است."
      },
      {
        "id": 2697780,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "باز آی، که خرقه در میانست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2697796,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تخمی که تو کاشتی نمو داد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تخمیتی که تو کاشتی، حالا رشد کرده است و آن پیمانی که بسته‌ای، هنوز پابرجاست."
      },
      {
        "id": 2697810,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عهدی که گذاشتی همانست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2697797,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این تن، که بر تو مرده، دل شد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این بدن که به خاطر تو از کار افتاده است، حالا تبدیل به دل شده و آن دلی که به خاطر غم تو می‌سوزد، در واقع زندگی است."
      },
      {
        "id": 2697823,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "و آن دل، که غم تو خورد، جانست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2697822,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نتوان ز تو روی در کشیدن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما نمی‌توانیم از تو روی بگردانیم و از تو دور شویم، تا جایی که بتوانیم."
      },
      {
        "id": 2697821,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بارت بکشیم، تا توانست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2697820,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چشم سر ما غلط نبیند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چشم ما نمی‌تواند ببیند که خطای دید دارد، چرا که رنگ سرمه‌ای که از خاک اصفهان به دست آمده، بسیار زیبا و خاص است."
      },
      {
        "id": 2697819,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کش سرمه ز خاک اصفهانست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2697818,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سرنامهٔ عشق خود ز ما پرس",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از ما دربارهٔ مقدمهٔ عشق بپرس، زیرا این عشق کاری نیست که دیگران انجام دهند."
      },
      {
        "id": 2697817,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کین عشق نه کار دیگرانست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2697816,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زود از در گوش باز گردد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به زودی هر داستانی که بر سر زبان‌هاست، از دل و گوش بازگشت خواهد کرد."
      },
      {
        "id": 2697815,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر قصه، که بر سر زبانست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2697814,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنرا که خطیب سود خواند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر کسی را که به عنوان سخنران یا خطیب معرفی می‌شود، در دین اوحدی مورد تحسین قرار دهیم، در واقع به اوزیان و خسارتی گرفتار می‌شویم."
      },
      {
        "id": 2697813,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در مذهب اوحدی زیانست",
        "languageId": null,
        "coupletSummary": null
      }
    ],
