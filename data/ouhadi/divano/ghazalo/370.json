        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کمتر ز سگیم در شمار او",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این جمله به این معناست که ما در مقایسه با او از ارزش کمتری برخورداریم، چرا که او اصلاً در دسته ما قرار نمی‌گیرد."
      },
      {
        "id": 2697633,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
