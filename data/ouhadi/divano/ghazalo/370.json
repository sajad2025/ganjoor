        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر کس به تفرجی و صحرایی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر کسی در دنیای خود سرگرم لذت و تفریح است، اما به بوی خوش بهار ما توجه نمی‌کند."
      },
      {
        "id": 2697637,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
