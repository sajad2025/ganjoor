        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در شهر عاشقان خود پایان نبود شب را",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2699202,
        "vOrder": 17,
