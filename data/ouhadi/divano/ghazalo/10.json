        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتم: مگر به پایان آید شب فراقش",
        "languageId": null,
