        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ما عرضه بر که داریم این عشق بوالعجب را؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2699204,
        "vOrder": 15,
