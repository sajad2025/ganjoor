        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کامشب طبیب ما بر بیمار دیگرست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2698637,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در خانه اوست چون نبود، ماه، گو: متاب",
