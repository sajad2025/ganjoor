        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کی قراری داشتی در مسکنی؟",
        "languageId": null,
        "coupletSummary": null
      }
