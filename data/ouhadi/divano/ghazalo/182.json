        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2700093,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرا بس باشد این دولت که آن مهروی هر صبحی",
