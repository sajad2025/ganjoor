        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دعای عاشقان تست در شبهای تنهایی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دعای کسانی که عاشق هستند در شب‌های تنهایی، باعث پایندگی و ادامه‌ی خوشبختی تو است."
      },
      {
        "id": 2700065,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که روز دولت حسن ترا پاینده می‌دارد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2700064,
        "vOrder": 7,
