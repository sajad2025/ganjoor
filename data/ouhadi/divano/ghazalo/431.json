        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو دانه نیست درین عرصه دام باز مکش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2696696,
        "vOrder": 13,
