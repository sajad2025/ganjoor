        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کنون که قبله گرفتی سر از نماز مکش",
        "languageId": null,
        "coupletSummary": null
