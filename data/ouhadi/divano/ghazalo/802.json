        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یوسف خود را بتوانی ربود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر بتوانی یوسف خود را به دست بیاوری، وقتی به چنین گرگ‌صفتانی برسی."
      },
