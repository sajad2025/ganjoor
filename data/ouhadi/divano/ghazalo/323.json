        "text": "گمان مبر تو که گوشم به پند خواهد بود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2694761,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به اوحدی سخنی چند نقد تلخ بگوی",
