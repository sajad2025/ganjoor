        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای حورزاده، عشق بیاموز ادیب را",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2699196,
        "vOrder": 5,
