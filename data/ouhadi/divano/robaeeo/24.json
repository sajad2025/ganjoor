        "sectionIndex4": null,
        "text": "نابوده زبود این و آن هیچ به دست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2722689,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از من طلب هیچ نمیباید کرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هیچ انتظاری از من نباید داشته باشید، چون من در این دنیا چیزی برای ارائه ندارم."
      },
