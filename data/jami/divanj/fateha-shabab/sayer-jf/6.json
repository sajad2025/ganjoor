        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تدبیر غنا ز کیمیا می پنداشت",
        "languageId": null,
