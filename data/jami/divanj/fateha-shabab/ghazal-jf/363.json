    "verses": [
      {
        "id": 2969892,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر من از خوی تو هر چند که بی داد رود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هرچند که از ستم و ناعدالتی تو بر من بگذرد، ولی وقتی که چهره زیبای تو را می‌بینم، همه‌ی این مشکلات و بدی‌ها از یادم می‌رود."
      },
      {
        "id": 2969905,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون رخ خوب تو بینم همه از یاد رود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2969893,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گره طره مشکین مگشا پیش صبا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: موهای مشکی و گره‌خورده‌ات را در مقابل نسیم باز نکن، زیرا عمر صد دل عاشق، ارزشش را ندارد که به باد برود."
      },
      {
        "id": 2969917,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عمر صد دل شده مپسند که بر باد رود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2969916,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا به کی عاشق دلخسته به امید وصال",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تا چه زمانی یک عاشق دلbroken باید با امیدی ناامید کننده به سمت در تو بیاید و در نهایت غمگین برگردد؟"
      },
      {
        "id": 2969915,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شادمان سوی درت آید و ناشاد رود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2969914,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نقش شیرین رود از سنگ ولی ممکن نیست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: رودی که از سنگ می‌گذرد، می‌تواند نقش زیبایی ایجاد کند، اما هرگز نمی‌شود که محبت و یاد رخش از ذهن فرهاد محو شود."
      },
      {
        "id": 2969913,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که خیال رخش از خاطر فرهاد رود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2969912,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خاک بادا سر من در ره آن سرو روان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: خاک بر سر من که در راه آن درخت زیبا، دلی را یاری کنم که به مشقت من پی برده و خود به راحتی برود."
      },
      {
        "id": 2969911,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که گرفتاری من بیند و آزاد رود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2969910,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جز به ویرانه غم جا نکند مرغ دلم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مرغ دل من تنها در ویرانه‌ها آرام می‌گیره و به همین خاطر است که به خانه‌های شاد و آباد راهی ندارد."
      },
      {
        "id": 2969909,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جغد ازان نیست که در منزل آباد رود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2969908,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل به آن غمزه خونریز کشد جامی را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل به آن نگاه عاشقانه و کشنده می‌سپارد و در پی آن، مشغول نوشیدن می‌شود؛ اما چون مرگ به سراغش بیاید، همچون طعمه‌ای به سمت شکارچی خواهد رفت."
      },
      {
