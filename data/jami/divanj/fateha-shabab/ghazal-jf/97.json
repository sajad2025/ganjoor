        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "قبلتی وجهک فی کل صلات",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2973419,
        "vOrder": 3,
