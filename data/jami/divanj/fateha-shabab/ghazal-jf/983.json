    "verses": [
      {
        "id": 2978838,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتی بگوی عاشق و بیمار کیستی!",
        "languageId": null,
        "coupletSummary": "از من پرسیدی که عاشق و بیمار چه کسی هستم؟ من عاشق توام، تو بگو یار چه کسی هستی؟"
      },
      {
        "id": 2978837,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من عاشق توام تو بگو یار کیستی؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2978836,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بستی میان به فتنه کشیدی ز غمزه تیغ",
        "languageId": null,
        "coupletSummary": "کمر به فتنه‌گری بسته‌ای و با غمزه‌ات شمشیر می‌زنی؛ ای همه‌ی جان‌ها به قربان تو، قصد آزار چه کسی را داری؟"
      },
      {
        "id": 2978835,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جانم فدات در پی آزار کیستی؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2978834,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دارم دلی ز هجر تو هر دم فگارتر",
        "languageId": null,
        "coupletSummary": "دلی دارم که از دوری تو هر لحظه زخمی‌تر از قبل است. به من بگو که بر روی زخم دل چه کسی مرهم می‌گذاری؟"
      },
      {
        "id": 2978833,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا خود تو مرهم دل افگار کیستی!",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2978832,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر شب من و خیال تو و کنج محنتی",
        "languageId": null,
        "coupletSummary": "هر شب من با خیال تو و کنجی پر از درد تنها هستم. تو یار و همراه که هستی و به درد دل چه کسی گوش می‌کنی؟ "
      },
      {
        "id": 2978843,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو با که‌ای و مونس و غمخوار کیستی؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2978831,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا چند گرد کوی تو گردم گهی بپرس",
        "languageId": null,
        "coupletSummary": "چقدر اطراف منزل تو پرسه بزنم؟ حداقل یک بار از من بپرس که چه می‌کنم و از چه کسی طلب و خواسته‌ای دارم."
      },
      {
        "id": 2978829,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کاین جا چه می کنی و طلبکار کیستی!",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2978828,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جامی مدار چشم خلاصی ز قید عشق",
        "languageId": null,
        "coupletSummary": "ای جامی، انتظار رهایی از بند عشق را نداشته باش. تنها کاری که باید بکنی، این است که فکر کنی و قدر این بند و زندان را بدانی."
      },
      {
        "id": 2978827,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اندیشه کن ببین که گرفتار کیستی!",
        "languageId": null,
        "coupletSummary": null
      }
