        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سعاد بالسعادة والسلامه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2976997,
        "vOrder": 5,
        "coupletIndex": 2,
