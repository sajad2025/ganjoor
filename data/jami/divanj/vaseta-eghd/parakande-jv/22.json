    },
    "next": null,
    "previous": {
      "id": 80879,
      "title": "شمارهٔ ۲۱",
      "urlSlug": "sh21",
      "excerpt": "از آتش سودای تو دم زد دل من",
      "mainSections": null
    },
    "verses": [
      {
        "id": 3002369,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سقاک الله ای دیار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: درود بر تو ای سرزمین که از دور به یادگار مانده‌ای."
      },
      {
        "id": 3002368,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که از دور روزگار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002367,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تهی مانده ای ز یار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو از دوست من خالی هستی و جانم بی‌قرار است."
      },
      {
        "id": 3002366,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من و جان بی قرار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002380,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به گرد تو اشکبار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در اطراف تو، اشک‌ها جریان دارند؛ نه فقط به صورت پنهانی، بلکه به وضوح و نمایان."
      },
      {
        "id": 3002365,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه پنهان چه آشکار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002363,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو ابری که در بهار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مثل ابری که در بهار بر روی چمن‌ها باران می‌بارد و آنها را خیس می‌کند."
      },
      {
        "id": 3002362,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کند گریه بر چمن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002361,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به هر منزل و مقام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در هر جا که آن درخت خوشبو و زیبا حضور دارد، حالتی خاص و دلنشین به آن مکان می‌بخشد."
      },
      {
        "id": 3002360,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که آن سرو خوشخرام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002359,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به یاران نشسته رام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: با دوستان دور هم نشسته‌ایم و از زندگی لذت می‌بریم و جام می‌نوشیم."
      },
      {
        "id": 3002358,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به عشرت گرفته جام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002357,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وزان جام شادکام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از آن جام شادمانی گام‌هایی را به جلو برداشته‌ام."
      },
      {
        "id": 3002356,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به جایی نهاده گام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002355,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برآنجای صبح و شام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر صبح و شام، به جایی می‌روم که خودم را بشناسم و بر خودم تکیه کنم."
      },
      {
        "id": 3002354,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نهم روی خویشتن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002353,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درین دلگشا محل",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در این مکان زیبا و دلپذیر، همچون بهشتی بی‌نظیر وجود دارد."
      },
      {
        "id": 3002352,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو فردوس بی بدل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002351,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز دوران پر حیل",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در این دنیا پر از فریب و نیرنگ چه چیزی جز نقص و کاستی می‌بینم؟"
      },
      {
        "id": 3002350,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه بینم بجز خلل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002364,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کنم تا برد اجل",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من تلاش می‌کنم که تا زمان مرگم، امید و آرزوهایم را مدیریت کنم."
      },
      {
        "id": 3002381,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سر رشته امل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002382,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گهی ناله بر طلل",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گاهی بر بلندی‌ها ناله می‌زنم و گاهی بر دمنوش‌ها گریه می‌کنم."
      },
      {
        "id": 3002383,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گهی گریه بر دمن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002401,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به هر جا زمین نشین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر جا که آن معشوقه‌ی دلنشین حضور داشته باشد، زمین و زمان تحت تأثیر وجود او قرار می‌گیرد."
      },
      {
        "id": 3002402,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شد آن یار نازنین",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002403,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به چشم من غمین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چشمانم غمگین هستند مانند تیغی که برای انتقام تیز شده است."
      },
      {
        "id": 3002404,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که دارد به تیغ کین",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002405,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به جانم غمش کمین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: درد دل من به خاطر مشکلات و رنج‌های آن سرزمین است که در دل من جاودانه مانده است."
      },
      {
        "id": 3002406,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خس و خار آن زمین",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002408,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به از سرو و یاسمین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بهتر از درختان سرو و گل یاسمن، چیزهای دیگری وجود دارند که ارزش بیشتری دارند."
      },
      {
        "id": 3002415,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به از سنبل و سمن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002409,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلی دارم ای نسیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دلم به خاطر جدایی او دو نیم شده است، ای نسیم."
      },
      {
        "id": 3002410,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز هجران او دو نیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002411,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو هر بزم را ندیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر مهمانی که برگزار شود، تو هستی که ترس و نگرانی را از میان می‌بری."
      },
      {
        "id": 3002412,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تویی ناکشیده بیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002413,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گذر کن بر آن حریم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به آن مکان که آن ماه در آنجا سکونت دارد، عبور کن."
      },
      {
        "id": 3002414,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که آن مه بود مقیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002400,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درآن روضه نعیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در آن باغ خوشبختی، قصه زندگی‌ام را بازگو کن."
      },
      {
        "id": 3002399,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بگو شرح حال من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002398,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو آن یار دل گسل",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که آن معشوق دل‌فریب به من ضربه‌ای می‌زند، گویی سرنوشت من را رقم می‌زند."
      },
      {
        "id": 3002397,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به قتلم دهد سجل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002396,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وزآن قتل تنگدل",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از آن قتل، دل‌های حساس و زجرکشیده به راهی متعادل و آرام هدایت می‌شوند."
      },
      {
        "id": 3002395,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به رفتار معتدل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002394,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به خاکم رسد خجل",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در اینجا شاعر می‌گوید که اگر پای او به خاک بیفتد، او به زودی از آن خجالت می‌کشد و این احساس را به جانش منتقل می‌کند. به عبارتی، او در بیان احساس شرم و خجالت خود نسبت به وضعیتش می‌پردازد و نشان می‌دهد که این احساس عمیقاً بر او تأثیر گذاشته است."
      },
      {
        "id": 3002393,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به جانش کنم بحل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002392,
        "vOrder": 47,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز شوقش چو گل ز گل",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به خاطر عشق او، مانند گلی که لباسش را پاره می‌کند، من نیز لباس خود را پاره می‌کنم."
      },
      {
        "id": 3002391,
        "vOrder": 48,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زنم چاک پیرهن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002390,
        "vOrder": 49,
        "coupletIndex": 24,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 26,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درین خطه خطر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در این منطقه باید احتیاط زیادی داشته باشید و از خطرات دوری کنید."
      },
      {
        "id": 3002389,
        "vOrder": 50,
        "coupletIndex": 24,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 26,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حذر جامیا حذر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3002388,
        "vOrder": 51,
        "coupletIndex": 25,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 27,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که با طبع نکته ور",
        "languageId": null,
