        "id": 2921615,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وز برون با کسان درشت آیین",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2921614,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زیر آن خاربن قرار گرفت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زیر آن درخت خاردار، نشسته بود و تصمیم به ترک کردن کوی محبوبش گرفت."
      },
      {
        "id": 2921613,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ترک رفتن به کوی یار گرفت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2921612,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چند روزی بر این نسق چو گذشت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چند روزی که از این وضعیت گذشت، بارها در دل لیلی افکار و احساسات مختلفی شکل گرفت."
      },
      {
        "id": 2921611,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بارها در ضمیر لیلی گشت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2921610,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که چه حال اوفتاد مجنون را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مجنون در چه وضعیتی افتاد؟ او که کاملاً دیوانه و عاشق شده است."
      },
      {
        "id": 2921609,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیخود آن مبتلای مفتون را",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2921608,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که نشانش به دشت پیدا نیست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: علامت او در دشت قابل مشاهده نیست، حتی نشانی از آهوان صحرا هم وجود ندارد."
      },
      {
        "id": 2921607,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هم تگ آهوان صحرا نیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2921606,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مانده است از گروه گوران دور",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: باقی‌مانده‌ای از جمعیت گوران‌ها که نتوانسته‌اند از میان گوزن‌ها جدا شوند و در دل آنها شور و هیاهوست."
      },
      {
        "id": 2921605,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نفکند در صف گوزنان شور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2921604,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "روزها نشنوم ز کس رازش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر در طول روز از کسی چیزی نشنوم، شب صدای او به گوشم نمی‌رسد."
      },
      {
        "id": 2921603,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شب نیاید به گوشم آوازش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2921624,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آخرالامر هیچ چاره ندید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در نهایت، وقتی که او هیچ راه حلی نیافت، درباره وضعیت خود از افراد نزدیک و مورد اعتمادش سوال کرد."
      },
      {
        "id": 2921626,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شرح حالش ز محرمان پرسید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2921649,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "قصه درد او بیان کردند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: درد او را تعریف کردند و وضعیتش را به وضوح نشان دادند."
      },
      {
        "id": 2921627,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صورت حال او عیان کردند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2921648,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیمروزی به کام دمسازان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در میانه‌ی روز، افرادی که همدل و همراهند، لحظه‌ای را در خواب خوشی و آرامش می‌گذرانند، در حالی که چشم‌های غمگین و نگران دیگران به دور آن‌هاست."
      },
      {
        "id": 2921647,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یافت در خواب چشم غمازان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2921646,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چشم ها را کشید سرمه ناز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چشم‌ها را با سرمه زیبا کردند و عقل و دین را از پرده راز بیرون آوردند."
      },
      {
        "id": 2921645,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عقل و دین را درید پرده راز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2921644,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کرد نعلین دلبری در پای",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دلبری با نعلین (کفش) به پا شده و با قدم‌های وفادار خود، زمین را خسته می‌کند."
      },
      {
        "id": 2921643,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شد به گام وفا زمین فرسای",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2921642,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شد خرامنده تا بر مجنون",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: غمگینی به آرامی قدم زد تا بر سر مجنون سایه‌ای بیفکند."
      },
      {
        "id": 2921641,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سایه افکند بر سر مجنون",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2921640,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بانگ زد کای ز عشق برخوردار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: فریاد زد که ای کسی که از عشق بهره‌مند هستی، سایه‌ات را بر سر عشق بگستران و به وصال برس."
      },
      {
        "id": 2921639,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سایه انداخت وصل سر بردار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2921638,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت مجنون کیی تو باز نمای",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مجنون، تو کیستی؟ لب خاموشت را باز کن و به وضوح راز دل را بیان کن."
      },
      {
        "id": 2921637,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لب خامش به شرح راز گشای",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2921636,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت من آن که زخم او خوردی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او می‌گوید تو همان کسی هستی که به خاطر خواهش او زخم‌هایش را متحمل شدی و سر خود را به نشانه احترام پایین آوردی."
      },
      {
        "id": 2921635,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به تمناش سر فرو بردی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2921634,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "منم آرام جان تو لیلی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من آرامش زندگی‌ات هستم و لیلی، معشوقه‌ای که همیشه به سمتش می‌نگری."
      },
      {
        "id": 2921633,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "قبله جاودان تو لیلی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2921632,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت رو رو که آنچنانم من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بگو که من به قدری عاشق توام که هیچ چیز دیگری جز عشق تو را نمی‌شناسم."
      },
      {
        "id": 2921631,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که بجز عشق تو ندانم من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2921630,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عشق تو ای نگار فرزانه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عشق تو، ای دختر نیکوکار، در دل من به قدری جا گرفته که مانند یک خانه است."
      },
      {
        "id": 2921629,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در دلم کرد آنچنان خانه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2921628,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که تو را هم نماند گنجایی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بعد از این، تو را خوشتر از من نخواهی یافت و تنها باقی می‌مانی."
      },
      {
        "id": 2921602,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خوشترم بعد ازین به تنهایی",
        "languageId": null,
        "coupletSummary": null
      }
    ],
