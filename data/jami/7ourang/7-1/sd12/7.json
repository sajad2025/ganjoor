      },
      {
        "id": 2920809,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خواستی لایزال بی کم و کاست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2920810,
        "vOrder": 3,
