        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل افروزی چو آن خورشید خوبان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل‌افروزی همچون آن خورشید زیبا از سمت بارگاه برنمی‌خیزد."
      },
      {
        "id": 4824437,
        "vOrder": 8,
