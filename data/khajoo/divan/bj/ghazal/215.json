    "verses": [
      {
        "id": 4825974,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خیز تا باده در پیاله کنیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بیا بلند شو و بگذار تا در پیاله شراب بریزیم و چهره زیبا را مانند گل لاله زیبا جلوه‌دار کنیم."
      },
      {
        "id": 4825975,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گل روی قدح چو لاله کنیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4825976,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی می جانفزای و نغمه چنگ",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از باده‌ای که جان را سرشار می‌کند و آوای چنگ به وجود می‌آورد، تا کی باید خون گریه کنیم و ناله سر دهیم؟"
      },
      {
        "id": 4825977,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا بکی خون خوریم و ناله کنیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4825978,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر دم از دیده ی قدح پیمای",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر لحظه از چشمان ما، باده‌ی سرخ رنگ را در لیوان می‌ریزیم و می‌نوشیم."
      },
      {
        "id": 4825979,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "باده ی لعل در پیاله کنیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4825980,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شاد خوران چو مجلس آرایند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی شادمانان دور هم جمع می‌شوند، غم و اندوه را به دور می‌رانیم و آن را به مسئولیت زمان می‌سپاریم."
      },
      {
        "id": 4825981,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دفع غم را بمی حواله کنیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4825982,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با گل و لاله همچو بلبل مست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: با گل و لاله مثل بلبل شاد و سرمست، توصیف زیبایی آن کلاهۀ خوشبو را می‌کنیم."
      },
      {
        "id": 4825983,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وصف آن عنبرین کلاله کنیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4825984,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وز شگرفان چارده ساله",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما ادعای زندگی شصت ساله را از کسانی که فقط fourteen سال دارند، می‌کنیم."
      },
      {
        "id": 4825985,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دعوی عمر شصت ساله کنیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4825986,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون بخوان وصال دست بریم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که به وصال برسیم، با یک لحظه ارتباط، هر دو جهان را تحت تأثیر قرار خواهیم داد."
      },
      {
        "id": 4825987,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دو جهان را بیک نواله کنیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4825988,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وز بخار شراب آتش فام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از بخار شراب، ورق چهره را با رنگ آتشینی پر از شبنم کنیم."
      },
      {
        "id": 4825989,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ورق چهره پر ز ژاله کنیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4825990,
        "vOrder": 17,
