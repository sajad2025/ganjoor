    "verses": [
      {
        "id": 4807091,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرا یاقوت او قوت روانست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: یاقوت او به من انرژی و قوت می‌دهد، اما اشک‌های من همچون یاقوتی جاری است."
      },
      {
        "id": 4807092,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ولی اشکم چو یاقوت روانست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807093,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رخش ماهست یا خورشید شب پوش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: صورت ماه است یا خورشید در دل شب، خطش مثل طوطی است یا به زیبایی هندوستان."
      },
      {
        "id": 4807094,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خطش طوطیست یا هندوستانست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807095,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صبا از طرّه اش عنبر نسیمست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بزرگ‌ترین عطر و بوی خوش، از موها و عطر سنبل او به مشام می‌رسد؛ نسیم صبحگاهی نیز از این عطرها بهره‌مند است و بوی دل‌انگیزی به همراه دارد."
      },
      {
        "id": 4807096,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نسیم از سنبلش عنبر فشانست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807097,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "میانش یکسر مو در میان نیست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در وسط این فرد هیچ مویی وجود ندارد، اما یک سر موی او به اندازه‌ای است که مانند دهان عمل می‌کند."
      },
      {
        "id": 4807098,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ولیکن یک سر مویش دهانست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807099,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شنیدم کان صنم با ما چنان نیست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: شنیدم که آن معشوق مانند ما نیست، اما وقتی نگاه کردم، دیدم که واقعاً همین‌طور است."
      },
      {
        "id": 4807100,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ولیکن چون نظر کردم چنانست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807101,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز چشمش چشم پوشش چون توان داشت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی توانستم از نگاهش دور شوم، دریافتم که مثل کوهی ناتوان است و نمی‌تواند مدت زیادی من را از خود دور نگه‌دارد."
      },
      {
        "id": 4807102,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که یکچندست کوهم ناتوانست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807103,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیا آن آب آتش رنگ در ده",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بیا به سراغ آن آبی که رنگش شبیه آتش است، زیرا اگر خود آتش هم باشد، می‌تواند آتش را خاموش کند."
      },
      {
        "id": 4807104,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که گر خود آتشست آتش نشانست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807105,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بدان ماند که خونش می دواند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به یاد داشته باش که خونش مانند آبی که از چشمانم می‌ریزد، جاری است."
      },
      {
        "id": 4807106,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بدینسان کز پیت اشکم روانست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807107,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو مرغی زیرک آمد جان خواجو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مانند پرنده‌ای زیرک، جان خواجو به سوی تو آمده است، زیرا که دام زلف تو برای او خانه و پناهگاهی است."
      },
      {
        "id": 4807108,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که او را دام زلفت آشیانست",
        "languageId": null,
        "coupletSummary": null
      }
