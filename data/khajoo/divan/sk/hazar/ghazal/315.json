      },
      {
        "id": 4811262,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز عنبر طوق و از زر کرده یاره",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4811263,
        "vOrder": 3,
