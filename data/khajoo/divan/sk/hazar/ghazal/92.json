    "verses": [
      {
        "id": 4807145,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با منت کینه و با جمله صفاست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اینکه با وجود کینه و ناراحتی‌های موجود در دل، باز هم رفتارهای زیبا و محبت‌آمیز دیده می‌شود، نشان می‌دهد که ما به سرنوشت شوریده و پرچالشی دچاریم."
      },
      {
        "id": 4807146,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اینهم از طالع شوریده ی ماست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807147,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "راستی را صنما بی قد تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عزیزم، تو تنها کسی هستی که می‌توانی به ما کمک کنی؛ بدون تو هیچ‌چیز در زندگی‌ام درست نمی‌شود."
      },
      {
        "id": 4807148,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کار ما هیچ نمی آید راست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807149,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر گیاهی که بروید پس ازین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر گیاهی که بعد از این از خاک قبر ما رشد کند، نشان از محبت و زیبایی ما خواهد بود."
      },
      {
        "id": 4807150,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از سر تربت ما مهر گیاست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807151,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می کشم درد بامید دوا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من با امید به درمان، درد را تحمل می‌کنم، هرچند که درد تو خود همان درمان است."
      },
      {
        "id": 4807152,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گرچه درد از قبلت عین دواست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807153,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این چه بویست که ناگه بدمید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این چه بویی است که ناگهان به مشام می‌رسد و این چه اتفاقی است که دوباره شروع شده است؟"
      },
      {
        "id": 4807154,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وین چه فتنه ست که دیگر برخاست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807155,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "باز از ناله ی مرغان سحر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: صدای ناله و خواندن پرندگان سحرگاه، فضای چمن را پر از هیاهو و شلوغی کرده است."
      },
      {
        "id": 4807156,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صبحدم صحن چمن پر غوغاست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807157,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گرچه در پرورش نطفه ی خاک",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگرچه در پرورش جوانه‌های خاکی، عطر موهای تو وزندگی نسیم صبحگاهی را به ارمغان می‌آورد."
      },
      {
        "id": 4807158,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بوی زلفت مدد باد صباست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807159,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خیز کز نکهت انفاس نسیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: برخیز و بیدار شو که با نسیم صبحگاهی، عطر دل‌فریب و لطیف گل‌ها در فضا پخش شده و زیبایی آنها را به رخ می‌کشد."
      },
      {
        "id": 4807160,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر سحر پیرهن غنچه قباست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807161,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر نه خواجوست که دور از رخ تست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر خواجو نیست که دور از چهره‌ات باشد، پس چرا این زلف‌های هندوئی تو اینقدر آشفته و بی‌نظم هستند؟"
      },
      {
        "id": 4807162,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
