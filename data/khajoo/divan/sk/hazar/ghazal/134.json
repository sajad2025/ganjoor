    "verses": [
      {
        "id": 4807919,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در آن مجلس که جام عشق نوشتند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در آن جمعی که عشق را تعریف کردند، جا برای نصیحت‌های حکیمان وجود ندارد."
      },
      {
        "id": 4807920,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کجا پند خردمندان نیوشند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807921,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خداوندان دانش نیک دانند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دانشمندان واقعی می‌دانند که افرادی که در حالت گیجی و حیرت هستند، در واقع درک عمیق‌تری از حقایق دارند."
      },
      {
        "id": 4807922,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که مدهوشان خداوند هوشند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807923,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خوشا وقتی که مستان جام نوشین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چه خوب است وقتی که شادمانان با نوشیدنی دلپذیر، به چشمه‌ی شیرین تو بیایند و از آن بنوشند."
      },
      {
        "id": 4807924,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیاد چشمه ی نوش تو نوشند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807925,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مکن قصد من مسکین که خوبان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به دیگران نرنج، زیرا انسان‌های نیکو به کسانی که در تنگنا هستند، آزار نمی‌رسانند."
      },
      {
        "id": 4807926,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چنین در خون مسکینان نکوشند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807927,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برون از زلف و رخسارت ندیدم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من هیچ چیز زیبایی که از زلف و چهره‌ات فراتر باشد ندیده‌ام، مانند اینکه بر روی ماه سنبل‌ها را بپوشانند."
      },
      {
        "id": 4807928,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که بر مه سنبل مه پوش پوشند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807929,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هنوزت جاودان در عین سحرند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو هنوز هم در دل زیبایی و جاذبه‌های سحرآور هستی، و هنوز هم به عنوان یک موجود ارزشمند و خوشبو در نظر گرفته می‌شوی."
      },
      {
        "id": 4807930,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هنوزت هندوان عنبر فروشند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807931,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مگو خواجو که مرغان ضمیرم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نگو خواجو که افکار من مانند پرندگان درونم، بهاری و شاداب هستند و همچون بلبلان در حال شعرخوانی و سر و صدا هستند."
      },
      {
        "id": 4807932,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زمستی همچو بلبل در خروشند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4807933,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نگر کازادکان گر ده زبانند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به دقت به فرزندان نگاه کن، اگرچه در ظاهر بی‌صدا هستند، اما مانند گل‌های سوسن با زیبایی و ظرافت‌های خود، همگی داستان‌ها و احساسات درونی‌شان را بیان می‌کنند."
      },
      {
        "id": 4807934,
        "vOrder": 16,
