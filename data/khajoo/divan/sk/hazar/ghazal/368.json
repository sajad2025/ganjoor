      },
      {
        "id": 4812255,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یغرّد فی المغار یدالمُغنّی",
        "languageId": 2,
        "coupletSummary": "هوش مصنوعی: در دل غار، آواهای دلنشین و آوازخوانی به گوش می‌رسد که سلام خدا بر خواننده‌ای است که آیات زیبای قرآن را تلاوت می‌کند."
      },
      {
        "id": 4812256,
