        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رخت از آفتاب عالم‌افروز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: پوشش زیبای تو همچون درخشش آفتاب در آسمان دیده می‌شود."
      },
      {
        "id": 4812242,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
