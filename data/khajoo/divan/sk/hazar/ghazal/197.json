        "coupletSummary": null
      },
      {
        "id": 4809063,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه زند عقل با تطاول عشق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عقل چه کار می‌تواند با جستجوی بی‌پایان عشق انجام دهد، در حالی که جوانب زندگی مثل کرکس‌ها برای شکار آماده‌اند."
      },
      {
        "id": 4809064,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نکند کرکسان چرخ شکار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4809065,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کامت از دار می شود حاصل",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به نظر می‌رسد که زیبایی‌ها و لذت‌های زندگی مانند میوه‌ای از درخت است. از فرصت‌ها بهره‌مند شو و خوشی‌ها را به دست آور."
      },
      {
        "id": 4809066,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کام برگیر و کام دل بردار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4809067,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
