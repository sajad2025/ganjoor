      },
      {
        "id": 4809050,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شهد یا شکّرست یا گفتار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4809051,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آهوان صید مردمند و دلم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آهوان مانند شکار برای مردم هستند و دل من هم شکار آن آهوانی است که به انسان‌ها عشق می‌ورزند."
      },
      {
        "id": 4809052,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صید آن آهوان مردمدار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4809053,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کار ما با ستمگری افتاد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما با شخصی سر و کار داریم که تنها هدفش آزار و ستم بر ماست و هیچ نیتی جز این ندارد."
      },
      {
        "id": 4809054,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که بجز قصد ما ندارد کار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4809055,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گل صد برگ را بباید ساخت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: برای عید نوروز باید گل صد برگ را آماده کرد و با صدای دلنشین هزار لحن، آن را جشن گرفت."
      },
      {
        "id": 4809056,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فصل نوروز با نوای هزار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4809057,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پیش عشّاق لطف باشد قهر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در برابر عاشقان، بی‌محلی حس زیبایی دارد، اما برای کسانی که به معشوق علاقه‌مندند، بی‌اعتنایی نوعی افتخار به حساب می‌آید."
      },
      {
        "id": 4809058,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نزد مشتاق فخر باشد عار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4809059,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل بی مهر کی شود روشن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل بدون عشق و محبت هرگز روشن و شاداب نمی‌شود، همان‌طور که پرنده‌ای که بال ندارد نمی‌تواند پرواز کند."
      },
      {
        "id": 4809060,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرغ بی بال کی بُود طیار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4809061,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه زند عقل با تطاول عشق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عقل در برابر عشق چه کاری می‌تواند انجام دهد؟ مانند صیدی که در دام سوار atrap کرده شده است."
      },
      {
        "id": 4809062,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
