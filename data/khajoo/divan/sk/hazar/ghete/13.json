      },
      {
        "id": 4812612,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سپهر فضل شمس نخجوانی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4812613,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "توئی مسّاح صحرای معالی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو در زندگی مانند یک راهنمای خبره در بیابان‌های وسیع هستی و در دریاهای عمیق از معانی و مفهوم‌ها، مانند یک ناخدا می‌باشی."
      },
      {
        "id": 4812614,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "توئی ملاّح دریای معانی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4812615,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ترا مخدوم خود دانی که دانم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو فکر می‌کنی که من را به عنوان خدمتگزار خود می‌شناسی، در حالی که من هم تو را به عنوان کسی که باید تحت نظر او باشم، می‌شناسم."
      },
      {
        "id": 4812616,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرا محکوم خود دانم که دانی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4812617,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گرانی از حضورت کی توان یافت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در حضور تو، نمی‌توان غم و سنگینی را احساس کرد، زیرا روح سبکت تو را از این بارها آزاد می‌کند."
      },
      {
        "id": 4812618,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که ناید از سبک روحان گرانی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4812619,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز شعرت عار می باید که نبود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از شعر تو باید خجالت کشید، چون نبودن آب باعث شرمندگی است."
      },
      {
        "id": 4812620,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که نبود آب را ننگ از روانی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4812621,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ننالد بلبل از دستان سرائی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بلبل از طرز نوازش نوازنده ناراحت نمی‌شود و طوطی نیز از شیرینی کلام ناراضی نیست."
      },
      {
        "id": 4812622,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نرنجد طوطی از شکّر فشانی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4812623,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خلیل و اخفش آن شهرت ندارند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: خلیل و اخفش به اندازه‌ی نیشابوری و جرباد قانی معروفیت و شهرت ندارند."
      },
      {
        "id": 4812624,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که نیشابوری و جرباد قانی",
        "languageId": null,
        "coupletSummary": null
      },
      {
