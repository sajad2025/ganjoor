        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زین پیش نهان چند توان داشتن آخر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چند بار می‌توان در دل غم جدایی پنهان ماند؟"
      },
      {
        "id": 4812343,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در دل غم هجران",
        "languageId": null,
        "coupletSummary": null
      },
      {
