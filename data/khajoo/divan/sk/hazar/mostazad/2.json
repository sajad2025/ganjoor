        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از بی سر و پائی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4812338,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا چند مخالف زنی ای مطرب خوشگوی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چقدر باید به مخالف‌خوانی ادامه دهی، ای مطرب خوش‌صدا، در دل عاشقان؟"
      },
