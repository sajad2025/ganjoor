        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آخر چه زیان مملکت حسن شما را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در نهایت، ضرر مملکت شما از بی‌نظمی و بی‌سر و سامانی چه خواهد بود؟"
      },
