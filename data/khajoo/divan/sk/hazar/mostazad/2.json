        "id": 4812339,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در پرده ی عشّاق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4812340,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بنواز زمانی من بی برگ و نوا را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: لطفاً لحظه‌ای برای من که بی‌نوا و بدون سرود هستم، نوا بخوان."
      },
      {
        "id": 4812341,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از بانگ نوائی",
        "languageId": null,
        "coupletSummary": null
      },
      {
