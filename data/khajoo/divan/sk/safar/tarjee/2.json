      {
        "id": 4817985,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آمد گَهِ عیش و نوبت جام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4817986,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای لعبت سیمبر بیاور",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای معشوق زیبا، بیا و با جام طلایی، شراب زرق و برق‌دار را به ما بده."
      },
      {
        "id": 4817987,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از ساغر زر شراب زرفام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4817988,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن باده ی پخته ده که حیفست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به ما آن نوشیدنی خوب و گوارا را بده که افسوس می‌خورد و ما هنوز در این حال ناپخته و خام هستیم."
      },
      {
        "id": 4817989,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می پخته و ما بدین صفت خام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4817990,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بنمای ز مطلع صراحی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در زمان سحر، ظرف می را به نمایش بگذار و ستاره‌ای را که در آسمان صبح درخشان است، نشان بده."
      },
      {
        "id": 4817991,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در وقت سحر ستاره ی بام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4817992,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شاهد غرضست ور نه در خلد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر معشوقه‌ای در کار نباشد، بهشت و آرامش چه معنایی دارد؟ وقتی دل شاداب و آرامی وجود ندارد، چه فایده‌ای از زندگی در نعمت‌ها و خوشی‌هاست؟"
      },
      {
        "id": 4817993,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آرام کراست بی دلارام؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4817994,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون خار بود بچشم رامین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چون رامین چهره ی زیبای ویسه را نمی بیند، او برایش مانند خاری در چشم می آید."
      },
      {
        "id": 4817995,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گل بی رخ ویسه ی گل اندام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4817996,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز ایام شکایتی که دارم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از روزگارهایی که شکایت دارم، همه را یکی یکی برای تو می‌گویم."
      },
      {
        "id": 4817997,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
