        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در دام زمانه چند باشی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هرچند در تنگنای زمان قرار داری، اما همیشه می‌توانی از لذت زندگی لذت ببری و به آنها بپردازی."
      },
      {
        "id": 4818001,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رو جام شراب گیر مادام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4818002,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 2,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": 4,
        "sectionIndex4": null,
