      {
        "id": 4815696,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بلبلی باز گفت در نوروز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4815697,
        "vOrder": 3,
