        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از ناله نحیف تر زنالم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من از ناله لطیف‌تر می‌زنم و صدایم ضعیف‌تر از موی باریک است."
      },
      {
        "id": 4816252,
        "vOrder": 10,
