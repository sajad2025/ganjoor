      },
      {
        "id": 4816246,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دست از دل خسته چون نشویم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4816247,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کر گشت فلک زهای هایم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آسمان با صدای گریه‌ام بی‌صدا شد و جهان پر شد از زمزمه‌های من."
      },
      {
        "id": 4816248,
        "vOrder": 6,
