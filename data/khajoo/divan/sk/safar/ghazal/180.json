      {
        "id": 4816259,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بگذار که شکّرت ببوسم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بگذار که من شیرینی تو را بچشم، بیا که من هم عطر تو را استشمام کنم."
      },
      {
        "id": 4816260,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پیش آی که عنبرت ببویم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4816261,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا چند زنی مرا بچوگان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چقدر باید به من آسیب برسانی؟ آخر من هم روزی به شما خواهم گفت که دیگر خسته شدم."
