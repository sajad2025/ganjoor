      {
        "id": 4817447,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "قدح در ده که چشم مست خوبان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: باده را بنوش که چشم‌های مست زیبایی‌ها همچون صبح روشن شده است و ما را به روشنی حقیقت دعوت می‌کند."
      },
      {
        "id": 4817448,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "قد اتّضحت لنا ای اتّضاح",
        "languageId": 2,
        "coupletSummary": null
      },
      {
        "id": 4817449,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "الا والله لا اسلو هواهم",
        "languageId": 2,
        "coupletSummary": "هوش مصنوعی: به خدا قسم، من هرگز از عشق آن‌ها دور نخواهم شد و به حرف‌های سرزنش‌کننده بی‌توجهی نخواهم کرد."
      },
      {
        "id": 4817450,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "و لا اصبوا الی قول اللّواح",
        "languageId": 2,
        "coupletSummary": null
      },
      {
        "id": 4817451,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ملامت می‌کنندم پارسایان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مردم پاک‌دل و پرهیزکار مرا به خاطر عشق به زیبایی‌ها سرزنش می‌کنند."
      },
      {
        "id": 4817452,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "الام الام فی حبّ الملاح",
        "languageId": 2,
        "coupletSummary": null
      },
      {
        "id": 4817453,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کجا قول خردمندان کنم گوش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کجا می‌توانم از عقل و دانایی حرف بزنم وقتی که مستی نمی‌تواند سخن فرد بصیر را بشنود؟"
      },
      {
        "id": 4817454,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که سکران نشنود گفتار صاحی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4817455,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عدولی عن محبتم فسادی",
        "languageId": 2,
        "coupletSummary": "هوش مصنوعی: اگر از عشق من سرپیچی کنی، فساد و نابودی تو در دست‌های دیگران، به نفع من خواهد بود."
      },
      {
        "id": 4817456,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "و موتی فی مضاربهم صلاحی",
        "languageId": 2,
        "coupletSummary": null
      },
      {
        "id": 4817457,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلم جان از گذار دیده در باخت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل من از دیدن یک جهان بی‌نهایت ناامید است، اما در این حال، هیچ چیزی نمی‌تواند مرا از مسیر خود منحرف کند."
      },
      {
        "id": 4817458,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ولیس علیه فیه من جناح",
        "languageId": 2,
        "coupletSummary": null
      },
      {
        "id": 4817459,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زهی از عنبر سارا کشیده",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عطر دلنشین عنبر از سارا به مشام رسیده و زیبایی‌اش بر برف سفید کافور تأثیر گذاشته است."
      },
      {
        "id": 4817460,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رقم بر گرد کافور رباحی",
        "languageId": null,
        "coupletSummary": null
      },
      {
