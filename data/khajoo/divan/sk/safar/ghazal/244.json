      },
      {
        "id": 4817472,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "و غررت الودق و الدّیک حاک",
        "languageId": 2,
        "coupletSummary": null
      },
      {
        "id": 4817473,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نسیم عراقی ندانم چه بادی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نسیم عراقی را نمی‌شناسم که چه بادی است، و خاک سپاهان را نیز نمی‌دانم چه خصوصیاتی دارد."
      },
      {
        "id": 4817474,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زمین سپاهان ندانم چه خاکی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4817475,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بدین مشک‌سایی و عنبرفشانی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: با این بوی خوش مشک و عطر عنبر، ای نسیم روح‌بخش، جانم فدای تو باد."
      },
      {
        "id": 4817476,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ایا نفحة الرّیح روحی فداک",
        "languageId": 2,
        "coupletSummary": null
      },
      {
        "id": 4817477,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ندانم چه نقشی که مثل تو صورت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نمی‌دانم چه طرحی است که مثل تو، چهره‌ای زیبا و دلربا از آبی و خاکی نداشته باشد."
      },
      {
        "id": 4817478,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مصوّر نگردد ز آبی و خاکی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4817479,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ریاض بهشتی بدین روح‌بخشی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گلستانی که روح و جان را تازه می‌کند، مانند چراغی در آسمان است که درخشش و تابش خیره‌کننده‌ای دارد."
      },
      {
        "id": 4817480,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چراغ سپهری بدین تابناکی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4817481,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خرد را فریبی و دل را امیدی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: خرد را نمی‌توان فریب داد و دل به امید زنده است. روح زندگی دارد و جسم به سمت نابودی می‌رود."
      },
      {
        "id": 4817482,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "روان را حیاتی و تن را هلاکی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4817483,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه در دل ممّکن که در قلب جانی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در دل انسان، وجود حقیقتی زنده و پوینده است و نه تنها از جنبه مادی و ظاهری تشکیل شده، بلکه از روحی ناب و خالص سرچشمه می‌گیرد."
      },
      {
        "id": 4817484,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه از گِل مرکب که از روح پاکی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4817485,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مررنا با کناف نجد و بتنا",
        "languageId": 2,
        "coupletSummary": "هوش مصنوعی: ما از کنار دشت نجد گذر کردیم و در کنار درختان اراک شب را گذراندیم، شاید بتوانم تو را دوباره ببینم."
      },
      {
        "id": 4817486,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
