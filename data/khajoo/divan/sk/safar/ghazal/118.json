        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شد گریه و ناله مونس من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آوای گریه و ناله‌ی من، همدم می‌نوش و ساز و آواز است."
      },
      {
        "id": 4815056,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
