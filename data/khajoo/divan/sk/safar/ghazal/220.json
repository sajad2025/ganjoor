        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4817027,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بود پیوسته خواجو مست و مخمور",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: خواجو همیشه در حال مستی و سرخوشی بود و در این حال، یاد نرگس زیبا و فریبنده ترک‌ها دل او را شاد می‌کرد."
      },
