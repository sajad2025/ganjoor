        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3025456,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا شام‌، غرق حیلهٔ روز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در طول روز، غرق در ترفندهای زندگی هستیم و تا شب، به خوش‌گذرانی و لذت‌بردن از زندگی مشغولیم."
      },
