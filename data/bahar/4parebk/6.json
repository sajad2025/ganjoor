        "coupletIndex": 24,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 26,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از گفتهٔ من گرفت مایه",
        "languageId": null,
        "coupletSummary": null
      },
