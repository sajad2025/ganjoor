        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "*",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3044279,
        "vOrder": 47,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در ساحت این زمانه تار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در دنیای امروز، احساسات و نیکی‌ها از دل من فرار کرده و تاریکی بر من سایه افکنده است."
      },
