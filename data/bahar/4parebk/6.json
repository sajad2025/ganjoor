        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با بربط خود به جنبش آرم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: با ساز خود به حرکت درآور هر سوی دنیا و هر چهار طرف را."
      },
      {
        "id": 3044321,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر شش جهت و چهارسو را",
        "languageId": null,
        "coupletSummary": null
      },
