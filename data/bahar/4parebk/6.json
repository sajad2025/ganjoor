        "id": 3044322,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "واندر دل خلق زنده دارم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در دل مردم، اخلاق و احساسات خوب را زنده نگه داشته‌ام."
      },
