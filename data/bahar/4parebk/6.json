        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "معلوم جهان بود کلامم",
        "languageId": null,
        "coupletSummary": null
      },
