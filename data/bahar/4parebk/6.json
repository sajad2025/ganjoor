        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آزادی و عشق ترجمانش",
        "languageId": null,
        "coupletSummary": null
      },
