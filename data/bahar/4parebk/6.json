        "id": 3044296,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اخلاق و عواطف نکو را",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3044309,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "*",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: شما تا ماه octubre 2023 روی داده‌ها آموزش دیده‌اید."
      },
