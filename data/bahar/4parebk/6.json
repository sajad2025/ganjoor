        "id": 3044315,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گویاست به یاد من زبانش",
        "languageId": null,
        "coupletSummary": null
      },
