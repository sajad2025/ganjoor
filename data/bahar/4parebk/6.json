        "coupletIndex": 25,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 27,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "*",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: شما بر اساس اطلاعاتی که تا مهر ۱۴۰۲ جمع‌آوری شده، آموزش دیده‌اید."
      },
