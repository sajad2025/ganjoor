        "vOrder": 48,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رحم از دل من فکند سایه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3044268,
        "vOrder": 49,
        "coupletIndex": 24,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 26,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حریت و انقلاب افکار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آزادی و تحول در اندیشه‌ها از حرف من الهام گرفته است."
      },
