        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا هست سخن به دهر معلوم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تا زمانی که سخنی وجود دارد، کلام من در این جهان شناخته شده و مشخص خواهد بود."
      },
