        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نخلیست محبتت که از وی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: محبت تو مانند درخت نخل نیست که از آن میوه‌ای جز اندوه و غم به من نرسد."
      },
      {
        "id": 5062867,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
