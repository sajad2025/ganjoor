    "verses": [
      {
        "id": 5063262,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گرم صد ره زنی با تیغ بیداد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر با ظلم و بیدادگرانه به کسی ظلم کنی، هرگز در برابر کسی از حق و عدالت دفاع نخواهم کرد."
      },
      {
        "id": 5063263,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به پیش کس نخواهم زد رهی داد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5063264,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صنوبر با قدت کی شد برابر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: صنوبر با قامتش هرگز به قد سرو و شمشاد نمی‌رسد، زیرا همیشه در برابر آن‌ها احساس شرم می‌کند."
      },
      {
        "id": 5063265,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که شرمنده نشده چون سرو شمشاد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5063266,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "متاع کفر و دین از مو و رویت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من به خاطر زیبایی‌های تو، هم کفر و هم دین را رها کرده‌ام و در این معامله، همه چیزم را از دست داده‌ام."
      },
      {
        "id": 5063267,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دراین سودا شدم یکباره برباد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5063268,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بصید اندازی دلها ندیدم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در دنیا کسی را ندیده‌ام که با نگاهش دل‌ها را به آسانی شکار کند، مانند تو که با چشمانت دل‌ها را تسخیر می‌کنی."
      },
      {
        "id": 5063269,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز تیر غمزه چون چشم تو صیاد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5063270,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "منت آن مرغ دست آموزم آخر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من برای آزادی و رهایی خود، منت آن مرغ دست آموز را می‌کشم، تا کی باید در قفس زندگی کنم؟"
      },
      {
        "id": 5063271,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نسازی از قفس تا چندم آزاد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5063272,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بشر هرگز بدین خوبی ندیدم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من هرگز کسی را به این خوبی ندیده‌ام، نمی‌دانم فرشته‌ای است یا از نسل پری‌ها."
      },
      {
        "id": 5063273,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ملک باشی ندانم یا پری زاد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5063274,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلی دارم برت از گرمی شوق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل من پر از عشق و اشتیاق به توست، به طوری که تمام وجودم در آتش و درد و فریاد است."
      },
      {
        "id": 5063275,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سراپا آتش و افغان و فریاد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5063276,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نخستین دم مرا شیخ طریقت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: شیخ طریقت تنها در عشق تو مرا راهنمایی نکرده و هیچ چیزی جز عشق تو به من نداده است."
      },
      {
        "id": 5063277,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بجز عشقت نداده هیچ ارشاد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5063278,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پدر تنها نه بهر عشق پرورد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: پدر تنها به خاطر محبتش مرا بزرگ نکرد، بلکه مادر هم به همین دلیل برای من زحمت کشید."
      },
      {
        "id": 5063279,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که مادر هم مرا بهر همین زاد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5063280,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز آزادان دربار تو چون نور",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از آزادگان دربار تو بگو که مانند نورند، پس بگو که در نهایت، چه چیزی باعث شد که به بندگی تو بپردازند؟"
      },
      {
        "id": 5063281,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
