        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا تو بر گیریش بخنجر باز",
        "languageId": null,
        "coupletSummary": null
