        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که از غم خاطرم را شاد کردند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5063370,
        "vOrder": 9,
