        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلی دیگر نمی بینم در این شهر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در این شهر دیگر دلی نمی‌بینم که از غم دوری تو خوشحال باشد."
      },
      {
        "id": 5063463,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که نبود از غم هجر تو مسرور",
        "languageId": null,
        "coupletSummary": null
      },
