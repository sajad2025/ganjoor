        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که ما را در نظر هستی تو منظور",
        "languageId": null,
        "coupletSummary": null
      },
