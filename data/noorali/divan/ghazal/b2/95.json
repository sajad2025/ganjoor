        "sectionIndex4": null,
        "text": "چو پروانه همه بال و پرم سوخت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مانند پروانه، تمامی وجودم را در عشق تو از دست دادم، زیرا تو در جمع من شعله‌ای نیستی که در انتظارش هستم."
      },
      {
        "id": 5063873,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رخت کان نیست شمع محفل من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5063874,
        "vOrder": 7,
        "coupletIndex": 3,
