        "coupletSummary": "هوش مصنوعی: عشق، ای رهبر نماز، عقل گمراه را به سوی نماز هدایت کن."
      },
      {
        "id": 5062621,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عقل گمره را بره بر الصلا",
        "languageId": null,
        "coupletSummary": null
