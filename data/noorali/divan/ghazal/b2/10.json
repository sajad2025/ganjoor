        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "الصلا گفتم بیاران بارها",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گفتم نماز را چند بار به شما یادآوری می‌کنم و دوباره این یادآوری را تکرار می‌کنم."
      },
      {
        "id": 5062639,
        "vOrder": 20,
