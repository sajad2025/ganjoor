        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی بران را زبرگ بی برگی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: افرادی که هیچ شاخ و برگی ندارند، مانند درختی بی‌برگ هستند که نمی‌توانند ثمر دهند."
      },
      {
        "id": 5061133,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
