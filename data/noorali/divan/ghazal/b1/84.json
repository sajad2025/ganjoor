        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شد عیان چون بجهان نور علی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چشم‌ها روشن شد و نور علی نمایان گشت، آن زمان که صفات خداوند بر ذات او تابید."
