        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سرکشانرا بگیر و برگردن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: افرادی که سرکش هستند را بگیر و بر گردنشان از موی خود حریر ببند."
      },
      {
