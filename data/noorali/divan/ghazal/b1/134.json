        "id": 5060741,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر کس که بدل ظلمت زنگار ندارد",
        "languageId": null,
        "coupletSummary": null
      }
