        "text": "چند کنم قوت دل بی تو ز خون جگر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5061048,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کرد جهان پر گهر نظم گهر بار من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: جهان را به زیبایی و نظم آراسته‌ای و زندگی من نیز به این ترتیب، پر از زیبایی و ارزش شده است."
      },
