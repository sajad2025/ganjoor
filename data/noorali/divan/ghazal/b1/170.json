        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هرگز از دیدن محبوبم دست نمی‌کشم، حتی اگر به خاطر دوری، بی‌تاب و بی‌خواب شوم."
      },
      {
        "id": 5061291,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
