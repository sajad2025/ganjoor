        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "طایر آشیان قدسم من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من پرنده‌ دنیای معنویت و پاکی هستم، اما در این دنیای فانی مانند قفسی محصور شده‌ام."
      },
      {
        "id": 5061289,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
