        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شب روان ره محبت را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: محبت و عشق در شب تاریک، هیچ ترسی از نگهبانان یا موانع ندارد."
      },
      {
        "id": 5061287,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کی بود وحشتی ز میر عسس",
        "languageId": null,
        "coupletSummary": null
      },
      {
