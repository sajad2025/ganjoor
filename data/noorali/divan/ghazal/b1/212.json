        "languageId": null,
        "coupletSummary": "هوش مصنوعی: پوشش زهد و لباس تقوا را جز با حضور دل کجا می‌توان یافت؟"
      },
      {
        "id": 5061957,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
