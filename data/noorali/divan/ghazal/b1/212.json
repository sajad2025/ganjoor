        "sectionIndex4": null,
        "text": "عین آبیم و آب می جوئیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5061956,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
