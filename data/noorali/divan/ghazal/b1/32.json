    "verses": [
      {
        "id": 5059248,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "باز ساز عشق سر کردیم ما",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما دوباره به عشق روی آوردیم و عقل خرافی را کنار گذاشتیم."
      },
      {
        "id": 5059249,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ترک عقل تیره سر کردیم ما",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5059250,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "معتکف گشتیم کنج میکده",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در گوشه میکده نشسته‌ایم و در حال نوشیدن شراب هستیم و به دیگران اطلاع داده‌ایم که ما در اینجا مشغولیم."
      },
      {
        "id": 5059251,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "باده نوشان را خبر کردیم ما",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5059252,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خشک لب هر جا حریفی یافتیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر جا که دوست و همراهی پیدا کردیم، با نوشیدنی برای او لبی تر و دلش را شاد کردیم."
      },
      {
        "id": 5059253,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کام او از باده تر کردیم ما",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5059254,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شربتی از لعل جانان ساختیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما نوشیدنی از سنگ‌هایی با ارزش و زیبا تهیه کردیم و دل‌هایمان را از شکر و خوشحالی لبریز کردیم."
      },
      {
        "id": 5059255,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کام جان ها پر شکر کردیم ما",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5059256,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "داغ عشقی بر جگرها سوختیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما با آتش عشق به شدت آسیب دیدیم و دل‌های‌مان پر از درد و ناراحتی شد."
      },
      {
        "id": 5059257,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سینه ها را پر شرر کردیم ما",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5059258,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گنج جان در کنج ویران یافتیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما در جایی که ویران و خالی از زندگی بود، گنجی ارزشمند و معنوی پیدا کردیم و به همین دلیل دیگر به دنبال گنج‌های دنیوی از طلا و نقره نرفتیم."
      },
      {
        "id": 5059259,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ترک گنج سیم و زر کردیم ما",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5059260,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دست و دل شستیم از سود و زیان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما از وابستگی به منافع و زیان‌ها دست برداشتیم و هر نوع سود و ضرری را کنار گذاشتیم."
      },
      {
        "id": 5059261,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ترک هر نفع و ضرر کردیم ما",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5059262,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پا و سر در عشق جانان باختیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما در عشق محبوب خود همه وجودمان را فدای او کرده‌ایم و اکنون که خود را از دست داده‌ایم، نه پا داریم و نه سر؛ یعنی بی‌هویت و بی‌سروسامان شده‌ایم."
      },
      {
        "id": 5059263,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خویش را بی پا و سر کردیم ما",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5059264,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سرگذشت خویش کوته ساختیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما داستان زندگی‌امان را به طور خلاصه بیان کردیم و سرگذشت خود را کوتاه کردیم."
      },
      {
        "id": 5059265,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "قصه خود مختصر کردیم ما",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5059266,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همنشین گشتیم با نور علی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما با نور ایمان و فضائل علی در کنار هم نشسته‌ایم و به همین دلیل ارزش و اعتبار خود را افزایش داده‌ایم."
      },
      {
