        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گاه ترسا صفت بدیر آمد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گاهی پیشوایان دین در اوایل شب می‌آیند، و گاهی اهل شیعه در معابد حضور می‌یابند."
      },
      {
