        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر سریر فقر چون نور علی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در زندگی فقیرانه، همانند نور، نشانه‌ای از سلطنت و وقار وجود ندارد."
