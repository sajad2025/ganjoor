        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5060872,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مگر نور علی گردیده ظاهر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: شاید نور امام علی به وضوح نمایان شده باشد که من جهانی را می‌بینم که مظهر نور است."
