        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سایه گستر لوای درویشان",
        "languageId": null,
        "coupletSummary": null
      },
