        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پادشاهان گدای درویشان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5062160,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خوش نوا ساز عالمند و بود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در عالم، صداهایی دلنشین و زیبا وجود دارد و در این میان، صدای درویشان نیز نمایانگر فقر و نیازمندی آن‌هاست."
      },
      {
