        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سر خوش آنکه نهاده بر گردن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: شادی از آنِ کسی است که بر گردن خود زنجیر محبت و وفاداری به درویشان گذاشته است."
