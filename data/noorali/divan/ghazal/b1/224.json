        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سرو جانم فدای آنکه بود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: سرو روح من فدای کسی است که روحش فدای درویشان است."
      },
      {
