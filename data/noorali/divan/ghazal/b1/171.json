        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صورت اعیان عیان ساخت باظهار خویش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5061298,
        "vOrder": 3,
