        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کرد عیان هستیش آینه نیستی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: خود را آشکار کرد و به مانند آینه‌ای که حاوی عدم است، در آن آینه ناظر خود را مشاهده کرد."
      },
      {
        "id": 5061299,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
