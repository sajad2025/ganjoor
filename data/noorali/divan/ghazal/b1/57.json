        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جمله ذرات از می توحید ذات",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تمامی موجودات از شراب یکتایی آنچنان مست و بی خود شده‌اند که جای هشیاری و آگاهی کجاست؟"
      },
      {
        "id": 5059605,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
