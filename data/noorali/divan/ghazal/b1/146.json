      },
      {
        "id": 5060917,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه بگشادت که بستی لب ز گفتار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5060918,
        "vOrder": 3,
