        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "میکشان را باده گلگون ز بط",
        "languageId": null,
        "coupletSummary": null
      },
