    "verses": [
      {
        "id": 5062170,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "روی بهر چه هر دم سوی گلشن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به خاطر هر چیزی که هر لحظه به سمت گلزار می‌آیم، اشک‌های گلم را در دامن خود ببین."
      },
      {
        "id": 5062171,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیا گلهای اشگم بین بدامن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5062172,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلم کائینه نور تجلی است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل من مانند آینه‌ای است که همیشه نور تجلی را منعکس می‌کند و این روشنی به خاطر تصویر روی توست."
      },
      {
        "id": 5062173,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مدام از عکس رویت هست روشن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5062174,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز سروت کی کند دل قمری جان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل قمری به خاطر بندگی‌اش نمی‌تواند از ثروت و خوشی‌های دیگران خوشنود شود. در واقع، او تحت تأثیر مقام و موقعیت خود به گونه‌ای زندگی می‌کند که نمی‌تواند به راحتی از خواسته‌ها و آروزهای دیگران چشم‌پوشی کند."
      },
      {
        "id": 5062175,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که طوق بندگی دارد بگردن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5062176,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه حد خورشید تابان را که آید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: خورشید درخشان چه فاصله‌ای دارد تا از کنج خانه‌ات به سمت کعبه بیاورد."
      },
      {
        "id": 5062177,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بطرف کعبه کویت ز روزن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5062178,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو آنشاهی که جبریل امین را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو آن پادشاهی که جبرئیل امین در خلوتگاه تو به آرامش و پناه آمده است."
      },
      {
        "id": 5062179,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در خلوت سرایت گشته مأمن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5062180,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نبودش آن تزین عرش اعظم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر آن زیبایی که به عرش اعظم می‌دهد، بر پای نعلین تو نباشد، هرگز نمی‌توانستیم عرش را زینت بخشیم."
      },
      {
        "id": 5062181,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز نعلینت نمیشد گر مزین",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5062182,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بجز نور رخت در کعبه و دیر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تنها روشنی چهره‌ات است که چشم شیخ و برهمن را به خود جلب می‌کند و غیر از آن در هیچ مکان مقدسی نگاه آنها نمی‌چرخد."
      },
      {
        "id": 5062183,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نجوید دیده شیخ و برهمن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5062184,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو جان عالمی عالم تن تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو روح و جان همهٔ موجودات هستی، اما وجود جسمانی تو در کجاست که بدون روح هیچ حیات و زندگی در آن نیست."
      },
      {
        "id": 5062185,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کجا بیجان حیاتی هست بر تن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5062186,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فلک گر باردم از کین بسر تیغ",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر آسمان هم بخواهد بر من سخت بگیرد و به من ظلم کند، محبت تو همچون زره‌ای در برابر تیرها و سختی‌ها از من محافظت می‌کند."
      },
      {
        "id": 5062187,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بود مهر توام در بر چو جوشن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5062188,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز گفتارت که برهانیست قاطع",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از سخنت که دلیل قاطعی است، داستان کاف و نون روشن و مشخص شده است."
      },
      {
        "id": 5062189,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حدیث کاف و نون گشته مبرهن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5062190,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز رخسارت که مرآت الهیست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از چهره‌ات که آینه‌ای از جمال الهی است، نور خداوند بر ما تابیده است."
      },
      {
        "id": 5062191,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شده نور علی ما را مبین",
        "languageId": null,
        "coupletSummary": null
      }
