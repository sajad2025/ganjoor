        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5060186,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ادب ادب ادب آور که رسم عشاقست",
