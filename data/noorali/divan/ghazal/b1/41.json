        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "قطره های می بود بر لعل او",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: قطره های شراب بر لبان او مانند سنگی قیمتی است یا اینکه مانند خورشید، درخشان و پر نور است."
      },
