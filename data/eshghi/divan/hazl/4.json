    "verses": [
      {
        "id": 4623147,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این چه بساطی است، چه گشته مگر؟",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این چه وضعیتی است که پیش آمده؟ چه اتفاقی افتاده است؟ کشور به چه حالتی درآمده که در آستانه مرگ و نابودی قرار دارد؟"
      },
      {
        "id": 4623148,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مملکت از چیست؟ شده محتضر:",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4623149,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "موقع خدمت همه مانند خر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در زمان خدمت، همه مانند الاغ فقط در اطراف خود مشغول هستند و هیچ کار مثبتی انجام نمی‌دهند."
      },
      {
        "id": 4623150,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جمله اطباش، به گل مانده در",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4623151,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 2,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به به ازین مملکت خر تو خر!",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این سرزمین واقعاً جای شگفت‌انگیزی است!"
      },
      {
        "id": 4623152,
        "vOrder": 6,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیست به دزدی شما، در جهان؟",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در این جهان دزدی وجود ندارد، اما چه کسی شما را این‌گونه فریب داده است؟"
      },
      {
        "id": 4623153,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کیست که خر کرده، شما را چنان؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4623154,
        "vOrder": 8,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چیست که خفتند، همه بی گمان؟",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چه چیزی باعث شده است که همه بدون شک خوابیده‌اند؟ افسوس بر شما، ای کسانی که به زمین افتاده‌اید!"
      },
      {
        "id": 4623155,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وه به شما، ای همه افتادگان!",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4623156,
        "vOrder": 10,
        "coupletIndex": 5,
        "versePosition": 2,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به به ازین مملکت خر تو خر!",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چه خوب است این سرزمین، عجب جایی است!"
      },
      {
        "id": 4623157,
        "vOrder": 11,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مادر بیچاره، فتاده علیل",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مادر غمگین و ناتوان، در جستجوی راهی برای درمان و بهبودی فرزندش است و به هر سو می‌رود."
      },
      {
        "id": 4623158,
        "vOrder": 12,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دخترک اندر پی هر کج سبیل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4623159,
        "vOrder": 13,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پرستارانش ز وزیر و وکیل",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: پرستاران به سراغ وزیران و وکیلان رفته‌اند و آن‌ها را درگیر مسائل کوچک و بی‌اهمیت می‌کنند."
      },
      {
        "id": 4623160,
        "vOrder": 14,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جمله فتادند، به فکر آجیل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4623161,
        "vOrder": 15,
        "coupletIndex": 8,
        "versePosition": 2,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به به ازین مملکت خر تو خر!",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این جمله به نوعی به وضعیت نامناسب و خنده‌دار یک مکان اشاره دارد، به‌طوری که حتی خر هم در آنجا احساس راحتی و خوشحالی می‌کند. به عبارتی دیگر، اوضاع آن‌قدر بد و عجیب است که همه چیز به خوبی پیش می‌رود، حتی برای موجوداتی مانند خر."
      }
