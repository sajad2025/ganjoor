      {
        "id": 49650,
        "authorName": "جهانگیر تجددی",
        "authorUrl": "",
        "commentDate": "2019-10-03T21:50:33",
        "htmlComment": "<p>سلام<br />این نظم حال پریشانم را منظم کرد<br /> انسان پریشان سخت به سخن می اید<br />چه قدر زیبا اشاره می کند ؛<br />من پریشان ترین پریشان جهان بوده و هستم<br />(پریشان خاطران رفتند در خاک<br />  مرا از خاک ایشان آفریدند)<br /> این حقیر، واژه چینی کرده ام که ارام دل خود باشد ، که امید است ادب دوستان آن را دور از ادب ندانند<br />پریشان ،نظم میگوید<br />پریشان نظم، میگوید<br />پری جان، نظم میگوید<br />پری ،جان نضم میگوید</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": null,
        "replies": [],
        "myComment": false,
        "coupletIndex": -1,
