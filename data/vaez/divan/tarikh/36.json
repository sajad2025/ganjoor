        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این گنبذ را بسعی موفور",
        "languageId": null,
        "coupletSummary": null
      },
      {
