      },
      {
        "id": 4749709,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شاهی که جهان ازوست معمور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4749710,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بلقیس زمانه را «سلیمان »",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بلقیس در هر زمان، همانند سلیمان، باید در کنار هم باشند و همیشه خوشحال و شاداب زندگی کنند."
      },
      {
        "id": 4749711,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "باشند زهم، همیشه مسرور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4749712,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر خوان عطای او نوالش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: فغفور با دست خود، غذا و نعمت‌های بخشیده شده از سوی او را در ظرفی گرفت."
      },
      {
        "id": 4749713,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در کاسه گرفت دست فغفور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4749714,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رفتند ز بیمش اهل آزار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: افراد آزاردهنده به خاطر ترس از او، به خودشان آسیب می‌زنند؛ مانند نیش زنبور که بر خود می‌زند."
      },
      {
        "id": 4749715,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر خویش فرو چو نیش زنبور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4749716,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از یاری حق نمود تعمیر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: با کمک و یاری خداوند، این گنبد با تلاش فراوان ساخته و تعمیر شده است."
      },
      {
        "id": 4749717,
        "vOrder": 10,
