        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هم چرخ و، هم آفتاب پرنور",
        "languageId": null,
        "coupletSummary": null
