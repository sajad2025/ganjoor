      },
      {
        "id": 4749674,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گشته در روزگار معتدلش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در دوران خوش و آرامش، به دلیل تأثیرات طبیعت، از بسیاری چیزها دور شده است."
      },
      {
        "id": 4749675,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از طبایع ز بس گرفتن دور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4749676,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آب شمشیر او، مگر گیرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آب شمشیر او مانند آتشی می‌باشد که در چشم دشمن مغرور تأثیر می‌گذارد."
      },
      {
        "id": 4749677,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آتش چشم دشمن مغرور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4749678,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "او «سلیمان » و هند وادی نمل",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او به قدرتی مانند سلیمان و مهارت در فرماندهی سپاه خود دارد، به طوری که می‌تواند بر سرزمین هند و مخلوقات آن تسلط یابد."
      },
      {
        "id": 4749679,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر سپاهش بر آن کنند عبور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4749680,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دور نبود ز هندیان دغا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دور از انتظار نیست که هندی‌ها در نقشه‌های نادرست و فریب‌دهنده خود، همچون مورهایی که به سوراخ‌های خود می‌خزند، عمل کنند."
      },
      {
        "id": 4749681,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر بسوراخ در خزند چو مور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4749682,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز آب عدل «نجف قلی خان » کرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نجف قلی خان با عدالت خود به آبادانی کشور قندهار کمک کرده است."
      },
      {
        "id": 4749683,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کشور «قندهار» را معمور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4749684,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن بمردی زبانزد عالم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این شخص به خاطر ویژگی‌های برجسته‌اش در بین مردم معروف شده و آن دیگری به عنوان یک اصل و حقیقت مورد قبول همگان شناخته می‌شود."
      },
      {
        "id": 4749685,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "و آن بجوهر مسلم جمهور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4749686,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیست از ضبط او در آن کشور",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در آن سرزمین، هیچ چیز نمی‌تواند از کنترل او خارج شود، به جز خوشه‌ای که خود از آن خواسته باشد."
      },
      {
        "id": 4749687,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سرکشی غیر خوشه را مقدور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4749688,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کس در او از ضعف پروریش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هیچ‌کس نمی‌تواند از ضعف و ناتوانی او بهره‌برداری کند، همان‌طور که نمی‌توان دانه‌ای از یک مورچه گرفت."
      },
      {
        "id": 4749689,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نتواند گرفت دانه ز مور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4749690,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خصم اگر برد جان زتیغش، کرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر دشمن جان کسی را با شمشیرش بگیرد، او را در گور زنده نگه می‌دارد و این دیگرت اثر می‌گذارد."
      },
      {
        "id": 4749691,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زنده از گرد کلفتش در گور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4749692,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برق تیغش چو داغ لاله کند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که تیغ آن شخص مانند درخشش قرمز لاله‌ای سوزان شود، دشمن بدبخت و سیاه‌رو را در تنگنا قرار می‌دهد."
      },
      {
        "id": 4749693,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دشمن روسیاه را محصور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4749694,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خصم در کین او دو دل گردد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که دشمن در کینه‌اش دو دل می‌شود، شمشیرش به دلش نفوذ می‌کند مانند خطری که ناگهان پیش می‌آید."
      },
      {
        "id": 4749695,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تیغ او در دلش کند چو خطور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4749696,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر عدو از نهیب او، گردد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر دشمن از خشم او بترسد، وسعت هند به اندازه‌ی چشم یک مور کوچک می‌شود."
      },
      {
        "id": 4749697,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وسعت هند همچو دیده مور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4749698,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این ایالت، براو مبارک باد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این سرزمین، به برکت وجود او، تحت تأثیر عدالت او رونق یافته و آباد است."
      },
      {
        "id": 4749699,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن ولایت ز عدل او معمور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4749700,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر احبا همیشه فیض رسان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: همیشه بر دوستان نعمت و بر دشمنان پیروزی عطا کن."
      },
      {
        "id": 4749701,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر اعادی مظفر و منصور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4749702,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دوستش، سربلند باد و عزیز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دوستش همیشه در رفاه و سربلندی باشد و دشمنش دلی شکسته و تحت تسلط باشد."
      },
      {
        "id": 4749703,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دشمنش، دلشکسته و مقهور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4749704,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرو سان چون ز عدل و احسانش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به جایی نرو که با انصاف و نیکوکاری، مکانی برای آسایش و شادی فراهم شده است."
      },
      {
        "id": 4749705,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گشت دارالقرار، دار سرور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4749706,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت واعظ برای تاریخش:",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: واعظ گفت که به خاطر او، قندهار هم آباد و پر رونق شده است."
      },
      {
        "id": 4749707,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "«شد ازو قندهار هم معمور»",
        "languageId": null,
        "coupletSummary": null
      }
    ],
