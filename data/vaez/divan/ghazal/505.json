        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست عین شباب درویشان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4744184,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست نور شکسته رنگی عشق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عشق همچون نوری با رنگ‌های متفاوت در تاریکی شب، روشنی بخش دل درویشان است."
      },
