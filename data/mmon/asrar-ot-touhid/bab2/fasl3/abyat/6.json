        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 18,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حفا که درین سخن نه زرقست و نه فن",
        "languageId": null,
        "coupletSummary": null
      },
      {
