        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من فراوان کشیده‌ام غم دل",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من غم و اندوه زیادی را تجربه کرده‌ام، اما همواره در این بستر زاری کمتری داشته‌ام."
      },
