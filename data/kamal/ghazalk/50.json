        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سر که پیش تو بر زمین دارد",
        "languageId": null,
        "coupletSummary": null
      },
      {
