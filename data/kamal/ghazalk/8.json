        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جان اگر صد هزار لطف کند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر جان هزاران نیکی و محبت هم بکند، در نهایت شرمنده و خجالت‌زدهٔ لبان تو خواهد بود."
      },
