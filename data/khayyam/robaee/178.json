      {
        "id": 113594,
        "authorName": "Mosi Baghbani",
        "authorUrl": null,
        "commentDate": "2023-11-24T21:47:12.7708058",
        "htmlComment": "<p>&nbsp;تموم کردم و بسیار لذت بردم مخصوصا از حاشیه های جناب کیخا،ایشالا همیشه سالم وسلامت باشید</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": "8444d78a-84ee-48f0-e44a-08dbece21572",
        "replies": [],
        "myComment": false,
