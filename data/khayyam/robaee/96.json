      {
        "id": 116507,
        "authorName": "جمشید حقایقی",
        "authorUrl": null,
        "commentDate": "2024-02-08T14:00:37.7094315",
        "htmlComment": "\r\n\r\n<p>من می نه ز بهر تنگدستی نخورم&nbsp; &nbsp; &nbsp; یا از غم رسوایی و مستی نخورم &nbsp; &nbsp;</p>\r\n\r\n\r\n\r\n<p>من می ز برای خوشدلی می&zwnj;خوردم</p>\r\n\r\n\r\n<p>اکنون که تو بر دلم نشستی نخورم</p>\r\n\r\n\r\n\r\n\r\n&nbsp;\r\n",
        "publishStatus": "",
