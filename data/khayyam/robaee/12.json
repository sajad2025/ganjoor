        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی‌دادگری شیوهٔ دیرینهٔ توست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3844316,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای خاک! اگر سینهٔ تو بشکافند",
        "languageId": null,
        "coupletSummary": "ای خاک، اگر سینه‌ی تو را بشکافند، در درون سینه‌ی تو بسی جان‌ها و انسان‌های عزیز و گوهرمانند در درون تو نهفته شده‌ست."
      },
