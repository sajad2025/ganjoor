        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای نمایان سهیل، اوج وجود و تابش خورشید آسمان آفرینش."
      },
      {
        "id": 3076604,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کافتاب سپهر ایجادی",
        "languageId": null,
        "coupletSummary": null
