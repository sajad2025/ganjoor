        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون زنم دیده برهم آینه‌وار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی چشم‌هایم را می‌بندم، مانند آینه‌ای که منعکس می‌کند، چشمان حیران عشق خوابشان نمی‌آید."
      },
      {
        "id": 4632420,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
