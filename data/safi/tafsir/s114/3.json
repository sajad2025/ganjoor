        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در ششم سال ابتداء این نامه گشت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278334,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در هزار و سیصد و هشت این چنین",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278335,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گشت ختم از عون ربّ العالمین",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278336,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این است از حق نعمتی بر خاص و عام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278337,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر بفهمند اهل ایمان بالتمام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278338,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اوفتد ابلیس در اندوه و سوز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278339,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کز چه شد معلوم قرآن را رموز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278340,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا به امروز این چنین روشن بیان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278341,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شرح قرآن را نیامد در جهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278342,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کآن به فهم مردمان باشد قریب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278343,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خاص و عام از وی برد هر کس نصیب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278344,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پس جنود فتنه را دیو عناد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278345,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جمع سازد بدهد ایشان را به یاد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278346,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کاین زمان افسانه ها را نو کنید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278347,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "راه خلقان را به طرح نو زنید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278348,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از لباس آدمی باید برون",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278349,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اندر آیید از پی حیلت کنون",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278350,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پس درآید دیو از شکل بشر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278351,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا به هم جنسی زند راه از حشر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278352,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زآنکه جنسیّت به غایت جاذب است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278353,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در اثر همجنس قولش غالب است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278354,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنچنان که یافت چون قرآن نزول",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278355,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ره زدیم از خلق مکه در قبول",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278356,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خود برون از شکل آدم آمدیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278357,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "راهشان از راه همجنسی زدیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278358,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا چه گفتن آن ولید و بولهب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278359,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همچنین ابلیس رویان عرب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278360,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست در تفسیر شرحش مو به مو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278361,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنچه کردند آن خسیسان گفتگو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278362,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "باز هم در بر کند دیو آن لباس",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278363,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می نماید خویش را بر شکل ناس",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278364,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر چسان تا افکند طرح کلام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278365,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نفی تفسیر صفی را بر انام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278366,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا تو شیطان را شناسی زین نشان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278367,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هرچه گوید زن تو مشتی بر دهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278368,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وآنکه او بوجهل و شیطان نسبت است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278369,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رهزن خلق از طریق طاعت است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278370,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این قدر کافی است از بهر شناس",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278371,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مابقی را کن به فهم خود قیاس",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278372,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر پناه از شرّ خنّاس عدو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278373,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر اله الناس گاه جستجو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278374,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو افکند وسواس دیو اندر صدور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278375,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر پناه از وی به خلاّق الأمور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278376,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اندر این نظم مبارک از کلام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278377,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یافت اسرار معانی انتظام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278378,
        "vOrder": 47,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بحر گوهر گشت تفسیر صفی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278379,
        "vOrder": 48,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از رموز نغز بکر مختفی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278380,
        "vOrder": 49,
        "coupletIndex": 24,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 26,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر کند کس نفی این نظم و کتاب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278381,
        "vOrder": 50,
        "coupletIndex": 24,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 26,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هیچ او را نیست حاجت بر جواب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278382,
        "vOrder": 51,
        "coupletIndex": 25,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 27,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زآنکه کرده نفی عقل و علم خویش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278383,
        "vOrder": 52,
        "coupletIndex": 25,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 27,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو چه گویی آنچه او خود گفته بیش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278384,
        "vOrder": 53,
        "coupletIndex": 26,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 28,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وا هِل او را در چنان جهل و حسد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278385,
        "vOrder": 54,
        "coupletIndex": 26,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 28,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا سزای جهل او از حق رسد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278386,
        "vOrder": 55,
        "coupletIndex": 27,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 29,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر تو ای پروردگار مهر و ماه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278387,
        "vOrder": 56,
        "coupletIndex": 27,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 29,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خود صفی جوید ز هر جهلی پناه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278388,
        "vOrder": 57,
        "coupletIndex": 28,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 30,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو پناه هر پناه آرنده ای",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278389,
        "vOrder": 58,
        "coupletIndex": 28,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 30,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ده پناه، آرد پناه ار بنده ای",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278390,
        "vOrder": 59,
        "coupletIndex": 29,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 31,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اول و آخر پناه ما تویی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278391,
        "vOrder": 60,
        "coupletIndex": 29,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 31,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جرم بخش و مالک و مولی تویی",
        "languageId": null,
        "coupletSummary": null
      }
    ],
