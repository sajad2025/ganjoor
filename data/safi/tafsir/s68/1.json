    "next": {
      "id": 146045,
      "title": "۲- آیات ۵ تا ۲۵",
      "urlSlug": "sh2",
      "excerpt": "فَسَتُبْصِرُ وَ یُبْصِرُونَ (۵) بِأَیِّکُمُ اَلْمَفْتُونُ (۶) إِنَّ رَبَّکَ هُوَ أَعْلَمُ بِمَنْ ضَلَّ عَنْ سَبِیلِهِ وَ هُوَ أَعْلَمُ بِالْمُهْتَدِینَ (۷) فَلاٰ تُطِعِ اَلْمُکَذِّبِینَ (۸) وَدُّوا لَوْ تُدْهِنُ فَیُدْهِنُونَ (۹) وَ لاٰ تُطِعْ کُلَّ حَلاّٰفٍ مَهِینٍ (۱۰) هَمّٰازٍ مَشّٰاءٍ بِنَمِیمٍ (۱۱) مَنّٰاعٍ لِلْخَیْرِ مُعْتَدٍ أَثِیمٍ (۱۲) عُتُلٍّ بَعْدَ ذٰلِکَ زَنِیمٍ (۱۳) أَنْ کٰانَ ذٰا مٰالٍ وَ بَنِینَ (۱۴) إِذٰا تُتْلیٰ عَلَیْهِ آیٰاتُنٰا قٰالَ أَسٰاطِیرُ اَلْأَوَّلِینَ (۱۵) سَنَسِمُهُ عَلَی اَلْخُرْطُومِ (۱۶) إِنّٰا بَلَوْنٰاهُمْ کَمٰا بَلَوْنٰا أَصْحٰابَ اَلْجَنَّةِ إِذْ أَقْسَمُوا لَیَصْرِمُنَّهٰا مُصْبِحِینَ (۱۷) وَ لاٰ یَسْتَثْنُونَ (۱۸) فَطٰافَ عَلَیْهٰا طٰائِفٌ مِنْ رَبِّکَ وَ هُمْ نٰائِمُونَ (۱۹) فَأَصْبَحَتْ کَالصَّرِیمِ (۲۰) فَتَنٰادَوْا مُصْبِحِینَ (۲۱) أَنِ اُغْدُوا عَلیٰ حَرْثِکُمْ إِنْ کُنْتُمْ صٰارِمِینَ (۲۲) فَانْطَلَقُوا وَ هُمْ یَتَخٰافَتُونَ (۲۳) أَنْ لاٰ یَدْخُلَنَّهَا اَلْیَوْمَ عَلَیْکُمْ مِسْکِینٌ (۲۴) وَ غَدَوْا عَلیٰ حَرْدٍ قٰادِرِینَ (۲۵)",
      "mainSections": null
    },
    "previous": null,
    "verses": [
      {
        "id": 5274605,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": -1,
        "sectionIndex1": null,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بسم االله الرحمن الرحیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274606,
        "vOrder": 2,
        "coupletIndex": 1,
        "versePosition": -1,
        "sectionIndex1": null,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ن وَ اَلْقَلَمِ وَ مٰا یَسْطُرُونَ (۱) مٰا أَنْتَ بِنِعْمَةِ رَبِّکَ بِمَجْنُونٍ (۲) وَ إِنَّ لَکَ لَأَجْراً غَیْرَ مَمْنُونٍ (۳) وَ إِنَّکَ لَعَلیٰ خُلُقٍ عَظِیمٍ (۴)",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274607,
        "vOrder": 3,
        "coupletIndex": 2,
        "versePosition": -1,
        "sectionIndex1": null,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بنام خدای بخشندۀ مهربان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274608,
        "vOrder": 4,
        "coupletIndex": 3,
        "versePosition": -1,
        "sectionIndex1": null,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ن بقلم و آنچه می‌نویسند (۱) که نیستی تو بنعمت پروردگارت مجنون (۲) و بدرستی که مر تراست پاداش بدون منت (۳) و بدرستی که تویی بر خلق عظیم (۴)",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274609,
        "vOrder": 5,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نون مراد از نفس کلیه است هم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274610,
        "vOrder": 6,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عقل کلی نیز مقصود از قلم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274611,
        "vOrder": 7,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یافت از تأثیر عقلانی نمود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274612,
        "vOrder": 8,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صورت این ممکنات اندر شهود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274613,
        "vOrder": 9,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صورت اشیاست زین نون، وین قلم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274614,
        "vOrder": 10,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که شد اندر لوح امکانی رقم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274615,
        "vOrder": 11,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پس قسم بر سطر سطر ممکنات",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274616,
        "vOrder": 12,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زآنچه شد بنوشته با کِلک از دوات",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274617,
        "vOrder": 13,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنچه بنگارندگانِ این صور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274618,
        "vOrder": 14,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می نویسند از قلم زیر و زبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274619,
        "vOrder": 15,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست آن باز ار به تن داری روان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274620,
        "vOrder": 16,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صورت اشیاء و ماهیّات آن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274621,
        "vOrder": 17,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیستی دیوانه ای فخر کبار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274622,
        "vOrder": 18,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو به نعمت های آن پروردگار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274623,
        "vOrder": 19,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن چنان که بر تو این نسبت دهند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274624,
        "vOrder": 20,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "احمق و دیوانه و مجنون چند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274625,
        "vOrder": 21,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنکه در عقل و نبوّت خاتم است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274626,
        "vOrder": 22,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عقل او گویند بی عقلان کم است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274627,
        "vOrder": 23,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مر تو را اجری است بی منّت ز کس",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274628,
        "vOrder": 24,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در نبوّت یعنی از حق است و بس",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274629,
        "vOrder": 25,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیست غیری در وصولش واسطه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274630,
        "vOrder": 26,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا بود منّت تو را از رابطه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274631,
        "vOrder": 27,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خود تو بر خُلق بزرگی ای رسول",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274632,
        "vOrder": 28,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که کنی از قومت این ایذا قبول",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274633,
        "vOrder": 29,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست اندر حسن خُلق افزون سخن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274634,
        "vOrder": 30,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با تو گویم بعضی از آن جمله من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274635,
        "vOrder": 31,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفته بعضی خُلق این باشد به چشم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274636,
        "vOrder": 32,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که کند خشم ار کست نایی به خشم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274637,
        "vOrder": 33,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفته منصور این است که، بر نیک و بد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274638,
        "vOrder": 34,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بنگری از چشم حق نه از چشم خود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274639,
        "vOrder": 35,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بس دقیق است، این کلام عام نیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274640,
        "vOrder": 36,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست بهر پخته، بهر خام نیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274641,
        "vOrder": 37,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لیک می گوید صفی شو منتقل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274642,
        "vOrder": 38,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست خُلق ادراکت ار شد معتدل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274643,
        "vOrder": 39,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وآن میسّر نیست بهر هیچ کس",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274644,
        "vOrder": 40,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جز که بندد دست وسواس و هوس",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274645,
        "vOrder": 41,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بستن آن هم بود دور از گمان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274646,
        "vOrder": 42,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جز که آید پای عشق اندر میان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274647,
        "vOrder": 43,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چونکه آمد عشق هر فکری که هست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274648,
        "vOrder": 44,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دان که از شهر حواس او بار بست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274649,
        "vOrder": 45,
        "coupletIndex": 24,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "او نخواهد جز رضای یار خویش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274650,
        "vOrder": 46,
        "coupletIndex": 24,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فارغ است از راحت و آزار خویش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274651,
        "vOrder": 47,
        "coupletIndex": 25,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پس نکرد او فعلی آن محبوب کرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274652,
        "vOrder": 48,
        "coupletIndex": 25,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کرد محبوب ار که کاری خوب کرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5274653,
        "vOrder": 49,
        "coupletIndex": 26,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این لسان دیگری بُد نک سخن",
