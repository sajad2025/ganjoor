    "next": null,
    "previous": null,
    "verses": [
      {
        "id": 5277686,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": -1,
        "sectionIndex1": null,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بسم االله الرحمن الرحیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277687,
        "vOrder": 2,
        "coupletIndex": 1,
        "versePosition": -1,
        "sectionIndex1": null,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "إِنّٰا أَنْزَلْنٰاهُ فِی لَیْلَةِ اَلْقَدْرِ (۱) وَ مٰا أَدْرٰاکَ مٰا لَیْلَةُ اَلْقَدْرِ (۲) لَیْلَةُ اَلْقَدْرِ خَیْرٌ مِنْ أَلْفِ شَهْرٍ (۳) تَنَزَّلُ اَلْمَلاٰئِکَةُ وَ اَلرُّوحُ فِیهٰا بِإِذْنِ رَبِّهِمْ مِنْ کُلِّ أَمْرٍ (۴) سَلاٰمٌ هِیَ حَتّٰی مَطْلَعِ اَلْفَجْرِ (۵)",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277688,
        "vOrder": 3,
        "coupletIndex": 2,
        "versePosition": -1,
        "sectionIndex1": null,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بنام خدای بخشایندۀ مهربان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277689,
        "vOrder": 4,
        "coupletIndex": 3,
        "versePosition": -1,
        "sectionIndex1": null,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بدرستی که ما فرستادیمش در شب قدر (۱) و چه چیز دانا کردت که چیست شب قدر (۲) شب قدر بهتر است از هزار ماه (۳) نازل می‌شوند فرشتگان و روح در آن باذن پروردگارشان از هر امری (۴) سلامتست آن تا وقت طلوع صبح (۵)",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277690,
        "vOrder": 5,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عابدی بود اندر اسرائیلیان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277691,
        "vOrder": 6,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نام او شمسون بسی روشن روان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277692,
        "vOrder": 7,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کرده بُد هشتاد سال او خود جهاد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277693,
        "vOrder": 8,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با عدوی دین حق با اجتهاد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277694,
        "vOrder": 9,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با صحابه گفت حالش را رسول",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277695,
        "vOrder": 10,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بس شدند از استماع آن ملول",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277696,
        "vOrder": 11,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که بود ما را چنین طاعت کجا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277697,
        "vOrder": 12,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با حیات و عمر کوتاه از قضا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277698,
        "vOrder": 13,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آمد اینکه ما فرستادیم چند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277699,
        "vOrder": 14,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در شب قدر این کتاب ارجمند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277700,
        "vOrder": 15,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یعنی آن از لوح محفوظ مبین",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277701,
        "vOrder": 16,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در سماء دنیوی آمد چنین",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277702,
        "vOrder": 17,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پس ورا روح الامین در بیست سال",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277703,
        "vOrder": 18,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در جهان آورد ز امر ذوالجلال",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277704,
        "vOrder": 19,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه تو را دانا نمود از لیل قدر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277705,
        "vOrder": 20,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با چنان قدر و شرف وآن شرح صدر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277706,
        "vOrder": 21,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از هزاران ماه آن شب بهتر است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277707,
        "vOrder": 22,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اهل طاعت را که طاعت درخور است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277708,
        "vOrder": 23,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر زمین نازل شوند افرشتگان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277709,
        "vOrder": 24,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با امین وحی جبریل اندر آن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277710,
        "vOrder": 25,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز امر حق از بهر هر کاری که هست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277711,
        "vOrder": 26,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کرده حق تقدیر آن در فوق و پست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277712,
        "vOrder": 27,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا طلوع فجر در آن شب تمام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277713,
        "vOrder": 28,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می نباشد جز سلامت جز سلام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277714,
        "vOrder": 29,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نزد تحقیق از کمال سرمدی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277715,
        "vOrder": 30,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لیلة القدر است بنیۀ احمدی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277716,
        "vOrder": 31,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حال کون احتجابش بالعهود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277717,
        "vOrder": 32,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر مقام قلب از بعد شهود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277718,
        "vOrder": 33,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زآنکه ممکن نیست آن انزال خاص",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277719,
        "vOrder": 34,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جز که در این بیّنه در حال خاص",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277720,
        "vOrder": 35,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیست ظاهر قدر آن بر هیچ کس",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277721,
        "vOrder": 36,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خود شناسد قدر آن احوال و بس",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277722,
        "vOrder": 37,
        "coupletIndex": 20,
        "versePosition": -1,
        "sectionIndex1": null,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "« جذبه »",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277723,
        "vOrder": 38,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 1,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جمله اشیاء را در آن حال و صفت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277724,
        "vOrder": 39,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 1,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می بباید از حقایق معرفت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277725,
        "vOrder": 40,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 1,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چیست دانی لیلة القدر ای عیار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277726,
        "vOrder": 41,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 1,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر شنیدستی نسیم کوی یار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277727,
        "vOrder": 42,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 1,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شرح آن حال ار نمایم هیچ من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277728,
        "vOrder": 43,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 1,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "منقلب گردم بمانم از سخن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277729,
        "vOrder": 44,
        "coupletIndex": 24,
        "versePosition": 0,
        "sectionIndex1": 1,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خاصه کز یار عزیز آید پیام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277730,
        "vOrder": 45,
        "coupletIndex": 24,
        "versePosition": 1,
        "sectionIndex1": 1,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که امشبت من میهمانم در مقام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277731,
        "vOrder": 46,
        "coupletIndex": 25,
        "versePosition": 0,
        "sectionIndex1": 1,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خانه را خالی کن از بیگانه تو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277732,
        "vOrder": 47,
        "coupletIndex": 25,
        "versePosition": 1,
        "sectionIndex1": 1,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "منتظر بنشین به باب خانه تو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277733,
        "vOrder": 48,
        "coupletIndex": 26,
        "versePosition": 0,
        "sectionIndex1": 1,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با تو من گویم چه زین حال عجب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277734,
        "vOrder": 49,
        "coupletIndex": 26,
        "versePosition": 1,
        "sectionIndex1": 1,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که فراوان دیده ام این روز و شب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277735,
        "vOrder": 50,
        "coupletIndex": 27,
        "versePosition": 0,
        "sectionIndex1": 1,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خانه از غیر ار کنی خالی تمام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277736,
        "vOrder": 51,
        "coupletIndex": 27,
        "versePosition": 1,
        "sectionIndex1": 1,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آید آن مهمان غیبت لاکلام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277737,
        "vOrder": 52,
        "coupletIndex": 28,
        "versePosition": 0,
        "sectionIndex1": 1,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چونکه آمد کار بر دلخواه توست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277738,
        "vOrder": 53,
        "coupletIndex": 28,
        "versePosition": 1,
        "sectionIndex1": 1,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "طالع از برج حقیقت ماه توست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277739,
        "vOrder": 54,
        "coupletIndex": 29,
        "versePosition": 0,
        "sectionIndex1": 1,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "قوّه های عقلی و روحی تمام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5277740,
        "vOrder": 55,
        "coupletIndex": 29,
        "versePosition": 1,
        "sectionIndex1": 1,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا به صبحت در درودند و سلام",
        "languageId": null,
        "coupletSummary": null
      }
    ],
