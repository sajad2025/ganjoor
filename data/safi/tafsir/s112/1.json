    "next": null,
    "previous": null,
    "verses": [
      {
        "id": 5278187,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": -1,
        "sectionIndex1": null,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بسم االله الرحمن الرحیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278188,
        "vOrder": 2,
        "coupletIndex": 1,
        "versePosition": -1,
        "sectionIndex1": null,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "قُلْ هُوَ اَللّٰهُ أَحَدٌ (۱) اَللّٰهُ اَلصَّمَدُ (۲) لَمْ یَلِدْ وَ لَمْ یُولَدْ (۳) وَ لَمْ یَکُنْ لَهُ کُفُواً أَحَدٌ (۴)",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278189,
        "vOrder": 3,
        "coupletIndex": 2,
        "versePosition": -1,
        "sectionIndex1": null,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بنام خدای بخشاینده مهربان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278190,
        "vOrder": 4,
        "coupletIndex": 3,
        "versePosition": -1,
        "sectionIndex1": null,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بگو یا محمد اوست خدای یگانه (۱) خدا بی‌نیاز (۲) نزاده و زاینده نشده (۳) و نیست او را همتا و همسال (۴)",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278191,
        "vOrder": 5,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفته اند ارباب تحقیق و خرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278192,
        "vOrder": 6,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ذات بحت و بودِ محض است آن احد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278193,
        "vOrder": 7,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فرد و مطلق از خصوص و از عموم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278194,
        "vOrder": 8,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وز عروض و لاعروض و هر رسوم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278195,
        "vOrder": 9,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مطلق است اعنی ز قید خاص و عام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278196,
        "vOrder": 10,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه بود وصف و نشان او را نه نام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278197,
        "vOrder": 11,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جمله زو آثار کثرت منتفی است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278198,
        "vOrder": 12,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در حجاب لاتعیّن مختفی است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278199,
        "vOrder": 13,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عاری است از وصف کثرت وحدتش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278200,
        "vOrder": 14,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دور از شرط و تعیّن نسبتش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278201,
        "vOrder": 15,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست یکتایی چنان یکتا که او",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278202,
        "vOrder": 16,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در عدد داخل شود بی گفتگو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278203,
        "vOrder": 17,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در عددها وحدتش خارج بود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278204,
        "vOrder": 18,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نی چو واحد در عدد داخل شود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278205,
        "vOrder": 19,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حق ز وجه واحدیّت بی مقال",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278206,
        "vOrder": 20,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جامع کل صفات است و کمال",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278207,
        "vOrder": 21,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در مقام واحدیّت از جهات",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278208,
        "vOrder": 22,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می پذیرد علم و تعیین و صفات",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278209,
        "vOrder": 23,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "واحدیّت وصف ذات حضرت است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278210,
        "vOrder": 24,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فرض در وی اعتبار کثرت است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278211,
        "vOrder": 25,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یافت اندر واحدیّت اعتبار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278212,
        "vOrder": 26,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اسم و رسم و نعت و وصف از هر قرار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278213,
        "vOrder": 27,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست واحد از احد اول نزول",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278214,
        "vOrder": 28,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مر حقیقت از محمّد (ص) در وصول",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278215,
        "vOrder": 29,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای محمّد(ص) در جواب مشرکان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278216,
        "vOrder": 30,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که تو را گویند حق را ده نشان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278217,
        "vOrder": 31,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این بتان ما بود پیدا که چیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278218,
        "vOrder": 32,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو به ما بنما که معبود تو کیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278219,
        "vOrder": 33,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گو تو ایشان را هو االله احد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278220,
        "vOrder": 34,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "او نگنجد در اشارت، در عدد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278221,
        "vOrder": 35,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پاک و بیرون است از عین و عیان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278222,
        "vOrder": 36,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه اشارت می پذیرد نه بیان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278223,
        "vOrder": 37,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "منفرد اندر صفات و ذات خویش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278224,
        "vOrder": 38,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مطلق از ادراک مخلوقات خویش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278225,
        "vOrder": 39,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شأن او یکتایی است اندر وجود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278226,
        "vOrder": 40,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیستش ثانی به ذات و وصف و بود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278227,
        "vOrder": 41,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اندر آن حضرت خرد را راه نیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278228,
        "vOrder": 42,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ممکنی از هستی اش آگاه نیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278229,
        "vOrder": 43,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نک ز االله الصمد بشنو بیان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278230,
        "vOrder": 44,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اوست معبود و پناه بندگان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278231,
        "vOrder": 45,
        "coupletIndex": 24,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر وجودی راست بر وی احتیاج",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278232,
        "vOrder": 46,
        "coupletIndex": 24,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "او نباشد از وجودی لاعلاج",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278233,
        "vOrder": 47,
        "coupletIndex": 25,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نی نیاز است از وجود غیر خود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278234,
        "vOrder": 48,
        "coupletIndex": 25,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کرد خلق او بر ظهور خیر خود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278235,
        "vOrder": 49,
        "coupletIndex": 26,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیست فوقش آمری و ناهی ای",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278236,
        "vOrder": 50,
        "coupletIndex": 26,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خلق را نه از مشیتش آگاهی ای",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278237,
        "vOrder": 51,
        "coupletIndex": 27,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "باشد از وصفش یکی لا جوف له",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278238,
        "vOrder": 52,
        "coupletIndex": 27,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خورد و خواب آنجا ندارد هیچ ره",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278239,
        "vOrder": 53,
        "coupletIndex": 28,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 26,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یا که من غیر شبیه آمد صمد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278240,
        "vOrder": 54,
        "coupletIndex": 28,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 26,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیست مانندی مر او را در سند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278241,
        "vOrder": 55,
        "coupletIndex": 29,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 27,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نی از او زاید ولد یا هیچ چیز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278242,
        "vOrder": 56,
        "coupletIndex": 29,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 27,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نی ز چیزی گشته او زاییده نیز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278243,
        "vOrder": 57,
        "coupletIndex": 30,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 28,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیست همتایی مر او را هیچ کس",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278244,
        "vOrder": 58,
        "coupletIndex": 30,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 28,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هم نه عقلی را به درکش دسترس",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5278245,
        "vOrder": 59,
        "coupletIndex": 31,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 29,
