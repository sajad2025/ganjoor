        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به چشم عجب و تکبر به کس نگاه مکن",
        "languageId": null,
        "coupletSummary": null
      },
