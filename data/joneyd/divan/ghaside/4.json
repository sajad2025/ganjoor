        "id": 5302598,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز باب او روا الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
