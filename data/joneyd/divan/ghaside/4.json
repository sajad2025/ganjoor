        "id": 5302624,
        "vOrder": 64,
        "coupletIndex": 31,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به هر صبح و مسا الله اکبر",
        "languageId": null,
        "coupletSummary": null
      }
