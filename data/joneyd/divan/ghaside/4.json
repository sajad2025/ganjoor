        "id": 5302605,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "منور کرده اطراف جهان را",
