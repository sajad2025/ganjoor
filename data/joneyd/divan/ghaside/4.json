        "id": 5302608,
        "vOrder": 48,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چراغ اهتدی الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302609,
        "vOrder": 49,
        "coupletIndex": 24,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به بانگ دعوتش جان مرحبا گوی",
        "languageId": null,
        "coupletSummary": null
      },
