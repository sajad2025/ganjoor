        "id": 5302580,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ندارد منتهی الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302581,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تَبارک مَن لَهُ ما فوقَ عرشٍ",
