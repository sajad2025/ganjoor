        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در صدق و صفا الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
