        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "و ما تحتُ الثری الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302583,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تُقدَّس مَن تَحیَّر فی ثَناهُ",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302584,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عقول اولی النهی الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302585,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "الهٌ واحدٌ فردٌ قدیمٌ",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302586,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تمجَّد بالعُلی الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302587,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "علیمٌ قادرٌ حیٌّ حکیمٌ",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302588,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "توحَّد بالبقا الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302589,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تنزّه عن مشارکت البرایا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302590,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وحل عن الورا الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302591,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کریمی کز عطاها رخ نتابد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302592,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به هر جرم و خطا الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302593,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
