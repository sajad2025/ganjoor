        "id": 5302611,
        "vOrder": 51,
        "coupletIndex": 25,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خروش افکنده از مه تا به ماهی",
        "languageId": null,
        "coupletSummary": null
      },
