        "id": 5302618,
        "vOrder": 58,
        "coupletIndex": 28,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "غریو اندر سما الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302619,
        "vOrder": 59,
        "coupletIndex": 29,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زبان مرغ و ماهی ذکر گویش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302620,
        "vOrder": 60,
        "coupletIndex": 29,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در آب و در هوا الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302621,
        "vOrder": 61,
        "coupletIndex": 30,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "(جنید) پرگناه آمد به در گاه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302622,
        "vOrder": 62,
        "coupletIndex": 30,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به عذر ما مضا الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302623,
        "vOrder": 63,
        "coupletIndex": 31,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شده قربان ره تکبیر ایشان",
        "languageId": null,
        "coupletSummary": null
      },
