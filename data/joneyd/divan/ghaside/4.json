        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه مرد بی‌نوا الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
