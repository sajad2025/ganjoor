        "id": 5302604,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زهی فضل و عطا الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
