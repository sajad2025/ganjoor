        "id": 5302616,
        "vOrder": 56,
        "coupletIndex": 27,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نهاده در بها الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302617,
        "vOrder": 57,
        "coupletIndex": 28,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فکنده غلغل تکبیر ایشان",
        "languageId": null,
        "coupletSummary": null
      },
