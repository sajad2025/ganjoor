        "id": 5302610,
        "vOrder": 50,
        "coupletIndex": 24,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هم اندر ابتدا الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
