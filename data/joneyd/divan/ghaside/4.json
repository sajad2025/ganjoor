        "id": 5302606,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به دین مصطفی الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302607,
        "vOrder": 47,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بدو افروخته از نور ایمان",
        "languageId": null,
        "coupletSummary": null
      },
