        "id": 5302615,
        "vOrder": 55,
        "coupletIndex": 27,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خریده مال و تن ز ایشان و جنت",
        "languageId": null,
        "coupletSummary": null
      },
