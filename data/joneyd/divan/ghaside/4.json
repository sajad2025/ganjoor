        "id": 5302612,
        "vOrder": 52,
        "coupletIndex": 25,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صدای این ندا الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302613,
        "vOrder": 53,
        "coupletIndex": 26,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به یاد وعده‌اش مردان غازی",
        "languageId": null,
        "coupletSummary": null
      },
