        "sectionIndex4": null,
        "text": "عقول انبیا الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302571,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "روان اصفیا در حیرت او",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302572,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز فرط کبریا الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302573,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به نور وحدت او گشته روشن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302574,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل هر آشنا الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302575,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حروف کائنات از عرش تا فرش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302576,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ورا خواند ثنا الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302577,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "امور اولین و آخرین را",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302578,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نوشته از قضا الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302579,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
