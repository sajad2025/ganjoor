        "id": 5302614,
        "vOrder": 54,
        "coupletIndex": 26,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "روان کرده فدا الله اکبر",
        "languageId": null,
        "coupletSummary": null
      },
