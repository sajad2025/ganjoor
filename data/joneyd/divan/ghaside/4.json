        "id": 5302603,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همه روزی‌خوران فضل و جودش",
        "languageId": null,
        "coupletSummary": null
      },
