        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که بار منت بیگانه محنتی‌ست عظیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302775,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به تنگ‌دستی و خواری کجا شود قانع",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302776,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کسی که صاحب جاه است و مالک زر و سیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302777,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو انس نیست مرا با کسی در این منزل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302778,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مصاحبی نتوان کرد با دلی به دو نیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302779,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خرابه ایست جهان کآمد از اساس امید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302780,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به هیچ روی نهانی روا نداشت حکیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302781,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حرام بادم اقامت در این نشیمن حور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302782,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرا که خانه مهیاست در جوار حریم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302783,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو دست می‌دهدم با فرشتگان پرواز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302784,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چرا به عشوه شوم پای‌بند دیو رجیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302785,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلم ز بوی وطن راحت آن چنان یابد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302786,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که باد روضه رضوان وزد بر اهل جحیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302787,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "روا بود که به شکرانه جان برافشانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302788,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر آن صباح که آرد سلام دوست نسیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302789,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو جست برق حجازی به کام شام از نجد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302790,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به عزم کعبه مهاجر شوم چو ابراهیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302791,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ندای طور سماع کلام نزدیک است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302792,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که نور وادی ایمن ز دور یافت کلیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302793,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بسی نماند که در بحر عشق غوطه خورم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302794,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شوم مجرد و دور افکنم ز خویش گلیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302795,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به رفق بازدهم قرض و خوش بیاسایم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302796,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که می‌خورم غم بیهوده از برای غریم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302797,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کجاست خصم که می‌دادمش به نحت الزام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302798,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیا که مسئله کردم به طوع خود تسلیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302799,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دمی که با غم عشقش نبوده‌ام هم‌دم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302800,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کنون ز غصه آنم ندم شده‌ست ندیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302801,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل از وفا به کسی ده که در حیات و ممات",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302802,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کند به صورت و معنی وفای تو تقدیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302803,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل شکسته به دست آر کاندر این بازار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302804,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درست نیست تجارت مگر به قلب سلیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302805,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلا مصاحب دون‌همتان مشو زنهار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302806,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هزار بار تو را بیش کرده‌ام تعلیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302807,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز آستین لئیمان بدار دست طمع",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302808,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "امیدوار بنه سر بر آستان کریم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302809,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "الهی از کرم و جود خویش بخش مرا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302810,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که رحمت تو عظیم است و منت تو عظیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302811,
        "vOrder": 47,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به وقت عجز که می‌خوانمت به زاری و سوز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302812,
        "vOrder": 48,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو از دعای منی واقف ای سمیع و علیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302813,
        "vOrder": 49,
        "coupletIndex": 24,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "امیدوار به لطف و کمال و عفو تو‌ام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302814,
        "vOrder": 50,
        "coupletIndex": 24,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که جرم بنده ببخشای ای غفور رحیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302815,
        "vOrder": 51,
        "coupletIndex": 25,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "(جنید) اگر به مثل هم‌عنان ذوالنون است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302816,
        "vOrder": 52,
        "coupletIndex": 25,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تنش خمیده چو دال است و دل‌شکسته چو جیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302817,
        "vOrder": 53,
        "coupletIndex": 26,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مگر به پرتو روشن‌دلان کسی گردد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302818,
        "vOrder": 54,
        "coupletIndex": 26,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که یومش از نظر یک ستاره گشت اویم",
        "languageId": null,
        "coupletSummary": null
      }
    ],
