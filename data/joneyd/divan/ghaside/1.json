        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر سر طور بلای تو هزاران چو کلیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302378,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خسته افتاده و بیمار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302379,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گاه اندیشه کند زهره صدیقان آب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302380,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست مهری تو جگرخوار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302381,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شحنه عدل تو هرکس که دم از خویش زند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302382,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خوارش آویخته از دار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302383,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای بسا خرمن اعمال مطیعان به جویی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302384,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رایگان بر سر بازار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302385,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عرش تا فرش بسوزاند اگر بدرخشد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302386,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لمعه ای از شرر نار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302387,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صدهزاران دل سودازده را جان بر لب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302388,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هردم از حسرت دیدار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302389,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا که در بارگه قرب تو یابد باری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302390,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بارها بر دل ابرار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302391,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در بیابان هوایت ز حرارت شده خشک",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302392,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پوست بر هر تن اصرار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302393,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر که را گوش دلی هست نوای تسبیح",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302394,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شنود از در و دیوار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302395,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر به هر ذره تو را حمد و ثنایی خواندم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302396,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نبود هیچ سزاوار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302397,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این همه نور که بر عالم جان می‌تابد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302398,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یک شعاع است ز انوار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302399,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آسمان سبحه سیار از آن گرداند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302400,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که کند عیش تندکار(؟) تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302401,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست بر او وحدت ذات تو دلیل روشن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302402,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر یک از کوکب سیار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302403,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کس نداند به حقیقت که چه باشد یا چون",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302404,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فوق این گنبد دوار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302405,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کشتی وهم و خرد را همه در هم شکند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302406,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "موجی از قلزم بتار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302407,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هیچ مخلوق کند فکر تصرف هیهات",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302408,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در نهان خانه ستار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302409,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با چنین نور که هر ذره از او دارد فیض",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302410,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هیچ بینا کند انکار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302411,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مشرکان راه ندارند به حضرت ور نه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302412,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کیست کاو نیست طلب‌کار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302413,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی‌سبب خوانی و بی‌واسطه رانی و کسی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302414,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نبود مانع کردار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302415,
        "vOrder": 47,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر که او گشت عزیز تو ز خواری برهید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302416,
        "vOrder": 48,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شوربخت آن که بود خوار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302417,
        "vOrder": 49,
        "coupletIndex": 24,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر که دانا و توانا دگری می‌داند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302418,
        "vOrder": 50,
        "coupletIndex": 24,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خبرش نیست ز تیمار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302419,
        "vOrder": 51,
        "coupletIndex": 25,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صورت آدم از آن روی چنین مطبوع است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302420,
        "vOrder": 52,
        "coupletIndex": 25,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که به صنع است نمودار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302421,
        "vOrder": 53,
        "coupletIndex": 26,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حاش لله که توان کرد به خلقت مانند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302422,
        "vOrder": 54,
        "coupletIndex": 26,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کان محال است در اخبار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302423,
        "vOrder": 55,
        "coupletIndex": 27,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بلبل جان (جنید) از قفس خاکی تن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302424,
        "vOrder": 56,
        "coupletIndex": 27,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌کشد نغمه ای از کار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302425,
        "vOrder": 57,
        "coupletIndex": 28,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فکر او تا به قیامت نکند استحضار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302426,
        "vOrder": 58,
        "coupletIndex": 28,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عدد منت بسیار تو سبحان الله",
        "languageId": null,
        "coupletSummary": null
      }
    ],
