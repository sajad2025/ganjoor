      },
      {
        "id": 5302689,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کور است منزل تو و تابوت و خانه‌ات",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302690,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تدبیر از برای چنین تنگنا بکن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302691,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ناچار جسم و جان تو از هم جدا شود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302692,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در باب این جدایی ترک جدا بکن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302693,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دنیا مشعبدی‌ست دغا باز و مهره‌زرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302694,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رو عرصه برفشان و حذر زین دغا بکن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302695,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در چار سوی کون و مکان وحشت است خیز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302696,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "قطع امید کلی از این خسته جا بکن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302697,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در صومعه به بوی ریا معتکف مباش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302698,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خوش باش ترک صومعه بوی ریا بکن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302699,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بهر ریای خلق بکردی بسی عمل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302700,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آخر خدای را شو و ترک ریا بکن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302701,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا چند لاف مردی و زورآوری زنی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302702,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با نفس خویش در ره دین یک غزا بکن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302703,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ماری‌ست هفت‌سر که تو را یار و هم‌دم است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302704,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مردانه باش و چاره این اژدها بکن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302705,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خواهی که در جهان نفسی مشک‌بو زنی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302706,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خاشاک روبی ره خود چون صبا بکن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302707,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در راه حق یکی بده و هفت‌صد بگیر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302708,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای ساده‌دل معاملتی با خدا بکن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302709,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پنداشت فلسفی که هنرمند و عاقل است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302710,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای بی‌هنر متابعت انبیا بکن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302711,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خواهی که رستگار شوی بگذر از نجات",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302712,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درمان درد چوی(؟) و ترک شفا بکن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302713,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن را که گوش جان به حقایق نهاده‌اند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302714,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گو استماع این سخن دل‌ربا بکن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302715,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یا رب تو واقفی که یکایک به حال خویش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302716,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درمانده‌ایم حاجت هر یک روا بکن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302717,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این نفس خویش‌دشمن بیگانه‌خوی را",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302718,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با ساکنان عالم قدس آشنا بکن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302719,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "غافل مشو (جنید) که وقت اجابت است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5302720,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بردار دست عجز و به زاری دعا بکن",
        "languageId": null,
        "coupletSummary": null
      }
    ],
