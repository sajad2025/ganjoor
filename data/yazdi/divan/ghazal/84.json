        "sectionIndex4": null,
        "text": "یا طایر نیم بسملی بود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4375603,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از دست تو قطره قطره خون شد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر دلی داشتم، از غم فراق تو هر لحظه و به آرامی احساس درد و رنج می‌کردم."
      },
      {
        "id": 4375604,
        "vOrder": 4,
