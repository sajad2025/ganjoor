    "next": {
      "id": 111498,
      "title": "شمارهٔ ۱۴۱",
      "urlSlug": "sh141",
      "excerpt": "گرچه ما از دستبرد دشمنان افتاده‌ایم",
      "mainSections": null
    },
    "previous": {
      "id": 111496,
      "title": "شمارهٔ ۱۳۹",
      "urlSlug": "sh139",
      "excerpt": "ما خِیلِ تُهی‌دست جگرگوشهٔ بختیم",
      "mainSections": null
    },
    "verses": [
      {
        "id": 4376383,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شب چو در بستم و مست از مِیِ نابش کردم",
        "languageId": null,
        "coupletSummary": "شب هنگام، وقتی که در را بستم و تحت تأثیر شراب خالص بودم، اگر ماه در زد، به او پاسخ رد دادم."
      },
      {
        "id": 4376384,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ماه اگر حلقه به در کوفت جوابش کردم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4376385,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیدی آن تُرکِ خَتا دشمن جان بود مرا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو آن ترک زیبا را می‌دیدی که برای من دشمن جان بود، هرچند که من عمری به اشتباه او را دوست نامیدم."
      },
      {
        "id": 4376386,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گرچه عمری به خطا دوست خطابش کردم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4376387,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "منزلِ مردمِ بیگانه چو شد خانهٔ چشم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که خانه و زندگی دیگران به چشمم آمد، آنقدر برایشان گریه و زاری کردم که باعث ویرانی آن مکان شدم."
      },
      {
        "id": 4376388,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنقدر گریه نمودم که خرابش کردم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4376389,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شرحِ داغِ دلِ پروانه چو گفتم با شمع",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که شروع به بیان دردها و احساسات دلشکسته‌ام کردم، شمع که نماد عشق و روشنایی بود، با کلماتی که بر زبان آوردم شعله‌ای در دلش برافروخت و او را به اشک انداخت."
      },
      {
        "id": 4376390,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آتشی در دلش افکندم و آبش کردم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4376391,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "غرقِ خون بود و نمی‌مرد ز حسرت فرهاد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او در دردی عمیق و غمناک غرق شده بود و از حسرت به خود نمی‌پیچید؛ داستان شیرین و فرهاد را خواندم و او را به خواب بردم."
      },
      {
        "id": 4376392,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خواندم افسانهٔ شیرین و به خوابش کردم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4376393,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل که خونابهٔ غم بود و جگرگوشهٔ درد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل من که پر از غم و درد است، به خاطر ستم و بی‌عدالتی تو، به مانند گوشتی روی آتش سوخته شده است."
      },
      {
        "id": 4376394,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر سر آتشِ جورِ تو کبابش کردم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4376395,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زندگی کردن من مردن تدریجی بود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زندگی من به تدریج به سوی مرگ پیش می‌رفت و آنچه از وجودم گرفته می‌شد، عمری به حساب آوردم."
      },
      {
        "id": 4376396,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنچه جان کَنْد تنم، عمر حسابش کردم",
        "languageId": null,
        "coupletSummary": null
      }
    ],
