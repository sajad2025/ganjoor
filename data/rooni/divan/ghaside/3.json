        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در شبان روز گنبد خضرا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4065973,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همه امروزهای دولت تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: همه روزهای خوشی که در زمان حکمرانی تو سپری شده، باید همچنان با فرداها و روزهای آینده ادامه داشته باشد."
      },
