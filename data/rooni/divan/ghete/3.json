    "verses": [
      {
        "id": 4069769,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو سررشته خویش گم کرده ام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من در زندگی خود، راه و مسیرم را گم کرده‌ام و آرزو دارم که یک راهنما در این جهان برایم باشد."
      },
      {
        "id": 4069770,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بعالم یکی رهبرم آرزوست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4069771,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرا خورد یکبارگی غم دریغ",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: حسرت و اندوهی که به یکباره بر من چیره شد، در دنیا فقط آرزو دارم که یکبار دیگر این غم را تجربه کنم."
      },
      {
        "id": 4069772,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به گیتی یکی غم خورم آرزوست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4069773,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بسی داوریها که دارم ولیک",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من قضاوت‌های زیادی دارم، اما تنها آرزویم این است که یک داور عادل داشته باشم."
      },
      {
        "id": 4069774,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یکی دادگر داورم آرزوست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4069775,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زر و زیور من قناعت بس است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ثروت و زیبایی‌های مادی برای من کافی است و دیگر نمی‌خواهم از منافع و آرزوهای بیشتر صحبت کنم."
      },
      {
        "id": 4069776,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نگویم زر و زیورم آرزوست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4069777,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برای عروسان بکر سخن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: برای عروس‌های بی‌تجربه، صحبت و پندهای جدید و نوین از شوهر آرزو می‌شود."
      },
      {
        "id": 4069778,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یکی تازه رو شوهرم آرزوست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4069779,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درین عهد ناخوش که قحط سخاست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در این زمان ناخوش که همه جا کمبود سخن وجود دارد، نمی‌گویم که طلا و نقره آرزوست."
      },
      {
        "id": 4069780,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نگویم که سیم و زرم آرزوست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4069781,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه در خاطر و دل بگردد مرا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در ذهن و دل من دیگر جایی ندارد، زیرا این اسب و آن الاغ آرزوی من هستند."
      },
      {
        "id": 4069782,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که این اسب و آن استرم آرزوست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4069783,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کزین دهر نااهل حاش الوجوه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از این دنیا و زمانه ناسازگار، در گوشه‌ای پنهان نشسته‌ام. آرزو دارم که حتی یک چیز نیک و تازه به دست آورم، چون مثل اسبی خسته و بی‌فایده هستم."
      },
      {
        "id": 4069784,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خری حر که یک نوبرم آرزوست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4069785,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بدین بی بقائی چنین زندگی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به دلیل ناپایدار بودن این زندگی، از دین اسلام دور افتاده‌ام و آرزو دارم که شرایط بهتری برای زندگی‌ام فراهم شود."
      },
      {
