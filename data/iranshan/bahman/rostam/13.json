    "next": {
      "id": 146277,
      "title": "بخش ۱۴ - نامه نوشتن شاه بهمن به آذربرزین",
      "urlSlug": "sh14",
      "excerpt": "جهان چون بپوشید دیبای زرد",
      "mainSections": null
    },
    "previous": {
      "id": 146275,
      "title": "بخش ۱۲ - رفتن برزین آذر به کوه به جستن اژدها و کشتن برزین اژدها را",
      "urlSlug": "sh12",
      "excerpt": "سپهبد ز گفتار او شد دژم",
      "mainSections": null
    },
    "verses": [
      {
        "id": 5297024,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دَرِ گنج بگشاد یزداد گو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297025,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سپه را همی ساز دادند نو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297026,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جو آگاه شد بهمن از کار اوی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297027,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از آن لشکر گُشن و کردار اوی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297028,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در گنج‌های کهن برگشاد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297029,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سپه را بفرمود تا عرض داد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297030,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سپاهش بر آمد سه پنجه هزار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297031,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلیران ایران و خنجرگذار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297032,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پیاده دوره سی هزاران فزون",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297033,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یکایک همه دست شسته به خون",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297034,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو روزی بداد و سپه را بخواند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297035,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همی گرد بر ماه رخشان فشاند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297036,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "براند او ابا لشکر از شهر بلخ",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297037,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز بهر عدو عیش او گشته تلخ",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297038,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چنان بود چون کوه آهن سپاه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297039,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همی رفت با پیل بر ساقه شاه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297040,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو نزد ستخر آمدش پیشرو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297041,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فرو زد سراپرده ای شاه نو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297042,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "میان هر دو را نیم فرسنگ بود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297043,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جهان از سواران کین تنگ بود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297044,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "طلایه برون شد ز هر دو سپاه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297045,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلیران لشکر گرفتند راه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297046,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو خورشید رنگ دلارای زد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297047,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شهنشاه با مهتران رای زد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297048,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که فردا که صف برکشد دو سپاه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297049,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به میدان درآیم به ناوردگاه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297050,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به تنها ز برزین بجویم نبرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297051,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بکوشم که آرم سرش زیر گرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297052,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گمانم که یزدان دهد یاوری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297053,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شود در میان کوته از داوری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297054,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کناره شود خیره خون ریختن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297055,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دو لشکر بماند ز آویختن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297056,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که امروز شد سالیان سی و هشت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297057,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که می خونِ گُردان خورَد ساده دست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297058,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بدو گفت دستور کای شهریار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297059,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همانا نخواهد کسی کارزار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297060,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز دشمن چرا جست باید نبرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297061,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به ویژه که داری تو مردان مرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297062,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مشو بدگمان تو بدین توش خویش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297063,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بگوید خردمند بر کوش خویش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297064,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز گفتار او شاه تندی گرفت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297065,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز خشم آتش دل بلندی گرفت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297066,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بدو گفت برزین نه سنگست و روی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297067,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که از تیغ و زوبین نتابدش روی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297068,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همانا که خونست و باد و دمی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297069,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ستوه آید از رنج و گردد غمی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297070,
        "vOrder": 47,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه گرز من از گرز او کمترست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297071,
        "vOrder": 48,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه او را جز از سر سری دیگرست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297072,
        "vOrder": 49,
        "coupletIndex": 24,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 26,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ببینی که فردا به ناوردگاه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297073,
        "vOrder": 50,
        "coupletIndex": 24,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 26,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چگونه کنم روز برزین سیاه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297074,
        "vOrder": 51,
        "coupletIndex": 25,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 27,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نگشت از دلت مهر آن خانه کم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297075,
        "vOrder": 52,
        "coupletIndex": 25,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 27,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همی بر تن خویش خواهی ستم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297076,
        "vOrder": 53,
        "coupletIndex": 26,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 28,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شد از خشم او مرد دانا خموش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5297077,
        "vOrder": 54,
        "coupletIndex": 26,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 28,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ببستش زبان و بیا کند گوش",
        "languageId": null,
        "coupletSummary": null
      }
    ],
