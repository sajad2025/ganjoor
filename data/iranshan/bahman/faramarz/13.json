        "coupletSummary": null
      },
      {
        "id": 5287540,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وزان پس سپه را ز کشور بخواند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287541,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هم از باختر هم ز خاور بخواند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287542,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زمین بود هفتاد فرسنگ بیش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287543,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که بُد ساخته لشکرش جای خویش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287544,
