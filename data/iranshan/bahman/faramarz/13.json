    "verses": [
      {
        "id": 5287516,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وزان روی زال و فرامرز و سام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287517,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برفتند با شادی و ناز و کام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287518,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به راهش نشستند در نیمروز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287519,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به شب خوردن و روز نخجیر بوز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287520,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز رزم سیوم در گذشتیم نیز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287521,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فرامرز را تنگ شد رستخیز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287522,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یکی داستان یاد دارم ز خویش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287523,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که ناید همی اندر آن کم و بیش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287524,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شنیدم که روزی هم از بامداد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287525,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برآمد ز خاور یکی تیره باد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287526,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جهان را تو گفتی که بر زد بهم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287527,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز سرما و در جانور شد دژم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287528,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سراسر هوا گشت مانند دود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287529,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زمین همچو زندان بیژن نمود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287530,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو خلخال دلبند بربست یار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287531,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دگر زیر گیسوی او گوشوار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287532,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هوا هر گهی پر ز رعد و خروش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287533,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زمین هر زمانی برآمد به جوش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287534,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چنان شد کزان پرده قیرگون",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287535,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گهی آب و گه آتش آمد برون",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287536,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گزارنده این داستان کرد یاد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287537,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که چون باز لشکر به بلخ اوفتاد",
