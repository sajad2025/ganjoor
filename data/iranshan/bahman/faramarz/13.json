        "coupletSummary": null
      },
      {
        "id": 5287539,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همی رزم را کرد شش سال ساز",
