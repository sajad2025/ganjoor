        "coupletSummary": null
      },
      {
        "id": 5287538,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل شاه ایران بجوشید باز",
