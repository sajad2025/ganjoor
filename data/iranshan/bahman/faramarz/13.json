        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شمرده برآمد سه اسبه سوار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287545,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز جنگ‌آوران نهصد و ده هزار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287546,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چنان گشت از انبوهشان شهر بلخ",
