        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز اسبان تازی و برگستوان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287551,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ببخشید چندانک بودش توان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287552,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پس آنگه ز بیرون یکی بزم ساخت",
