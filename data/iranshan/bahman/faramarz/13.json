        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یکی هفته ز آواز چنگ و رباب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287557,
        "vOrder": 42,
