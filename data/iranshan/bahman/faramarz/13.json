        "coupletSummary": null
      },
      {
        "id": 5287553,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که گردون از آن بزم گردن فراخت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5287554,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سران سپه را یکایک بخواند",
