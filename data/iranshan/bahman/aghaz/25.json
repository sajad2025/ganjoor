        "coupletIndex": 24,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 26,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نهانیش داری نمانَد نهان",
