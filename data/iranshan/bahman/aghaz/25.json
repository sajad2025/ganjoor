        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که پاداش آن از تو چونین سزد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5284276,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرا بودی از روزگار نخست",
