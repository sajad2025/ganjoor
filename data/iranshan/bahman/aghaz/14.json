        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که سنگی گران آمد از کوهسار",
        "languageId": null,
        "coupletSummary": null
      },
      {
