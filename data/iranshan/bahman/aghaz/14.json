        "coupletIndex": 27,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 29,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همی گفت کاین خوابِ من گشت راست",
