        "id": 5281829,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پس آهنگِ آن شاهِ رنجور کرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5281830,
        "vOrder": 47,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به خوبی مر او را به بر در گرفت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5281831,
        "vOrder": 48,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیابان گُزید و ره اندر گرفت",
