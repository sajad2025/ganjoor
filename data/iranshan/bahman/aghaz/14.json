        "coupletSummary": null
      },
      {
        "id": 5281824,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چنان دید در خوابِ خوش شهریار",
        "languageId": null,
        "coupletSummary": null
      },
      {
