        "vOrder": 60,
        "coupletIndex": 29,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 31,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خنک آنکه نام نکویی برد",
        "languageId": null,
        "coupletSummary": null
      },
