      {
        "id": 5281839,
        "vOrder": 56,
        "coupletIndex": 27,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 29,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ولیکن چنان رستگاری کراست",
        "languageId": null,
        "coupletSummary": null
      },
