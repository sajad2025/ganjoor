    "verses": [
      {
        "id": 5281784,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همی زخم شد تا بر و گردنش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5281785,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به خاک اندر آمد به ناگه تنش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5281786,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بزد تیغ و زنجیر بُبرید خوار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5281787,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برون رفت با نامور شهریار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5281788,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلیران ز تیغش گریزان شدند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5281789,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو گاهِ خزان برگ‌ریزان شدند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5281790,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو بشکست دروازه و بند را",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5281791,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فرو خوابنید او تنی چند را",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5281792,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برفتند لختی و شب تیره گشت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5281793,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز دیدن همه دیده‌ها خیره گشت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5281794,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جدا گشت از او شاه یزدان‌شناس",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5281795,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به یک راه شاه و به یک راه پارس",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5281796,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پس آمد خبر نزد لؤلؤ که شاه",
