        "vOrder": 59,
        "coupletIndex": 29,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 31,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جهان بی درنگست و هم بگذرد",
