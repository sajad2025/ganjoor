        "id": 5281828,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بزد پر و آن سنگ را دور کرد",
        "languageId": null,
        "coupletSummary": null
