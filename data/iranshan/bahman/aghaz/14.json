        "coupletSummary": null
      },
      {
        "id": 5281797,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رها گشت و گشتست رویین تباه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5281798,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از آن بزم برخاست بانگ و خروش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5281799,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل و مغز لؤلؤ برآمد به جوش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5281800,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همه بر نشستند و بشتافتند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5281801,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به هر راه لشکر همی تافتند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5281802,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سوارِ جهان نامدار اردشیر",
