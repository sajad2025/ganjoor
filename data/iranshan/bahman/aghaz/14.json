        "coupletSummary": null
      },
      {
        "id": 5281845,
        "vOrder": 62,
        "coupletIndex": 30,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 32,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه آنکس که شصتش نبد روزگار",
