        "coupletIndex": 28,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 30,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پس آنگه اگر مُردمی گو بمیر",
