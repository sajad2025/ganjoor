        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گرفت آن همه رخت‌ها زیر سر",
        "languageId": null,
        "coupletSummary": null
