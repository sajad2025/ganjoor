        "vOrder": 65,
        "coupletIndex": 32,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 34,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همانگاه بر بارگی برنشست",
