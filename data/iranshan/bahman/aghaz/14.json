        "id": 5281827,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یکی مرغ تیز از هوا بر پرید",
        "languageId": null,
        "coupletSummary": null
