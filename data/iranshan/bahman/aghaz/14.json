        "coupletIndex": 26,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 28,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل خویش خوش کرد بهمن به مرگ",
