        "coupletSummary": null
      },
      {
        "id": 5281808,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بدان تیرگی پیش بهمن گرفت",
