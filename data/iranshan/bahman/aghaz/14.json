        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که دشمن بُدی شاه را خیر خیر",
