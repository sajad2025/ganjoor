        "vOrder": 61,
        "coupletIndex": 30,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 32,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه آنکس که بگذاشت سالی هزار",
