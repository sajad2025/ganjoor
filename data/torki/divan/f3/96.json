        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اصغرم ای عمه جان! چو سایر شبها",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عمه جان، من امشب مانند شب‌های دیگر هستم و احساس اضطراب نمی‌کنم."
      },
      {
        "id": 5052964,
        "vOrder": 6,
