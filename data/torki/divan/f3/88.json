        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بگو در کربلا در خون کشیدند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در کربلا، گل‌های زیبا و درختان با شکوه را در خون غرق کردند."
      },
      {
        "id": 5052772,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نهال سنبل و، سرو سمن را",
        "languageId": null,
        "coupletSummary": null
      },
      {
