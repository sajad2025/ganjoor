        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حسین آن شاه بی غسل و کفن را",
        "languageId": null,
        "coupletSummary": null
      },
      {
