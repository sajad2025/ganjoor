        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که افسردند یاس ویاسمن را»",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5052769,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز من باد صبا از راه یاری",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از من، باد صبا بگذر و پیام پرندگان باغ را به یاری برسان."
      },
      {
        "id": 5052770,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رسان پیغام مرغان چمن را",
        "languageId": null,
        "coupletSummary": null
      },
      {
