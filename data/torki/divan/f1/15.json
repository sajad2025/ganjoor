        "text": "نخجیر کن آهوان صحرا را",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5046122,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یک لحظه کنار چشم من بنشین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر یک لحظه کنار چشم من بنشینی، می‌توانی زیبایی و تحولی را که در دل من موج می‌زند، ببینی."
      },
