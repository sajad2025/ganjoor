        "sectionIndex4": null,
        "text": "چشم تو به یک کرشمه ای یارا!",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چشم تو با یک حرکت جلب توجه، همه‌ی قدرت و تحمل ما را از ما گرفت."
      },
      {
        "id": 5046113,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بربود زدست، طاقت ما را",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5046114,
        "vOrder": 3,
