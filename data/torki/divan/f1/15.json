        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یک روز کمند زلف خود بگشا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: یک روز دسته‌های موهای خود را آزاد کن و با آن به شکار آهوهای صحرا بپرداز."
      },
      {
        "id": 5046121,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
