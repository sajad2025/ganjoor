        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اسکندر با یک نگاه طعنه‌آمیزش می‌تواند سپاه دارا را شکست دهد."
      },
      {
        "id": 5046125,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
