        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در دندان صاف رخشانت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دندان‌های سفید و صاف تو از لطافت، مانند درختان از عمان زیباست."
      },
      {
        "id": 5047917,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از لطافت ز در عمان به",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5047918,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
