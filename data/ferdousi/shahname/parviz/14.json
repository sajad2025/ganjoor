      },
      {
        "id": 2030144,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که بهرام شاهست و پیروزبخت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بهرام شاه، فردی پیروز و خوشبخت است که شایسته دریافت تاج و نشستن بر تخت زیبا می‌باشد."
      },
      {
        "id": 2030145,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سزاوار تاج است و زیبای تخت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2030146,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نجوید جز از راستی درجهان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در زندگی تنها از حقیقت و صداقت طلب کن، چه در حضور دیگران و چه در خفا و پنهانی."
      },
      {
        "id": 2030147,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه در آشکار و چه اندر نهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2030148,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نوشته شد آن شمع برداشتند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آن شمع خاموش شد و در شب تاریک، افکار و اندیشه‌ها را به جا گذاشتند."
      },
      {
        "id": 2030149,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شب تیره باندیشه بگذاشتند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2030150,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو پنهان شد آن چادر لاژورد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که چادر لاجوردی از دید پنهان شود، جهان از دیدن خورشید زرد محروم می‌شود."
      },
      {
        "id": 2030151,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جهان شد ز دیدار خورشید زرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2030152,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیامد یکی مرد پیروزبخت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مردی خوش شانس و پیروز وارد شد و در ایوان کاخی به نام بهرام، تختی قرار داد."
      },
      {
        "id": 2030153,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نهاد اندر ایوان بهرام تخت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2030154,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برفتند ایوان شاهی چو عاج",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ایوان شاهی از بین رفت و تاج را مانند عاج از برکت آن مکان آویزان کردند."
      },
      {
        "id": 2030126,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیاویختند از برگاه تاج",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2030140,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برتخت زرین یکی زیرگاه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بر روی تخت زرین، یکی زیرپایی گذاشتند و سپس راه را برای رفتن باز کردند."
      },
      {
        "id": 2030125,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نهادند و پس برگشادند راه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2030108,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نشست از بر تخت بهرامشاه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آن کیانی که کلاه را بر سر گذاشت، از روی تخت بهرامشاه پایین آمد."
      },
      {
        "id": 2030095,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به سر برنهاد آن کیانی کلاه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2030096,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دبیرش بیاورد عهد کیان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دبیر (نویسنده) به همراه قرارداد و نوشته‌ای از دوران کهن، پارچه‌ای گرانبها و زیبا از جنس پرنیان را به نمایش می‌آورد."
      },
      {
        "id": 2030097,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نوشته بران پربها پرنیان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2030098,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گوایی نوشتند یکسر مهان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در این شعر بیان می‌شود که بهرام به عنوان پادشاهی بزرگ و محترم شناخته شده است و دیگران به خاطر او به احترام و ستایشش قدم پیش گذاشته‌اند."
      },
      {
        "id": 2030099,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که بهرام شد شهریار جهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2030100,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بران نامه چون نام کردند یاد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی نامه‌ای را نوشتند و نامی از آن یاد کردند، یکی از آن‌ها بر روی نامه یک مهر زرین گذاشت."
      },
      {
        "id": 2030101,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بروبر یکی مهر زرین نهاد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2030102,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چنین گفت کاین پادشاهی مراست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او گفت که این پادشاهی متعلق به من است و خداوند پاک، گواهی بر این موضوع دارد."
      },
      {
        "id": 2030103,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بدین بر شما پاک یزدان گواست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2030104,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چنین هم بماناد سالی هزار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این جمله به این معناست که به مدت هزار سال، چیزی باقی خواهد ماند که از نسل من و به عنوان یک فرمانروا و پادشاه به یادگار مانده است."
      },
      {
        "id": 2030105,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که از تخمهٔ من بود شهریار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2030106,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پسر بر پسر هم چنین ارجمند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: فرزند بر فرزند دیگر نیز باید به همان اندازه با ارزش و محترم بماند، همان‌طور که با تاج و تخت بزرگ."
      },
      {
        "id": 2030107,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بماناد با تاج و تخت بلند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2030109,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بآذر مه اندر بد و روز هور",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در آتش سوزان و در نور خورشید، آنچه از شیر داغ روی خاکستر به وجود آمده است، نهفته است."
      },
      {
        "id": 2030123,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که از شیر پردخته شد پشت گور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2030110,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چنین گفت زان پس بایرانیان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: پس از آن، او به ایرانیان گفت که نزاع و دشمنی از میان برداشت شده است."
      },
      {
        "id": 2030111,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که برخاست پرخاش و کین از میان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2030112,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کسی کوبرین نیست همداستان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر کسی در یک مسیر درست یا نادرست با تو هم‌نظر نباشد، به این معنی نیست که خودت هم باید همیشه در مسیر ناخن به‌دست یا غیرمنطقی باشی."
      },
      {
        "id": 2030113,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر کژ باشید اگر راستان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2030114,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به ایران مباشید بیش از سه روز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در ایران بیشتر از سه روز نمانید، زیرا زندگی در اینجا با مشکلات و سختی‌هایی همراه است."
      },
      {
        "id": 2030115,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چهارم چو از چرخ گیتی فروز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2030116,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر آید همه نزد خسرو شوید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: همه به نزد پادشاه بیایید و بر این سرزمین و فراتر از آن، سر و صدا نکنید."
      },
      {
        "id": 2030117,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برین بوم و بر بیش ازین مغنوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2030118,
        "vOrder": 47,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه از دل برو خواندند آفرین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نه به خاطر دل بیرون رفته از تو، بلکه به خاطر اینکه مبادا زمین تو را فراموش کند، به تو مدح و ستایش می‌کنند."
      },
      {
        "id": 2030119,
        "vOrder": 48,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که پردخته از تو مبادا زمین",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2030120,
        "vOrder": 49,
        "coupletIndex": 24,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 26,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هرآنکس که با شاه پیوسته بود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر کسی که با پادشاه در ارتباط بود، در عمق دلش از این سلطنت خسته و ناامید بود."
      },
      {
        "id": 2030121,
        "vOrder": 50,
        "coupletIndex": 24,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 26,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بران پادشاهی دلش خسته بود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2030122,
        "vOrder": 51,
        "coupletIndex": 25,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 27,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برفتند زان بوم تا مرز روم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از آن سرزمین تا مرز روم پراکنده شدند و از دیاری آباد دور شدند."
      },
      {
        "id": 2030220,
        "vOrder": 52,
        "coupletIndex": 25,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 27,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پراگنده گشتند ز آباد بوم",
        "languageId": null,
        "coupletSummary": null
      }
    ],
