    "verses": [
      {
        "id": 1942499,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چراغ اَست مَر تیره شَب را بَسیچ",
        "languageId": null,
        "coupletSummary": "ماه همچون چراغی است که شب تاریک را روشن می‌کند. شاعر در ادامه توصیه می‌کند که از انجام کار بد تا حد ممکن دوری کن."
      },
      {
        "id": 1942500,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به بَد تا تَوانی تو هَرگز مَپیچ",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1942501,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو سی روز گردش بپیمایَدا",
        "languageId": null,
        "coupletSummary": "وقتی ماه چرخهٔ کامل خود را طی کند (در طول سی روز)، جهان تیره و تاریک به واسطهٔ آن روشن می‌شود."
      },
      {
        "id": 1942502,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شَوَد تیره گیتی بِدو روشَنا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1942503,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پَدید آید آنگاه باریک و زَرد",
        "languageId": null,
        "coupletSummary": "سپس ماه به صورت باریک و زرد رنگ پدیدار می‌شود، مانند پشت خمیدهٔ کسی که از غم عشق رنج می‌برد."
      },
      {
        "id": 1942504,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو پُشتِ کسی کو غَمِ عشق خْوَرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1942505,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو بیننده دیدارش اَز دور دید",
        "languageId": null,
        "coupletSummary": "وقتی کسی ماه را از دور ببیند، خیلی زود ناپدید می‌شود، زیرا به سرعت کوچک و کم‌نور می‌شود."
      },
      {
        "id": 1942506,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هَم اَندَر زَمان او شَوَد ناپَدید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1942507,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دِگَر شَب نمایش کُنَد بیش‌تَر",
        "languageId": null,
        "coupletSummary": "شب بعد، ماه بیشتر نمایان می‌شود و نور بیشتری به تو می‌بخشد."
      },
      {
        "id": 1942509,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو را روشَنایی دَهَد بیش‌تَر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1942538,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به دو هَفته گَردَد تَمام و دُرُست",
        "languageId": null,
        "coupletSummary": "پس از دو هفته، ماه کامل و تمام می‌شود و به حالت اولیه‌اش برمی‌گردد."
      },
      {
        "id": 1942539,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بِدان باز گَردَد که بود از نُخُست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1942565,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بُوَد هَر شَبانگاه باریک‌تَر",
        "languageId": null,
        "coupletSummary": "هر شب ماه باریک‌تر می‌شود و به خورشید درخشان نزدیک‌تر می‌گردد."
      },
      {
        "id": 1942568,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به خورشیدِ تابَنده نَزدیک‌تَر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1942569,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بِدینسان نَهادَش خداوندِ داد",
        "languageId": null,
        "coupletSummary": "خداوند طبیعت ماه را این‌گونه قرار داده است؛ و از ابتدای آفرینش، همیشه این نظم برای ماه وجود داشته است."
      },
      {
        "id": 1942570,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بُوَد تا بُوَد هَم بِدین یِک نَهاد",
        "languageId": null,
