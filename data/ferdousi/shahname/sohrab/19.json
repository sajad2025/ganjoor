        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به کاووس یکسر پیامش بداد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1956311,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بدو گفت کاووس کز انجمن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کاووس به او گفت که اگر از این جمع زنده بماند، همانند یک پهلوان خواهد بود."
      },
      {
        "id": 1956326,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر زنده ماند چنان پیلتن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1956312,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شود پشت رستم به نیرو ترا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بدون شک، اگر به قدرت رستم پشت‌کنید، به آسانی می‌توانید مرا نابود کنید."
      },
      {
        "id": 1956313,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هلاک آورد بی‌گمانی مرا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1956314,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر یک زمان زو به من بد رسد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر یک بار به من آسیب برسد، جز به بدی نمی‌توانم پاداش او را بدهم."
      },
      {
        "id": 1956315,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نسازیم پاداش او جز به بد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1956316,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کجا گنجد او در جهان فراخ",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آیا می‌توان او را در این دنیای وسیع جا داد، در حالی که به آن همه زیبایی و عظمتش اشاره می‌شود؟"
      },
      {
        "id": 1956317,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بدان فر و آن برز و آن یال و شاخ",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1956318,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شنیدی که او گفت کاووس کیست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او می‌گوید که اگر کاووس، پادشاه است، پس طوس که هست؟"
      },
      {
        "id": 1956319,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر او شهریارست پس طوس کیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1956320,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کجا باشد او پیش تختم به پای",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او کجا می‌تواند باشد در برابر تخت من، در حالی که کجا می‌تواند او را زیر فرش سلطنتی بیاندازد؟"
      },
      {
        "id": 1956321,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کجا راند او زیر فر همای",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1956322,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو بشنید گودرز برگشت زود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی گودرز حرف‌ها را شنید، سریعاً برگشت و به سمت رستم رفت، طوری که به نظر می‌رسید مانند دودی به او نزدیک می‌شود."
      },
      {
        "id": 1956323,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر رستم آمد به کردار دود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1956324,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بدو گفت خوی بد شهریار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او به او گفت: ای پادشاه، خصلت ناپسند مانند درختی است که همیشه بی‌ثمر و بی‌فایده می‌ماند."
      },
      {
        "id": 1956325,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درختیست خنگی همیشه به بار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1956295,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ترا رفت باید به نزدیک او",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: باید برای او بروی و جان تاریکش را روشن کنی."
      },
      {
        "id": 1956294,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درفشان کنی جان تاریک او",
        "languageId": null,
        "coupletSummary": null
      }
