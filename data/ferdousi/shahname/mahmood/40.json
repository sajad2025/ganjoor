        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز بهر سپهبد گو پیلتن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به خاطر فرمانده، بگو که پهلوان در هر جمعی به خاطر مردانگی‌اش ستوده شده است."
      },
      {
        "id": 1987236,
        "vOrder": 6,
