      },
      {
        "id": 1987232,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیاورد قرطاس و مشک و عبیر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1987233,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نبشتند عهدی ز شاه زمین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در زمان قدیم، قراردادی نوشته شد که به عظمت و شکوه کیخسرو، شاه زمین، اشاره داشت و او را به عنوان فردی پاک‌دین و نیکوکار توصیف می‌کرد."
      },
      {
        "id": 1987234,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سرافراز کیخسرو پاک‌دین",
        "languageId": null,
        "coupletSummary": null
      },
      {
