        "id": 1987237,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که او باشد اندر جهان پیشرو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او باید در جهان، رهبر، هوشیار و سرآمد باشد."
      },
      {
        "id": 1987238,
        "vOrder": 8,
        "coupletIndex": 3,
