      {
        "id": 113119,
        "authorName": "جهن یزداد",
        "authorUrl": null,
        "commentDate": "2023-11-07T13:06:25.3957803",
        "htmlComment": "<p><br /><br />چپ و راست&nbsp; را&nbsp; هر دو بال سپاه<br />بیاراست یکسر چو بایست شاه<br />زمین شد بکردار کشتی بر آب<br />&nbsp;تو گویی سوی جنگ دارد شتاب<br />جای &laquo; چپ و راست&nbsp; را هر دوبال سپاه&raquo;&nbsp;&nbsp; قلب و جناح سپاه&nbsp; کرده اند<br />&nbsp;هر دو بال در چپ و راست است و نه قلب و جناح<br />بنگرید سروده ای به این زیبایی را چگونه با&nbsp; قلب و جناح نابود کرده اند<br /><br />جای جنگ غرق امده<br />نه دستنویس خالقی جنگ اورده اند باز خالقی انرا غرق کرده ایا هیچ&nbsp; کشتی یا لشکری بدنبال غرق شدن&nbsp; است؟<br /></p>",
        "publishStatus": "",
