      },
      {
        "id": 1945648,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خروشان و جوشان و پیلان دمان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1945660,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یکی بزمگاه‌ست گفتی به‌جای",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گویی جایگاه جشن و شادی است، به جای صدای شیپور و ناله، ساز نای به گوش می‌رسد."
      },
      {
        "id": 1945649,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز شیپور و نالیدن کره نای",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1945650,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برفتند از جای یکسر چو کوه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: همه آن‌ها به یکباره از جا خارج شدند، مانند کوهی که از زمین سر برآورده باشد، و از هر دو طرف گروهی به حرکت درآمدند."
      },
      {
        "id": 1945651,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دهاده برآمد ز هر دو گروه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1945652,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیابان چو دریای خون شد درست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی بیابان به مانند دریای خون تبدیل شد، تو به درستی گفتی که در این زمین گلی به نام لاله شکوفا شده است."
      },
      {
        "id": 1945653,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو گفتی که روی زمین لاله رست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1945654,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پی ژنده پیلان به خون اندرون",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در مسیری که فیل‌های ضعیف و ناتوان گام برمی‌دارند، خونریزی وجود دارد، همان‌طور که اگر از جاده بیفتند، ستون‌ها را در آنجا نمی‌توان یافت."
      },
      {
        "id": 1945655,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چنان چون ز بیجاده باشد ستون",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1945656,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همه چیرگی با منوچهر بود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: منوچهر فرمانروایی بود که با قدرت و نفوذش، دل‌ها و ذهن‌های مردم را پر از عشق و محبت کرد."
      },
      {
        "id": 1945657,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کزو مغز گیتی پر از مهر بود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1945658,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چنین تا شب تیره سر بر کشید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تا شب تار فرا رسید، خورشید درخشان به آرامی ناپدید شد."
      },
      {
        "id": 1945659,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درخشنده خورشید شد ناپدید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1945579,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زمانه به یک سان ندارد درنگ",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زندگی هیچگاه ثابت و یکسان نیست؛ گاهی شیرین و لذیذ است و گاهی تلخ و آزاردهنده."
      },
      {
        "id": 1945633,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گهی شهد و نوش است و گاهی شرنگ",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1945578,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل تور و سلم اندر آمد به‌جوش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل از شوق و هیجان به تپش درآمد و به تماشای یک حمله ناگهانی و غیرمنتظره گوش فرا دادند."
      },
      {
        "id": 1945521,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به راه شبیخون نهادند گوش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1945496,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو شب روز شد کس نیامد به جنگ",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی شب به روز تبدیل شد، هیچ‌کس به میدان نبرد نیامد و دو حریف درنگی کردند و ساز جنگ را آماده کردند."
      },
      {
        "id": 1945497,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دو جنگی گرفتند ساز درنگ",
        "languageId": null,
        "coupletSummary": null
      }
    ],
