      },
      {
        "id": 2006750,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلت برگسل زین سرای کهن",
        "languageId": null,
        "coupletSummary": null
      },
      {
