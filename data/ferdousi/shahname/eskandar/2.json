      },
      {
        "id": 2001867,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نوشتم یکی نامه‌ای پیش ازین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نامه‌ای را که قبل از این نوشته‌ام، در آن از دردها و مشکلات بیشتری سخن گفته‌ام."
      },
      {
        "id": 2001854,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نوشته درو دردها بیش ازین",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001880,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو جفت ترا روز برگشته شد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که روز جفت تو تغییر کرد، یکی از بنده‌ها بر زمین افتاد و کشته شد."
      },
      {
        "id": 2001879,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به دست یکی بنده‌بر کشته شد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001878,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر آیین شاهان کفن ساختم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من برای بزرگداشت شاهان لباس مرگ تهیه کردم و از این دنیا به طرز تندی کوچ کردم."
      },
      {
        "id": 2001877,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ورا زین جهان تیز پرداختم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001876,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بسی آشتی خواستم پیش جنگ",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بسیاری از اوقات تلاش کردم که به صلح و آرامش برسم، اما وقتی جنگ در پیش بود، صلح به تأخیر افتاد."
      },
      {
        "id": 2001875,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نکرد آشتی چون نبودش درنگ",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001874,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز خونش بپیچید هم دشمنش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عزت و شرف او باعث شد که دشمنانش نتوانند به او آسیب بزنند و او را به مقام والایی برسانند."
      },
      {
        "id": 2001873,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به مینو رساناد یزدان تنش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001872,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیابد کسی چاره از چنگ مرگ",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هیچکس نه می‌تواند از چنگال مرگ فرار کند، چون مرگ مانند باد پاییز است و ما همچون برگ‌هایی هستیم که از درختان می‌ریزد."
      },
      {
        "id": 2001871,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو باد خزانست و ما همچو برگ",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001870,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جهان یکسر اکنون به پیش شماست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: جهان به طور کامل اکنون در مقابل شما قرار دارد و داراها (افراد ثروتمند) هم حاوی نکته‌ها و درس‌های زیادی هستند."
      },
      {
        "id": 2001869,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر اندرز دارا فراوان گواست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001881,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که او روشنک را به من داد و گفت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او روشنک را به من سپرد و گفت که باید تو او را در پنهان نگاه داری."
      },
      {
        "id": 2001868,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که چون او بباید ترا در نهفت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001866,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کنون با پرستنده و دایگان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اکنون با شخصی که به خوبی از دیگران مراقبت می‌کند و دایگان، بزرگان و فرهیختگان از ایران همراه هستند."
      },
      {
        "id": 2001865,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از ایران بزرگان پرمایگان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001864,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فرستید زودش به نزدیک من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بسرعت او را به سمت من بفرستید تا شاید بتوانم تاریکی جانم را برطرف کنم."
      },
      {
        "id": 2001863,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زداید مگر جان تاریک من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001862,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بدارید چون پیش بود اصفهان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر جا که باشید، وقتی اصفهان پیش رویتان است، کاردانان و حرفه‌ای‌ها از همه جا در آنجا پراکنده‌اند."
      },
      {
        "id": 2001861,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز هر سو پراگنده کارآگهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001860,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همه کارداران با شرم و داد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: همه مسئولان با احساس شرم و عدالت در تلاش هستند که با اهتمام و توانمندی خود به وظایفشان رسیدگی کنند."
      },
      {
        "id": 2001859,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که دارای دارابشان کار داد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001858,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وز آنجا نخواهید فرمان رواست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از آنجا که شما قدرت و اختیار دارید، تمام آنچه در شهرهای ایران است تحت فرمان شماست."
      },
      {
        "id": 2001857,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همه شهر ایران پیش شماست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001856,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل خویش را پر مدارا کنید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل خود را با مهربانی پر کنید و در این دنیا برای من نام و شهرتی به دست آورید."
      },
      {
        "id": 2001855,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرا در جهان نام دارا کنید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001824,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سوی روشنک همچنین نامه‌ای",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به سمت روشنک، نامه‌ای از شاه جهان‌دار خودکامۀ خود فرستاده شده است."
      },
      {
        "id": 2001852,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز شاه جهاندار خودکامه‌ای",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001823,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نخست آفرین کرد بر کردگار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اولین کارش سپاسگزاری از خالق و فرمانروای جهان، که دانا و پرورش‌دهنده است."
      },
      {
        "id": 2001792,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جهاندار و دانا و پروردگار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001790,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دگر گفت کز گوهر پادشا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او گفت که از گنجینهٔ پادشاه تنها انسان‌های پاک و نیکو زاده می‌شوند."
      },
      {
        "id": 2001789,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نزاید مگر مردم پارسا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001788,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلارای با نام و با رای و شرم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: صحبت کردن با کسی که هم نامش معروف است و هم عقایدش مورد احترام، کار پسندیده‌ای است و صدای او هم دلنشین و نرم است."
      },
      {
        "id": 2001787,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سخن گفتن خوب و آوای نرم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001786,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پدر مر ترا پیش ما را سپرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: پدر تو را به ما سپرد و بعد از آن، از دنیا رفت و به یاد او، نام نیکش در خاطرها باقی ماند."
      },
      {
        "id": 2001785,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وزان پس شد و نام نیکی ببرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001784,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو آیی شبستان و مشکوی من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی به خوابگاه من بیایی، در آنجا گنجینه‌ای از زیبایی و شگفتی را خواهی دید که تو نیز جستجوگر جهانی بهتر خواهی شد."
      },
      {
        "id": 2001783,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ببینی تو باشی جهانجوی من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001782,
        "vOrder": 47,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سر بانوانی و زیبای تاج",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زیبا و باوقار همچون تاجی درخشان بر سر بانوان، نمایانگر ارزش و ناز از یار و تختی از عاج است."
      },
      {
        "id": 2001781,
        "vOrder": 48,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فروزندهٔ یاره و تخت عاج",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001780,
        "vOrder": 49,
        "coupletIndex": 24,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 26,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نوشتیم نامه بر مادرت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما نامه‌ای به مادرت نوشتیم تا تو را به ما بفرستد."
      },
      {
        "id": 2001779,
        "vOrder": 50,
        "coupletIndex": 24,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 26,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که ایدر فرستد ترا در خورت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001791,
        "vOrder": 51,
        "coupletIndex": 25,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 27,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به آیین فرزند شاهنشهان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به سبک و روش فرزند پادشاهان، به جلو می‌روند و در درون، موبد اصفهان حضور دارد."
      },
      {
        "id": 2001778,
        "vOrder": 52,
        "coupletIndex": 25,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 27,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به پیش اندرون موبد اصفهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2001776,
        "vOrder": 53,
        "coupletIndex": 26,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 28,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پرستنده و تاج شاهان و مهد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این جمله به این معناست که پرستش کننده یا کسی که به نوعی محبوب و مورد احترام است، در واقع به قوم و قبیله‌ای تعلق دارد که بانی و مهد آن است. همچنین اشاره‌ای دارد به اینکه شیر و شهد، که نمادهای نعمت و برکت هستند، از این مهد و سرچشمه به دست آمده‌اند. به نوعی می‌توان گفت که ارزش‌ها و نعمت‌ها از یک منبع و مرکز خاص سرچشمه می‌گیرند."
      },
      {
        "id": 2001775,
        "vOrder": 54,
        "coupletIndex": 26,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 28,
        "sectionIndex3": null,
        "sectionIndex4": null,
