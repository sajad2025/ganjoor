        "coupletSummary": null
      },
      {
        "id": 1947639,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یکی سرو دید از برش گرد ماه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: یک درخت سرو را دید که در کنار او، ماه زیبا و درخشان، عطر دل‌انگیزی را به سر کلاهی که بر سر دارد، می‌پاشد."
      },
      {
        "id": 1947638,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نهاده ز عنبر به سر بر کلاه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1947637,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به دیبا و گوهر بیاراسته",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به پارچه‌ای زیبا و جواهرات آراسته‌ای، مانند بهشتی پر از آرزوها و خواسته‌ها."
      },
      {
        "id": 1947636,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به سان بهشتی پر از خواسته",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1947635,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بپرسید سیندخت مهراب را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: سیندخت از مهراب درباره خوشاب پرسید و او هم درباره عناب توضیحاتی داد."
      },
      {
        "id": 1947634,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز خوشاب بگشاد عناب را",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1947633,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که چون رفتی امروز و چون آمدی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که امروز رفتی و وقتی که برگشتی، ای کاش مدت زمان کم‌تری از تو دور باشم."
      },
      {
        "id": 1947632,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که کوتاه باد از تو دست بدی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1947631,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه مردست این پیر سر پور سام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این مرد پیر که از نسل سام است، چه شخصی است! او در حالتی است که به یاد تخت و قدرت خود می‌افتد، حتی اگر در شرایط سختی قرار داشته باشد."
      },
      {
        "id": 1947680,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همی تخت یاد آیدش گر کنام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1947706,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خوی مردمی هیچ دارد همی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: انسان باید ویژگی‌های خوب و ارزشمند را از افراد بزرگ و نامدار بگیرد و به خود بپروراند."
      },
      {
        "id": 1947707,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پی نامداران سپارد همی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1947708,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چنین داد مهراب پاسخ بدوی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مهراب به بدوی جواب داد که ای سرو زیبا، همچون ماهی که بر روی آسمان می‌درخشد."
      },
      {
        "id": 1947782,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که ای سرو سیمین بر ماه روی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1947781,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به گیتی در از پهلوانان گرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در دنیا هیچکس نمی‌تواند زال زر را به تنهایی بر رقبایش پیروز کند، زیرا او از پهلوانان بزرگ است."
      },
      {
        "id": 1947780,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پی زال زر کس نیارد سپرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1947779,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو دست و عنانش بر ایوان نگار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر دست و مهار او را بر ایوان زیبایی نبینی، باید گفت که مانند او سوارکاری وجود ندارد."
      },
      {
        "id": 1947778,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نبینی نه بر زین چون او یک سوار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1947777,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل شیر نر دارد و زور پیل",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او دلش جرات و شجاعت شیر را دارد و قدرتش به اندازه‌ی نیروی پلنگ است، دستانش همچون دریای نیل قوی و بزرگ هستند."
      },
      {
        "id": 1947776,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دو دستش به کردار دریای نیل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1947775,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو بر گاه باشد در افشان بود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هرگاه در میدان جنگ باشد، سرها به اوج می‌رود و همچون ستاره‌ها درخشان می‌شود."
      },
      {
        "id": 1947774,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو در جنگ باشد سر افشان بود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1947773,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رخش پژمرانندهٔ ارغوان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: شکوه و زیبایی صورتش مانند گل‌های جوان و تازه‌رسیده است؛ او سرزنده و خوشبخت است."
      },
      {
        "id": 1947783,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جوان سال و بیدار و بختش جوان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1947772,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به کین اندرون چون نهنگ بلاست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در دل انسان همچون نهنگی که در دریا می‌غلتد، خشم و کینه‌ای نهفته است و در درون او، توانایی‌ها و قدرتی مانند دندان‌های تیز اژدها وجود دارد."
      },
      {
        "id": 1947770,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به زین اندرون تیز چنگ اژدهاست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1947769,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نشانندهٔ خاک در کین به خون",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این جمله به تصویر کشیدن وضعیتی است که نشان می‌دهد در شرایطی پرتنش و خونین، اثرات و نشانه‌های آن بر روی خاک نمایان می‌شود. نیازی نیست مشخص شود که این اتفاق به چه دلیلی رخ داده، اما تلاش برای فهمیدن واقعیت تلخی که بین دو طرف وجود دارد، به وضوح احساس می‌شود."
      },
      {
        "id": 1947768,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فشانندهٔ خنجر آبگون",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1947767,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از آهو همان کش سپیدست موی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: افراد مغرض و عیب‌جو، از دیگران به‌خصوص کسانی که ظاهری زیبا دارند، انتقاد می‌کنند و به خیال خود عیوب آن‌ها را می‌نمایانند."
      },
      {
        "id": 1947766,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بگوید سخن مردم عیب جوی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1947765,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سپیدی مویش بزیبد همی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: سفیدی موی او زیبا به نظر می‌رسد و به نظر می‌رسد که دل‌ها را هم فریب می‌دهد."
      },
      {
        "id": 1947764,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو گویی که دلها فریبد همی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1947763,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو بشنید رودابه آن گفت‌گوی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی رودابه این صحبت‌ها را شنید، ناراحت و غمگین شد و چهره‌اش مانند گل سرخ، سرخ و داغ شد."
      },
      {
        "id": 1947762,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برافروخت و گلنارگون کرد روی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1947761,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلش گشت پرآتش از مهر زال",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل او از عشق زال پر از آتش شد و به همین خاطر از او دوری جست و به شدت ناراحت و بی‌قرار گشت."
      },
      {
        "id": 1947771,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از او دور شد خورد و آرام و هال",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 1947785,
        "vOrder": 47,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو بگرفت جای خرد آرزوی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که عقل و تفکر در جایی محدود شود، آرزوها و خواسته‌ها به شکل دیگری نمایان می‌شوند و بر اساس نظر و روش‌های جدیدی شکل می‌گیرند."
      },
      {
        "id": 1947797,
        "vOrder": 48,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دگر شد به رای و به آیین و خوی",
        "languageId": null,
        "coupletSummary": null
      }
    ],
