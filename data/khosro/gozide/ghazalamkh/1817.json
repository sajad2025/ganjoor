      {
        "id": 3173556,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عشقی که نه جان دهند در وی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عشقی که در آن جان فدای محبوب نشود و فقط بازی و شوخی باشد، عشق واقعی نیست."
      },
      {
        "id": 3173557,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بازی باشد، نه عشقبازی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3173558,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می آیی و می چکد ز تو ناز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو می‌رسی و لطافت و زیبایی‌ات به همه جا سرایت می‌کند، از سر تا پا تمام وجودت پر از ناز و فریبندگی است."
      },
      {
        "id": 3173559,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
