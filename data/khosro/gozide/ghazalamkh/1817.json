        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کو دل ننهد به جانگدازی",
        "languageId": null,
        "coupletSummary": null
