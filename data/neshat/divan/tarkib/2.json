        "coupletIndex": 28,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فردوس شریک کهترت باد",
        "languageId": null,
        "coupletSummary": null
      },
      {
