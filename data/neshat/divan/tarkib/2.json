        "vOrder": 98,
        "coupletIndex": 29,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای بزم طرب فزای دارا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای مهمانی شاد و دل‌انگیز، ای ناهید ثروتمند، همیشه به یاری من بشتاب."
      },
      {
