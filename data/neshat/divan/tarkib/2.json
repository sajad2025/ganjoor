        "vOrder": 108,
        "coupletIndex": 31,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از صاف طرب بساغرت باد",
