        "vOrder": 86,
        "coupletIndex": 26,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر سعد که در فلک توان جست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر خوشبختی که در آسمان بتوان جستجو کرد، سد قرن به همراه ستاره‌ات باشد."
