        "vOrder": 84,
        "coupletIndex": 25,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از جعد خطی معنبرت باد",
        "languageId": null,
        "coupletSummary": null
      },
      {
