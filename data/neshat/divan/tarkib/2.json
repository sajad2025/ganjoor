    "next": null,
    "previous": {
      "id": 119492,
      "title": "شمارهٔ ۱",
      "urlSlug": "sh1",
      "excerpt": "این بزم شهنشه جهان است",
      "mainSections": null
    },
    "verses": [
      {
        "id": 4582707,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای شام نشاط طره بگشا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای شب، شادابی خود را با گیسوانت به نمایش بگذار؛ ای صبح، چهره‌ی آرزوهایت را آشکار کن."
      },
      {
        "id": 4582708,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای صبح مراد چهره بنما",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582709,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای روز بروی دوست بگذر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای روز، بر روی دوست گذر کن و ای شب، با زلف یار بازگرد."
      },
      {
        "id": 4582710,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای شب با زلف یار باز آ",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582711,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای دوست بخستگان نظر کن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای دوست، به کسانی که در سختی هستند توجه کن و ای آقا، به بندگان خود رحم کن و محبت نشان بده."
      },
      {
        "id": 4582712,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای خواجه به بندگان ببخشا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582713,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای گوش ره صماخ بر بند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای گوش، به صدای درون خود توجه کن و ای چشم، دروازه‌ی دیدن را باز کن."
      },
      {
        "id": 4582714,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای چشم در سرای بگشا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582715,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای عشق پی قدوم خسرو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای عشق، در پی آمدن خسرو باش و ای عقل، در پی نثار دارا راه بگیر."
      },
      {
        "id": 4582716,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای عقل پی نثار دارا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582717,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بنشین و سرای دل بیفروز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بنشین و دل خود را شاد کن، سپس بلند شو و فضای ذهنت را آرام و دلپذیر بساز."
      },
      {
        "id": 4582718,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برخیز و فضای سر بیارا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582719,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای جبهه ره سجود بر گیر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای جبهه، سر به خاک بگذار و سجده کن، ای چهره، به خاک راه بیا."
      },
      {
        "id": 4582720,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای چهره بخاک ره بیالا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582721,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای جشن نقاب چهره بر کش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای عید فرح و شادی، چهره‌ات را پنهان کن و ای میهمانی، غبار از موهای زیبا کنار بزن."
      },
      {
        "id": 4582722,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای بزم غبار طره بزدا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582723,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای خلد بپاسبان در آویز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای باغ، تو را به نگهبانی می‌سپارم، ای آسمان، در آستانهٔ آرامشی."
      },
      {
        "id": 4582724,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای چرخ در آستان بیاسا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582725,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 2,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کین بزم شهنشه جهان است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این جشن و میهمانی که در نظر داریم، هدف اصلی زمین و آسمان است و به نوعی شکوه و عظمت دنیای پادشاهی را نشان می‌دهد."
      },
      {
        "id": 4582726,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 3,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مقصود زمین و آسمان است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582727,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یار آمد و همچنان بخوابی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دوست آمد و همچنان در خواب هستی، پس از خواب برخیز، چون خورشید طلوع کرده است."
      },
      {
        "id": 4582728,
        "vOrder": 24,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر خیز که سر زد آفتابی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582729,
        "vOrder": 26,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر چهره نهاد چنبر زلف",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بر چهره نازک او، حلقه‌ای از موهایی چون زلف صبح افتاده است و گویی پرنده‌ای آزادانه در کنار او نشسته است."
      },
      {
        "id": 4582730,
        "vOrder": 28,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صبح است و گشاده پر غرابی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582731,
        "vOrder": 30,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "باز آمده از شکار گردون",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بازگشته‌ام از شکار زمان و از خون محبوبم بر دستانم ردّی باقی مانده است."
      },
      {
        "id": 4582732,
        "vOrder": 32,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از خون مهش بکف خضابی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582733,
        "vOrder": 34,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کرده بدو نیم پیکر ماه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نیمی از پیکر ماه را به او تقدیم کرده‌اند و هر کدام از او آویزان شده‌اند."
      },
      {
        "id": 4582734,
        "vOrder": 36,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آویخته هر یک از رکابی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582735,
        "vOrder": 38,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آورده ببند خام زلفش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: موهای پر پیچ و تاب او را به گونه‌ای بسته‌ام که مانند حلقه‌ای از نور تابان به نظر می‌رسد."
      },
      {
        "id": 4582736,
        "vOrder": 40,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درهر خم حلقه آفتابی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582737,
        "vOrder": 42,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی دیده ی من رخش نکونیست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هرگز نخواهی دستیابی به زیبایی‌های گلزار اگر که دلی برای دیدن نداشته باشی."
      },
      {
        "id": 4582738,
        "vOrder": 44,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گلزار خوش است باسحابی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582739,
        "vOrder": 46,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ملک شه عادلی دلا نیست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ملک و شاه عادلی وجود ندارد که بدون منظور و مصلحتی، به خرابی و نابودی دست بزند."
      },
      {
        "id": 4582740,
        "vOrder": 48,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی مصلحتی اگر خرابی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582741,
        "vOrder": 50,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر حاصل عاقلی همین است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر نتیجه عقلانیت همین باشد، پس از این به بعد من و مستی، از شرابی دور نخواهیم بود."
      },
      {
        "id": 4582742,
        "vOrder": 52,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زین پس من و مستی از شرابی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582743,
        "vOrder": 54,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سرمایه ی عمر رفت بر باد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تمامی روزگار عمرم به هدر رفته است و حالا می‌خواهم آنچه را که دارم به یک چیز بی‌ارزش و ناپایدار بسپارم."
      },
      {
        "id": 4582744,
        "vOrder": 56,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بنیاد وی افکنم بر آبی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582745,
        "vOrder": 58,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "راه است دراز و دور کوتاه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای خواجه، راهی که در پیش داریم خیلی طولانی و دور است، اما تو هیچ عجله‌ای از خودت نشان نمی‌دهی."
      },
      {
        "id": 4582746,
        "vOrder": 60,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای خواجه نمیکنی شتابی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582747,
        "vOrder": 62,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آزادی ما غلامی تست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آزادی ما وابسته به خدمت توست ای آقا، تو هم هیچ پاداشی نمی‌گیری."
      },
      {
        "id": 4582748,
        "vOrder": 64,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای خواجه نمیکنی ثوابی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582749,
        "vOrder": 66,
        "coupletIndex": 21,
        "versePosition": 2,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "...",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این بیت اشاره به این دارد که شخصی، احساساتی از خواب و خیال دارد که شبیه به میوه‌های رسیده و خوشمزه است. این احساسات، در دل او، ترکیبی از شور و شوق و میل به زندگی را ایجاد کرده‌اند. در واقع، او در دنیایی آرمانی و زیبا غوطه‌ور است که به او حس خوشایندی می‌دهد."
      },
      {
        "id": 4582750,
        "vOrder": 68,
        "coupletIndex": 21,
        "versePosition": 3,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "...",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582751,
        "vOrder": 70,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل رهبر و بخت یاورت باد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: باشد که دلِ رهبر همیشه شاد باشد و بختت یارت کند، و هر دو جهانی که آرزو داری، به تو ارزانی شود."
      },
      {
        "id": 4582752,
        "vOrder": 72,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کام دو جهان میسرت باد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4582753,
        "vOrder": 74,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شاد است روان عالم از تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: روح جهان به خاطر تو شاد است و غم‌ها از یاد تو دور می‌شود."
      },
      {
        "id": 4582754,
        "vOrder": 76,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "غم دور همی ز خاطرت باد",
        "languageId": null,
        "coupletSummary": null
      },
