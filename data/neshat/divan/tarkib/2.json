        "coupletIndex": 24,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ور باد ز زلف دلبرت باد",
        "languageId": null,
        "coupletSummary": null
