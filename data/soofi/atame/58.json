        "text": "رخ از رندان بی سامان مپوشان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5043508,
        "vOrder": 3,
        "coupletIndex": null,
        "versePosition": 5,
        "sectionIndex1": null,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در جواب او",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5043509,
