        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5043517,
        "vOrder": 13,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 1,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز شوق صحنک بغرای میده",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از شوق و هیجان، مانند دیگ قلیه‌ای که به جوش آمده، در درونم طغیانی بوجود آمده است."
      },
