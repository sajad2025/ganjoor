        "text": "چو پروانه گرت پروای عشق است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3425441,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مگو از دی و از فردا و فردا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ذکر نکن که از گذشته و آینده حرف بزنی، چرا که امروز تنها زمانی است که وعدهٔ عشق در آن وجود دارد."
      },
