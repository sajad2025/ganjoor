        "sectionIndex4": null,
        "text": "آفتابی به مه شده پیدا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: خورشید در آسمان نمایان است، هرچند ماه نیز در پشت ابرها پنهان شده است."
      },
      {
        "id": 3423232,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
