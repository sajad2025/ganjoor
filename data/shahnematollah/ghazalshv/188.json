        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که چو ما از سر همه برخاست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3421157,
        "vOrder": 11,
