        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3421942,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جان معنی طلب نه صورت تن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: جان به دنبال معناست و نه تنها ظاهر بدن. انسانی که بی‌روح است، چه کاری می‌تواند انجام دهد؟"
      },
      {
        "id": 3421943,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تن بی جان چه می کند دانا",
        "languageId": null,
        "coupletSummary": null
      },
