        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3430019,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر خیال غیر آید درنظر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر فکر کسی جز او به ذهن ما بیاید، باید تصویر او را بر چشم خود نقش کنیم و اجازه ندهیم به چیز دیگری فکر کنیم."
      },
      {
        "id": 3430020,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
