        "text": "هستی اوست هرچه هست آنست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3424256,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دامن سید است در دستم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دامن سید در دست من است و همیشه بنده به وسیله آن دستیابی دارد."
