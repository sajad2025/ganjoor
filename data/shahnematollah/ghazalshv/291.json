        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3425174,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون ز هستی خویش نیست شدیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که از وجود خودمان آزاد می‌شویم، وجود واقعی و حقیقی اوست که در وجود ما بروز می‌کند. هر چیزی که وجود دارد، همان حقیقت اوست."
      },
      {
        "id": 3425175,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
