        "text": "نعمة الله در شراب افتاده است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نعمت خداوند در شراب گنجانده شده و سرش را به پای این خم می‌سایید."
      },
      {
        "id": 3424748,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سر به پای خم می بنهاده است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3424747,
        "vOrder": 3,
        "coupletIndex": 1,
