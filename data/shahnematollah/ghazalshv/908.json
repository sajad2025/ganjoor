        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ایمن ز فنائی و بقا نیز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3431134,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ما از تو به غیر تو نخواهیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما به جز تو خواسته‌ای نداریم، بدون تو در این دنیا چه باید کرد؟"
      },
