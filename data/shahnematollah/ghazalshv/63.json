        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کز سردار فنا یابی بقا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3422830,
        "vOrder": 13,
        "coupletIndex": 6,
