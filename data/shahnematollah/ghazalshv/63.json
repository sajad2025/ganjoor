      },
      {
        "id": 3422819,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نعمت از الله کی باشد جدا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3422820,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در دل و دیده ندیدم جز یکی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در دل و چشم من جز یک چیز وجود ندارد، هرچند در طول زندگیم تجربیات زیادی را در این دو جهان اندوخته‌ام."
      },
      {
        "id": 3422821,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گرچه گردیدم بسی در دو سرا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3422822,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "میل ساحل کی کند بحری چو شد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تجمع آب‌ها و وجود دریا چنان گسترده و عمیق است که در آن هیچ نیازی به سمت ساحل و کناره‌ها احساس نمی‌شود. وقتی کسی در چنین دریا و عمق بالایی غرق می‌شود، دیگر به سمت ساحل و نقاط امن فکر نمی‌کند."
      },
      {
        "id": 3422823,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "غرقه در دریای بی پایان ما",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3422824,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ما نوا از بی نوائی یافتیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما از بی‌نوایی و فقر، نوا و آهنگ پیدا کردیم. اگر دنبال آهنگ هستی، باید از بی‌نوایان جستجو کنی."
      },
      {
        "id": 3422826,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر نوا جوئی بجو از بینوا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3422835,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از خدا بیگانه ای دیدیم نه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما فردی را دیدیم که از خدا دور است، اما این دیدار به هیچ وجه نشان دهنده شخصیت او نیست؛ چه بسا کسانی که به نظر می‌رسد از خدا دورند، در واقع به خوبی با او آشنا هستند."
      },
      {
        "id": 3422827,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر که باشد هست با او آشنا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3422828,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سروری خواهی برآ بر دار عشق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر می‌خواهی برتری و قدرتی بیابی، باید به عشق و احساسات عمیق گرایش داشته باشی، زیرا در این مسیر است که از نابودی و زوال به جاودانگی دست می‌یابی."
      },
      {
