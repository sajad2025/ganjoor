        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نظری کن که نور دیدهٔ ماست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3421017,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در خرابات ساقی سر مست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در میخانه، ساقی که در حال مستی است، خدمتگزار سید ما و فقرای جامعه است."
      },
      {
        "id": 3421018,
        "vOrder": 12,
