        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ما جمله یکیم اگر هزاریم",
        "languageId": null,
        "coupletSummary": null
      },
