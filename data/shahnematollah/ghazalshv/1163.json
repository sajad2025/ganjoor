        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "باقی همه صورت نگاریم",
        "languageId": null,
        "coupletSummary": null
      },
