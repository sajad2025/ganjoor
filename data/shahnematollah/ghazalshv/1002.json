        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جامع انتهاست یعنی دل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3435375,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در ولایت ولی کامل اوست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در این جا به این معناست که در سرزمین وجود یک فرد کامل و با بصیرت، همواره به یاد خداست و ارتباطش با او در تمام ساعات شبانه‌روز ادامه دارد. این اشاره دارد به حالتی از دل که با خداوند در ارتباط است و همیشه در یاد اوست."
      },
