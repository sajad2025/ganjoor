        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چیست عنبر والهٔ گیسوی ما",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3422656,
        "vOrder": 3,
