        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دُردی درد است درمانم بلی",
        "languageId": null,
        "coupletSummary": null
      },
      {
