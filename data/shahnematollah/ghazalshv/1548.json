        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گه به این و گه به آن خوانی مرا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گاهی مرا به این سو و گاهی به آن سو می‌خوانی، اما هر چه می‌خواهی بگو، من همان هستم که هستم."
      },
      {
        "id": 3429135,
        "vOrder": 10,
