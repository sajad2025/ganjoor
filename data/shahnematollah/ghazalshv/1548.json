        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر جمال خویش حیرانم بلی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3429140,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
