        "text": "لاجرم نیکو مسلمانم بلی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3429132,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دردمندم دردمندم دردمند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من در رنج و درد هستم و این درد تلخی است که به معنای واقعی درمانی برای من نیست."
      },
      {
        "id": 3429133,
        "vOrder": 8,
