        "sectionIndex4": null,
        "text": "لذت و وهم عاقلان هیچست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3424812,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "منصب زهد نزد ما سهلست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مقام زهد و پارسایی برای ما آسان است، در حالی که لذت و عشق به بدکاران هیچ ارزشی ندارد."
      },
      {
        "id": 3424793,
        "vOrder": 16,
