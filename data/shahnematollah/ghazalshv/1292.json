        "text": "در صحبت ما همه صفاین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در گفتگوهای ما، همه چیز به لطف خدا فراهم شده و ما همه از این خوشنودی و شوق برخورداریم."
      },
      {
        "id": 3425744,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ما را همه ذوق از خداین",
        "languageId": null,
        "coupletSummary": null
