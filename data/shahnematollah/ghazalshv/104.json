        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر کف ما خوش حبابی پر ز آب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3420609,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در خرابات مغان موجود نیست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در میخانه و میان شراب‌نوشان، مانند یک عاشق زار و پست نبود که به چنین حالتی دچار باشد."
      },
