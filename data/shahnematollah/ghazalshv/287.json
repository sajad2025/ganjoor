        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر چه دارم به نام رندان است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3425153,
        "vOrder": 3,
