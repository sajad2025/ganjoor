        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دردمندیم و درد درمان است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما دردی داریم و درمانی که خوشایندتر از درد دل نیست."
      },
      {
        "id": 3421899,
        "vOrder": 12,
