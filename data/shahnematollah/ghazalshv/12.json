      },
      {
        "id": 3421913,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "الصلا هر که عاشق است صلا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3421912,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در خرابات خلوتی داریم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در این دنیای پرازدحام، در مکانی ساده و خلوتی داریم که ارزشش بیشتر از هر جایی در جهان است."
      },
      {
        "id": 3421911,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به از این در جهان که دارد جا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3421910,
        "vOrder": 5,
