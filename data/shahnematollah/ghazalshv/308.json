        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ساقی قدحی به عاشقان ده",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای ساقی، جامی به عاشقان بده از آن شرابی که برای جان مفید است."
      },
      {
        "id": 3423559,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
