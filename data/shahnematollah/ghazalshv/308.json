        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گرچه دو جهان فدای جانست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3423545,
        "vOrder": 13,
