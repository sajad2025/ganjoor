        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از مذهب و دین ما چه پرسی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از مذهب و دین ما چه می‌پرسی؟ آنچه که نظر ما بر آن است، همین است."
      },
      {
        "id": 3423557,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنست که رای ما برآنست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3423558,
        "vOrder": 5,
        "coupletIndex": 2,
