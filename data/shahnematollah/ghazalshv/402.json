        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3416619,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جان فروشم بر سر بازار عشق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من جانم را در بازار عشق فدای عشق می‌کنم و آگاهانه به دنبال خریدن آن هستم."
      },
      {
