        "coupletSummary": "هوش مصنوعی: هر چیزی که به خودت می‌پسندی، حالا می‌تواند یک پارچه معمولی یا پارچه‌ای با ارزش باشد، باید آن را با افتخار بپوشی."
      },
      {
        "id": 3439096,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خود بپوشی پلاس یا دیبا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3439097,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر پلاس است جامه‌ات آن دم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر لباس تو در آن لحظه که عزاداری می‌کنی، پاره و کهنه باشد، هیچ فایده‌ای نخواهد داشت."
      },
      {
        "id": 3439098,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هیچ سودی ندارت ماتم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3439099,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ور حریر است و جامهٔ شاهی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر لباس زیبا و ابریشمی و شاهانه می‌پوشی، با این حال قشنگ‌تر از ماهی نیست."
      },
      {
        "id": 3439100,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خوش بپوشش که خوشتر از ماهی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3439101,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پیرهن چون برون کنی از تن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که لباس را از تن جدا کنی، نقاط قوت و ضعف بدن بیشتر نمایان می‌شود."
      },
      {
        "id": 3439102,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هنر و عیب تن شود روشن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3439103,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آشکارا شود چنانکه بود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر چیزی مانند آنچه که هست، به وضوح و آشکار به تو نشان داده خواهد شد."
      },
      {
        "id": 3439104,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بنماید به تو همان که بود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3439105,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جامه از علم وز عمل می‌دوز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: لباسی از دانش و اخلاق بپوش، پس بیا و از ما کسب آموزش کن."
      },
      {
        "id": 3439106,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جامه دوزی بیا ز ما آموز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3439107,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خلعت خاص پوش سلطانی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: پوشش ویژه‌ای که مخصوص پادشاهی است، سزاوار است که بر تن کنی، نه اینکه عریان بمانی."
      },
      {
        "id": 3439108,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حیف باشد که برهنه مانی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3439109,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خرقه دوزم ز وصلهٔ اخلاق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من برای دوستانم اخلاق و سلوک نیکو را مانند پارچه‌ای وصله‌دوزی می‌کنم، به‌گونه‌ای که برای همه‌ی آنها به‌طور کلی مناسب باشد."
      },
      {
        "id": 3439110,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بهر یاران خود علی الاطلاق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3439111,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هرکه را پیرهن چنین باشد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هرکس که چنین لباس و ظاهری داشته باشد، در حقیقت گنج و ارزش بزرگی در درون خود دارد."
      },
      {
        "id": 3439112,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یوسف او در آستین باشد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3439085,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گرچه بسیار جامه بخشیدیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هرچند که ما به دیگران کمک و لباس‌های زیادی داده‌ایم، اما خود ما هیچ‌کدام از این لباس‌ها را بر تن نکرده‌ایم."
      },
      {
        "id": 3439084,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به از این جامه‌ای نپوشیدیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3439083,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بستان یادگار ما درپوش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بستان نماد یادگاری از ماست که بر سر تاجی قرار دارد و با علم بر دوش نشان داده می‌شود."
      },
      {
        "id": 3439068,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تاج بر سر نه و علم بر دوش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3439056,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جامهٔ آخرت چنین باشد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: لباس آخرت این‌گونه است و در واقع، این همان معنای اصلی این کلام است."
      },
      {
        "id": 3439057,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آخر این سخن همین باشد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3439058,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت پیغمبر خدا که خدا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: پیامبر خدا فرمود که خداوند به دلیل بزرگواری و بخشندگی‌اش با ما چنین بیان کرده است."
      },
      {
        "id": 3439059,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 20,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اینچنین گفت از کرم با ما",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3439060,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر که داند که من که سلطانم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر کسی که بداند من کی هستم و چه قدرتی دارم، می‌داند که می‌توانم با بخشش، گناهان را forgive کنم."
      },
      {
        "id": 3439061,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 21,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر ببخشم گناه بتوانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3439062,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عفو فرمایمش گناه تمام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من از گناه خود می‌گذرم و نگران هیچ‌کس نیستم، نه از مردم عادی و نه از افراد خاص."
      },
      {
        "id": 3439063,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 22,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هیچ باکم نه از خواص و عوام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3439064,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سخنی با موحد است ای یار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دوستی عزیز، بدان که هر کسی که به جز خداوند به چیزی دیگر متوسل شود، در نهایت از نعمت‌ها و زیبایی‌های حیات دور خواهد افتاد."
      },
      {
        "id": 3439065,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 23,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر که شرک آورد رود در ناز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3439066,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ما نداریم شرک و می‌داند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما به هیچ عنوان شریک و همسری برای خدا قائل نیستیم و او می‌داند که اگر بخواهد، قادر است گناهان را ببخشد."
      },
      {
        "id": 3439067,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 24,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر ببخشد گناه بتواند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3439069,
        "vOrder": 47,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پای تا سر همه گنهکاریم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما از سر تا پا گناهکاریم، اما هنوز به بخشش امیدواریم."
      },
      {
        "id": 3439082,
        "vOrder": 48,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 25,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لیکن امید عفو می‌داریم",
        "languageId": null,
        "coupletSummary": null
      }
    ],
