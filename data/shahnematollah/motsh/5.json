        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آتش چو جنان شد",
        "languageId": null,
        "coupletSummary": null
