        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر طور روان شد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3442538,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اسرار حقیقت نتوان گفت به اغیار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: رازهای حقیقت را نمی‌توان به دیگران گفت، زیرا وقتی به دنیا آمدند، خود را نشان دادند."
      },
      {
        "id": 3442536,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کو چون به جهان شد",
        "languageId": null,
        "coupletSummary": null
      },
      {
