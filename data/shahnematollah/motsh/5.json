        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کز سرّ سرا پردهٔ اسرار برآمد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از عمق رازها و اسرار، دل به بیرون آمد و در خفا پنهان شد."
      },
      {
