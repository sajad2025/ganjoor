        "text": "دلت از نور عزت کامل آمد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2320708,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تویی مطلوب هر جا طالبی هست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو هدف هر کسی هستی که دنبال تو می‌گردد و دلت از درک حقیقت پر شده و شاداب شده است."
      },
      {
        "id": 2320709,
        "vOrder": 20,
