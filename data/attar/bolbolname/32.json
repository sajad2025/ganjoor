        "sectionIndex4": null,
        "text": "همی پوشی سیاهی را بناموس",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2321246,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مکن شادی اگر کارت برآید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر موفق به انجام کاری شدی، خوشحال نباش، چرا که روز خوب و بد هر کدام زمانی به سر می‌آیند."
      },
