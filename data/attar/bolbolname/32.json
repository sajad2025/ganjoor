        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز بند آرزوی خویش برخیز",
        "languageId": null,
        "coupletSummary": null
      },
      {
