    "verses": [
      {
        "id": 2312789,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دعا می‌کرد آن داننندهٔ دین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آن کسی که به علم دین آگاه بود، دعا می‌کرد و مردم گروهی به او پاسخ می‌دادند و آمین می‌گفتند."
      },
      {
        "id": 2312788,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جهانی خلق می‌گفتند آمین",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2312787,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یکی دیوانه گفت آمین چه باشد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: یک دیوانه گفت: \"آمین\" یعنی چه؟ من که نمی‌دانم این چیست."
      },
      {
        "id": 2312786,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که آگه نیستم تا این چه باشد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2312792,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بدو گفتند آمین آن بود راست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به او گفتند که هرچه بخواهی، درست است. خواجه هر چیزی که از خدا خواسته بود، به حقیقت پیوسته است."
      },
      {
        "id": 2312785,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کامام خواجه از حق هرچه درخواست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2312783,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چنان باد و چنان باد و چنان باد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مثل باد شد و مانند باد، آن مجنون فریاد می‌زند و زبانش گشوده می‌شود."
      },
      {
        "id": 2312782,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زبان بگشاد آن مجنون بفریاد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2312781,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که نبود آن چنان و این چنین هیچ",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هیچ چیز در عالم به آن صورت که من می‌خواهم وجود ندارد، و هر چه که خواسته باشد، به همین دلیل از این مسائل و پیچیدگی‌ها دور است."
      },
      {
        "id": 2312780,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کامام خواجه خواهد، چند ازین پیچ",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2312779,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ولیکن جز چنان نبوَد کم و بیش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اما چیزی جز آنچه اراده‌ی حق باشد، کم یا زیاد نمی‌شود؛ پس از خود چه می‌خواهید؟"
      },
      {
        "id": 2312778,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که حق خواهد چه می‌خواهید ازخویش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2312759,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گرت چیزی نخواهد بود روزی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر چیزی برای تو مقدر نشده باشد، در روزی که تقدیر تو فقط عذاب و ناراحتی باشد، روزی‌ات چیزی جز سوزش در دل نخواهد بود."
      },
      {
        "id": 2312758,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نباشد روزیت جز سینه سوزی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2312757,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر او خواهدت کاری برآید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر او بخواهد، به تو کمک می‌کند، وگرنه اگر نه، تنها دردی برایت به همراه خواهد داشت."
      },
      {
        "id": 2312748,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وگرنه از گلت خاری برآید",
        "languageId": null,
        "coupletSummary": null
      }
    ],
