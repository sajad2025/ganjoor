      },
      {
        "id": 2315512,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برون نیست از دو حالِ تو درین راه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2315513,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر بیداری اینجا چون نشینی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر در اینجا بیدار و هوشیار نشینی، تا زمانی که چشم‌هایت را پلک بزنی، چیزی نخواهی دید."
      },
      {
        "id": 2315514,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که تا برهم زنی دیده، نه بینی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2315515,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وگر تو خفتهٔ این پادشائی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر در خواب این سلطنت باشی، هیچ چیز نخواهی دید تا وقتی که چشمت را باز کنی."
      },
      {
        "id": 2315516,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه بینی هیچ تا دیده گشائی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2315517,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بملکی چَند نازی چند خندی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به چندین زیبایی و ناز و لطافت بخند، زیرا هر زمان که چشمانت را باز کنی و دوباره ببندی، ممکن است لحظه‌ای دیگر را از دست بدهی."
      },
      {
        "id": 2315518,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که تا چشمی گشائی و ببندی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2315519,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ازو آثار در عالم نه بینی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر در جهان آثار او را نبینی، در واقع وجودش به هیچ می‌ماند و حتی آنچه که می‌بینی نیز از دیدگاه وجودی، بی‌ارزش است."
      },
      {
        "id": 2315520,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
