        "text": "کم از هیچی بوَد آن هم نه بینی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2315521,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
