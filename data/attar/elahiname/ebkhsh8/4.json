        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من به راه رفتم و در جستجوی آنچه هستم، دنبال چیزهایی می‌گردم که به سرعت از دست می‌روند."
      },
      {
        "id": 2311616,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
