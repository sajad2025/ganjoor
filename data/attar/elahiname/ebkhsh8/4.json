        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بخاک ابلیس را افتاده دیدم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2311619,
        "vOrder": 7,
