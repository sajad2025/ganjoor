        "sectionIndex4": null,
        "text": "وگرنه او ترا معزول دارد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در غیر این صورت، او تو را از مقام خود کنار می‌گذارد و با کارهایی که نمی‌توانی انجام دهی، مشغول می‌سازد."
      },
      {
        "id": 2317696,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بصد ناکردنی مشغول دارد",
        "languageId": null,
        "coupletSummary": null
      },
