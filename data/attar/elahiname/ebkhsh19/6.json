        "sectionIndex4": null,
        "text": "کسی کو عمر در دنیی بسر برد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کسی که در این دنیا زندگی طولانی کند، اگر در دین هم بمیرد، مردی با نفوذ و قوی خواهد بود."
      },
      {
        "id": 2317406,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
