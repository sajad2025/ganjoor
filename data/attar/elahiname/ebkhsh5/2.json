        "sectionIndex4": null,
        "text": "که از دیوت گر این حاصل نبودی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر آن دیو نبود، تو هرگز این آرزو را در دل نداشتی."
      },
      {
        "id": 2310191,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
