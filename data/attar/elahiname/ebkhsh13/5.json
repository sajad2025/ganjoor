    "verses": [
      {
        "id": 2314173,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مگر شد آشکارا قحط سالی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آیا نشانه‌هایی از کمبود و فقر به طور واضح در میان مردم دیده شد؟ "
      },
      {
        "id": 2314171,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به پیش خلق آمد تنگ حالی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2314170,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سراسیمه جهانی خلقِ محبوس",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دنیا به شدت نگران و پریشان شد، مانند افرادی که در زندان هستند، به خاطر بارانی که قرار است ببارد، به سوی طاووس‌ها می‌شتابند."
      },
      {
        "id": 2314169,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شدند از بهرِ باران پیشِ طاوس",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2314168,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که باران می‌نیاید آشکارا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: باران نمی‌بارد، پس از خداوند درخواست کن تا ما را به حال خود رها نکند."
      },
      {
        "id": 2314167,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دعائی کن زحق در خواه ما را",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2314166,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پس آنگه گفت طاوس ای عزیزان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: طاوس گفت: ای عزیزان، ابر به طور بیهوده و بدون هدف نمی‌بارد."
      },
      {
        "id": 2314165,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نگردد ابر بر بیهوده ریزان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2314164,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شما را گرچه جز باران طلب نیست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: شما فقط انتظار باران را دارید و اگر باران نبارد، جای تعجب نیست."
      },
      {
        "id": 2314163,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر باران نمی‌بارد عجب نیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2314162,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عجب اینست کز چندین گنه کار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: جالب اینجاست که از میان بسیاری از گنهکاران، هیچکس یکبار هم سنگی بر سر مردم نمی‌زند."
      },
      {
        "id": 2314161,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نبارد سنگ بر مردم بیکبار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2314160,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگرچه میغ ترک آسمان کرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگرچه ابر آسمان را ترک کرده، اگر به این موضوع دقت کنی، تعجبی نخواهد بود."
      },
      {
        "id": 2314159,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تعجّب گر کنی زان می‌توان کرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2314158,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که نکشافد زمین از شومی ما",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمین به خاطر بدبختی‌های ما فاش نمی‌شود، زیرا ما به خاطر ندانم‌کاری‌هایمان آسیب می‌زنیم."
      },
      {
        "id": 2314157,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خورد ما را ز نامعلومی ما",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2314172,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو پنداری که ازمردانِ راهی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو فکر می‌کنی که از مردان راه، کدام یک واقعاً در مسیر خود گم شده است؟"
      },
      {
        "id": 2314174,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کدامین مرد، سرگردانِ راهی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2314191,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو پندار تو برگیرند از پیش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که افکار و تصورات تو از چیزی جدایی بگیرند، مثل این است که کسی به یاد مرده‌ای بیفتد و از درون خود احساس ناراحتی کند."
      },
      {
        "id": 2314175,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کسی مرده سگی برخیزد از خویش",
        "languageId": null,
