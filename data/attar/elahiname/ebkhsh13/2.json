        "text": "که جانت را امل آمد پدیدار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2314121,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
