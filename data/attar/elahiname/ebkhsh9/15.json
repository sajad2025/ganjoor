      },
      {
        "id": 2312199,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سپه را خواست دادن عرض یک روز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2312200,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نبود آنجایگه حاضر ایاسش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در آن مکان که ایاس حاضر نبود، شاهی که حق را می‌شناخت، انتظار او را می‌کشید."
      },
      {
        "id": 2312201,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "طلب می‌کرد شاه حق شناسش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2312202,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کسی شاه از برای او فرستاد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: شخصی از طرف شاه پیام فرستاد که شاه به خاطر تو در اینجا توقف کرده است."
      },
      {
        "id": 2312204,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که شاه اینجا برای تو باستاد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2312217,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیا کاینجایگه عرض سپاهست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بیا که اینجا محل نمایش نیروهاست، هدف از این نمایش، نشان دادن آن چهره زیباست که همچون ماه می‌درخشد."
      },
      {
        "id": 2312205,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "غرض زین عرض آن روی چو ماهست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2312206,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رسول شاه رفت و گفت این راز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: پیامبر شاه رفت و راز را فاش کرد، ایاز که مانند سیمرغ بود، پاسخ این راز را داد."
      },
      {
        "id": 2312207,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جوابش داد ایاز سیمبر باز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2312208,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "روان شد مرد تا نزدیکِ محمود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مردی روانه شد تا به نزدیک محمود برسد و به او گفت: آیا چهره‌ی معشوق را ندیدی؟"
      },
      {
        "id": 2312209,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شهش گفتا ندیدی روی مقصود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2312210,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چنین گفت او که دیدم می‌نیاید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او گفت: وقتی دیدم که جوابی از او نمی‌رسد، متوجه شدم که دیگه هیچ نتیجه‌ای از این گفتگو نخواهم گرفت."
      },
      {
        "id": 2312211,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جوابی زو شنیدم می‌نیاید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2312212,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بدو گفتم بیا چون شاهِ پیروز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به او گفتم بیا، مانند یک پادشاه پیروز، امروز خبر پیروزی سپاه را خواهد گفت."
      },
      {
        "id": 2312213,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سپه را عرض خواهد داد امروز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2312214,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرا گفتا بگو با شاهِ گُربز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به من گفتند که به شاه گربز بگو که هیچ‌کس هرگز معشوق خود را به کسی نخواهد داد."
      },
      {
        "id": 2312215,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
