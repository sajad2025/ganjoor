      {
        "id": 2309415,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که فرزندی شود شایسته موجود",
        "languageId": null,
        "coupletSummary": null
