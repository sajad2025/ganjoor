    "sections": [
      {
        "id": 104715,
        "poemId": 10996,
        "poem": null,
        "poetId": 9,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 6,
        "ganjoorMetre": {
          "id": 6,
          "urlSlug": null,
          "rhythm": "فاعلاتن فاعلاتن فاعلن (رمل مسدس محذوف یا وزن مثنوی)",
          "name": null,
          "description": null,
          "verseCount": 148935
