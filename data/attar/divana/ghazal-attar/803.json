        "text": "هرچند قلندر جهانی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2287645,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شطرنج مباز با ملوکان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در بازی شطرنج با پادشاهان بازی نکن، چون راه و چاره را نمی‌دانی."
      },
      {
        "id": 2287639,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
