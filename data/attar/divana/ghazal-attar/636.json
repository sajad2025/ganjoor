      },
      {
        "id": 2286422,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "غم تو مرهم دل افکاران",
        "languageId": null,
        "coupletSummary": null
      },
