      },
      {
        "id": 2288569,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بنده بودن تو را خداوندی",
        "languageId": null,
        "coupletSummary": null
