    "verses": [
      {
        "id": 2282057,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این چه سوداست کز تو در سر ماست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این چه شور و شوقی است که در دل ما وجود دارد و این چه هیاهویی است که از سمت تو به ما می‌رسد."
      },
      {
        "id": 2282051,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وین چه غوغاست کز تو در بر ماست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282052,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از تو در ما فتاده شور و شری",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این بیت بیانگر این است که حالت‌ها و هیجانات ناشی از محبت و عشق تو در وجود ما رخنه کرده است، اما این میزان شور و شوق برای ما مناسب و قابل قبول نیست."
      },
      {
        "id": 2282053,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این همه شور و شر نه در خور ماست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282054,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا تو کردی به سوی ما نظری",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی تو به ما نگاه کردی، تمام پادشاهی دنیا زیر فرمان ماست."
      },
      {
        "id": 2282055,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ملک هر دو جهان مسخر ماست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282056,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پاکباز آمده‌ایم از دو جهان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما از دو جهانی که در آن بوده‌ایم به اینجا آمده‌ایم، زیرا تو در دل و وجود ما جای داری."
      },
      {
        "id": 2282058,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کاتش‌ات در میانِ جوهر ماست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282065,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آتشی کز تو در نهادِ دل است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آتش درونی که از تو در دل ما شعله‌ور است، همیشه ما را هدایت و راهنمایی خواهد کرد."
      },
      {
        "id": 2282059,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا ابد رهنمای و رهبر ماست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282060,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیده‌ای کو که روی تو بیند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کسی را دیده‌ای که چهره‌ات را ببیند، اما چشمانش تاریک و ناامید است، در حالی که محبوب ما در کنار ماست."
      },
      {
        "id": 2282061,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیده تیره است و یار در بر ماست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282062,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ما درین ره حجاب خویشتنیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما در این مسیر به خاطر خودمان مانع شده‌ایم، وگرنه چهره تو همیشه در مقابل ماست."
      },
      {
        "id": 2282063,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ورنه روی تو در برابر ماست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282064,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا که عطار عاشق غم توست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عطار به خاطر عشق و غم تو دل دوستان هنرمند ما را نیز آکنده از غم کرده است."
      },
      {
        "id": 2282084,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل اصحابِ ذوق غمخور ماست",
        "languageId": null,
        "coupletSummary": null
      }
