        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرد جانان نه‌ای مکن دعوی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای مرد محبوب، خود را به جای او نگذار که مردان واقعی در این مقام نمی‌گنجند."
      },
      {
        "id": 2283986,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
