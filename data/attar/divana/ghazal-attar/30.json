    "verses": [
      {
        "id": 2282135,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اینت گم گشته دهانی که توراست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این فرد در کلامش می‌گوید که در کجا می‌توانم به جستجوی تو بپردازم؛ زیرا تو در عین حال وجود داری و در عین حال گم شده‌ای. تو آن کسی هستی که همه چیز در موردش بی‌نظیر است و من به دنبالت هستم."
      },
      {
        "id": 2282136,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وینت نابوده میانی که توراست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282137,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از دو چشم تو جهان پرشور است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چشمان تو برای جهان نشاط و هیجان به ارمغان آورده‌اند و این دنیا به خاطر تو، دیوانه‌وار و پرشور شده است."
      },
      {
        "id": 2282138,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اینت شوریده جهانی که توراست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282158,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جادوان را به سخن خشک کنی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر بخواهی جادوگران را با گفتار بی‌روح و خشک خاموش کنی، این نشان از چرب‌زبانی و فصاحت توست که واقعاً جالب است."
      },
      {
        "id": 2282159,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خه زهی چرب‌زبانی که توراست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282160,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آخر این ناز تو هم در گذرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این ناز و اداهای تو نیز به زودی تمام می‌شود و زمانه‌ای که همه چیز در دستان توست، به زودی به پایان خواهد رسید."
      },
      {
        "id": 2282161,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چند مانده است زمانی که توراست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282181,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتی از من شکری باید خواست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو گفتی که باید از من شکری بخواهی، اما این دهان آشفته من تنها متعلق به توست."
      },
      {
        "id": 2282182,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اینت آشفته دهانی که توراست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282183,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون بهای شکرت صد جان است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی بهای عشق تو به اندازه صد جان است، چه کار می‌توانم بکنم با نیمی از جانم که متعلق به توست؟"
      },
      {
        "id": 2282184,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه کنم نیمهٔ جانی که توراست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282185,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مده ای ماه کسی را شکری",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به افراد نیکوکار و محبوب می‌گوید که نباید به بدگویی از دیگران بپردازند، زیرا هرکسی می‌تواند در دلش چیزهای خوب یا بدی داشته باشد. بنابراین، زبان انسان باید برای بیان خوبی‌ها باشد و به جای شکایت کردن و بدگویی، بهتر است زیبایی‌ها را بیان کند."
      },
      {
        "id": 2282186,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که شکر هست زبانی که توراست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282187,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خط معزولی حسن تو دمید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: خط معزول تو به قدری زیبا و دلربا است که حتی دشواری‌های موجود را نیز ناتوان کرده و فرمانروایی آن فقط مخصوص توست."
      },
      {
        "id": 2282188,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سست ازآن گشت عنانی که توراست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282189,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "قیر شد گرد رخت غالیه گون",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این بیت به زیبایی و جذابیت ظاهر شخصی اشاره دارد و وضعیت او را به گونه‌ای توصیف می‌کند که مانند پارچه‌ای گران‌قیمت و زیبا به نظر می‌رسد. در اینجا، تلاش شده تا به شکلی هنری و شاعرانه ویژگی‌های ظاهری فرد بیان شود."
      },
      {
        "id": 2282190,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خطت از غالیه دانی که توراست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282191,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون خط او بدمد ای عطار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که صدای خوش خط او به گوش برسد، دیگر از احساسات غمگین و فریادها کاسته می‌شود، زیرا همه چیز به سمت زیبایی و آرامش می‌رود."
      },
      {
        "id": 2282192,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کم شود آه و فغانی که توراست",
        "languageId": null,
        "coupletSummary": null
      }
    ],
