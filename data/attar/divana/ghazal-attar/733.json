        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون مشک خطا درم خریده",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2285615,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر هیچ ورق ندیده خطی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هیچ ورق و نوشته‌ای را ندیده‌ام که خطش از خط تو زیباتر باشد."
      },
      {
        "id": 2285616,
