    "verses": [
      {
        "id": 2290747,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون دربسته است درج ناپدیدش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که در بسته است و کسی نمی‌تواند وارد شود، یک بوسه می‌تواند به‌راحتی آن در را باز کند و راه را برای ورود هموار سازد."
      },
      {
        "id": 2290748,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به یک بوسه توان کرد کلیدش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290749,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شکر دارد لبش هرگز نمیری",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر بتوانی از یک قاشق شکر بچشی، لب‌هایش همیشه شیرین و جاودانه به نظر می‌رسند."
      },
      {
        "id": 2290750,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر یک ذره بتوانی چشیدش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290751,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ندید از خود سر یک موی بر جای",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هیچ گاه نیاورده‌ام از خود سر یک موی بر جای کسی که او را از دور و نزدیک دیده‌ام."
      },
      {
        "id": 2290736,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کسی کز دور و از نزدیک دیدش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290735,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مگر طراری بسیار می‌کرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زن جوانی با زیبایی و جذابیتش آن‌قدر دلربایی می‌کرد که هر کس به او نزدیک می‌شد، تحت تأثیر طنازی‌هایش قرار می‌گرفت و در دام عشق او می‌افتاد."
      },
      {
        "id": 2290734,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کمند طره‌اش زان سر بریدش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290725,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر نبود کمند طرهٔ او",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر بند موهای او نبود که او را به سوی خود جلب کند، هرگز به سمت او نرفتم."
      },
      {
        "id": 2290719,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که یارد سوی خود هرگز کشیدش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290720,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگرچه او جهان بفروخت بر من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: با اینکه او کل جهان را در برابر من به بها گذاشت، من با جان پرخونم او را خریدم."
      },
      {
        "id": 2290721,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به صد جان جان پرخونم خریدش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290722,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز جان بیزار شو در عشق جانان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر می‌خواهی در عشق محبوبت به جای زندگی‌ات او را انتخاب کنی، باید از جان خود دل بکنی و به خاطر او فدا شوی."
      },
      {
        "id": 2290723,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر خواهی به جای جان گزیدش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290724,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلم جایی رسید از عشق رویش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل من به جایی از عشق روی او رسیده که اگر غم ادامه پیدا کند، جانم به خطر خواهد افتاد."
      },
      {
        "id": 2290726,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که کار از غم به جان خواهد رسیدش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290733,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر بر گویم ای عطار آن غم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر به تو بگویم ای عطار، آن غمی که دل مرا می‌خورد را نمی‌توانی بشنوی."
      },
      {
        "id": 2290727,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کزو دل خورد نتوانی شنیدش",
        "languageId": null,
        "coupletSummary": null
      }
    ],
