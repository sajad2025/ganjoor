    "verses": [
      {
        "id": 2282200,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عزیزا هر دو عالم سایهٔ توست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عزیزم، هر دو جهان تحت تاثیر وجود توست و بهشت و جهنم از زیبایی‌های تو سرچشمه می‌گیرد."
      },
      {
        "id": 2282201,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بهشت و دوزخ از پیرایهٔ توست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282202,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تویی از روی ذات آیینهٔ شاه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو همانند آینه‌ای هستی که چهره‌ی شاه را نمایان می‌کند و جلوه‌های تو نمایانگر صفات او هستند."
      },
      {
        "id": 2282203,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شه از روی صفاتی آیهٔ توست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282204,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که داند تا تو اندر پردهٔ غیب",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کسی نمی‌داند که در دنیای ناپیدا، چه چیز و چه واقعیتی اصل وجود تو را تشکیل می‌دهد."
      },
      {
        "id": 2282205,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه چیزی و چه اصلی مایهٔ توست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282207,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو طفلی وانکه در گهوارهٔ تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو هنوز کودک هستی و آن کسی که تو را در گهواره جابه‌جا می‌کند، همان پرستار تو نیز هست."
      },
      {
        "id": 2282214,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو را کج می‌کند هم دایهٔ توست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282208,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر بالغ شوی ظاهر ببینی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی به بلوغ برسی، متوجه خواهی شد که به ظاهر، چیزی کم نداری و دنیای اطرافت پر از دانش و تجربیات بیشتر از توست."
      },
      {
        "id": 2282209,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که صد عالم فزون‌تر پایهٔ توست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282210,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو اندر پردهٔ غیبی و آن چیز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو در دنیای پنهان هستی و چیزی که می‌بینی، در واقع فقط سایه‌ای از خود توست."
      },
      {
        "id": 2282211,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که می‌بینی تو آن خود سایهٔ توست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282212,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برآی از پرده و بیع و شرا کن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از پشت پرده بیرون بیاید و خرید و فروش کن، زیرا که هر دو جهان (دنیا و آخرت) یک سرمایه برای توست."
      },
      {
        "id": 2282213,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که هر دو کون یک سرمایهٔ توست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282233,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو از عطار بشنو کانچه اصل است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو از عطار بشنو که حقیقت، درونی است و از تو و همسایه‌ات دور نیست."
      },
      {
        "id": 2282235,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برون نی از تو و همسایهٔ توست",
        "languageId": null,
        "coupletSummary": null
      }
    ],
