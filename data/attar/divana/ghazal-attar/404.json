        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فکندم خویشِتن را در خطر باز",
        "languageId": null,
        "coupletSummary": null
      },
      {
