        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هستی ما به پیش هستی تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وجود ما در مقایسه با وجود تو، چیزی جز یک ذره در هر کجا نیست."
      },
      {
        "id": 2287851,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
