        "text": "تو ز غیرت جمال ننمایی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2287755,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در حجابیم ما ز هستی خویش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما در پرده‌ای از وجود خود پنهان هستیم، اما تو در روشنایی و نمایانی."
      },
      {
        "id": 2287756,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ما نهانیم و تو هویدایی",
        "languageId": null,
        "coupletSummary": null
      },
      {
