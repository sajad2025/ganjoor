    "verses": [
      {
        "id": 2289533,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از می عشق تو چنان مستم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از عشق تو چنان شاداب و سرخوشم که دیگر نمی‌دانم وجود دارم یا نه."
      },
      {
        "id": 2289534,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که ندانم که نیست یا هستم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2289536,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آتش عشق چون درآمد تنگ",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که شعله‌های عشق به وجودم وارد شد، در دل خود احساس تنگی و اضطراب کردم و از خودم فرار کردم."
      },
      {
        "id": 2289543,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من ز خود رستم و درو جستم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2289537,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لاجرم هست نیستم، هیچم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در نهایت، من وجود ندارم و هیچ چیز نیستم. به همین دلیل، عقل و هوشی ندارم و فقط در حال سرمستی هستم."
      },
      {
        "id": 2289538,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لاجرم عاقلی نیم، مستم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2289539,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چند گویم ز خود که در ره عشق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بسیار بارها درباره خودم حرف زده‌ام که در مسیر عشق، اندکی از این عشق را چشیدم و از خودم جدا شدم."
      },
      {
        "id": 2289540,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جرعه‌ای خوردم و ز خود رستم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2289541,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ننگ من از من است بی من من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: شرم من ناشی از خودم است و بدون وجودم، به جایی پرواز کردم و به دوستی ملحق شدم."
      },
      {
        "id": 2289542,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر پریدم به دوست پیوستم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2289563,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ساقیا درد درد در ده زود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دوست عزیز، ای ساقی! زودتر بگذار تا دردی که دارم را بیان کنم، زیرا به خاطر یک درد دیگر توبه‌ام را شکستم."
      },
      {
        "id": 2289637,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که به یک درد توبه بشکستم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2289638,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "باز، خمخانه برگشادم در",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دوباره در مکانی که مشروبات الکلی سرو می‌شود، در را باز کردم و کمربند را دور کمرم بستم."
      },
      {
        "id": 2289639,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "باز، زنار بر میان بستم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2289732,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هرچه کردم به عمرهای دراز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هرکاری که در طول عمرم انجام دادم، اکنون تنها حسرتی در دستانم باقی مانده است."
      },
      {
        "id": 2289733,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زان همه حسرت است در دستم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2289734,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ترک عطار گفتم و بی او",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من از ترک عطار صحبت کردم و بدون او با چشمانی پر از اشک در گوشه‌ای نشستم."
      },
      {
        "id": 2289735,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیده پر خون به گوشه بنشستم",
        "languageId": null,
        "coupletSummary": null
      }
