    "verses": [
      {
        "id": 2281133,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کم شدن در کم شدن دین من است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کاهش و فانی شدن برای من نشانه‌ی دین من است و از دست رفتن در وجود، راه و روش من به شمار می‌رود."
      },
      {
        "id": 2281134,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیستی در هستی آیین من است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281082,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حال من خود در نمی‌آید به نطق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: حالم به قدری بد است که نمی‌توانم آن را به زبانی توصیف کنم. چیزی که می‌تواند حال مرا نشان دهد، اشک‌های خونین من است."
      },
      {
        "id": 2281081,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شرح حالم اشک خونین من است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281080,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کار من با خلق آمد پشت و روی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کار من با مردم به گونه‌ای است که هم طرفدار و هم مخالف وجود دارند و نفرین من بر افرادی است که به خداوند کافرند."
      },
      {
        "id": 2281043,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کافرین خلق نفرین من است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281027,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا پیاده می‌روم در کوی دوست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هرچند که پیاده به سوی دوست می‌روم، اما خوشحالی و شادابی به مانند سبز و خرم بودن چمن، همواره با من است."
      },
      {
        "id": 2281028,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سبز خنگ چرخ در زین من است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281029,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از درش گردی که آرد باد صبح",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از درش بادی می‌وزد که برای من مانند سرمه‌ای است که چشم‌های بینا را می‌سازد."
      },
      {
        "id": 2281030,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سرمهٔ چشم جهان‌بین من است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281031,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون به یک دم صد جهان از پس کنم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی به یک لحظه نگاه می‌کنم، احساس می‌کنم که صد دنیا را پشت سر گذاشته‌ام، اما در واقع هنوز در ابتدای مسیرم قرار دارم."
      },
      {
        "id": 2281032,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بنگرم گام نخستین من است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281033,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من چرا گرد جهان گردم چو دوست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من چرا باید به دور دنیا سفر کنم، در حالی که دوست من در قلبم و در وجودم حضور دارد؟"
      },
      {
        "id": 2281034,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در میان جان شیرین من است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281035,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ماه‌رویا عشق تو گر کافری است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عشق تو برای من آنقدر باارزش است که حتی اگر به نظر بیاید که کفر است، من با کمال میل صدبار آن را قبول می‌کنم."
      },
      {
        "id": 2281036,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این چنین صد کافری دین من است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281037,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر بسوزم زآتش عشقت رواست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر بخاطر عشق تو بسوزم، این کار درست است؛ زیرا آتش عشق تو برای من آرامش‌دهنده است."
      },
      {
        "id": 2281038,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کآتش عشق تو تسکین من است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281039,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا دل عطار خونین شد ز عشق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دلی که به خاطر عشق، پر از درد و غم شده، یادآور این است که عشق می‌تواند انسان را به شدت تحت تأثیر قرار دهد؛ به گونه‌ای که حتی کوششی برای آرامش در زندگی نیست و سختی‌هایی را به همراه دارد."
      },
      {
        "id": 2281040,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خاک بستر خشت بالین من است",
        "languageId": null,
        "coupletSummary": null
      }
    ],
