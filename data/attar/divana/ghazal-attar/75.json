    "verses": [
      {
        "id": 2280260,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سر عشقت مشکلی بس مشکل است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عشق تو برایم چالش بزرگی است؛ روح و جانم در حیرت و شیدایی به سر می‌برد."
      },
      {
        "id": 2280245,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حیرت جان است و سودای دل است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280261,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عقل تا بوی می عشق تو یافت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی عقل بوی عشق تو را استشمام کرد، همیشه مثل یک دیوانه شده که از خود بی‌خود است و هیچ عقلی ندارد."
      },
      {
        "id": 2280244,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دایما دیوانه‌ای لایعقل است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280242,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر امید روی تو در کوی تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در انتظار دیدار تو، عاشق در کوچه‌های تو قدم می‌زند و تا زانو در گل و لای است."
      },
      {
        "id": 2280227,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پای عاشق تا به زانو در گل است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280228,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "منزل اندر هر دو عالم کی کند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر که در عشق تو خانه و آرامش دارد، در این دنیا و آن دنیا جایی برای او نیست."
      },
      {
        "id": 2280229,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر که را در کوی عشقت منزل است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280230,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست عاشق لیک هم بر خویشتن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عاشق واقعی همیشه بر خود و احساساتش تسلط دارد، اما هر کسی که لحظه‌ای از عشق تو غافل شود، در حقیقت از عشق خود نیز غافل است."
      },
      {
        "id": 2280231,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر که از عشق تو یک دم غافل است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280232,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفته‌ای حاصل چه داری از غمم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گفته‌ای چه چیزی از غم‌هایت به دست آورده‌ای؛ اما نمی‌توان با کلام، آنچه که به خاطر درد و رنج به دست آورده‌ام را بیان کرد."
      },
      {
        "id": 2280233,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می به نتوان گفت آنچم حاصل است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280234,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا دلم در دام عشقت اوفتاد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که دلم گرفتار عشق تو شد، مانند پرنده‌ای زخمی در خون خود افتاده‌ام."
      },
      {
        "id": 2280235,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در میان خون چو مرغی بسمل است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280236,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "معطلی مطلق تویی در ملک عشق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو در دنیای عشق، به طور کامل معطل هستی و در حقیقت آنچه در دو جهان وجود دارد، به دست‌های درخواست‌کنندگان وابسته است."
      },
      {
        "id": 2280237,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر دو عالم دست‌های سایل است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280238,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا گشادی بر دل عطار دست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به منظور آرامش و راحتی دل عطار، کار سختی است و نیاز به تلاش زیادی دارد."
      },
      {
        "id": 2280239,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر دل عطار بندی مشکل است",
        "languageId": null,
        "coupletSummary": null
      }
    ],
