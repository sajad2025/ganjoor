        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ساکن گوشهٔ جهان ز جهان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در گوشه‌ای از دنیا، هیچ‌کس نیست که مانند من این‌قدر تنها باشد."
      },
      {
