    "verses": [
      {
        "id": 2280738,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای دلشده دلربای من کیست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای دل، چه کسی است که دلربایی می‌کند و من به خاطر او از جا برخاسته‌ام؟"
      },
      {
        "id": 2280739,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از جای شدم به جای من کیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280740,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیگانه شدم ز هر دو عالم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از هر دو جهان بیگانه شده‌ام، مگر آنکه آشنای من چه کسی است؟"
      },
      {
        "id": 2280741,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "واگه نه که آشنای من کیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280742,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ره گم کردم درین بیابان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در این بیابان سردرگم شده‌ام و نمی‌دانم که راه به کجا می‌برد. راهنما و هدایت‌کننده‌ام کیست که مرا به سوی هدفم راهنمایی کند؟"
      },
      {
        "id": 2280743,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کو رهبر و رهنمای من کیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280728,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جان می‌کاهم درین ره دور",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در این مسیر دشوار، تمام وجودم را فدای آن می‌کنم و می‌پرسم که چه کسی روح من را تازه می‌کند؟"
      },
      {
        "id": 2280727,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پیک ره جان‌فزای من کیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280726,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صد بار بریختند خونم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: خون من بارها ریخته شده است، اما کسی مسئول پرداخت دیه‌ام نیست."
      },
      {
        "id": 2280717,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در عهدهٔ خون‌بهای من کیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280711,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر دم گرهی عظیم افتد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر لحظه مشکلی بزرگ پیش می‌آید، اما چه کسی می‌تواند این مشکلات را حل کند؟"
      },
      {
        "id": 2280712,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در پرده گره‌گشای من کیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280713,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صد کار فتاده هر کسی را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر کس مشکلات و نگرانی‌های خودش را دارد، اما هیچ‌کس نیست که به فکر من و غم‌هایم باشد."
      },
      {
        "id": 2280714,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "غمخوارهٔ من برای من کیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280715,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "محرومم ازین طلب که دارم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من از آنچه که می‌خواهم محرومم، چون کسی که در دلش آرزوی حرم را دارد، نمی‌داند سراینده‌اش کیست."
      },
      {
        "id": 2280716,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مطلوب حرم‌سرای من کیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280718,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر من سجلی کنم درین کار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر من در این کار تظاهر به سجود کنم، تنها کسی که می‌تواند رنگ زردی چهره‌ام را ببیند، کیست؟"
      },
      {
        "id": 2280725,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جز زردی رخ گوای من کیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280719,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر گفت فرید ماجرایی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: فرید داستانی را مطرح کرد که شنیده بود، و حالا کسی نمی‌داند که داستان من چیست."
      },
      {
        "id": 2280720,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اشنودهٔ ماجرای من کیست",
        "languageId": null,
        "coupletSummary": null
      }
    ],
