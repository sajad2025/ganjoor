    "verses": [
      {
        "id": 2284851,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای دو عالم پرتوی از روی تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای دو عالم، تو نور و جمالی هستی که بهشت حقیقی در سایهٔ وجود تو قرار دارد و خاک کوی تو بیش از هر چیز دیگری ارزشمند است."
      },
      {
        "id": 2284852,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جنت الفردوس خاک کوی تو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2284853,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صد جهان پر عاشق سرگشته را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بسیاری از عاشقان در جستجوی عشق و حقیقت هستند، اما هیچ چیز نمی‌تواند جای گزین زیبایی و جذابیت تو شود."
      },
      {
        "id": 2284854,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هیچ وجهی نیست الا روی تو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2284803,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صد هزارن قصه دارم دردناک",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من داستان‌های بسیاری دارم که هر یک از آنها پر از درد و رنج است و دور از چهره تو به یاد می‌آید، هر بار که به موهای تو نگاه می‌کنم."
      },
      {
        "id": 2284838,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دور از روی تو با هر موی تو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2284802,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کور باید گشت از دید دو کون",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: برای اینکه بتوانم به تو نگاه کنم، لازم است از دیدن دو جهان و تمامی امور آن چشم بپوشم."
      },
      {
        "id": 2284764,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا توان کردن نگاهی سوی تو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2284748,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یافت هندوخان لقب بر خوان چرخ",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هندوخان به عنوان یک عنوان در دایره‌ی زندگی و سرنوشت در چرخ زمان ظاهر شد، تا زمانی که تو به زندگی‌اش آمدی و او را به هندو تبدیل کردی."
      },
      {
        "id": 2284749,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ترک گردون تا که شد هندوی تو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2284750,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پشت صد صد پهلوان می‌بشکند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: حتی اگر صدها قهرمان پشت سر هم بایستند، فقط یک نگاه جادویی تو می‌تواند همه آن‌ها را شکست دهد."
      },
      {
        "id": 2284751,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تیر یک یک غمزهٔ جادوی تو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2284752,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دی مرا خواندی به تیر غمزه پیش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو با نگاهت مرا به تیر غمزه‌ات فراخواندی تا من هم مانند کمانی از ابروی تو برانم."
      },
      {
        "id": 2284753,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا کمان بر زه کنم ز ابروی تو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2284754,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خود سپر بفکندم و بگریختم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من خود را به خطر انداختم و فرار کردم، زیرا کمان در دستان تو وجود دارد."
      },
      {
        "id": 2284755,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کان کمان هم هست بر بازوی تو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2284756,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه ز تو بگریختم از بیم سنگ",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من از تو فرار نکردم به خاطر ترس از سنگ، بلکه چون دیدم سنگ در کنار توست."
      },
      {
        "id": 2284757,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زانکه دیدم سنگ در پهلوی تو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2284758,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شد زبان در وصف تو عطار را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زبان عطار به توصیف تو به قدری زیبا و درخشان است که مانند یک رشته مروارید می‌درخشد."
      },
      {
        "id": 2284759,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درفشان چون حلقهٔ لؤلؤی تو",
        "languageId": null,
