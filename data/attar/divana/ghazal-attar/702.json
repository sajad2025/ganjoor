    "verses": [
      {
        "id": 2284976,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای مُرَقَّع‌پوش در خَمّار شو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای کسی که لباس‌های رنگارنگ به تن داری، با میگساران به صراحت و به شکل مردانه درگیر شو و در میخانه حضور پیدا کن."
      },
      {
        "id": 2284977,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با مغان مردانه اندر کار شو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2284978,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چند ازین ناموس و تزویر و نفاق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از این دروغ‌ها و تزویرها و نیرنگ‌ها دست بردار و به راست‌گویی و دینداری روی بیاور."
      },
      {
        "id": 2284979,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "توبه کن زین هر سه و دین‌دار شو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2284980,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یا برو از حلقهٔ مردانِ دین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: یا از جمع مردان دین خارج شده و به جمع کافران بپیوند."
      },
      {
        "id": 2284981,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در میان حلقهٔ کُفّار شو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2284982,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یا منادی کن اناالحق در جهان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای ندا دهنده، در دنیا اعلام کن که حقیقت وجود دارد. هنگامی که این حقیقت فاش شد، به مانند کسی که به دار (چوبه‌دار) رفته است، آماده‌ی پذیرش نتایج آن باش."
      },
      {
        "id": 2284983,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون اناالحق گفته شد بر دار شو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2284984,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون نه‌ای در کفر و در ایمان تمام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر در حقیقت کفر و ایمان نیستی، به آنچه که می‌تواند تو را به مقصد برساند، چنگ بزن و در مسیر درست قرار بگیر."
      },
      {
        "id": 2284969,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گیر زُنّاری و در خَمّار شو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2284968,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون حضورت نیست در مسجد دمی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که تو در مسجد نیستی، لحظه‌ای هم بدون لباس نیکو و آراسته نزن و خود را در زمره زاهدان و مومنان قرار بده."
      },
      {
        "id": 2284967,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی‌مُرقَّع گَرد و با زُنّار شو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2284958,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عاجزی در دین و زهدِ خویشتن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: خود را از ناتوانی در اعتقادات و زهد شخصی رهایی بخش و از این دین خالی و بی‌محتوا دوری کن."
      },
      {
        "id": 2284952,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خیز و زین دینِ تهی بیزار شو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2284953,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چند باشی در حجابِ خویش تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چند وقت در پوشش و حجاب خود باقی خواهی ماند؟ تو می‌توانی به مراتب بالای معرفت و حقیقت دست پیدا کنی."
      },
      {
        "id": 2284954,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عالمِ تجرید را عطّار شو",
        "languageId": null,
        "coupletSummary": null
      }
