    "verses": [
      {
        "id": 2291185,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دستم نرسد به زلف چون شستش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من به زلف او دسترسی ندارم، چون وقتی که او را دیدم، از دستش افتادم و به پایش رسیدم."
      },
      {
        "id": 2291186,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در پای از آن فتادم از دستش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2291187,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر مرغ هوای او شوم شاید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر دل به عشق او بسپارم، ممکن است در دست من گرفتار بسیاری از دام‌های پیچیده و معانی عمیق باشد."
      },
      {
        "id": 2291188,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صد دام معنبر است در شستش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2291189,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از لب ندهد میی و می‌داند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او از لبش جرعه‌ای نمی‌دهد و می‌داند که من به خاطر نگاه مستش در حال مستی هستم."
      },
      {
        "id": 2291190,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مخموری من ز نرگس مستش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2291191,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیچاره دلم که چشم مست او",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل بیچاره من که در برابر نگاه مست او، تمام توبه‌ها و عهدهایی که کرده بودم، با یک اشاره او به راحتی شکسته شد."
      },
      {
        "id": 2291192,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صد توبه به یک کرشمه بشکستش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2291193,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بشکفت گل رخش به زیبایی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گل زیبای چهره‌اش مانند غنچه‌ای شکفته شد و جانش را با زیبایی‌اش در آغوش گرفت."
      },
      {
        "id": 2291194,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "غنچه ز میان جان کمر بستش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2291195,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از بس که بریخت مشک از زلفش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به دلیل آنکه موهایش بویی شبیه مشک دارد و این بوی خوش به قدری زیاد است که بر اطرافش می‌ریزد، در نتیجه خاک زیر پاهایش به‌طور ناچیز و بی‌ارزش به نظر می‌رسد."
      },
      {
        "id": 2291196,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون خاک به زیر پای شد پستش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2291197,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون بود بتی چنان که در عالم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر وجود بتی باشد که در جهان به او پرستش کنند، جایی که شایسته این کار است."
      },
      {
        "id": 2291182,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بپرستندش که جای آن هستش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2291181,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یک یک سر موی من همی گوید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر یک تار موی من به من می‌گوید که به چهره‌اش نگاه کن و از پرستش او دریغ نکن."
      },
      {
        "id": 2291180,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رویش بنگر که گفت مپرستش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2291171,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نی نی که نقاب بر نمی‌دارد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هیچ چیز به اندازه‌ی نی نمی‌تواند خود را نشان دهد، و تا زمانی که خود را برهنه نکند، دیگران در برابرش قدردانی نخواهند کرد."
      },
      {
        "id": 2291165,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا سجده نمی‌کنند پیوستش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2291166,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عطار دلی که داشت در عشقش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عطار قلبی را که در عشقش به اوج رسیده بود، امیدی ندارد و دیگر نمی‌نشیند."
      },
      {
        "id": 2291167,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برخاست اومید و نیست بنشستش",
        "languageId": null,
        "coupletSummary": null
      }
