      "mainSections": null
    },
    "verses": [
      {
        "id": 2290661,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گم شدم در خود نمی‌دانم کجا پیدا شدم",
        "languageId": null,
        "coupletSummary": "چنان در خود غرق شدم که گم گشتم؛ همچون قطره‌ای که در دریا گم و غرق شود."
      },
      {
        "id": 2290659,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شبنمی بودم ز دریا غرقه در دریا شدم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290644,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سایه‌ای بودم از اول بر زمین افتاده خوار",
        "languageId": null,
        "coupletSummary": "پیش از این سایه‌ای بود که بی‌ارزش بر زمین افتاده بود به‌محض آنکه خورشید پیدا شد ناپدید شدم. (راست در اینجا قید است یعنی به‌محض آنکه‌، در همان آن)"
      },
      {
        "id": 2290645,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "راست کان خورشید پیدا گشت ناپیدا شدم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290646,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زآمدن بس بی‌نشانم وز شدن بس بی‌خبر",
        "languageId": null,
        "coupletSummary": "از آمدن چیزی نمی‌دانم و از شدن هم بی‌خبر هستم گویی آمدن و رفتن من، یک نفس بیش نبود."
      },
      {
        "id": 2290647,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گوییا یکدم برآمد کامدم من یا شدم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290648,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌مپرس از من سخن زیرا که چون پروانه‌ای",
        "languageId": null,
        "coupletSummary": "از من و از حال من چیزی مپرس زیرا همچون یک پروانه در نور و زیبایی یار خود جان‌سپار و بی‌پروا شدم."
      },
      {
        "id": 2290649,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در فروغ شمع روی دوست ناپروا شدم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290650,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در ره عشقش چو دانش باید و بی‌دانشی",
        "languageId": null,
        "coupletSummary": "در ره عشق او و برای رسیدن به او چونکه هم دانایی و هم نادانی لازم است پس من هم نادان و هم دانا شدم."
      },
      {
        "id": 2290651,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لاجرم در عشق هم نادان و هم دانا شدم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290652,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون همه تن دیده می‌بایست بود و کور گشت",
        "languageId": null,
        "coupletSummary": "چون با تمام وجود باید ببینی و همزمان نبینی پس این چیز بسیار عجیب را بنگر که هم بینا و هم نابینا شدم."
      },
      {
        "id": 2290653,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این عجایب بین که چون بینا و نابینا شدم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290654,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خاک بر فرقم اگر یک ذره دارم آگهی",
        "languageId": null,
        "coupletSummary": "خاک بر سر من بادا و ننگ بر من باد اگر یک ذره بدانم که کجا رفتم جایی که من‌ِ عاشق رفتم."
      },
      {
        "id": 2290655,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا کجاست آنجا که من سرگشته‌دل آنجا شدم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290656,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون دل عطار بیرون دیدم از هر دو جهان",
        "languageId": null,
        "coupletSummary": "وقتی که دل عطار را بیرون از هر دوجهان دیدم (دل او شیفته هیچکدام نشد) من از تاثیر دل او، عاشق و شیدا شدم."
      },
      {
        "id": 2290657,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من ز تأثیر دل او بی‌دل و شیدا شدم",
        "languageId": null,
        "coupletSummary": null
      }
    ],
