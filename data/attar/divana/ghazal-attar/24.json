        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جان من بستهٔ رضای تو است",
        "languageId": null,
        "coupletSummary": null
      },
      {
