    "verses": [
      {
        "id": 2278644,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جان به لب آوردم ای جان درنگر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من به آخرین حد خود رسیده‌ام، ای معشوق! به من نگاهی بینداز. می‌بینم نزدیک است که مانند خاک از بین بروم. فقط کمی به من توجه کن."
      },
      {
        "id": 2278643,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌شوم با خاک یکسان درنگر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2278634,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چند خواهم بود نی دنیا نه دین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بسیاری از چیزها را از دست داده‌ام و نه دنیا و نه دین توانسته‌اند مرا راضی کنند. با نگاهی به اوضاع و احوال خود، متوجه می‌شوم که گیج و آشفته‌ام."
      },
      {
        "id": 2278628,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عاجز و فرتوت و حیران درنگر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2278629,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دور از روی تو کار خویش را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی دور از توام، هیچ چیز از کارهایم را نمی‌بینم. به صورت درمانی من نگاه نکن."
      },
      {
        "id": 2278630,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌نبینم روی درمان درنگر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2278631,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌فروشم آبروی خویشتن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من آبروی خود را به خاطر تو مانند خاکی ارزان می‌فروشم. به آن بی‌اعتنایی کن و به من نگاه کن."
      },
      {
        "id": 2278632,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر درت چون خاک ارزان درنگر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2278633,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر نگه کردن به من ننگ آیدت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر برایت مایه‌ی شرم است که به من نگاه کنی، پس از دور مرا با چشم پوشیده مشاهده کن."
      },
      {
        "id": 2278635,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سوی من از دیده پنهان درنگر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2278642,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا فتادم از تو یوسف‌روی دور",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: یوسف‌چهره، وقتی که از تو دور شدم، احساس می‌کنم که در چاه و زندان محبوس هستم و به وضعیت خودم فکر می‌کنم."
      },
      {
        "id": 2278636,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مانده‌ام در چاه و زندان درنگر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2278637,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی سر زلف تو چون دیوانه‌ای",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بی‌زلف تو، مانند یک دیوانه، در بیابان سرگردان و بی‌هدف شده‌ام. فقط به من نگاه کن."
      },
      {
        "id": 2278638,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سر نهادم در بیابان درنگر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2278639,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون به جز تو ننگرم من در دو کون",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی به جز تو به هیچ‌کس و هیچ‌چیز دیگری نگاه نمی‌کنم، و در این دنیا فقط تو را می‌بینم، امیدوارم تو هم به من نگاه کنی و بر من نظر داشته باشی، ای عشق من."
      },
      {
        "id": 2278640,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو به من نیز آخر ای جان درنگر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2278641,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عشق در وصل تو عطار را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عشق به تو باعث شد عطار در دریای جدایی غرق شود، به این موضوع دقت کن."
      },
      {
        "id": 2278661,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کرد غرق بحر هجران درنگر",
        "languageId": null,
        "coupletSummary": null
      }
    ],
