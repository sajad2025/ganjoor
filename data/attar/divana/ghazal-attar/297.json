        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون بگشایی ز پای دل بند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که پرده‌ی دل را کنار بزنی و آزاد شوی، قید و بندهای جان نیز از بین می‌روند و رهایی به دست می‌آوری."
      },
      {
        "id": 2276156,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جان بند نهاد بگسلاند",
        "languageId": null,
        "coupletSummary": null
      },
      {
