        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر پرده که پیش او درآید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر چیزی که در مقابل او قرار گیرد، به خاطر قدرت عشقش کنار زده می‌شود."
      },
      {
