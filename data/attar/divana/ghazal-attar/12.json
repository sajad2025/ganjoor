        "authorUrl": "",
        "commentDate": "2019-05-13T16:34:55",
        "htmlComment": "<p>زلف او چون سایه گسترد اینت شب..</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": null,
