    "verses": [
      {
        "id": 2290865,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌شد سر زلف در زمین کش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر می‌خواستم از زیبایی و دلربایی‌ات برایت بگویم، باید سر زلف تو را به زمین می‌کشیدم. چقدر تو زیبا و دلنشینی!"
      },
      {
        "id": 2290900,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون شرح دهم تو را که آن خوش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290866,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از تیزی و تازگی که او بود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او به قدری با طراوت و زنده است که انگار همه چیز در وجودش به شدت در حال تحریک و فعالیت است؛ همچون آب و آتش که هر یک نشانگر زندگی و انرژی هستند."
      },
      {
        "id": 2290885,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گویی همه آب بود و آتش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290886,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پر کرده ز چشم نرگسینش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چشم‌های نرگسینش پر از زخم‌هایی است که از بی‌وفایی و ظلم به او رسیده است."
      },
      {
        "id": 2290887,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از تیر جفا هزار ترکش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290888,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زیر قدشم هزار مشتاق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زیر سایه من هزاران عاشق وجود دارند که من آن‌ها را دیده‌ام."
      },
      {
        "id": 2290889,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از مردم دیده کرده مفرش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290890,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جان همه کاملان ز زلفش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: جان تمامی کسانی که به کمال رسیده‌اند، از در هم‌ریختگی زلف او دچار آشفتگی می‌شود، درست مانند حالتی که سر زلف او خود به هم ریخته است."
      },
      {
        "id": 2290891,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همچون سر زلف او مشوش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290892,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "روی همه عاشقان ز عشقش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عشق او بر دل همه عاشقان آثار و نشانه‌هایی از درد و رنج به جا گذاشته است."
      },
      {
        "id": 2290893,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از خون جگر شده منقش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290894,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گل چهره و گل فشان و گل بوی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چهره‌ای زیبا و دلربا دارد، بویی خوش مانند گل منتشر می‌کند و پیشانی‌اش به مانند ماه درخشان است. این شخص، جوانی جذاب و دلنشین است."
      },
      {
        "id": 2290895,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مه طلعت و مه جبین و مهوش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290896,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صد تشنه ز خون دیده سیراب",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: صد نفر تشنه‌ی خون هستند و از چشمان آن پری، که مثل دشنه است، سیراب می‌شوند."
      },
      {
        "id": 2290897,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از دشنهٔ چشم آن پریوش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290898,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گه دل گه جان خروش می‌کرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گاهی دل و گاهی جان ناله می‌زد و می‌گفت: ای زلف سرخ و زیبا، از شانه‌ات جدا شو."
      },
      {
        "id": 2290899,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کای غالیه زلف زلف برکش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290884,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عطار ز زلف دلکش او",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عطار از زیبایی و دل‌فریبی او تا روز قیامت در حال کشمکش و چالش است."
      },
      {
        "id": 2290883,
        "vOrder": 20,
