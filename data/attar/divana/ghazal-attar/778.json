        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو بشنیدم ز جانان این سخن‌ها",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که از محبوبم این سخن‌ها را شنیدم، به او گفتم که از همه چیز دست بردار."
      },
      {
        "id": 2289357,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بدو گفتم که دست از جمله داری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2289351,
        "vOrder": 17,
