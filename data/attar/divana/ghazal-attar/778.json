        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بدان می‌داریم کز عزت خویش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بدان که می‌دانم اگر بخواهم، می‌توانم تو را به خاطر جایگاه خودم به ذلت بکشاند."
      },
      {
        "id": 2289346,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
