        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به تنهاییت بگذارم که تا تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: می‌خواهم تنهایت را به تو بسپارم تا همیشه در حالت بی‌قراری بمانی."
      },
      {
        "id": 2289348,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بمانی تا ابد در بیقراری",
        "languageId": null,
        "coupletSummary": null
      },
      {
