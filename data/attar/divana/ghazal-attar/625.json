    "verses": [
      {
        "id": 2292656,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر مردی خویشتن ببینیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر تو مرد هستی، باید خودت را در پس دوکدان ببینی و نشستن را به خودت بسپاری."
      },
      {
        "id": 2292657,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اندر پس دوکدان نشینیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2292658,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیگر نزنیم لاف مردی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دیگر تخمل نکنیم که مردانگی را به رخ بکشیم و از شرم، راه زنان را انتخاب کنیم."
      },
      {
        "id": 2292660,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وز شرم ره زنان گزینیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2292667,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کاری عجب اوفتاده ما را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کار عجیبی برای ما پیش آمده است؛ ما به مقام و حالتی رسیدیم که هم از زهر و تلخی زندگی رنج می‌بریم و هم از شیرینی و خوشی."
      },
      {
        "id": 2292661,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پیمانهٔ زهر و انگبینیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2292662,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا زهر چو انگبین نگردد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تا زمانی که زهر به شیرینی عسل تبدیل نشود، هرگز نمی‌توانیم زیبایی او را ببینیم."
      },
      {
        "id": 2292663,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یک ذره جمال او نبینیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2292664,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سر رشتهٔ دل ز دست دادیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل را از دست داده‌ایم و نمی‌دانیم که این وضعیت چیست که اکنون در آن قرار داریم."
      },
      {
        "id": 2292665,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کین چیست که ما کنون درینیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2292666,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای ساقی درد درد در ده",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای ساقی، امروز دردی که دارم را با من تقسیم کن، فراتر از مفاهیم کفر و دین است."
      },
      {
        "id": 2289491,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کامروز ورای کفر و دینیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2291870,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ما در ره یار سر ببازیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما برای رسیدن به محبوب و معشوق خود، تمام جان و دل را فدای او می‌کنیم و سپس به کارها و مسئولیت‌های خود خواهیم پرداخت."
      },
      {
        "id": 2289490,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وانگه پس کار خود نشینیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2287108,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آبی در ده صبوحیان را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما در دل خود حس شور و شوقی داریم که چون آتش می‌زند، همان‌طور که نوشیدنی زیبایی در دست صبوحیان است."
      },
      {
        "id": 2286309,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کز عشق به سینه آتشینیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2286310,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صبح رخ او پدید آمد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: صبحی که چهره زیبای او ظاهر شد، ما همه از جمله افرادی هستیم که در این خوشحالی و سرخوشی شریکیم."
      },
      {
        "id": 2286311,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ما جمله صبوحیان ازینیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2286312,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ما مستانیم و همچو عطار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما افرادی سرزنده و شادابیم و مانند عطار به خاطر حالت سرمستی‌امان احساس شرم و خجالت داریم."
      },
      {
        "id": 2286313,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از مستی خویش شرمگینیم",
        "languageId": null,
        "coupletSummary": null
      }
