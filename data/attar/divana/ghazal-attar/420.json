        "text": "بگذار جهان و در جهان باش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2291261,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "منگر تو به دیدهٔ تصرف",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به آنچه که در دنیای مادی و جدایی‌های ظاهری وجود دارد نگاه نکن و به فراتر از این دوگانگی‌ها و تفاوت‌ها توجه کن."
      },
