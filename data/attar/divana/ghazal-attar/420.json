        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2291259,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در یک قدم این جهان و آن نیز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در یک قدم می‌توانی هم در این دنیا و هم در دنیای دیگری باشی، پس بهتر است فقط در این دنیا زندگی کنی و از آن بهره‌برداری کنی."
      },
      {
        "id": 2291260,
        "vOrder": 14,
