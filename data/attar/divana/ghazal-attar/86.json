    "verses": [
      {
        "id": 2281098,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همه عالم خروش و جوش از آن است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تمام جهان به خاطر وجود یک معشوق خاص و پرجاذبه در حال تلاطم و هیجان است، حتی اگر این معشوق در حالت پنهان باشد."
      },
      {
        "id": 2281089,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که معشوقی چنین پیدا، نهان است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281083,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز هر یک ذره خورشیدی مهیاست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر یک ذره از دنیا مانند یک خورشید انرژی‌ دارد و هر قطره آب، مانند یک دریا راز و زیبایی به همراه دارد."
      },
      {
        "id": 2281084,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز هر یک قطره‌ای بحری روان است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281085,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر یک ذره را دل برشکافی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر یک ذره را بشکافی، می‌بینی که درون آن چه زندگی و جانی نهفته است."
      },
      {
        "id": 2281086,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ببینی تا که اندر وی چه جان است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281087,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از آن اجسام پیوسته است درهم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این ابیات به این معناست که تمام اجزای موجود در این جهان به یکدیگر وابسته و مرتبط هستند و هر جز درست مانند اعضای یک خانواده به یکدیگر عشق و محبت می‌ورزد. در حقیقت، این ارتباط و پیوستگی تمامی ذرات باعث ایجاد نوعی همدلی و دوستی میان آن‌ها می‌شود."
      },
      {
        "id": 2281088,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که هر ذره به دیگر مهربان است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281090,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه توحید است اینجا و نه تشبیه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در این مکان نه تنها به یگانگی خداوند اشاره‌ای شده و نه به تشابه او با چیز دیگری، نه کفر وجود دارد و نه دین خاصی. اینجا هیچ‌یک از این مفاهیم به‌طور کامل مطرح نیستند."
      },
      {
        "id": 2281097,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه کفر است و نه دین نه هر دوان است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281091,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر جمله بدانی هیچ دانی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر همه‌چیز را هم بدانی، باز هم می‌فهمی که این همه‌چیز، نشانه‌ای از بی‌نشان بودن است."
      },
      {
        "id": 2281092,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که این جمله نشان از بی نشان است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281093,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلی را کش از آنجا نیست قوتی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل‌ها از جایی که در آن هستند، قدرتی ندارند و در میان کسانی که اهل دل هستند، هیچ‌کس نمی‌تواند به راحتی از آنجا دل بکند."
      },
      {
        "id": 2281094,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "میان اهل دل دستار خوان است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281095,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل عطار تا شد غرق این راه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل عطار وقتی در این مسیر غرق می‌شود، تمام اسرار و پنهانی‌های آن به وضوح نمایان می‌شود."
      },
      {
        "id": 2281096,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همه پنهانیش عین عیان است",
        "languageId": null,
        "coupletSummary": null
      }
    ],
