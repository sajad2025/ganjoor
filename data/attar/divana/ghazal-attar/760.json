    "verses": [
      {
        "id": 2288350,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درج یاقوت درفشان کردی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو با درخشش یاقوت، خود را زیبا نشان دادی، اما در پس این زیبایی، نیت بد و قصد آسیب به جان دیگران را داشتی."
      },
      {
        "id": 2288351,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیو بودی و قصد جان کردی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2288372,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شکری خواستم از لعل لبت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از لب‌های شیرین تو خواستم که شکر باشند، و تو هر دو لب‌ات را به شکرینه‌ای پر از شکر تبدیل کردی."
      },
      {
        "id": 2288446,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر دو لب را شکرستان کردی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2288447,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتم این لحظه یافتم شکری",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گفتم که در این لحظه شکری پیدا کردم، تو آن را از زیر آستین پنهان کرده بودی."
      },
      {
        "id": 2288448,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "روی از آستین نهان کردی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2288541,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وا گرفتی ز بیدلی شکری",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از ناامیدی و درد دل من، تو با لبان زیبا و شیرین‌ات چگونه می‌توانی چنین بی‌تفاوت برخورد کنی؟"
      },
      {
        "id": 2288542,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با چنین لب چرا چنان کردی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2288543,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از سبک روحی تو این نسزد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این رفتار و روحیه تو شایسته نیست که بخواهی از روی خشم به دیگران آسیب برسانی."
      },
      {
        "id": 2288544,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر تو بر خشم سر گران کردی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2288545,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عشوه دادی مرا در اول کار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در ابتدای ارتباط، با ناز و زیبایی خود من را مسحور کردی و قلبم را از شادی در پیوند با تو پر کردی."
      },
      {
        "id": 2288546,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلم از وصل شادمان کردی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2288547,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آخر کار چون ز دست شدم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در پایان کار، هنگامی که از دست رفته بودم، چشمانم را به خاطر دوری‌ام به شدت گریان کردی."
      },
      {
        "id": 2288548,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چشمم از هجر خون‌فشان کردی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2288549,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ریختی تیر غمزه بر رویم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو با ناز و فریب خود، قلبم را نشانه گرفتی و به گونه‌ای که مانند کمان می‌چرخیدی، مرا به شدت درگیر کردی."
      },
      {
        "id": 2288550,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا مرا پشت چون کمان کردی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2288551,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون دلم پیش خود هدف دیدی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که احساس کردی قلب من به چیزی علاقه‌مند است، بدتر از آنچه که بودی، بر من تأثیر گذاشتی."
      },
      {
        "id": 2288552,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل من بد بتر از آن کردی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2288553,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن چه کردی ز جور با عطار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آن چه با عطار کردی، نشان دهنده‌ی ظالمی و اثر آن چنان است که مانند حرکت دورترین ستاره‌ها به نظر می‌رسد."
      },
      {
        "id": 2288554,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
