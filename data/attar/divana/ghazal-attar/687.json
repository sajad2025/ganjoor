        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر درآید به کنار تو فرید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر فرید به کنارت بیاید، غم تو را از دل من خواهد برد."
