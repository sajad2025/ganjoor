    "verses": [
      {
        "id": 2281904,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مفشان سر زلف خویش سرمست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زلف‌هایت را به هیچکس نده که تحت تأثیر آن، از کنترل خویش خارج شده‌ام."
      },
      {
        "id": 2281905,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دستی بر نه که رفتم از دست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281906,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دریاب مرا که طاقتم نیست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به من کمک کن، چون دیگر توان تحمل این وضعیت را ندارم. لطفاً به من انصاف بده و حقم را بده."
      },
      {
        "id": 2281907,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "انصاف بده که جای آن هست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281909,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا نرگس مست تو بدیدم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی نرگس زیبای تو را دیدم، اثر زیبایی‌ات باعث شد که من هم به شادی و مستی بروم."
      },
      {
        "id": 2281916,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از نرگس مست تو شدم مست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281910,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای ساقی ماه‌روی برخیز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای ساقی زیبا، برخیز و بگذار که این آتش تند و سوزان توبه و پشیمانی بخوابد."
      },
      {
        "id": 2281911,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کان آتش تیز توبه بنشست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281912,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در ده می کهنه ای مسلمان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در ده قدیمی، مسلمان دیگری وجود دارد که کافر قدیمی توبه‌اش را شکسته است."
      },
      {
        "id": 2281913,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کین کافر کهنه توبه بشکست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281914,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در بتکده رفت و دست بگشاد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او به کافه‌ی شراب رفت و در حالی که به دور خودش زنجیری از چرم بست، دستش را باز کرد."
      },
      {
        "id": 2281915,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زنار چهار گوشه بربست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281935,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دردی بستد بخورد و بفتاد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دردی به او دست داد و از پا درآمد و از شرم وجود خود رها شد."
      },
      {
        "id": 2281937,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وز ننگ وجود خویشتن رست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281972,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عطار درو نظاره می‌کرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عطار به دقت تماشا می‌کرد تا ببیند چه زمانی موجودی از این قفس زوال و فنا خارج می‌شود."
      },
      {
        "id": 2281938,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا زین قفس فنا برون جست",
        "languageId": null,
        "coupletSummary": null
      }
    ],
