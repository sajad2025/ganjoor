    "verses": [
      {
        "id": 2283430,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون شراب عشق در دل کار کرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که عشق مانند شرابی در دل تأثیر می‌گذارد، دل از شدت سرمستی و شوری، بسیار بی‌خود و ناخواسته می‌شود."
      },
      {
        "id": 2283431,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل ز مستی بیخودی بسیار کرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2283432,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شورشی اندر نهاد دل فتاد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل در درونش دچار شورش و آشفتگی شده و در این حال، خواهان دیدار محبوب خود است."
      },
      {
        "id": 2283434,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل در آن شورش هوای یار کرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2283441,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جامهٔ دریوزه بر آتش نهاد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: لباس درویشان را بر روی آتش گذاشت و لباس ارزشمندتری را به عنوان کمربند به دورش بست."
      },
      {
        "id": 2283435,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خرقهٔ پیروزه را زنار کرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2283436,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هم ز فقر خویشتن بیزار شد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او از فقر خود ناخشنود شد و از زهد و ریاضت خویش نیز پشیمان گردید."
      },
      {
        "id": 2283437,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هم ز زهد خویش استغفار کرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2283438,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیکویی‌هائی که در اسلام یافت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نیکی‌ها و خوبی‌هایی که در اسلام وجود دارد، در برابر جمع مغان با فداکاری و بخشش نشان داده شده است."
      },
      {
        "id": 2283439,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر سر جمع مغان ایثار کرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2283440,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از پی یک قطره درد درد دوست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به دنبال یک لحظه ناراحتی از عشق، کسی با حسرت در گوشه‌ای نشسته و به یاد محبوبش درد و غم را تحمل می‌کند."
      },
      {
        "id": 2283240,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "روی اندر گوشهٔ خمار کرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2283239,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون ببست از هر دو عالم دیده را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که چشم خود را از دیدن دنیا و هر دو عالم ببندد، در حالت بی‌خودی و فراموشی خود، به حقیقتی عمیق و زیبا می‌رسد."
      },
      {
        "id": 2283238,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در میان بیخودی دیدار کرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2283219,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هستی خود زیر پای آورد پست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وجود خود را در زیر پا گذاشت و از جایگاه بلند خود به کشف رازها پرداخت."
      },
      {
        "id": 2283036,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وز بلندی دست در اسرار کرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2283037,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنچه یافت از یاری عطار یافت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آنچه به دست آورده از کمک عطار است و آنچه انجام داده ناشی از تلاش و اراده خود اوست."
      },
      {
        "id": 2283038,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وآنچه کرد از همت عطار کرد",
