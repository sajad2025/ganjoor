        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کشته تو در فراق افتاده است",
        "languageId": null,
        "coupletSummary": null
      },
      {
