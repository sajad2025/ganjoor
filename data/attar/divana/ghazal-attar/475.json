        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در جمال تو عیان می‌یابم",
        "languageId": null,
        "coupletSummary": null
      },
