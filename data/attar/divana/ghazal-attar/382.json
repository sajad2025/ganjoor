    "verses": [
      {
        "id": 2277587,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلم دردی که دارد با که گوید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل من پر از درد و غم است و نمی‌دانم باید این را با که در میان بگذارم. خودم باعث این درد شده‌ام و حالا باید هزینه‌اش را از چه کسی بگیرم."
      },
      {
        "id": 2277588,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گنه خود کرد تاوان از که جوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2277589,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دریغا نیست همدردی موافق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: متأسفانه هیچ همدرد و همراهی وجود ندارد که در سختی‌ها و بدبختی‌های من شریک شود و مایه دلگرمی‌ام باشد."
      },
      {
        "id": 2277590,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که بر بخت بدم خوش خوش بموید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2277591,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرا گفتی که ترک ما بگفتی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو به من گفتی که ترک عشق ما دیگر هیچ‌کس نمی‌تواند ترک زندگی‌اش را بگوید."
      },
      {
        "id": 2277592,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به ترک زندگانی کس بگوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2277594,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کسی کز خوان وصلت سیر نبود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کسی که از محبت و وصال تو سیر نشده است، چرا باید دست از عشق تو بردارد؟"
      },
      {
        "id": 2277601,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چرا باید که دست از تو بشوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2277595,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز صد بارو دلم روی تو بیند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل من چنان به تو وابسته است که حتی از دورترین فاصله‌ها نیز تو را می‌بیند و بوی تو را حس می‌کند."
      },
      {
        "id": 2277596,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز صد فرسنگ بوی تو ببوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2277597,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گل وصلت فراموشم نگردد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هرگز گل وصالت را فراموش نمی‌کنم، حتی اگر خارها از خاک گورم جوانه بزنند."
      },
      {
        "id": 2277598,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وگر خار از سر گورم بروید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2277599,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "غم درد دل عطار امروز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: امروز درد دل عطار را در مورد غم و اندوهش چه باید گفت؟ آیا باید چیزی بگوید یا نه؟"
      },
      {
        "id": 2277600,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه فرمایی بگوید یا نگوید",
        "languageId": null,
        "coupletSummary": null
      }
