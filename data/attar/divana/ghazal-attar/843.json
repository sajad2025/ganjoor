    "verses": [
      {
        "id": 2287742,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز عشقت سوختم ای جان کجایی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از عشق تو سوختم، ای عزیز، تو کجایی؟ من مانده‌ام در بی‌قراری و بی‌نظمی، تو کجایی؟"
      },
      {
        "id": 2287761,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بماندم بی سر و سامان کجایی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2287762,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه جانی و نه غیر از جان چه چیزی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نه تو نفس داری و نه چیزی جز نفس، پس کجایی که نه در درون وجودی و نه در بیرون از آن؟"
      },
      {
        "id": 2287763,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه در جان نه برون از جان کجایی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2287764,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز پیدایی خود پنهان بماندی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر نتوانی خود را پنهان کنی، چرا این‌قدر از خودت دوری؟ به‌راستی که در حضور و غیاب تو چه وضعیتی وجود دارد؟"
      },
      {
        "id": 2287765,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چنین پیدا چنین پنهان کجایی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2287766,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هزاران درد دارم لیک بی تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من هزاران درد دارم، اما بدون تو هیچ کدام از دردهایم تسکین نمی‌یابد. کجایی؟"
      },
      {
        "id": 2287767,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ندارد درد من درمان کجایی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2287768,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو تو حیران خود را دست گیری",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی تو در حیرتی، من هم دستت را می‌گیرم و احساس می‌کنم که در حالتی گیج و گیج‌تر از همیشه هستم و نمی‌دانم کجا باید بروم."
      },
      {
        "id": 2287769,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز پا افتاده‌ام حیران کجایی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2287770,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز بس کز عشق تو در خون بگشتم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به خاطر عشق تو چنان در رنج و عذاب افتاده‌ام که هم ایمان و هم کفر را از دست داده‌ام؛ حالا تو کجایی؟"
      },
      {
        "id": 2287771,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه کفرم ماند و نه ایمان کجایی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2287772,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیا تا در غم خویشم ببینی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بیایید تا در دل سینه‌ام غم را ببینی، مثل این که در پیچ و خم چوگان بازی می‌کنی و نمی‌دانی کجایی."
      },
      {
        "id": 2287773,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو گویی در خم چوگان کجایی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2287774,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز شوق آفتاب طلعت تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از شوق دیدن چهره‌ی تابناک تو، مانند ذره‌ای سرگردان و گمگشته هستم. تو کجایی؟"
      },
      {
        "id": 2287775,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شدم چون ذره سرگردان کجایی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2287760,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شد از طوفان چشمم غرقه کشتی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چشمم مانند طوفانی شدید، به حدی غرق شده که نمی‌دانم کشتی‌ام کجاست. در این آشفتگی و بی‌نظمی، نمی‌دانم به کدام سمت می‌روم."
      },
      {
        "id": 2287759,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ندانم تا درین طوفان کجایی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2287758,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چنان دلتنگ شد عطار بی تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عطار به شدت از دوری تو ناراحت و افسرده است، به طوری که دنیا برای او به یک زندان تبدیل شده است. او بی‌تابانه به یاد تو است و از نبودت رنج می‌برد."
      },
      {
        "id": 2287749,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
