    "verses": [
      {
        "id": 2279025,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه سازی سرای و چه گویی سرود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آیا موسیقی می‌نوازی و چه آهنگی سر می‌دهی؟ پس این خاک سیاه را رها کن و پایین بیا."
      },
      {
        "id": 2279026,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فروشو بدین خاک تیره فرود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2279027,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یقین‌دان که همچون تو بسیار کس",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بدان که مانند تو افراد زیادی در چرخ زندگی به حالتی مشابه افتاده‌اند."
      },
      {
        "id": 2279028,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فکندست در چرخ چرخ کبود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2279029,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه برخیزد از خود و آهن تو را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر خودت را به حرکت در نیاوری، نمی‌توانی مانند آهنی سرسخت و مقاوم بشوی، چرا که زیر فشار و چالش‌ها نمی‌توانی بر خودت فایق آیی."
      },
      {
        "id": 2279030,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو سر آهنین نیست در زیر خود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2279031,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر جامهٔ عمر تو زآهن است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر زندگی‌ات مانند لباسی از آهن باشد، مرگ برای تو آن را از هم خواهد پاشید."
      },
      {
        "id": 2279016,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اجل بگسلد از همش تار و پود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2279015,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر سر کشی زین پل هفت طاق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر از این پل هفت طاق عبور کنی، مانند آب رود از سنگ و سر بالا خواهی رفت."
      },
      {
        "id": 2279014,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سر و سنگ ماننده آب رود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2279005,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز سرگشتگی زیر چوگان چرخ",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از سردرگمی ناشی از چرخش زمان، به نظر می‌رسد که نمی‌دانی بالا چیست و پایین کجاست."
      },
      {
        "id": 2278999,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو گویی ندانی فراز از فرود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2279000,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو دور سپهرت نخواهد گذاشت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی آسمان دور از تو باشد، چه فایده‌ای دارد که مانند رود، به خاطر دوری خود ناله کنی؟"
      },
      {
        "id": 2279001,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز دور سپهری چه نالی چو رود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2279002,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رفیقان هم‌راز را کن وداع",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دوستان نزدیک و همراز خود را وداع کن و به عزت و احترام به عزیزان همدرد سلام بفرست."
      },
      {
        "id": 2279003,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عزیزان همدرد را کن درود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2279004,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درخت بتر بودن از بن بکن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: درخت خراب‌تر از ریشه‌اش را بکن و از شاخه‌اش چیز خوب به دست نیاور."
      },
      {
        "id": 2279006,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز شاخ بهی کن کلوخ آمرود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2279013,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مکن همچو عطار عمر عزیز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عمر گران‌قدر خود را بیهوده و بدون هدف صرف نکن، مانند عطار که تمام زندگی‌اش را در پی شعر و سرود گذراند."
      },
      {
        "id": 2279007,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
