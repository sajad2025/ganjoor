        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زلف بر هم فکنده می‌گذرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دختران با موهای آشفته و پریشان از کنار ما می‌گذرد، در حالی که مردم نامنظم و به‌هم‌ریخته به سوی او می‌آیند."
      },
      {
        "id": 2279391,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
