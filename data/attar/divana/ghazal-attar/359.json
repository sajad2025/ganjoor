        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شهسوار سپهر از پی او",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: خورشید به دنبال او می‌رود، در حالی که او با آرامش و بدون عجله وارد می‌شود."
      },
      {
        "id": 2279406,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌رود کو پیاده می‌آید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2279390,
        "vOrder": 7,
