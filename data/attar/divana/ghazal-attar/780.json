        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گاهگاهی شکری می‌دهدم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گاهی اوقات، در حین عبور از جایی، به نشانه‌ی قدردانی، شکر و سپاسگزاری می‌کنم."
      },
      {
        "id": 2289388,
        "vOrder": 10,
