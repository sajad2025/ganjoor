    "verses": [
      {
        "id": 2281376,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا کی از صومعه خمار کجاست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تا چه زمانی باید در این مکان خشک و بی‌روح بمانم؟ جایی که در آن اثری از شادابی و فهم عمیق نیست و تنها به ظواهر توجه می‌شود. من دیگر تحمل این وضعیت را ندارم و به دنبال راهی جدید هستم."
      },
      {
        "id": 2281342,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خرقه بفکندم زنار کجاست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281361,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سیرم از زرق فروشی و نفاق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از فریب و دروغ‌گویی در عشق خسته‌ام، به دنبال کسی هستم که اسرار عشق را بداند و به من کمک کند."
      },
      {
        "id": 2281362,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عاشقی محرم اسرار کجاست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281363,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون من از بادهٔ غفلت مستم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این بیت بیانگر حالتی است که شاعر در آن تحت تأثیر غفلت و بی‌خبری قرار دارد و به دنبال یاری و هدایت از کسی است که آگاه و هوشیار باشد. او به نوعی احساس تنهایی و نیاز به راهنمایی می‌کند و از بودن آن معشوق مطلع و بیدار خود ابراز نارضایتی می‌کند."
      },
      {
        "id": 2281364,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن بت دلبر هشیار کجاست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281365,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همه کس طالب یارند ولیک",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: همه افراد به دنبال دوستان و همراهان خوب هستند، اما کسی که فقیر و بی‌نواست، چشمانش به دنبال یاری روشن و مشخص می‌گردد."
      },
      {
        "id": 2281366,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مفلسی مست پدیدار کجاست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281367,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همه در کار شدیم از پی خویش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: همه ما مشغول تلاش و فعالیت هستیم، اما برای انجام این کار کسی که به طور کامل شایسته و مناسب باشد کجاست؟"
      },
      {
        "id": 2281368,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کاملی در خور این کار کجاست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281369,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گرچه مردم همه در خواب خوشند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: با وجود اینکه همه مردم در خواب و غفلت به سر می‌برند، کسی که باهوش و با دل آگاه است، کجا می‌تواند باشد؟"
      },
      {
        "id": 2281370,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زیرکی پر دل بیدار کجاست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281371,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "روز روشن همگان در خوابند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در روز که همه در خواب به سر می‌برند، عاشق واقعی و ماهر کجاست که خود را نشان دهد؟"
      },
      {
        "id": 2281372,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شبروی عاشق عیار کجاست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281373,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر گ پیرند همه پرده‌دران",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر همه افراد با تجربه و بزرگ‌سالان در جامعه به خاطر عیب و نقص‌های خود شرمنده باشند، پس آن شخص خوش‌معرفت و با اخلاق که در میان مردم است، کجاست؟"
      },
      {
        "id": 2281374,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یوسفی بر سر بازار کجاست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281375,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همه در جام بماندیم مدام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: همه ما در گودال ماندیم و به طور مداوم نشانه‌ای از مسیر و نزدیک بودن معشوق پیدا نکردیم."
      },
      {
        "id": 2281360,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اثر گرد ره یار کجاست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281359,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گشت عطار در این واقعه گم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عطار در این حادثه گم شده و از خود بی‌خبر است. او در میان این رویدادها حضور دارد، اما نمی‌داند که کجاست یا در چه وضعیتی قرار دارد."
      },
      {
        "id": 2281358,
        "vOrder": 20,
