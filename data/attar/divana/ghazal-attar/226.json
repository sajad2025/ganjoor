    "verses": [
      {
        "id": 2276537,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عشق آمد و آتشی به دل در زد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عشق به دل من ورود کرد و شعله‌ای آتشین افروخت تا اینکه دلم به طور سرزده و بدون فکر، شروع به صحبت درباره معشوق کرد."
      },
      {
        "id": 2276538,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا دل به گزاف لاف دلبر زد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2276539,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آسوده بدم نشسته در کنجی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من در گوشه‌ای آرام و بی‌خیال نشسته بودم که ناگهان غم عشق به سراغم آمد و بر در زد."
      },
      {
        "id": 2276540,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کامد غم عشق و حلقه بر در زد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2276525,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شاخ طربم ز بیخ و بن برکند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من از شدت شوق و شادی به همه چیز پشت کردم و تمام آنچه را که داشتم، به هم ریختم."
      },
      {
        "id": 2276524,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر چیز که داشتم به هم بر زد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2276523,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتند که سیم‌بر نگار است او",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گفتند که این زیبای نازنین به مانند نقره است. به همین خاطر وقتی به خاطر او به صورتش نگاه می‌کنم، حسرت و آرزو برایم ایجاد می‌کند."
      },
      {
        "id": 2276514,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا رویم از آرزوی او زر زد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2276508,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "طاوس رخش چو کرد یک جلوه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که طاوس زیبای رخش خود را به نمایش گذاشت، عقل من مانند مگسی بی‌اختیار دو دست بر سرش زد."
      },
      {
        "id": 2276509,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عقلم چو مگس دو دست بر سر زد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2276510,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از چهرهٔ او دلم چو دریا شد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چهرهٔ او برای من حالتی مانند دریا به وجود آورد و مانند دریا که امواجی از جواهرات را به نمایش می‌گذارند، من نیز احساسات و زیبایی‌های عمیق را در دل دارم."
      },
      {
        "id": 2276511,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دریا دیدی که موج گوهر زد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2276512,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عطار چو آتشین دل آمد زو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عطار با دل آتشین و پرشور خود به جمع ما پیوست، و هر بار که از میان خاکسترها بیرون می‌آید، شعله‌ای از انرژی و هیجان به همراه دارد."
      },
      {
        "id": 2276513,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر دم که زد از میان اخگر زد",
        "languageId": null,
        "coupletSummary": null
      }
