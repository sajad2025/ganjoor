    "verses": [
      {
        "id": 2292034,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گرچه در عشق تو جان درباختیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هرچند که در عشق تو جان خود را فدای تو کردیم، اما ارزش و اهمیت عشق تو را درک نکردیم."
      },
      {
        "id": 2292054,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "قیمت سودای تو نشناختیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2292056,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سالها بر مرکب فکرت مدام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: سال‌ها با تلاش و تفکر مستمر، در مسیر رسیدن به آرزوی تو وقت و انرژی صرف کردیم."
      },
      {
        "id": 2292091,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در ره سودای تو می‌باختیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2292057,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خود تو در دل بودی و ما از غرور",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو همیشه در دل ما حضور داشتی، اما ما به خاطر تکبر و خودخواهی‌مان لحظه‌ای با تو ارتباط برقرار نکردیم."
      },
      {
        "id": 2292076,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یک نفس با تو نمی‌پرداختیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2292077,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون بگستردی بساط داوری",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که محبت و عشق تو را گسترش دادی و شرایط قضاوت درباره‌اش را فراهم کردی، جان و دل خود را فدای آن کردم."
      },
      {
        "id": 2292078,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پیش عشقت جان و دل درباختیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2292079,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر دوعالم سرفرازی یافتیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما در دنیا و آخرت عزت و سربلندی به دست آوردیم، تا برای عشق تو سر خود را خم کنیم و خود را فدای تو کنیم."
      },
      {
        "id": 2292080,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا به سودای تو سر بفراختیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2292081,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آتش عشقت درآمد گرد دل",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عشق تو همچون آتش به قلب ما نفوذ کرد و ما مانند شمعی که در اثر حرارت می‌ذوب شود، از شدت این عشق ذوب شدیم."
      },
      {
        "id": 2292082,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ما چو شمع از تف آن بگداختیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2292083,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر امید وصل تو پروانه‌وار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به خاطر امید دیدار تو، مانند پروانه به سوی آتش روانه شدم و خود را در آتش عشق تو انداختم."
      },
      {
        "id": 2292084,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خویشتن در آتشت انداختیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2292085,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گاه چون پروانه‌ای می‌سوختیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گاهی مانند پروانه‌ای می‌سوختیم و گاهی با همین سوختن کنار می‌آمدیم و زندگی‌ می‌کردیم."
      },
      {
        "id": 2292086,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گاه با آن سوختن می‌ساختیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2292087,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همچو عطار از جهان بردیم دست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مانند عطار، از دنیا کناره گرفتیم تا بتوانیم به صدای درد تو گوش بسپاریم."
      },
      {
        "id": 2292088,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا نوای درد تو بنواختیم",
        "languageId": null,
        "coupletSummary": null
      }
