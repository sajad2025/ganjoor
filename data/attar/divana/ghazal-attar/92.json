    "verses": [
      {
        "id": 2281061,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شیر در کار عشق مسکین است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در عشق، شیر هم ناتوان و درمانده است؛ عشق را ببین که چقدر با قدرت و وقار عمل می‌کند."
      },
      {
        "id": 2281052,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عشق را بین که با چه تمکین است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281046,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نکشد کس کمان عشق به زور",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عشق به زور به کسی آسیب نمی‌زند، زیرا عشق واقعی برتر از قدرت همه سلاطین است."
      },
      {
        "id": 2281047,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عشق شاه همه سلاطین است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281048,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلم از دلبران بتی بگزید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل من از میان دلبران، معشوقی را برگزید که چهره‌اش همچون ماه و ستاره‌های پروین زیباست."
      },
      {
        "id": 2281049,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کو به رخ همچو ماه و پروین است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281050,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از لطیفی که هست آن دلبر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دلبر زیبا و لطیفی که می‌شناسیم، باعث فخر و افتخار زیبایان در سرزمین‌های چین و ماچین محسوب می‌شود."
      },
      {
        "id": 2281051,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فخر خوبان چین و ماچین است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281053,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وصف خوبی او چه دانم گفت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نمی‌دانم چطور وصف زیبایی او را بیان کنم، چرا که هر چه هم بگویم، تنها قطره‌ای از دریا خواهد بود."
      },
      {
        "id": 2281060,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هرچه گویم هزار چندین است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281054,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خوب رویی شگرف گفتاری",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زیبایی تو با کلامی شگفت‌انگیز همراه است که همچون فرشته‌ها رفتار می‌کند."
      },
      {
        "id": 2281055,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که به صورت فرشته آیین است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281056,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن نگاری که روی او قمر است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آن معشوقی که چهره‌اش مانند ماه می‌درخشد، موهایش مانند مشک خوشبو و معطر است."
      },
      {
        "id": 2281057,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "طره‌اش مشک عنبرآگین است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281058,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من چو فرهاد در غمش زارم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من مانند فرهاد به خاطر عشق او غمگینم، زیرا او زیبایی و جاذبه خاصی دارد."
      },
      {
        "id": 2281059,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کو به حسن و جمال شیرین است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280859,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صفتش در زمانه ممتاز است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ویژگی‌های او در این زمان بی‌نظیر است و دیدن او روح را به دانایی و آگاهی می‌رساند."
      },
      {
        "id": 2280858,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیدنش روح را جهان بین است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280857,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن ستم کز صنم کشید فرید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آن ظلم و ستمی که فرید از معشوق خود متحمل شده، بدون شک باعث آسیب به دل و ایمان او شده است."
      },
      {
        "id": 2280838,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی‌گمان آفت دل و دین است",
        "languageId": null,
        "coupletSummary": null
      }
