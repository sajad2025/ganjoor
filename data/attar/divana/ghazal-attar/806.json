        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ساقی تو بیا و بر کفم نه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای ساقی، بیا و در دستم یک کوزه آب زندگی بریز."
      },
      {
        "id": 2287583,
        "vOrder": 16,
