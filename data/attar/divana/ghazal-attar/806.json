        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یک قطره شراب در صبوحی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بهتر است برای شروع روز، یک قطره شراب به ما بچشانی."
      },
      {
        "id": 2287630,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
