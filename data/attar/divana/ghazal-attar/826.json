        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من برای تو تو برای منی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2288136,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر نمانم من ای صنم روزی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر من روزی دیگر در کنار تو نباشم، تو که جان من هستی، جای من خواهی بود."
      },
      {
        "id": 2288137,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو که جان منی بجای منی",
        "languageId": null,
        "coupletSummary": null
      },
