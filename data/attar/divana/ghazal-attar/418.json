    "verses": [
      {
        "id": 2291023,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای دل اگر عاشقی در پی دلدار باش",
        "languageId": null,
        "coupletSummary": "محمدحسین شکرچی: ای دل، اگر عاشقِ واقعیِ معشوقِ خود هستی، همواره دنباله رو و مطیع محبوبِ خود باش و بر درِ درگاهِ معشوقِ خود آماده و حلقه بگوشِ فرمانِ او باش."
      },
      {
        "id": 2291030,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر در دل روز و شب منتظر یار باش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2291024,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلبر تو دایماً بر در دل حاضر است",
        "languageId": null,
        "coupletSummary": "محمدحسین شکرچی: معشوق واقعی لحظه به لحظه و آن به آن آنچه تو طلب کنی یا طلب نکنی را برای تو محیا و آماده کرده است، بیدار و آگاه باش که معشوقِ تو از خودت به درونت آگاهتر است پس با او راز و نیاز کن و اسرارت را با او در میان بگزار ."
      },
      {
        "id": 2291025,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رو در دل برگشای حاضر و بیدار باش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2291026,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیدهٔ جان روی او تا بنبیند عیان",
        "languageId": null,
        "coupletSummary": "محمدحسین شکرچی: توانِ دیدن آشکارِ نظرِ شفادهندهِ (پاک کننده)  معشوق را عاشق ندارد، برای دستیابی به لطف معشوق حیا و پاکدامنی پیشه کن (خیره و گستاخ نباش)."
      },
      {
        "id": 2291027,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در طلب روی او روی به دیوار باش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2291028,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ناحیت دل گرفت لشگر غوغای نفس",
        "languageId": null,
        "coupletSummary": "محمدحسین شکرچی: خواسته‌های زیادی، عاشق را احاطه میکند و مانع از خواستن خودِ معشوق می‌شود، بنابرین تو، سعی کن دراین تله نیوفتی و هوشیار باش که جز خودِ معشوق از معشوق چیز دیگری نخواهی."
      },
      {
        "id": 2291029,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پس تو اگر عاشقی عاشق هشیار باش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2291106,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیست کس آگه که یار کی بنماید جمال",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هیچ‌کس نمی‌داند محبوب در چه زمانی زیبایی‌اش را نشان خواهد داد، اما تو حداقل به حال و روز خود رسیدگی کن و کاری که در دست داری را با دقت انجام بده."
      },
      {
        "id": 2291126,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لیک تو باری به نقد ساختهٔ کار باش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2291255,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در ره او هرچه هست تا دل و جان نفقه کن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در مسیر او، هر چیزی که داری را برای او خرج کن، حتی اگر به قیمت جانت باشد. تو باید از همه چیز و همه کس بری باشی و فقط به او زندگی کنی."
      },
      {
        "id": 2291127,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو به یکی زنده‌ای از همه بیزار باش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2291220,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر دل و جان تو را دُرّ بقا آرزوست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر آرزوی جاودانگی و بقا در دل و جانت وجود دارد، بهتر است سکوت کنی و در این دنیا با آگاهی به فنا و زوال زندگی کنی، مانند عطار که به این حقیقت می‌اندیشید."
      },
      {
        "id": 2291221,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دم مزن و در فنا همدم عطار باش",
        "languageId": null,
        "coupletSummary": null
      }
    ],
