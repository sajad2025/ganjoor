    "verses": [
      {
        "id": 2290106,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا عشق تو را به جان ربودم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی عشق تو در عمق وجودم نفوذ کرد، هیچ‌گاه بدون درد و رنج تو را احساس نکردم."
      },
      {
        "id": 2290107,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی درد تو یک نفس نبودم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290108,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از روز ازل هنوز مستم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از آغاز روزگار تا به امروز همچنان در حال شادی و سرمستی هستم و به خاطر عشق و احساس خود در حال سجده و عبادت هستم."
      },
      {
        "id": 2290109,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وز شوق الست در سجودم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290110,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتی که جمال خود نمایم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو گفتی که زیبایی‌ام را به نمایش بگذارم، این سخن را از کمال تو دریافتم."
      },
      {
        "id": 2290111,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این خود ز کمال تو شنودم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290112,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در آتش هجر انتظارم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در آتش جدایی منتظر می‌مانم و وجودم در این حال می‌سوزد."
      },
      {
        "id": 2290113,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌سازم و سوخت این وجودم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290114,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی لطف تو بوی خوش ندارم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بدون محبت و kindness تو، حتی اگر همه عطرهای خوشبو را داشته باشم، باز هم بویی خوش ندارم."
      },
      {
        "id": 2290115,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر جمله گلاب و مشک و عودم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290116,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از بوی جگر که می‌گدازم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی بوی جگر به مشامم می‌رسد، احساس می‌کنم که بسیار بالا و در اوج آسمان قرار دارم و دود من به آسمان می‌رود."
      },
      {
        "id": 2290117,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر اوج فلک رسید دودم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290118,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مفتاح هدایتم تو دادی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو کلید هدایت را به من دادی و من با آن درهای دانایی را گشودم."
      },
      {
        "id": 2290119,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنگه در اهلیت گشودم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290104,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در عشق تو یافتم سعادت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در عشق تو، بارها به خوشبختی دست یافتم و درونم را از هر چیزی خالی کردم."
      },
      {
        "id": 2290103,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صد باره درون خود زدودم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290102,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نامم ز تو زان شده است عطار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نام من به خاطر تو عطار شده است، زیرا زیبایی تو باعث شده که من عارفی شوم."
      },
      {
        "id": 2290093,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کز حسن تو عارفی نمودم",
