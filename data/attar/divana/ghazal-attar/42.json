    "verses": [
      {
        "id": 2281844,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنکه چندین نقش ازو برخاسته است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آن کسی که از او نقوش و طرح‌های زیادی ایجاد شده، ای پروردگار، او در پس پرده به چه زیبایی آراسته شده است."
      },
      {
        "id": 2281843,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یارب او در پرده چون آراسته است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281842,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون ز پرده دم به دم می تافته است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر لحظه, پرده‌ای از رازها و دنیای هستی کنار می‌رود و به همین نسبت, از دنیا و حقایق کاسته می‌شود."
      },
      {
        "id": 2281833,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر دو عالم دم به دم می‌کاسته است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281827,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون شود یک ره ز پرده آشکار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که یک بار از پرده پنهانی بیرون بیایی و خود را نشان دهی، باید بدانید که قیامت به پا شده است."
      },
      {
        "id": 2281828,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو یقین دان کان قیامت خاسته است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281829,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "محو گردد در قیامت زان جمال",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در روز قیامت، هر کسی که زیبایی را در این دنیا به نوعی به تصویر کشیده باشد، تحت تأثیر آن جمال الهی محو و نابود خواهد شد."
      },
      {
        "id": 2281830,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر که نقشی در جهان پیراسته است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281831,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ذره‌ای معشوق کی آید پدید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: یک ذره از معشوق چگونه می‌تواند نمایان شود، در حالی که دو جهان پر از طلا و خواسته‌هاست."
      },
      {
        "id": 2281832,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون دو عالم پر زر و پر خواسته است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281834,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در قیامت سوی خود کس ننگرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در روز قیامت، هیچ‌کس به سوی دیگری نگاه نمی‌کند، زیرا زیبایی و جلال الهی آن‌قدر شگفت‌انگیز است که همه را مجذوب خود می‌کند."
      },
      {
        "id": 2281841,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون جمال آن چنان آراسته است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281835,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ذره‌ای گشت است ظاهر زان جمال",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: یک ذره از زیبایی او نمایان شده است و از شتاب و هیجان آن، شوری در تمام جهان به وجود آمده است."
      },
      {
        "id": 2281836,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شور از هر دو جهان برخاسته است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281837,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای فرید اینجا چه خواهی کار و بار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای فرید، در اینجا چه می‌کنی؟ کار و زندگی‌ات در مسیر نادرست و نادانی است."
      },
      {
        "id": 2281838,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "راه تو نادانی و ناخواسته است",
        "languageId": null,
        "coupletSummary": null
      }
    ],
