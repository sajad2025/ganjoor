        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عمر بر من شتاب می‌آرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
