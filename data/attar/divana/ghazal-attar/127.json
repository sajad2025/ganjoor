        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حلقه‌در‌گوشِ حلقهٔ گوشت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2283705,
