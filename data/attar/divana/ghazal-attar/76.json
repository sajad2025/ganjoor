    "verses": [
      {
        "id": 2280240,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رَه میخانه و مسجد کدام است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به کدام مسیر می‌توانم بروم که هم راه میخانه باشد و هم مسجد، در حالی که هر دو برای من انسان درمانده ممنوع است؟"
      },
      {
        "id": 2280241,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که هر دو بر مَنِ مِسکین حرام است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280189,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه در مسجد گذارندم که رِند است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نه در مسجد راه می‌دهندم چون اهل رندی‌ام، و نه در میخانه که شرابش نارس و بی‌کیفیت است."
      },
      {
        "id": 2280188,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه در میخانه کین خَمّار، خام است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280187,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "میان مسجد و میخانه راهی است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در میان مسجد و میخانه، راهی وجود دارد که باید آن را جستجو کنید، ای عزیزان! این راه چیست که انسان را به دو سوی مختلف می‌برد؟"
      },
      {
        "id": 2280150,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بجویید ای عزیزان کین کدام است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280134,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به میخانه اِمامی مَست خُفته است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در میخانه، با حالتی مست خوابیده است و نمی‌دانم آن معشوق را چه نامی می‌گذارند."
      },
      {
        "id": 2280135,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نمی‌دانم که آن بُت را چه نام است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280136,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مَرا کعبهِ خَرابات است امروز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: امروز برای من، مکان مقدس عبادت همان خرابه‌ای است که در آنجا لذت و خوشی بیابم. در این محیط، داورم قاضی است و کسی که شراب می‌ریزد، امام من است."
      },
      {
        "id": 2280137,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حریفم قاضی و ساقی اِمام است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280138,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برو عطار کو خود می‌شناسد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: برو سراغ عطار که خودش می‌داند که چه کسی بزرگتر و معتبرتر است و در میان این بی‌خبرها، چه کسی در جستجوی حقیقت است."
      },
      {
        "id": 2280139,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که سَروَرْ کیست، سَرگردان کدام است",
        "languageId": null,
        "coupletSummary": null
      }
