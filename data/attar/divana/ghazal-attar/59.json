    "verses": [
      {
        "id": 2280317,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن دهان نیست که تنگ شکر است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این جمله بیانگر این است که آن دهان، برای شیرینی مناسب و تنگ نیست و همچنین آن میان، برای داشتن موهای متفاوت و متفاوت نیست. در واقع، اشاره به این دارد که ویژگی‌های مورد نظر در آن‌ها وجود ندارد."
      },
      {
        "id": 2280308,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وان میان نیست که مویی دگر است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280302,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زان تنم شد چو میانت باریک",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بدن من به خاطر تو مثل گلویم تنگ و باریک شده، چون دل من از حرف‌ها و عشق تو بیشتر تنگ می‌شود."
      },
      {
        "id": 2280303,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کز دهان تو دلم تنگ‌تر است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280304,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به دهان و به میانت ماند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در این بیت، اشاره به این دارد که چیزی یا کسی مانند یک سوزن است که در دو رشته قرار دارد. به گونه‌ای که اگر به آن نگاه کنی، می‌توانی احساس کنی که در نگاهش نوعی عمق و دقت وجود دارد. در واقع، این تصویر نشان‌دهنده‌ی ظرافت و توجه خاص در ارتباط با دیگران یا در مواجهه با احساسات و روابط است."
      },
      {
        "id": 2280305,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چشم سوزن که به دو رشته در است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280306,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر که مویی ز میان و ز دهانت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر که از میانه‌ی خود یا از دهانش خبری بگوید، در واقع از حقیقت بی‌خبر است."
      },
      {
        "id": 2280307,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خبری باز دهد بی‌خبر است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280309,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از میان تو سخن چون مویی است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: سخنان تو در مقایسه با سخنان دیگران بسیار شیرین و دلنشین است. حرف‌هایی که تو می‌زنی ارزش و لطافت ویژه‌ای دارند."
      },
      {
        "id": 2280316,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وز دهان تو سخن چون شکر است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280310,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه کمر را ز میانت وطنی است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نه کمر از میانت وطن است و نه سخن از دهانت عبور می‌کند."
      },
      {
        "id": 2280311,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه سخن را ز دهانت گذر است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280312,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "میم دیدی که به جای دهن است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این بیت به زیبایی و جذابیت اندام اشاره دارد. در آن به زینت و جلوه موی سر که در پایین کمر قرار دارد، اشاره شده و نشان می‌دهد که زیبایی‌های طبیعی در برخی نقاط بدن وجود دارد و می‌تواند توجه فرد را جلب کند."
      },
      {
        "id": 2280313,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "موی دیدی که میان کمر است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280314,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه میان چون الفی معدوم است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: میان انسان‌ها مانند چیزی ناپیدا است، اما دهان او مانند صدفی پر از گنجینه‌های باارزش است."
      },
      {
        "id": 2280315,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه دهان چون صدفی پر گوهر است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280392,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون میان تو سخن گفت فرید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی فرید با تو سخن می‌گوید، مانند این است که تو به اندازه او صحبت می‌کنی، چون صدای تو به اندازه او معروف است."
      },
      {
        "id": 2280412,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون دهان تو از آن نامور است",
        "languageId": null,
        "coupletSummary": null
      }
    ],
