    "verses": [
      {
        "id": 2281323,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن نه روی است ماه دو هفته است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آنچه که می‌بینید، چهره‌ای زیباست که به زودى تغییر می‌کند و آن، قامت استوار و بلند مثل سرو، از بین رفته است."
      },
      {
        "id": 2281322,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وان نه قد است سرو بررَفته است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281321,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پیش ماه دو هفتهٔ رخ تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در روزهای پیش رو، چهره تو چون ماه است و نور خورشید مانند نوری است که در مقایسه با زیبایی تو کودکانه به نظر می‌رسد."
      },
      {
        "id": 2281312,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ماه و خورشید طفل یک هفته است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281306,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ذره‌ای عشق آفتاب رخش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: یک ذره عشق از زیبایی او، در دل همه افراد نفوذ کرده و مورد پذیرش قرار گرفته است."
      },
      {
        "id": 2281307,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همه دلها به جان پذیرفته است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281308,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نرگس اوست ای عجب بیمار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نرگس او، یعنی چشمان زیبا و خاص او، باعث حیرت شده است. تعجب‌آور است که دل‌های عاشقان از درد و غم او پر شده و مبتلا به اندوه هستند."
      },
      {
        "id": 2281309,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل عشاق درد بگرفته است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281310,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر کجا صف کشیده مژه او",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر جا که مژه‌های او صف بسته‌اند، شور و آشوب حاکم است و آرامش به خواب رفته است."
      },
      {
        "id": 2281311,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فتنه بیدار و عافیت خفته است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281313,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از دهانش که هست معدومی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آنچه از دهانش خارج می‌شود، نشانه‌ای از وجود ندارد و جهان به شدت در هم ریخته و آشفته است."
      },
      {
        "id": 2281320,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیست عالم تهی پر آشفته است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281314,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به دهانش خوش آمد است محال",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر کسی از دهان او چیزی گفته باشد، ابداً نمی‌توان آن را باور کرد."
      },
      {
        "id": 2281315,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر که حرفی از آن دهان گفته است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281316,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در دهانش که هست سی و دو در",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در دهان او، سی و دو دندان وجود دارد که پشت آنها یک سنگ قیمتی درخشان و ناب نهفته است."
      },
      {
        "id": 2281317,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در پس یک عقیق ناسفته است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281318,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌نبینی دهانش اگر بینی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر دقت کنی، متوجه نخواهی شد که او چه قدر زیرک و باهوش است، آن کس که در پنهان چیزهای زیادی را نگه داشته است."
      },
      {
        "id": 2281319,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کاشکار است آنکه بنهفته است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2281339,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا درافشان شد از دهانش فرید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که فرید صحبت کرد، نوری از دهانش ساطع شد و بر قله‌ی عالمش درخشید."
      },
      {
        "id": 2281341,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
