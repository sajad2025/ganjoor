        "languageId": null,
        "coupletSummary": "هوش مصنوعی: لحظه‌ای آرام بنشین که این دل سرمست مانند باد به هر گوشه‌ای می‌وزد."
      },
      {
        "id": 2288183,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون باد همی رود به هر سوی",
        "languageId": null,
        "coupletSummary": null
      },
      {
