    "verses": [
      {
        "id": 2280295,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آتش عشق تو در جان خوشتر است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عشق تو همچون آتش در وجودم دلپذیرتر است و جانم با شعله‌های عشق تو شاداب‌تر و زنده‌تر می‌شود."
      },
      {
        "id": 2280296,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جان ز عشقت آتش‌افشان خوشتر است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280297,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر که خورد از جام عشقت قطره‌ای",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر کس که حتی یک قطره از عشق تو را بنوشد، تا آخر عمرش شاد و گیج و سرمست خواهد بود و این حالت برایش بهتر از هر چیز دیگری است."
      },
      {
        "id": 2280282,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا قیامت مست و حیران خوشتر است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280281,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا تو پیدا آمدی پنهان شدم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی تو ظاهر شدی، من پنهان شدم، زیرا بودن با معشوق در خفا زیباتر و لذت‌بخش‌تر است."
      },
      {
        "id": 2280280,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زانکه با معشوق پنهان خوشتر است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280271,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درد عشق تو که جان می‌سوزدم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگرچه درد عشق تو جانم را می‌سوزاند، اما اگر همه زهر دنیا باشد، باز هم از جان خوشایندتر است."
      },
      {
        "id": 2280265,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر همه زهر است از جان خوشتر است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280266,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درد بر من ریز و درمانم مکن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: درد را به جانم بریز و مرا درمان نکن، زیرا این درد تو برای من از هر درمانی لذت‌بخش‌تر است."
      },
      {
        "id": 2280267,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زانکه درد تو ز درمان خوشتر است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280268,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌نسازی تا نمی‌سوزی مرا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو کاری نکن که من بسوزم، چرا که سوختن در عشق تو برای من بهتر از این است که بدون عشق تو زندگی کنم."
      },
      {
        "id": 2280269,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سوختن در عشق تو زان خوشتر است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280270,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون وصالت هیچکس را روی نیست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که هیچ‌کس را به عنوان محبوب و وصل نمی‌بینی، با این حال بهتر است که در دیوار فاصله از او تصویرش را ببینی."
      },
      {
        "id": 2280272,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "روی در دیوار هجران خوشتر است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280279,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خشک سال وصل تو بینم مدام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در هر سالی که تو در کنارم نیستی، همیشه احساس خشکی می‌کنم. بنابراین، بهتر است در دلم طوفانی از عشق و اشتیاق بوجود بیاید تا این کمبود را پر کند."
      },
      {
        "id": 2280273,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لاجرم در دیده طوفان خوشتر است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2280274,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همچو شمعی در فراقت هر شبی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مثل یک شمع، در نبود تو هر شب تا صبح گریه می‌کنم و این برایم زیباتر است."
      },
      {
        "id": 2280275,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا سحر عطار گریان خوشتر است",
        "languageId": null,
        "coupletSummary": null
      }
    ],
