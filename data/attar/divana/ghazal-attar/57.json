        "authorName": "فرامرز شالمایی",
        "authorUrl": null,
        "commentDate": "2022-09-16T08:02:29.4716351",
        "htmlComment": "<p>استاد شجریان این شعر را عالی اجرا می کند&nbsp;</p>",
        "publishStatus": "",
        "inReplyToId": null,
