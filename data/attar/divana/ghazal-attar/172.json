        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر یک علوی جهود گردد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2282451,
        "vOrder": 15,
