        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر دم که به نفس می برآری",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر بار که نفس می‌کشی، در چشم دل مانند دود می‌شود."
      },
      {
        "id": 2282452,
        "vOrder": 16,
