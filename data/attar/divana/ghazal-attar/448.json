        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "واله و سرگشته در صحرای عشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2291760,
        "vOrder": 9,
