    "verses": [
      {
        "id": 2290087,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا عشق تو سوخت همچو عودم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی عشق تو در وجودم شعله‌ور شد، دیگر هیچ چیز از من باقی نماند."
      },
      {
        "id": 2290088,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یک ذره نماند از وجودم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290089,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا بگذشتی چو باد بر من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی عبور کردی مانند بادی که از کنار می‌گذرد، من در حالتی از تسلیم و فروتنی بر زمین افتاده‌ام."
      },
      {
        "id": 2290090,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر خاک فتاده در سجودم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290091,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یک لحظه ز تو نمی‌شکیبم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من حتی یک لحظه هم نمی‌توانم دوری از تو را تحمل کنم، بارها و بارها این احساس را تجربه کرده‌ام."
      },
      {
        "id": 2290092,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خود را صد ره بیازمودم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290094,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عشقت چو نشست در دلم ساخت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی عشق تو در قلبم جای گرفت، تمام دغدغه‌ها و نگرانی‌های من درباره سود و زیان از بین رفت."
      },
      {
        "id": 2290101,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برخاست ز ره زیان و سودم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290095,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از جوهر عشق هر دو عالم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر ذره‌ای از عشق موجود در جهان را داشتم، می‌توانستم عطر و زیبایی آن را به نمایش بگذارم."
      },
      {
        "id": 2290096,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یک ذره ز خویش می‌نمودم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290097,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون نیک به خود نگاه کردم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی به خودم نگاه کردم، متوجه شدم که در واقع در میانه وجود ندارم."
      },
      {
        "id": 2290098,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من خود به میانه در نبودم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290099,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون من به خودی نبود گشتم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که به خودم نگاه نمی‌کردم، تبدیل به آینه‌ای شدم که جهانیان را در خود بازتاب می‌دهد."
      },
      {
        "id": 2290100,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آیینه کاینات بودم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290120,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گه پردهٔ آسمان گشادم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گاهی پردهٔ آسمان را کنار می‌زنم و گاهی به چهرهٔ آفتاب می‌نگرم."
      },
      {
        "id": 2290122,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گه چهرهٔ آفتاب سودم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2290157,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از بس که بسوختم درین تاب",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من به خاطر سوختن‌های فراوانی که در این عشق کشیدم، دیگر هیچ‌چیز از عطار نیستم، اما هنوز هم مانند بخور یا عود وجود دارم."
      },
      {
        "id": 2290123,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عطار نیم ولیک عودم",
