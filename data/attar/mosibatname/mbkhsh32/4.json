        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2446865,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت این دارم خبر کان سیمبر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گفت: من از این موضوع مطلع هستم که آن شخص نقره‌ای از مرگ من بی‌خبر است."
      },
      {
        "id": 2446866,
