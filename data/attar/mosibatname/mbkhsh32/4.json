        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست از جان کندن من بی خبر",
        "languageId": null,
        "coupletSummary": null
      },
