    "verses": [
      {
        "id": 2443704,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بود مردی در سخاوت بی بدل",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مردی بود که در بخشندگی و بذل و بخشش مانند هیچ‌کس دیگری نبود. او هرچه در توان داشت را بدون هیچ نقص و کم‌وکاستی خرج می‌کرد."
      },
      {
        "id": 2443703,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هرچه بودی خرج کردی بی خلل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2443702,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مینداشت البته یک جو زر نگاه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او به طور قطع یک مقدار طلا در نظر داشت و گفت که روزی مردی نیکوکار و سخاوتمند به او خواهد رسید."
      },
      {
        "id": 2443701,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت یک روزیش مردی نیک خواه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2443700,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کای فلان آخر نترسی از هلاک",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اے فلان، چرا از نابودی نمی‌ترسی، در حالی که زمانی خواهد آمد که جان پاکت از تو جدا خواهد شد."
      },
      {
        "id": 2443699,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کان زمان کز تو برآید جان پاک",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2443698,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون نمیداری نگه یک پیرهن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چون نمی‌توانی از یک پیراهن نگهداری کنی، پس باید برایت کفن آماده کنند."
      },
      {
        "id": 2443697,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پس فراهم بایدت کردن کفن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2443696,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت چون جانم برآید در پسی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که جانم از بدنم خارج شود، به گونه‌ای که هر کسی برای من کفن خواهد شد."
      },
      {
        "id": 2443695,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وان کفن کدیه کنند از هر کسی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2443694,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر ز دروازه درآیم نیز من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر از دروازه داخل شوم، حتی پس از آن من همچنان بر سر شما، آن کفن را می‌زنم."
      },
      {
        "id": 2443693,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پس شما بر سر زنیدم آن کفن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2443657,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حرص مینگذاردت پاک ای پسر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای پسر، حرص و طمع تو را به سوی پاکی می‌کشاند، اما اگر به آن دلبسته شوی، ممکن است تو را به آلودگی و فاسد شدن برساند."
      },
      {
        "id": 2443656,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا پلید آئی تو درخاک ای پسر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2443655,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دایماً در خوی ناخوش ماندهٔ",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: همواره در حالتی ناخوشایند و رنج‌آور به سر می‌برم و صفات ناپسند من مثل آتشی سوزانده می‌شود."
      },
      {
        "id": 2443646,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وز صفات بد در آتش ماندهٔ",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2443618,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا صفاتت باتو خواهد بود جمع",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تا زمانی که ویژگی‌های تو به هم جمع شود، تو به تنهایی نخواهی بود. بدون اینکه بسوزی و شعله‌ور شوی، مانند شمع."
      },
      {
        "id": 2443617,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو نخواهی بود بی سوزی چو شمع",
        "languageId": null,
        "coupletSummary": null
      }
    ],
