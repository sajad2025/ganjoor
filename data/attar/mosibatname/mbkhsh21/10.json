      },
      {
        "id": 2443615,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کرد ازان دریای دانش سه سؤال",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2443614,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت از هفتاد فرسنگ آمدم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گفت: من از راهی بسیار دور و طولانی آمده‌ام، پس لطفاً به من پاسخ بده که خیلی نارحت و بی‌تاب هستم."
      },
      {
        "id": 2443613,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هین جوابم ده که دلتنگ آمدم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2443612,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چیست درویشی و بیماری و مرگ",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: درویشی، بیماری و مرگ سه پاسخ هستند که حیدر به آن‌ها می‌دهد. این به نوعی به وضعیت‌های مختلف زندگی و چالش‌هایی اشاره دارد که انسان با آن‌ها روبرو می‌شود. حیدر به دنبال درک و پاسخ به این موضوعات است."
      },
      {
        "id": 2443611,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "داد حیدر سه جواب او ببرگ",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2443610,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت درویشی تو جهل آمدست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در اینجا سخن از درویش و فقر است. درویش می‌گوید که جهل در زندگی‌اش حاکم است و حتی اگر فقر بر او سخت نگذرد، باز هم علم و دانش در دسترسی او نیست. به عبارتی، او می‌گوید که بی‌پولی را می‌توان تحمل کرد، اما عدم آگاهی و دانش به مراتب سخت‌تر و دردناک‌تر است."
      },
      {
        "id": 2443609,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فقر تو گر عالمی سهل آمدست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2443608,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست بیماری حسد بردن همه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: حسادت بیماری خطرناکی است که همه را تحت تأثیر قرار می‌دهد و به بدی کار و رفتار انسان منجر می‌شود. این احساس می‌تواند حتی به نابودی شخصیت و روح انسان بیانجامد."
      },
      {
        "id": 2443607,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست بد خوئی تو مردن همه",
        "languageId": null,
        "coupletSummary": null
      }
