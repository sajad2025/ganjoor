    "verses": [
      {
        "id": 2442348,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عیسی مریم بخواب افتاده بود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عیسی، فرزند مریم، خوابش برده بود و نیمه‌ای از خشت را به عنوان زیرسرش قرار داده بود."
      },
      {
        "id": 2442347,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیم خشتی زیر سر بنهاده بود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2442346,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون گشاد از خواب خوش عیسی نظر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی عیسی از خواب خوش بیدار شد، ابلیس بدذات را بر فراز از دور مشاهده کرد."
      },
      {
        "id": 2442345,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دید ابلیس لعین را بر زبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2442344,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت ای ملعون چرا استادهٔ",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به من بگو که چرا به من این طور توهین می‌کنی؟ چرا در حالتی که من دراز کشیده‌ام، اینگونه با من رفتار می‌کنی؟"
      },
      {
        "id": 2442343,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت خشتم زیر سر بنهادهٔ",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2442342,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جملهٔ دنیا چو اقطاع منست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تمام دنیا مانند بخش‌هایی از زندگی من است. هر چیزی که در دنیا وجود دارد، بخشی از من است و این کاملاً واضح و مشخص است."
      },
      {
        "id": 2442341,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست آن خشت آن من این روشنست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2442340,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا تصرف میکنی در ملک من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که به تصرف و کنترل من می‌پردازی، خودت را هم به شیوه‌ای به من نزدیک کرده‌ای."
      },
      {
        "id": 2442339,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خویش را آوردهٔ در سلک من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2442338,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عیسی آن از زیر سر پرتاب کرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عیسی (ع) با زیر سر خود، چهره‌اش را به زمین انداخت و عزم خواب و آرامش کرد."
      },
      {
        "id": 2442337,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "روی را برخاک عزم خواب کرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2442336,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون فکند آن نیم خشت ابلیس گفت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که شیطان آن نیمه خشت را انداخت، گفت: من اکنون می‌روم و تو هم اکنون خوب بخواب."
      },
      {
        "id": 2442301,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من کنون رفتم تو اکنون خوش بخفت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2442333,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون پس خشت لحد خواهی فتاد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که درون قبر خواهی افتاد، چرا باید بر روی خاک دیگران بنا بسازی؟"
      },
      {
        "id": 2442300,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خشت بر خشتی چرا خواهی نهاد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2442265,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون گل از خونابهٔ دل میکنی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که از عواطف و احساسات دردناک خود به خاطر دنیا و محبت‌های زودگذر رها می‌شوی، چرا باید برای آن دنیا تلاش کنی؟"
      },
