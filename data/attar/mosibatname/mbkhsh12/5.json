    "verses": [
      {
        "id": 2441021,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کاملی گفته‌ست از پیران راه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کاملان و حکیمان گفته‌اند که هر کسی که تصمیم به رفتن به حج می‌گیرد، باید از جایگاه و موقعیت خود آگاه باشد."
      },
      {
        "id": 2441022,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر که عزم حج کند از جایگاه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2441023,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کرد باید خان ومانش را وداع",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کسی که باید خانه و کاشانه‌اش را ترک کند، باید از باغ و زمین‌هایش دل بکند و رهایشان کند."
      },
      {
        "id": 2441024,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فارغش باید شد از باغ وضیاع",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2441025,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خصم را باید خوشی خشنود کرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر با دشمنی روبه‌رو هستی که به تو آسیب رسانده، بهتر است او را راضی و خوشنود کنی، زیرا این کار ممکن است برای تو نفعی داشته باشد."
      },
      {
        "id": 2441026,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر زیانی کرده باشی سود کرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2441027,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بعد از آن ره رفت روز و شب مدام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: پس از آن، شب و روز به سیر و سفر بپرداز و به مقامی برس که شایسته ورود به خانه خدا شوی."
      },
      {
        "id": 2441011,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا شوی تو محرم بیت الحرام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2441010,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون رسیدی کعبه دیدی چیست کار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که به کعبه رسیدی، متوجه می‌شوی که کار کسی که نه در روز آرامش دارد و نه در شب، چیست."
      },
      {
        "id": 2441009,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنکه نه روزت بود نه شب قرار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2441008,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جز طوافت کار نبود بر دوام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چاره‌ای جز چرخش و حرکت نیست، زیرا در غیر این صورت همیشه در حال نگرانی و بی‌قراری خواهی بود."
      },
      {
        "id": 2440993,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کار سرگردانیت باشد مدام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2440994,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا بدانی تو که در پایان کار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این بیت می‌گوید: تا زمانی که متوجه شوی، در انتهای هر کار هیچ‌کس جز خودت برای سرگردانی و بلاتکلیفی تو وجود ندارد."
      },
      {
        "id": 2440995,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیست کس الا که سرگردان کار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2440996,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عاقبت چون غرق خون افتادنست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در نهایت، سرنوشت انسان به گونه‌ای است که مانند آسمان که در حال سقوط است، به عاقبت‌های تلخی دچار می‌شود و با نابودی مواجه خواهد شد."
      },
      {
        "id": 2440997,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همچو گردون سرنگون افتادنست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2440998,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنچه میجوئی نمیآید بدست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آنچه که دنبالش هستی به دست نمی‌آید و برای به دست آوردنش نمی‌توانی حتی یک لحظه آرام بگیری."
      },
