        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دوستی تو سزای او بود",
        "languageId": null,
        "coupletSummary": null
      },
      {
