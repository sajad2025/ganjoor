        "text": "ورنه بنشینی چو چادر بایدت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2448530,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هرچه هستت چون برای او بود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر چیزی که داری، اگر برای او باشد، دوستیت با او پاداش خواهد داشت."
      },
      {
