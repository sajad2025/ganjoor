        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او لوح تورات را به زمین انداخت و محکم ریش هارون را در دست خود شکست."
      },
      {
        "id": 2445208,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
