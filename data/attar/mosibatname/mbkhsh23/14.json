    "verses": [
      {
        "id": 2444229,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن یکی پرسید از عباسه باز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: یکی از افراد از عباس پرسید و عباس در جواب گفت: ای کسی که سخنت به مانند کلیدی است که رازهای پنهان را می‌گشاید."
      },
      {
        "id": 2444230,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت ای نطقت کلید گنج راز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2444231,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیست کس از سیم داران مونست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هیچ کس از دوستداران بهشت به درون جلسه نمی‌آید، مگر اینکه بزرگ‌مردی در آن جمع حضور داشته باشد."
      },
      {
        "id": 2444232,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می نیاید خواجهٔ در مجلست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2444233,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت کی آید بر من سیم دار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گفت کی کسی می‌آید که مرا از زیر بار مشکلات نجات دهد، چرا که از من هیچ کار و تلاشی باقی نمانده است."
      },
      {
        "id": 2444234,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کز منش بر هم نماند کار و بار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2444219,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سیم داری کو بمجلس آیدم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر سیمی داری که به مجلس بیایی، اگرچه همه به خوبیو زرین باشند، من هم مثل مس به آنجا وارد می‌شوم."
      },
      {
        "id": 2444235,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر همه چون زر بود مس آیدم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2444218,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جیب در گردن رسن گردانمش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: می‌خواهم به سادگی همه چیز را دور گردنم بگذارم و لباسی را که بر تن دارم به کفنی تبدیل کنم."
      },
      {
        "id": 2444216,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پیرهن در بر کفن گردانمش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2444201,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از زفان من بچشم سیم دار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از زبان من چیزی بشنو که مانند گور، خانه‌ای زیبا و پرنقش و نگار خواهد شد."
      },
      {
        "id": 2444202,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون لحد گردد سرای زرنگار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2444203,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عیب او پوشید نتوانم برو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نمی‌توانم عیب او را پنهان کنم و دین او را به کفر تبدیل نمی‌کنم."
      },
      {
        "id": 2444204,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دین او را کفر گردانم برو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2444205,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این چنین کس کی کند رغبت بمن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کیست که بخواهد به من نزدیک شود وقتی این نسبت و ارتباط با من چنین است؟"
      },
      {
        "id": 2444206,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کی درست آید چنین نسبت بمن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2444207,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سوی هر ظالم بود رغبت ترا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به هر سو که ظلم و ستم باشد، تو نمی‌توانی به من نسبت دهی، زیرا من از آنچه که تو می‌خواهی دورم."
      },
      {
        "id": 2444208,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
