        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت دارم سوی گورستان شتاب",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گفت می‌خواهم به قبرستان بروم، زیرا آنجا فردی ظالم در حال عذاب است."
      },
      {
        "id": 2438857,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
