        "text": "گرم گردم زانکه سر ما ناخوش است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2438842,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن یکی را این چنین مرگی بود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: یکی از آن‌ها به گونه‌ای مرد که مرگش به اوج خودش رسید و دیگری مرگش مثل یک برگ ریزان بود."
      },
      {
        "id": 2438832,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
