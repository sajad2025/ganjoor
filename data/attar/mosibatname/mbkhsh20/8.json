      },
      {
        "id": 2443366,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برهنه سر میشدی دایم براه",
        "languageId": null,
        "coupletSummary": null
      },
      {
