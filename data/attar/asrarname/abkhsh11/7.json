        "text": "در آن عین فنا عین بقا شو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2325144,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
