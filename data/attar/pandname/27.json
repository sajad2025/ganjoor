    "verses": [
      {
        "id": 2454820,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چار چیز آمد نشان مُدْبِری",
        "languageId": null,
        "coupletSummary": "مدبر یعنی آدم بدبخت و پس‌رونده"
      },
      {
        "id": 2454821,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یاد گیرش گر تو روشن خاطری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2454822,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مدبری باشد به ابله مشورت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مدبر و صاحب خرد هرگز نباید با فرد احمق مشورت کند، زیرا حتی دادن ثروت به کسی که جاهل است، بی‌فایده و نادرست است."
      },
      {
        "id": 2454823,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هم به جاهل دادن سیم و زرت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2454824,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هرکه پند دوستان نکند قبول",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر کسی که به نصیحت دوستانش توجه نکند، در واقع در امور خود ناتوان و کم‌خودآگاه است."
      },
      {
        "id": 2454825,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در حقیقت مدبرست آن بوالفضول",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2454826,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر که از دنیا نگیرد عبرتی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر کسی که از زندگی درس عبرت نگیرد، نشان‌دهنده عقل و تدبیر اوست. بنابراین، او نسبت به این دنیا احساس تنفر خواهد داشت."
      },
      {
        "id": 2454827,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست از آن مدبر، جهان را نفرتی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2454828,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مشورت هر کس که با ابله کند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر کسی که با شخصی نادان مشورت کند، در واقع خود را به دام مشکلاتی می‌اندازد که او را به گمراهی می‌کشاند."
      },
      {
        "id": 2454829,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیوِ ملعونش سگِ گمره کند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2454830,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنکه مال خود دهد با جاهلان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کسی که دارایی‌اش را به افراد نادان می‌دهد، چگونه می‌تواند از افرادی باشد که به خوبی در نظر گرفته می‌شوند؟"
      },
      {
        "id": 2454831,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنچنان کس کی شود از مقبلان؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2454832,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زر چو ابله را همی‌آید به کف",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که مال و ثروت به دست فردی نادان می‌رسد، او بی‌ملاحظه خرج می‌کند و از آن به درستی استفاده نمی‌کند."
      },
      {
        "id": 2454833,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌کند اسراف و می‌سازد تلف",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2454834,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نشنود از دوست ابله پند را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دوست احمق نصیحت را نمی‌شنود و به خاطر نادانی‌اش از ارتباط و دوستی جدا می‌شود."
      },
      {
        "id": 2454835,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از جهالت بگسلد پیوند را",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2454836,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عبرتی گیر از زمانه ‌ای جوان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از زمانه‌ای که جوانی، عبرت بگیر تا به جمع نادانان نپیوندی."
      },
      {
        "id": 2454837,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا نباشی از شمار ابلهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2454838,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هرکه‌را از عقل آگاهی بود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر کس که دارای عقل و آگاهی باشد، نزد او دوری از گمراهی و خطا وجود دارد."
      },
      {
