    "verses": [
      {
        "id": 2299218,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بود آن دیوانهٔ عالی‌مقام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در آن زمان، فردی بلندمرتبه و دیوانه‌ای وجود داشت که با خضر صحبت می‌کرد و می‌گفت: ای مرد، همه چیز را بدان."
      },
      {
        "id": 2299217,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خضر با او گفت: ای مردِ تمام!",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299224,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رای آن داری که باشی یار من؟",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر تو بخواهی که دوست من باشی، گفتی که با تو همکاری نمی‌کنم."
      },
      {
        "id": 2299216,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت: با تو برنیاید کار من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299214,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زآنک خوردی آب حیوان چند راه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چون آب زندگی‌بخش را نوشیده‌ای، چند راه پیش رو داری تا جانت برای مدت طولانی زنده بماند."
      },
      {
        "id": 2299213,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا بماند جان تو تا دیرگاه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299212,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من در آنم تا بگویم تَرک جان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من در حالتی هستم که نمی‌توانم از جانم جدا شوم، زیرا برای بی‌جانان چیزی ندارم که آنها را رها کنم."
      },
      {
        "id": 2299211,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زآنک بی جانان ندارم برگ آن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299210,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون تو اندر حفظ جانی مانده",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به خاطر اینکه تو برایم عزیز و باارزش هستی، من هر روز به خاطر وجودت جانم را فدای تو می‌کنم."
      },
      {
        "id": 2299209,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من به تو هر روز جان افشانده",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299208,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بهتر آن باشد که چون مرغان ز دام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بهتر است که مانند پرندگان از دام‌ها دور باشیم و با هم در صلح و آرامش زندگی کنیم."
      },
      {
        "id": 2299188,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دور می‌باشیم از هم والسلام",
        "languageId": null,
        "coupletSummary": null
      }
    ],
