        "text": "می‌روم هر جای چون هر جاییی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299189,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون نشان یابم ز آب زندگی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که از آب حیات نشانه‌ای دریافت کنم، سلطنت و قدرت در دستانم خواهد بود، در حالی که در بندگی باقی خواهم ماند."
      },
      {
        "id": 2299204,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سلطنت دستم دهد در بندگی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299205,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هدهدش گفت: ای ز دولت بی‌نشان!",
        "languageId": null,
