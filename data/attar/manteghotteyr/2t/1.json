      },
      {
        "id": 2299200,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در شکر خوردن پگه خیز آمده",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299199,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت: هر سنگین‌دل و هر هیچ‌کس",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر فردی که دلش سنگین و دل‌زده است، مانند من، در قفس مشکلات و ناامیدی‌ها به تنگنا می‌افتد."
      },
      {
        "id": 2299198,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون منی را آهنین سازد قفس",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299197,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من در این زندانِ آهن مانده باز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من در این زندان سخت و طاقت‌فرسا گرفتار مانده‌ام و با وجود این که در حیرت و اندوه هستم، هنوز در آرزوی دستیابی به سرسبزی و طراوت زندگی هستم."
      },
      {
        "id": 2299196,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زآرزوی آب خضرم در گداز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299195,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خضر مرغانم، از آنم سبزپوش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من با مرغان خضر آشنا هستم و می‌دانم که آن‌ها از آب خضر می‌نوشند. این نشان می‌دهد که من هم باید از دانش و آگاهی بهره‌مند شوم."
      },
      {
        "id": 2299194,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بوک دانم کردن آب خضر نوش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299193,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من نیارم در بر سیمرغ تاب",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من نمی‌توانم در برابر سیمرغ (فرشته یا موجودی افسانه‌ای) تاب و توانایی مقابله داشته باشم، همان‌طور که یک قطره آب از چشمهٔ زنده و سبز بسنده است."
      },
      {
        "id": 2299192,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بس بود از چشمهٔ خضرم یک آب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299191,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سر نهم در راه چون سوداییی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من در راهی مثل یک دیوانه سر به راه می‌گذارم و در هر مکان، شبیه به هر مکان دیگری حرکت می‌کنم."
      },
      {
