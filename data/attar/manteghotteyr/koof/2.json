    "verses": [
      {
        "id": 2299629,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حقه‌ای زر داشت مردی بی‌خبر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مردی نادان یک حقه طلا داشت و زمانی که مرد، آن حقه طلا برای او باقی ماند."
      },
      {
        "id": 2299628,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون بمرد و زو بماند آن حقه زر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299627,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بعد سالی دید فرزندش به خواب",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: پس از گذشت یک سال، او در خواب دید که فرزندش چهره‌اش مثل موش شده و چشمانش پر از اشک است."
      },
      {
        "id": 2299626,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صورتش چون موش و دو چشمش پر آب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299625,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پس در آن موضع که زر بنهاده بود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در مکانی که طلا گذاشته شده بود، موشی به سرعت دور آن می‌چرخید."
      },
      {
        "id": 2299624,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "موشی اندر گرد آن می‌گشت زود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299623,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت فرزندش کزو کردم سؤال",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: فرزندش از او پرسید که چرا به اینجا آمده‌ای و حال و احوالش را بگو."
      },
      {
        "id": 2299622,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "«کز چه این جا آمدی؟ بر گوی حال»",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299621,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت: «زر بنهاده‌ام این جایگاه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گفت که من طلا را در اینجا گذاشته‌ام، ولی نمی‌دانم تا وقتی‌که کسی به آن دسترسی پیدا کند، چه زمانی اینجا خواهد بود."
      },
      {
        "id": 2299620,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من ندانم تا بدو کس یافت راه»",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299619,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت: «آخر صورت موشت چراست؟»",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در آخر گفت که چرا چهره موش به این صورت است؟ پاسخ داد که هر دلی که عشق طلا را بخواهد، چنین حالتی خواهد داشت."
      },
      {
        "id": 2299618,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت: هر دل را که مهر زر بخاست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299617,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صورتش این‌ست و در من می‌نگر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اینطور که به نظر می‌رسد، او ظاهری زیبا دارد ولی مهم‌تر از آن، به باطن و دل او توجه کن. از تجربیات و درس‌هایی که از او می‌گیری بهره‌مند شو و از چیزهای بی‌ارزش فاصله بگیر، پسرم."
      },
      {
        "id": 2299594,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پند گیر و زر بیفکن ای پسر!",
        "languageId": null,
        "coupletSummary": null
      }
