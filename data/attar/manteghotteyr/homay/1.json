      },
      {
        "id": 130171,
        "authorName": "افسانه چراغی",
        "authorUrl": null,
        "commentDate": "2025-05-01T19:44:59.0925471",
        "htmlComment": "<p>خسرونشانی: به پادشاهی رساندن. اعتقاد قدما بر این بود که سایه هما بر هر که افتد، او پادشاه می&zwnj;شود.&nbsp;</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": "3069de4e-d3ea-462d-eae9-08d995e349d5",
        "replies": [],
        "myComment": false,
