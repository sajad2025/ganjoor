      },
      {
        "id": 2305501,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بازگشت او نیز و مشتی راز گفت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او دوباره بازگشت و از رموز وصال با شمع سخن گفت و شرحی از آن ارائه داد."
      },
      {
        "id": 2305502,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از وصال شمع شرحی باز گفت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2305504,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ناقدش گفت این نشان نیست ای عزیز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: منتقد به او گفت: این چیزی که نشان دادی، نشانه‌ای نیست. ای عزیز، تو نیز باید مثل آن یک مورد که قبلاً نشان دادی، نشانه‌ای واقعی ارائه دهی."
      },
      {
        "id": 2305514,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همچو آن یک کی نشان دادی تو نیز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2305505,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیگری برخاست می‌شد مست مست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: شخصی دیگر برخاست و با حالتی شاد و سرحال، با پا زدن بر زمین، بر روی آتش نشسته و مشغول خوشگذارانی شد."
      },
      {
        "id": 2305506,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پای کوبان بر سر آتش نشست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2305507,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دست درکش کرد با آتش به هم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: با آتش عشق او، خود را فراموش کرد و در آغوشش به خوشی و آرامش رسید."
      },
      {
        "id": 2305508,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خویشتن گم کرد با او خوش به هم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2305509,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون گرفت آتش ز سر تا پای او",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که آتش به تمام وجود او رسید، تمام بدنش همانند آتشی سرخ شد."
      },
      {
        "id": 2305510,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سرخ شد چون آتشی اعضای او",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2305511,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ناقد ایشان چو دید او را ز دور",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ناقد وقتی از دور او را دید، شمعی را با خود برداشت و رنگش را به نور شمع مشابه کرد."
      },
      {
        "id": 2305512,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شمع با خود کرده هم رنگش ز نور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2305513,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت این پروانه در کارست و بس",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این پروانه در حال عشق و شیدایی است و تنها خودش از حال و هوایش باخبر است، دیگران از این وضعیت آگاهی ندارند."
      },
      {
        "id": 2305493,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کس چه داند، این خبر دارست و بس",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2305492,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنک شد هم بی‌خبر هم بی‌اثر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او در میان همه، بی‌خبر و بی‌اثر شده است، اما هنوز از حال او خبری دارد."
      },
      {
        "id": 2305491,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از میان جمله او دارد خبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2305490,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا نگردی بی‌خبر از جسم و جان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تا زمانی که از جسم و جان خود آگاه نباشی، چگونه می‌توانی به یک لحظه از محبوب خود باخبر شوی؟"
      },
      {
        "id": 2305471,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کی خبر یابی ز جانان یک زمان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2305472,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هرکه از مویی نشانت باز داد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هرکس که از مویی تو را نشان داد، به تو نشان می‌دهد که چقدر در عمق احساسات و جانت تأثیر دارد."
      },
      {
        "id": 2305473,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صد خط اندر خون جانت باز داد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2305474,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیست محرم نفس کس این جایگاه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این مکان خاص و با ارزش، جایی نیست که هر کسی بتواند به آن دسترسی داشته باشد یا درک کند. هیچ‌کس قادر نیست به عمق این جایگاه پی ببرد و فقط افراد خاص و آگاه می‌توانند به آن نزدیک شوند."
      },
      {
        "id": 2305475,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در نگنجد هیچ کس این جایگاه",
        "languageId": null,
        "coupletSummary": null
      }
    ],
