        "text": "شرح دِه کاین زرد رویت از چه خاست؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299509,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
