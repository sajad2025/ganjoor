        "text": "گر رسد از تیرش آسیبی مرا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299507,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گوید انگارم غلامی خود نبود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: او می‌گوید گویی که در سپاه من، هیچ غلامی نبود و نیز هیچ کمبودی در خودم احساس نمی‌شود."
      },
