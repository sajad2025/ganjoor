    "verses": [
      {
        "id": 2302661,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن عزیزی گفت شد هفتاد سال",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عزیز من گفت که برای شادی و لذت، هفتاد سال زندگی کرده‌ام و این حال خوش را تجربه کرده‌ام."
      },
      {
        "id": 2302660,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا ز شادی می‌کنم و از ناز حال",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2302659,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کین چنین زیبا خداوندیم هست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: خداوند زیبایی و کمال است و ما نیز به عظمت و وجود او متصل هستیم."
      },
      {
        "id": 2302658,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با خداوندیش پیوندیم هست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2302633,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون تو مشغولی بجویایی عیب",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی تو خودت مشغول هستی، به دنبال عیب‌ها نخواهی رفت و از زیبایی‌ها لذت نخواهی برد."
      },
      {
        "id": 2302679,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کی کنی شادی به زیبایی غیب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2302632,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عیب جویا، تو به چشم عیب بین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر همیشه به دنبال عیب‌ها و نقص‌ها باشی، هرگز نمی‌توانی ببینی که در حقیقت چه چیزهای مثبت و خوبی وجود دارد."
      },
      {
        "id": 2302630,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کی توانی بود هرگز غیب بین",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2302604,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اولا از عیب خلق آزاد شو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ابتدا از نواقص و کاستی‌های خود رهایی یاب و سپس با عشق به حقیقت مطلق، خوشحال و شاداب باش."
      },
      {
        "id": 2302603,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پس به عشق غیب مطلق شاد شو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2302602,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "موی بشکافی به عیب دیگران",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر به عیب‌های دیگران اشاره کنی و خودت را در این زمینه مورد پرسش قرار ندهی، در واقع به نوعی خود را از درک عیوب خود محروم کرده‌ای."
      },
      {
        "id": 2302601,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ور بپرسم عیب تو کوری در آن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2302600,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر به عیب خویشتن مشغولیی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر به عیب‌های خود مشغول باشی، هرچند که نقص‌های زیادی داری، باز هم مورد قبول هستی."
      },
      {
        "id": 2302599,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گرچه بس معیوبیی مقبولیی",
        "languageId": null,
        "coupletSummary": null
      }
