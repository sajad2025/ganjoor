    "verses": [
      {
        "id": 2301076,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ابلهی را میوهٔ دل مرده بود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: یک شخص احمق به شدت دلتنگ و بی‌قرار است و هیچ نشانه‌ای از صبر و آرامش در او دیده نمی‌شود. او به خاطر غم و اندوهی که در دل دارد، هیچگونه آرامش و ثباتی ندارد."
      },
      {
        "id": 2301074,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صبر و آرام و قرارش برده بود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2301073,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از پس تابوت می‌شد سوگوار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: پس از حمل تابوت، فردی دیوانه‌وار و پر از اندوه به سوگ نشسته بود و همچنین با صدای زاری به بیان احساسات خود می‌پرداخت."
      },
      {
        "id": 2301072,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی‌قراری، وانگهی می‌گفت زار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2301071,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کای جهان نادیدهٔ من چون شدی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای دنیا که برای من ناشناخته‌ای، چرا وقتی که به هیچ تبدیل شدی، جهانی که بیرون از من است هم از بین رفت؟"
      },
      {
        "id": 2301070,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هیچ نادیده جهان بیرون شدی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2301069,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی‌دلی چون آن شنید و کار دید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بی‌دلی وقتی آن را شنید و کارها را دید، گفت که انگار جهانی را صد بار دیده است."
      },
      {
        "id": 2301068,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت صد باره جهان انگار دید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2301067,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر جهان با خویش خواهی برد تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر می‌خواهی جهان را با خود به همراه داشته باشی، باید بدان که این دنیا را نمی‌توانی به شکل نادیده‌ای ترک کنی."
      },
      {
        "id": 2301066,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هم جهان نادیده خواهی مرد تو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2301075,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا که تو نظارهٔ عالم کنی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که تو به تماشای جهان مشغول هستی، عمرت به سرعت سپری می‌شود و نتوانی به دردهایت تسکینی بدهی."
      },
      {
        "id": 2301087,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عمر شد کی درد را مرهم کنی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2301088,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا نپردازی تو از نفس خسیس",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تا زمانی که از نفس خودخواه و پست خود دور نشوی، این جان ارزشمند و گرانبها در تباهی و ناپاکی گم می‌شود."
      },
      {
        "id": 2301089,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در نجاست گم شد این جان نفیس",
        "languageId": null,
        "coupletSummary": null
      }
    ],
