    "verses": [
      {
        "id": 2301828,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صوفیی می‌رفت در بغداد زود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: یک صوفی در حالیکه به بغداد می‌رفت، در میانه‌ی راه صدایی را شنید."
      },
      {
        "id": 2301827,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در میان راه آوازی شنود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2301826,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کان یکی گفت انگبین دارم بسی",
        "languageId": null,
        "coupletSummary": "  شخصی گفت که من عسل زیادی دارم و به قیمت بسیار ارزان می‌فروشم، پس کسی هست که بخواهد بخرد؟"
      },
      {
        "id": 2301825,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌فروشم سخت ارزان، کو کسی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2301896,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شیخ صوفی گفت ای مرد صبور",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: شیخ صوفی به مرد صبور گفت که تو به هیچ چیز چیزی نمی‌دهی، و او پاسخ داد که نه، من دور هستم از این کار."
      },
      {
        "id": 2302093,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌دهی هیچی به هیچی، گفت دور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2302288,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو مگر دیوانه‌ای ای بوالهوس",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آیا دیوانه‌ای که انتظار داری کسی چیزی به تو بدهد در حالی که هیچ‌چیز نداری؟"
      },
      {
        "id": 2302094,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کس به هیچی کی دهد چیزی به کس",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2302359,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هاتفی گفتش که‌ای صوفی درآی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: صدایی به صوفی می‌گوید که بیا و به دکان ما وارد شو؛ تو که از دیگران بالاتر هستی."
      },
      {
        "id": 2302358,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یک دکان زینجا که هستی برترآی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2302357,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا به هیچی ما همه چیزت دهیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما آماده‌ایم که همه چیزت را به تو بدهیم، حتی اگر بخواهی، چیزهای بیشتری هم به تو خواهیم داد."
      },
      {
        "id": 2302356,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ور دگر خواهی بسی نیزت دهیم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2302355,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست رحمت آفتابی تافته",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: رحمت مانند نوری است که همه ذرات و موجودات را در برمی‌گیرد و به آنها آگاهی می‌دهد."
      },
      {
        "id": 2302354,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جملهٔ ذرات را دریافته",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2302353,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رحمت او بین که با پیغمبری",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: خداوند رحمتش را نازل کرده و با پیامبری که در زمانی خاص به عتاب و سرزنش آمده، به کافران هشدار می‌دهد."
      },
      {
        "id": 2302352,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در عتاب آمد برای کافری",
        "languageId": null,
        "coupletSummary": null
      }
