    "verses": [
      {
        "id": 2302559,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در بر شیخی سگی می‌شد پلید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در کنار یک روحانی، سگی ناپاک وجود داشت، اما آن روحانی هیچ‌گاه دامن خود را به خاطر آن سگ آلوده نکرد."
      },
      {
        "id": 2302580,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شیخ از آن سگ هیچ دامن در نچید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2302579,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سایلی گفت ای بزرگ پاکباز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کسی به بزرگ و پاکباز گفت: چرا از این سگ به دوری نگزیدی و فاصله نگرفتی؟"
      },
      {
        "id": 2302578,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون نکردی زین سگ آخر احتراز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2302577,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت این سگ ظاهری دارد پلید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این جمله به این معناست که کسی ممکن است ظاهری زشت و ناخوشایند داشته باشد، اما در درون او حقیقتی پنهان و نیکو وجود دارد که برای دیگران قابل دیدن نیست."
      },
      {
        "id": 2302576,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هست آن در باطن من ناپدید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2302575,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنچ او را هست بر ظاهر عیان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آنچه که او دارد و در ظاهر آشکار است، برای دیگری در باطن و درون پنهان است."
      },
      {
        "id": 2302574,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این دگر را هست در باطن نهان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2302573,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون درون من چو بیرون سگست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در دل من حسی شبیه به سگ وجود دارد و می‌خواهم از آن فرار کنم، اما نمی‌توانم چون همیشه با من است و همراه من است."
      },
      {
        "id": 2302572,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون گریزم زو که با من هم تگ است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2302571,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر پلیدی درونت اندکیست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر درون تو اندکی پلیدی وجود داشته باشد، تو در هر جا و هر چیزی ناپاکی خواهی دید، زیرا آنچه در درون توست، بر دیدگاه و تجربیاتت تأثیر می‌گذارد."
      },
      {
        "id": 2302570,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صد نجس بینی که این خود زان یکیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2302569,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گرچه اندک چیزت آمد بند راه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هرچند که داشته‌هایت اندک باشد، اما مانع پیشرفت تو نخواهد شد؛ چه با کوهی از مشکلات مواجه باشی و چه فقط با ذره‌ای کوچک."
      },
      {
        "id": 2302568,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه به کوهی بازمانی چه به کاه",
        "languageId": null,
        "coupletSummary": null
      }
    ],
