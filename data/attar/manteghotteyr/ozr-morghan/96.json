    "verses": [
      {
        "id": 2303040,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خواجه زنگی را غلامی چست بود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: یک خدمتکار چابک و زبده در خدمت خواجه زنگی بود که از آلودگی‌های دنیوی دوری کرده و پاکدامن بود."
      },
      {
        "id": 2303039,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دست پاک از کار دنیا شست بود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2303038,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جملهٔ شب آن غلام پاک باز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تمام شب آن جوان پاکدامن عبادت می‌کرد تا به صبح رسید."
      },
      {
        "id": 2303037,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا به وقت صبح می‌کردی نماز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2303046,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خواجه گفتش ای غلام کارکن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: خواجه به غلامش گفت: ای خدمت‌گزار، وقتی شب به پایان رسید و بیدار شدی، مرا نیز بیدار کن."
      },
      {
        "id": 2303036,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شب چو برخیزی مرا بیدار کن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2303034,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا وضو سازم کنم با تو نماز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: غلام از عشق تو می‌خواهد که وضو بگیرد و به نماز بایستد، اما کسی به او جواب می‌دهد."
      },
      {
        "id": 2303033,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن غلام او را جوابی داد باز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2303032,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت آن زن را که درد زه بخاست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آن زن گفت: اگر کسی برای کمک و تسکین درد من حضور ندارد، پس طبیعی است که من به دنبال راه چاره‌ای باشم."
      },
      {
        "id": 2303031,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر کسش بیدارگر نبود رواست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2303030,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر ترا دردیستی بیداریی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر درد و دغدغه‌ای داری، روز و شب مشغول به کار هستی و بی‌کار نیستی."
      },
      {
        "id": 2303029,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "روز و شب در کار نه بی‌کاریی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2303028,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون کسی باید که بیدارت کند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گاهی اوقات باید کسی باشد که تو را به حرکت وادار کند و دیگری نیز باید به تو کمک کند تا بتوانی کارهایت را پیش ببری."
      },
      {
        "id": 2303027,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیگری باید که او کارت کند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2303026,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر که را این حسرت و این درد نیست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر کسی که این حسرت و درد در دلش وجود ندارد، انگار که او زنده نیست و باید او را خاک بدانیم."
      },
      {
        "id": 2303035,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خاک بر فرقش که این کس مرد نیست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2303047,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر که را این درد دل در هم سرشت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر کسی که این درد در دلش ریشه داشته باشد، نه تنها به جهنم نمی‌رسد بلکه به بهشت نیز نمی‌رسد."
      },
      {
        "id": 2303048,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
