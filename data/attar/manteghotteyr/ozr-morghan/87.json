        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیگری گفتش که ای سرهنگ راه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دیگری به او گفت: ای سرهنگ، اگر به آن مکان برسم چه خواهم کرد؟"
      },
      {
        "id": 2303134,
        "vOrder": 10,
