    "verses": [
      {
        "id": 2299579,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیده‌ور مردی به دریا شد فرود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مردی به کنار دریا رفت و از آن پرسید که چرا رنگش آبی یا کبود است."
      },
      {
        "id": 2299577,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت: ای دریا! چرا داری کبود؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299576,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جامهٔ ماتم چرا پوشیده‌ای؟",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چرا لباس سیاه به تن کرده‌ای؟ هیچ آتش‌سوزی وجود ندارد، پس چرا اشک می‌ریزی؟"
      },
      {
        "id": 2299575,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیست هیچ آتش، چرا جوشیده‌ای؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299574,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "داد دریا آن نکو دل را جواب",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دریا به آن دل نیکو پاسخ داد که از دوری دوست، دچار اضطراب و نگرانی است."
      },
      {
        "id": 2299573,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کز فراق دوست دارم اضطراب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299572,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون ز نامردی نیَم من مرد او",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به خاطر نامردی او، من هم مثل او نیمی از وجودم را فراموش کرده‌ام و به همین خاطر برای نشان دادن درد و رنج او، لباس نیلی بر تن کرده‌ام."
      },
      {
        "id": 2299571,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جامه، نیلی کرده‌ام از درد او",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299570,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خشک‌لب بنشسته‌ام مدهوش من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من با لب‌های خشگ نشسته‌ام و از شدت عشق در حال مستی هستم، آتش عشق باعث شده است که آب درونم به جوش بیاید."
      },
      {
        "id": 2299569,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زآتش عشق، آب من شد جوش‌زن",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299568,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر بیابم قطره‌ای از کوثرش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر حتی یک قطره از آب حیات او را بیابم، جاودانه و زنده خواهم شد و در درگاه او قرار می‌گیرم."
      },
      {
        "id": 2299567,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زندهٔ جاوید گردم بر درش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2299566,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ورنه چون من صد هزاران خشک‌لب",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر نبود عشق، هزاران انسان خشک و بی‌احساس مانند من روز و شب در راه او می‌میرند."
      },
      {
        "id": 2299536,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌بمیرد در ره او روز و شب",
        "languageId": null,
        "coupletSummary": null
      }
    ],
