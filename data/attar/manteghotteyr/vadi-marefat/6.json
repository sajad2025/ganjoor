        "text": "کز که دور افتاده‌ای زیر و زبر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2304667,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
