      {
        "id": 4514998,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتم ای شوخ شکرین گفتار",
        "languageId": null,
        "coupletSummary": null
      },
      {
