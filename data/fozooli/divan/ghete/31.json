        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پدر و مادرند در تک و دو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: پدر و مادر، در روز و شب، برای تو مراقبت و تربیت می‌کنند."
      },
      {
        "id": 4515002,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا ترا پرورند لیل و نهار",
        "languageId": null,
        "coupletSummary": null
      },
