        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که از آن مجمعی پریشان است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3122386,
        "vOrder": 13,
