        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فرق من و خاک کف پای تو",
        "languageId": null,
        "coupletSummary": null
      },
      {
