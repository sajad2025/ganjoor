        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این یکی «تیر» و آن دگر «مرداد»",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4554194,
        "vOrder": 11,
