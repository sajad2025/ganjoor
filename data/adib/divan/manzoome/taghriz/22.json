        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گهی تاب می دادش از شانه موی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گاهی موهایش را از روی شانه‌اش به زیبایی به جلو می‌آورد و گاهی چهره‌اش را با رنگ سرخ می‌آرود."
      },
      {
        "id": 4557356,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
