        "id": 4555380,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بخود گفت افسوس ازین زندگی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4555381,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که بیگانگی ز آشنایان خطاست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بیگانگی از نزدیکان نادرست است و بدی اندیشیدن درباره دوستان نیز ناپسند به حساب می‌آید."
      },
      {
        "id": 4555382,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بد اندیشی از دوستان نارواست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4555383,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من این شوخ را دوست پنداشتم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من این فرد شوخ طبع را به عنوان دوست تصور می‌کردم و از او انتظارات خوبی داشتم."
      },
      {
        "id": 4555384,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وز او بس امید بهی داشتم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4555385,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ندانستم اینسان درشتی کند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نفهمیدم که چرا سمور این‌قدر خشن و بی‌رحم رفتار می‌کند و چرا مانند یک خارپشت عمل می‌کند."
      },
      {
        "id": 4555386,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سموری چنین خارپشتی کند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4555387,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ندانستم اینسان دلیری کند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نمی‌دانستم که یک گوزن می‌تواند اینقدر شجاع باشد و با این قدرت دست به عمل بزند."
      },
      {
        "id": 4555388,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گوزنی چنین شیرگیری کند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4555389,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ندانستمی ترکتازی کند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نمی‌دانستم که با یک حرکت سریع، بی‌خبر از عواقبش، می‌تواند کار را به جایی برساند که پیامدهای بلندمدتی داشته باشد."
      },
      {
        "id": 4555390,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 15,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بکوتاه دستی درازی کند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4555391,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ندانستم اینگونه شیدا شود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نمی‌دانستم که این‌گونه عاشق و شیدا خواهم شد و به خاطر فکرهای بد، دچار رسوایی خواهم گشت."
      },
      {
        "id": 4555392,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 16,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بکام بداندیش رسوا شود",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4555393,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر این داستان خوب می دیدمی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر این ماجرا را خوب می‌دیدم، هرگز این رسوایی را بر خود نمی‌پذیرفتم."
      },
      {
        "id": 4555394,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 17,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کی این ننگ بر خود پسندیدمی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4555395,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کی او را بدین پایه بنشاند می",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چه کسی او را به این مقام رساند، در حالی که سزاوار بدی‌ها را بدی می‌نامند؟"
      },
      {
        "id": 4555396,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 18,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سزای بدی را بدی خواند می",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4555397,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو او را زره برد اینگونه دیو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی او زره را برداشت، این‌گونه دیو بر او غلبه کرد و او را نزد خدای کیهان برد."
      },
      {
        "id": 4555398,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 19,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "برم داد او نزد کیهان خدیو",
        "languageId": null,
        "coupletSummary": null
      }
