        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "همی شیر نوشم ز پستان مرگ",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من از پستان مرگ شیر می‌نوشم، تا درخت وجودم همیشه سبز و سرزنده باقی بماند."
      },
      {
        "id": 4556008,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
