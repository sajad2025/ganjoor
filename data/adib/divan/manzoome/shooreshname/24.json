        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4556005,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بخود گفت بانو که امروز روز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بانوی قصه به خود گفت که امروز هیچ روز خوبی ندارد و تنها می‌تواند احساس دل‌تنگی و درد کند."
      },
      {
