        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که ای کاش مادر نزادی مرا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای کاش مادر مرا به دنیا نمی‌آورد یا اینکه در دوران نوزادی به من شیر نمی‌داد."
      },
      {
        "id": 4556010,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
