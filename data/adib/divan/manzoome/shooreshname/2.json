        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که ای در خور تاج و دارای تخت",
        "languageId": null,
        "coupletSummary": null
      },
