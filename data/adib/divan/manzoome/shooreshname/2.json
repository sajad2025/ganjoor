        "text": "گرفتار زندان ننگ آمدم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4555409,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مهیا کن امروز مرگ مرا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: امروز آماده باش که من بمیرم یا اینکه به من شادی و خوشی عطا کن."
      },
      {
