      },
      {
        "id": 4555688,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درافتاد لرزه بر اندام او",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4555689,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بغرید همچو یکی ماده شیر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: شیر ماده‌ای به شدت غرغر کرده و به چهره او نگاهی می‌کند، گویی نشانه‌ای از خیر و خوبی در او می‌یابد."
      },
      {
        "id": 4555690,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نظر کرد در روی او خیر خیر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4555691,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که اینان کجا مرد کار منند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این افراد چه کاره هستند، اگر هنوز به سن و سالی نرسیده‌اند و مانند بچه شیرها هستند؟"
      },
      {
        "id": 4555692,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر شیر نر، شیر خوار منند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4555693,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرا عار باشد از اینان گریز",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من از فرار کردن از این افراد شرمسار هستم و هیچ ترسی از درگیری ندارم."
      },
      {
        "id": 4555694,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ندارم بدل هیچ باک از ستیز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4555695,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مگر حکم شهزاده کاری کند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آیا کاری از فرمانروای بزرگ برآید تا سواران بتوانند غباری برانگیزند؟"
      },
      {
        "id": 4555696,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سمند سواران غباری کند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4555697,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وگرنه ز یحیی و اکبر کسی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر از یحیی و اکبر کسی نترسد، به این دلیل است که من از این افراد افراد زیادی را دیدم که ترس ندارند."
      },
      {
        "id": 4555698,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نترسد که دیدم از اینان بسی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4555699,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرا نیست با حکم شهزاده تاب",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من نمی‌توانم در برابر تصمیمات و حکم‌های شاهزاده‌ای که قدرتش بر همه‌چیز تسلط دارد، تاب و تحمل داشته باشم. خانه‌ام به سختی ویران می‌شود و از عهده‌ی این وضعیت برنمی‌آیم."
      },
