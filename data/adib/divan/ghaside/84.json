      },
      {
        "id": 4534955,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گویی ای قبله‌گاه اهل نیاز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4534956,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "طره‌ات در مثل بود طرار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: موهای تو مانند طره‌ای زیباست و نیشخند تو در وصف، به زشتی و ناپسندی اشاره دارد."
      },
      {
        "id": 4534957,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "غمزه‌ات در صفت بود غماز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4534958,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "متماثل رخت بود با ماه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: لباس تو مانند ماه می‌درخشد و قامت تو به خاطر نازک‌نوشی‌ات به سمت زیبایی متمایل است."
      },
      {
        "id": 4534959,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "متمایل قدت بود از ناز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4534960,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تلخ از حسرت توام شد کام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به خاطر حسرت تو، شیرینی زندگی برایم تلخ شده و از رنجی که به خاطر تو متحمل شده‌ام، به وضوح درد دل‌هایم نمایان شده است."
      },
      {
        "id": 4534961,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فاش از محنت توام شد راز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4534962,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از فراقت بر آتش حسرت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از دوری تو در آتش حسرت می‌سوزم و عذاب می‌کشم."
      },
      {
        "id": 4534963,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چند باشم همی به سوز و گداز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4534964,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چیست این حرف‌های لاطایل",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این گفته‌ها و نظرات بی‌محتوا چیست و این تفکرهای پیچیده و بی‌فایده به چه کاری می‌آید؟"
      },
      {
        "id": 4534965,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چیست این فکرهای دور و دراز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4534966,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌نگویی که این چه ژاژ بود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو می‌گویی این چه بیهوده‌گویی است که به میدانش می‌آوری و به آن توجه می‌کنی."
      },
      {
        "id": 4534967,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که به میدانش آوری تک و تاز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4534968,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این سخن را اگر بری بازار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر این حرف را به دیگران بگویی، کسی آن را نمی‌خرد و ارزشی برایش قائل نمی‌شود؛ حتی ارزش ندارد که مثل سیب‌زمینی یا پیاز در بازار به فروش برسد."
      },
      {
        "id": 4534969,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نخرند از تواش به سیر و پیاز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4534970,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "غصهٔ قیس و قصهٔ لیلی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: غصه‌های قیس و داستان لیلی، شعری است درباره عشق و دلتنگی، همان‌طور که زندگی و سرگذشت ایاز نیز نشان‌دهنده‌ حساسیت‌ها و فراز و نشیب‌های انسانی است."
      },
      {
        "id": 4534971,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حرف محمود و سرگذشت ایاز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4534972,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کهنه شد این فسانه‌ها یکسر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: داستان‌های قدیمی کهنه شده‌اند، بنابراین بهتر است که این روایت‌ها را کنار بگذاریم و از ابتدا داستان جدیدی بسازیم."
      },
      {
        "id": 4534973,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کن حدیث نوی ز سر آغاز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4534974,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بگذر از این فسون و این نیرنگ",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از این فریب و نیرنگ عبور کن و دیگر درباره این حرف‌های جادو مانند سخن نگو."
      },
      {
        "id": 4534975,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیگر از این سخن فسانه مساز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4534976,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر هوای سخن بود به سرت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر خواسته باشی درباره صحبت کردن فکر کنی، پس از این به وطن خود برگرد و دوباره صحبت کن."
      },
      {
        "id": 4534977,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از وطن بعد از این سخن گو باز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4534978,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هوس عشق‌بازی ار داری",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر تمایل به عشق و سرگرمی داری، با محبوب خودت دلت را به بازی بگذار."
      },
      {
        "id": 4534979,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با وطن هم قمار عشق بباز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4534980,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از وطن نیست دلبری بهتر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از نظر عشق و محبت، هیچ شخصی بهتر از معشوق وطن نیست. بنابراین، به خاطر نیاز و ضرورت، قلب خود را به وطن بسپار."
      },
      {
        "id": 4534981,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به وطن دل بده ز روی نیاز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4534982,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شاهد شوخ دل‌فریب وطن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زیبای دلربای وطن به دلیل وجود رقیب خطرناک، هم‌دست و هم‌دم شده است."
      },
      {
        "id": 4534983,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با رقیب خطر شده دمساز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4534984,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در اصول ترقیات وطن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در بنیاد پیشرفت‌های کشور، شعر جایگاهی ویژه و ممتاز دارد."
      },
      {
        "id": 4534985,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شعر برگو گزیده و ممتاز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4534986,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پیش از وقت چاره باید کرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: قبل از آن که دیر شود، باید به فکر چاره‌ای باشیم، زیرا در فتنه‌ها خطرات زیادی برای سرزمین ما وجود دارد."
      },
      {
        "id": 4534987,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که درِ فتنه بر وطن شده باز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4534988,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا به کی در جهالت و غفلت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این جمله به این معناست که تا چه زمانی در نادانی و بی‌خبری خواهی ماند و نخواهی توانست تفاوت میان پایین و بالا را بشناسی."
      },
      {
        "id": 4534989,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نشناسی نشیب خود ز فراز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4534990,
        "vOrder": 47,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چیست اسلام در بر کفار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اسلام در برابر کفار، به معنای طعمه‌ای است که در جلوی انبوهی از گرازها قرار دارد."
      },
      {
        "id": 4534991,
        "vOrder": 48,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "طعمه‌ای پیش روی خیل گراز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4534992,
        "vOrder": 49,
        "coupletIndex": 24,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مایهٔ هر سعادتی علم است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مهم‌ترین چیزی که می‌تواند موجب موفقیت و خوشبختی شود، دانش است که از سوی خداوند دانا و بی‌همتا به انسان داده شده است."
      },
      {
        "id": 4534993,
        "vOrder": 50,
        "coupletIndex": 24,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به خدای علیم بی‌انباز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4534994,
        "vOrder": 51,
        "coupletIndex": 25,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کی ترقی کند کسی بی علم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کسی بدون علم و دانش نمی‌تواند پیشرفت کند، مانند پرنده‌ای که بدون بال نیست توان پرواز کردن."
      },
      {
        "id": 4534995,
        "vOrder": 52,
        "coupletIndex": 25,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرغ بی بال چون کند پرواز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4534996,
        "vOrder": 53,
        "coupletIndex": 26,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "علم تحصیل کن که سلم علم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: علم را فرا بگیر که به وسیله‌ی آن می‌توانی به اوج و موفقیت‌های بزرگ دست یابی."
      },
      {
        "id": 4534997,
        "vOrder": 54,
        "coupletIndex": 26,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از نشیبت برد به سوی فراز",
        "languageId": null,
        "coupletSummary": null
      }
    ],
