        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زین بیش ز مهر وی مجو کام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: برای بیشتری از عشق او درخواست نکن و از قهرش نترس."
      },
      {
        "id": 4541888,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زین بیش ز قهر وی میندیش",
        "languageId": null,
        "coupletSummary": null
      },
      {
