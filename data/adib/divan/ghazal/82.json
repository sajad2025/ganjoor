      {
        "id": 4542271,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جاسوس امور شرک و توحید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در این بیت به موضوعات مربوط به شرک و توحید، که نمایانگر باورهای متفاوت در ادیان هستند، اشاره شده است. همچنین به تمایز میان کفر و ایمان نیز پرداخته شده است. به‌طور کلی، این احساس وجود دارد که باید اسرار و اصول این باورها را درک و کشف کرد، چرا که هر یک از آن‌ها نمایانگر جنبه‌های مختلفی از حقیقت و واقعیت‌های دینی است."
      },
      {
        "id": 4542272,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
