        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4542151,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پشه گر شیرین کند زوکام جان",
