      {
        "id": 4543050,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون توپ بیاری عراده",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4543051,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیمی چو ز شب گذشت دیدم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نیمه شب که گذشت، متوجه شدم که به خانه‌ام آمدند و در آن به روی ما باز شده است."
      },
      {
        "id": 4543052,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کامد به سرای رو گشاده",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4543053,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این بنده ز جای جسته گفتم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این خدمتگزار از جای خود برخاست و گفت: ای مردم، چه اتفاقی افتاده است؟"
      },
      {
        "id": 4543054,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای قوم دیگر چه روی داده",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4543055,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتند قلی ز عشق لیلی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گفتند قلی که قیس به خاطر عشق لیلی در حال ناراحتی و درد کشیدن است."
      },
      {
        "id": 4543056,
        "vOrder": 10,
