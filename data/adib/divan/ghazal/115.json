        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در مضج قیس رو نهاده",
        "languageId": null,
        "coupletSummary": null
      },
      {
