        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کاین پای غلط بجا نهاده",
        "languageId": null,
        "coupletSummary": null
      },
