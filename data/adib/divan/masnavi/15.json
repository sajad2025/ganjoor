      },
      {
        "id": 4551859,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیان کرده ولله در قائل",
        "languageId": null,
        "coupletSummary": null
      },
