        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ز نور آفتاب بامدادی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: با تابش نور خورشید در صبح، درب خوشحالی به روی ما باز شد."
      },
      {
        "id": 4551837,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
