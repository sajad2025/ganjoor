      },
      {
        "id": 4551835,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که از گردون بخاک آمد اشارت",
        "languageId": null,
        "coupletSummary": null
