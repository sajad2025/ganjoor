        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4549286,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن زمان هر دو مشتهر گردیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در آن زمان هر دو شناخته خواهیم شد؛ تو به عنوان شخصی فریبنده و من به عنوان کسی که رازها را پیش‌بینی می‌کند."
      },
