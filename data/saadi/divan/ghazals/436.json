    "sections": [
      {
        "id": 97204,
        "poemId": 9758,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 7,
        "ganjoorMetre": {
          "id": 7,
          "urlSlug": null,
          "rhythm": "فعلاتن فعلاتن فعلاتن فعلن (رمل مثمن مخبون محذوف)",
          "name": null,
          "description": null,
          "verseCount": 94655
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "انگردیدیم",
        "plainText": "عمرها در پی مقصود به جان گردیدیم\r\nدوست در خانه و ما گرد جهان گردیدیم\r\nخود سراپرده قدرش ز مکان بیرون بود\r\nآن که ما در طلبش جمله مکان گردیدیم\r\nهمچو بلبل همه شب نعره زنان تا خورشید\r\nروی بنمود چو خفاش نهان گردیدیم\r\nگفته بودیم به خوبان که نباید نگریست\r\nدل ببردند و ضرورت نگران گردیدیم\r\nصفت یوسف نادیده بیان می کردند\r\nبا میان آمد و بی نام و نشان گردیدیم\r\nرفته بودیم به خلوت که دگر می نخوریم\r\nساقیا باده بده کز سر آن گردیدیم\r\nتا همه شهر بیایند و ببینند که ما\r\nپیر بودیم و دگرباره جوان گردیدیم\r\nسعدیا لشکر خوبان به شکار دل ما\r\nگو میایید که ما صید فلان گردیدیم",
