      {
        "id": 2240180,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دست موتم نکند میخ سراپردهٔ عمر",
        "languageId": null,
        "coupletSummary": "معنی: اگر سعادت یار گردد و من در کنار تو خیمه\nبزنم دیگر دست مرگ هم نمی‌تواند میخ سراپردهٔ عمر مرا از جای برآورد. - منبع: شرح غزل‌های سعدی / دکتر محمدرضا برزگر خالقی / دکتر تورج عقدایی"
      },
      {
        "id": 2240133,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر سعادت بزند خیمه به پهلوی توام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2240131,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو مپندار کز این در به ملامت بروم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نگران نباش که از این در به عنوان سرزنش و انتقاد می‌آیم، چون وقتی تو با تیغ خود به من آسیب می‌زنی، در واقع من به تو وابسته‌ام و در حالت ضعف هستم."
      },
      {
        "id": 2240105,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که گرم تیغ زنی بندهٔ بازوی توام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2240104,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سعدی از پردهٔ عشاق چه خوش می‌گوید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: سعدی درباره عشق و احساسات عاشقانه صحبت می‌کند و از طرفی بیان می‌کند که معشوقش باید پرده‌ها را کنار بزند. او خود را به صورت یک هندوی شاد و عاشق توصیف می‌کند که به زیبایی و جذابیت عشق اشاره دارد."
      },
      {
        "id": 2240103,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تُرک من! پرده برانداز که هندوی توام",
        "languageId": null,
        "coupletSummary": null
      }
    ],
