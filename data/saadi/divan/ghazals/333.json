    "sections": [
      {
        "id": 97101,
        "poemId": 9655,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 12,
        "ganjoorMetre": {
          "id": 12,
          "urlSlug": null,
          "rhythm": "مفاعیلن مفاعیلن فعولن (هزج مسدس محذوف یا وزن دوبیتی)",
          "name": null,
          "description": null,
          "verseCount": 155670
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "وش",
        "plainText": "خطا کردی به قول دشمنان گوش\r\nکه عهد دوستان کردی فراموش\r\nکه گفت آن روی شهرآرای بنمای\r\nدگربارش که بنمودی فراپوش\r\nدل سنگینت آگاهی ندارد\r\nکه من چون دیگ رویین می زنم جوش\r\nنمی بینم خلاص از دست فکرت\r\nمگر کافتاده باشم مست و مدهوش\r\nبه ظاهر پند مردم می نیوشم\r\nنهانم عشق می گوید که منیوش\r\nمگر ساقی که بستانم ز دستش\r\nمگر مطرب که بر قولش کنم گوش\r\nمرا جامی بده وین جامه بستان\r\nمرا نقلی بنه وین خرقه بفروش\r\nنشستم تا برون آیی خرامان\r\nتو بیرون آمدی من رفتم از هوش\r\nتو در عالم نمی گنجی ز خوبی\r\nمرا هرگز کجا گنجی در آغوش\r\nخردمندان نصیحت می کنندم\r\nکه سعدی چون دهل بیهوده مخروش\r\nولیکن تا به چوگان می زنندش\r\nدهل هرگز نخواهد بود خاموش",
