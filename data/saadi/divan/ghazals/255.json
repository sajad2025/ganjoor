    "sections": [
      {
        "id": 97023,
        "poemId": 9577,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 3,
        "ganjoorMetre": {
          "id": 3,
          "urlSlug": null,
          "rhythm": "مفاعلن فعلاتن مفاعلن فعلن (مجتث مثمن مخبون محذوف)",
          "name": null,
          "description": null,
          "verseCount": 136413
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "ود",
        "plainText": "تو را سماع نباشد که سوز عشق نبود\r\nگمان مبر که برآید ز خام هرگز دود\r\nچو هر چه می رسد از دست اوست فرقی نیست\r\nمیان شربت نوشین و تیغ زهرآلود\r\nنسیم باد صبا بوی یار من دارد\r\nچو باد خواهم از این پس به بوی او پیمود\r\nهمی گذشت و نظر کردمش به گوشه چشم\r\nکه یک نظر بربایم مرا ز من بربود\r\nبه صبر خواستم احوال عشق پوشیدن\r\nدگر به گل نتوانستم آفتاب اندود\r\nسوار عقل که باشد که پشت ننماید\r\nدر آن مقام که سلطان عشق روی نمود\r\nپیام ما که رساند به خدمتش که رضا\r\nرضای توست گرم خسته داری ار خشنود\r\nشبی نرفت که سعدی به داغ عشق نگفت\r\nدگر شب آمد و کی بی تو روز خواهد بود",
        "htmlText": "<div class=\"b\" id=\"bn1\"><div class=\"m1\"><p>تو را سماع نباشد که سوز عشق نبود</p></div>\r\n<div class=\"m2\"><p>گمان مبر که برآید ز خام هرگز دود</p></div></div>\r\n<div class=\"b\" id=\"bn2\"><div class=\"m1\"><p>چو هر چه می‌رسد از دست اوست فرقی نیست</p></div>\r\n<div class=\"m2\"><p>میان شربت نوشین و تیغ زهرآلود</p></div></div>\r\n<div class=\"b\" id=\"bn3\"><div class=\"m1\"><p>نسیم باد صبا بوی یار من دارد</p></div>\r\n<div class=\"m2\"><p>چو باد خواهم از این پس به بوی او پیمود</p></div></div>\r\n<div class=\"b\" id=\"bn4\"><div class=\"m1\"><p>همی‌گذشت و نظر کردمش به گوشه چشم</p></div>\r\n<div class=\"m2\"><p>که یک نظر بربایم مرا ز من بربود</p></div></div>\r\n<div class=\"b\" id=\"bn5\"><div class=\"m1\"><p>به صبر خواستم احوال عشق پوشیدن</p></div>\r\n<div class=\"m2\"><p>دگر به گِل نتوانستم آفتاب اندود</p></div></div>\r\n<div class=\"b\" id=\"bn6\"><div class=\"m1\"><p>سوار عقل که باشد که پشت ننماید</p></div>\r\n<div class=\"m2\"><p>در آن مقام که سلطان عشق روی نمود</p></div></div>\r\n<div class=\"b\" id=\"bn7\"><div class=\"m1\"><p>پیام ما که رساند به خدمتش که رضا</p></div>\r\n<div class=\"m2\"><p>رضای توست گرم خسته داری ار خشنود</p></div></div>\r\n<div class=\"b\" id=\"bn8\"><div class=\"m1\"><p>شبی نرفت که سعدی به داغ عشق نگفت</p></div>\r\n<div class=\"m2\"><p>دگر شب آمد و کی بی تو روز خواهد بود</p></div></div>",
        "poemFormat": 1,
        "cachedFirstCoupletIndex": 0,
        "language": null,
        "coupletsCount": 8,
        "top6RelatedSections": [
          {
            "id": 91373882,
            "poemId": 9577,
            "poem": null,
            "sectionIndex": 0,
            "poetId": 12,
            "relationOrder": 1,
            "poetName": "رودکی",
            "poetImageUrl": "/api/ganjoor/poet/image/roodaki.gif",
            "fullUrl": "/roodaki/baghimande/sh44",
            "fullTitle": "رودکی » قصاید و قطعات » شمارهٔ ۴۴",
            "htmlExcerpt": "<p>اگر چه عذر بسی بود روزگار نبود</p>\r\n<p>چنان که بود به ناچار خویشتن بخشود</p>\r\n<p>خدای را بستودم، که کردگار من است</p>\r\n<p>زبانم از غزل و مدح بندگانش نسود</p>\r\n<p>همه به تنبل و بند است بازگشتن او</p>\r\n<p>[...]</p>",
            "targetPoemId": 25228,
            "targetSectionIndex": 0,
            "poetMorePoemsLikeThisCount": 0
          },
          {
            "id": 91373883,
            "poemId": 9577,
            "poem": null,
            "sectionIndex": 0,
            "poetId": 15,
            "relationOrder": 2,
            "poetName": "فرخی سیستانی",
            "poetImageUrl": "/api/ganjoor/poet/image/farrokhi.gif",
            "fullUrl": "/farrokhi/divanf/ghetefk/sh9",
            "fullTitle": "فرخی سیستانی » دیوان اشعار » قطعات و ابیات بازماندهٔ قصاید » شمارهٔ ۹ - همو راست",
            "htmlExcerpt": "<p>همی روی و من از رفتن تو ناخشنود</p>\r\n<p>نگر به روی منا تا مرا کنی پدرود</p>\r\n<p>مرو که گر بروی باز جان من برود</p>\r\n<p>من از تو ناخشنود و خدای ناخشنود</p>\r\n<p>مرا ز رفتن تو وز نهیب فرقت تو</p>\r\n<p>[...]</p>",
