        "id": 21218,
        "authorName": "majid",
        "authorUrl": "http://naleney.tk",
        "commentDate": "2012-06-01T11:17:38",
        "htmlComment": "<p>عجب غزلی گفته</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": null,
        "replies": [],
