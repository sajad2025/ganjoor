        "coupletIndex": -1,
        "coupletSummary": "",
        "isBookmarked": false
      },
      {
        "id": 47867,
        "authorName": "ایرانی",
        "authorUrl": "",
        "commentDate": "2019-06-04T14:37:36",
        "htmlComment": "<p>این غزل رندانه از سعدی فرزانه و بسیاری از غزل های دیگر استاد سخن بعد ها سرمشق حافظ در غزلسرایی شد.</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": null,
        "replies": [],
        "myComment": false,
        "coupletIndex": -1,
