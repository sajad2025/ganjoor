      },
      {
        "id": 55191,
        "authorName": "فرزاد رضائی",
        "authorUrl": "",
        "commentDate": "2021-04-03T01:16:17",
        "htmlComment": "<p>نسترن جان:<br />خبرت خرابتر کرد جراحت جدایی<br />چو خیال آب روشن که به تشنگان نمایی<br />تو چه ارمغانی آری که به دوستان فرستی<br />چه از این به ارمغانی که تو خویشتن بیایی</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": null,
        "replies": [],
        "myComment": false,
        "coupletIndex": -1,
        "coupletSummary": "",
        "isBookmarked": false
      },
      {
        "id": 55771,
        "authorName": "فرزاد رضائی",
        "authorUrl": "",
        "commentDate": "2021-04-15T19:26:39",
        "htmlComment": "<p>نسترن جان <br />تو شاه شمداد قدانمی <br />جمال جانانمی <br />فقط همین بیت دروصف نبودنت  می تونم بگم <br />حال ما در فرقت جانان ابرام رقیب<br />داند خدای حال گردان غم مخور<br />عزیزانم در سایت گنجور بوسه بر دستانتان میزنم <br />خیلی ممنون از کاری که برای ما و ادبیات ما و فرهنگ و سلوک ما میکنید</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": null,
        "replies": [],
        "myComment": false,
        "coupletIndex": -1,
        "coupletSummary": "",
