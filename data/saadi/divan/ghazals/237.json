        "authorUrl": "",
        "commentDate": "2016-05-25T18:50:41",
        "htmlComment": "<p>جناب شمس ،<br /> بعید ندانید از سامرست موام است ، به یقین میگویم.</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": null,
