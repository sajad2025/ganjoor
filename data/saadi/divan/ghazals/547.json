        "id": 2237514,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صورت خود باز به ما ننگری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2237513,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خسرو اگر عهد تو دریافتی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر خسرو به پیمان تو اعتنا کند، دلش را به تو خواهد سپرد زیرا تو از هر چیز دیگر شیرین‌تر هستی."
      },
      {
        "id": 2237512,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل به تو دادی که تو شیرین‌تری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2237511,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر دری از خلق ببندم به روی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر درهای دوستی به روی دیگران را بستم، هرگز به روی تو نخواهم بست، زیرا به خاطر تو هر دری برایم باز است."
      },
      {
        "id": 2237510,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر تو نبندم که به خاطر دری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2237509,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سعدی اگر کشته شود در فراق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر سعدی در غم دوری بمیرد، زمانی که به یادش بیفتی دوباره زنده می‌شود."
      },
      {
        "id": 2237508,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زنده شود چون به سرش بگذری",
        "languageId": null,
        "coupletSummary": null
      }
