        "coupletSummary": "",
        "isBookmarked": false
      },
      {
        "id": 66123,
        "authorName": "nabavar",
        "authorUrl": "",
        "commentDate": "2018-01-01T01:51:46",
        "htmlComment": "<p>نمی دانم چرا تمام حاشیه های این حقیر که پاسخ سؤالات دوستان است به باز بینی میرود</p>",
        "publishStatus": "",
        "inReplyToId": null,
