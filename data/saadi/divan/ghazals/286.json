      {
        "id": 82470,
        "authorName": "۷",
        "authorUrl": "",
        "commentDate": "2018-04-21T19:24:43",
        "htmlComment": "<p>گر فراقت نکشد جان به وصالت بدهم<br />تو گرو بردی اگر جفت و اگر طاق آید<br />اگر درد دوری ات جانم را نگیرد با رسیدن به تو آن را میدهم زیرا در به هر روی جانم در گروه عشق تو است چه من ببرم(جفت آِید) و چه ببازم(تک آید)</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": null,
        "replies": [],
        "myComment": false,
        "coupletIndex": -1,
