    "sections": [
      {
        "id": 97051,
        "poemId": 9605,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 4,
        "ganjoorMetre": {
          "id": 4,
          "urlSlug": null,
          "rhythm": "مفعول فاعلاتن مفعول فاعلاتن (مضارع مثمن اخرب)",
          "name": null,
          "description": null,
          "verseCount": 16430
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "مبراید",
        "plainText": "سرمست اگر درآیی عالم به هم برآید\r\nخاک وجود ما را گرد از عدم برآید\r\nگر پرتوی ز رویت در کنج خاطر افتد\r\nخلوت نشین جان را آه از حرم برآید\r\nگلدسته امیدی بر جان عاشقان نه\r\nتا رهروان غم را خار از قدم برآید\r\nگفتی به کام روزی با تو دمی برآرم\r\nآن کام برنیامد ترسم که دم برآید\r\nعاشق بگشتم ار چه دانسته بودم اول\r\nکز تخم عشقبازی شاخ ندم برآید\r\nگویند دوستانم سودا و ناله تا کی\r\nسودا ز عشق خیزد ناله ز غم برآید\r\nدل رفت و صبر و دانش ما مانده ایم و جانی\r\nور زان که غم غم توست آن نیز هم برآید\r\nهر دم ز سوز عشقت سعدی چنان بنالد\r\nکز شعر سوزناکش دود از قلم برآید",
