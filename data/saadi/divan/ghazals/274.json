    "sections": [
      {
        "id": 97042,
        "poemId": 9596,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 12,
        "ganjoorMetre": {
          "id": 12,
          "urlSlug": null,
          "rhythm": "مفاعیلن مفاعیلن فعولن (هزج مسدس محذوف یا وزن دوبیتی)",
          "name": null,
          "description": null,
          "verseCount": 155670
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "اید",
        "plainText": "چه سرو است آن که بالا می نماید\r\nعنان از دست دل ها می رباید\r\nکه زاد این صورت منظور محبوب\r\nاز این صورت ندانم تا چه زاید\r\nاگر صد نوبتش چون قرص خورشید\r\nببینم آب در چشم من آید\r\nکس اندر عهد ما مانند وی نیست\r\nولی ترسم به عهد ما نپاید\r\nفراغت زان طرف چندان که خواهی\r\nوزین جانب محبت می فزاید\r\nحدیث عشق جانان گفتنی نیست\r\nو گر گویی کسی هم درد باید\r\nدرازای شب از ناخفتگان پرس\r\nکه خواب آلوده را کوته نماید\r\nمرا پای گریز از دست او نیست\r\nاگر می بنددم ور می گشاید\r\nرها کن تا بیفتد ناتوانی\r\nکه با سرپنجگان زور آزماید\r\nنشاید خون سعدی بی سبب ریخت\r\nولیکن چون مراد اوست شاید",
        "htmlText": "<div class=\"b\" id=\"bn1\"><div class=\"m1\"><p>چه سرو است آن که بالا می‌نماید</p></div>\r\n<div class=\"m2\"><p>عنان از دست دل‌ها می‌رباید</p></div></div>\r\n<div class=\"b\" id=\"bn2\"><div class=\"m1\"><p>که زاد این صورت منظور محبوب</p></div>\r\n<div class=\"m2\"><p>از این صورت ندانم تا چه زاید</p></div></div>\r\n<div class=\"b\" id=\"bn3\"><div class=\"m1\"><p>اگر صد نوبتش چون قرص خورشید</p></div>\r\n<div class=\"m2\"><p>ببینم آب در چشم من آید</p></div></div>\r\n<div class=\"b\" id=\"bn4\"><div class=\"m1\"><p>کس اندر عهد ما مانند وی نیست</p></div>\r\n<div class=\"m2\"><p>ولی ترسم به عهد ما نپاید</p></div></div>\r\n<div class=\"b\" id=\"bn5\"><div class=\"m1\"><p>فراغت زان طرف چندان که خواهی</p></div>\r\n<div class=\"m2\"><p>وزین جانب محبت می‌فزاید</p></div></div>\r\n<div class=\"b\" id=\"bn6\"><div class=\"m1\"><p>حدیث عشق جانان گفتنی نیست</p></div>\r\n<div class=\"m2\"><p>و گر گویی کسی هم‌درد باید</p></div></div>\r\n<div class=\"b\" id=\"bn7\"><div class=\"m1\"><p>درازای شب از ناخفتگان پرس</p></div>\r\n<div class=\"m2\"><p>که خواب‌آلوده را کوته نماید</p></div></div>\r\n<div class=\"b\" id=\"bn8\"><div class=\"m1\"><p>مرا پای گریز از دست او نیست</p></div>\r\n<div class=\"m2\"><p>اگر می‌بنددم ور می‌گشاید</p></div></div>\r\n<div class=\"b\" id=\"bn9\"><div class=\"m1\"><p>رها کن تا بیفتد ناتوانی</p></div>\r\n<div class=\"m2\"><p>که با سرپنجگان زور آزماید</p></div></div>\r\n<div class=\"b\" id=\"bn10\"><div class=\"m1\"><p>نشاید خون سعدی بی‌سبب ریخت</p></div>\r\n<div class=\"m2\"><p>ولیکن چون مراد اوست شاید</p></div></div>",
        "poemFormat": 1,
        "cachedFirstCoupletIndex": 0,
        "language": null,
        "coupletsCount": 10,
