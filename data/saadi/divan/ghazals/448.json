    "sections": [
      {
        "id": 97216,
        "poemId": 9770,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 12,
        "ganjoorMetre": {
          "id": 12,
          "urlSlug": null,
          "rhythm": "مفاعیلن مفاعیلن فعولن (هزج مسدس محذوف یا وزن دوبیتی)",
          "name": null,
          "description": null,
          "verseCount": 155670
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "یبان",
        "plainText": "خوشا و خرما وقت حبیبان\r\nبه بوی صبح و بانگ عندلیبان\r\nخوش آن ساعت نشیند دوست با دوست\r\nکه ساکن گردد آشوب رقیبان\r\nدو تن در جامه ای چون پسته در پوست\r\nبرآورده دو سر از یک گریبان\r\nسزای دشمنان این بس که بینند\r\nحبیبان روی در روی حبیبان\r\nنصیب از عمر دنیا نقد وقت است\r\nمباش ای هوشمند از بی نصیبان\r\nچو دانی کز تو چوپانی نیاید\r\nرها کن گوسفندان را به ذیبان\r\nمن این رندان و مستان دوست دارم\r\nخلاف پارسایان و خطیبان\r\nبهل تا در حق من هر چه خواهند\r\nبگویند آشنایان و غریبان\r\nلب شیرین لبان را خصلتی هست\r\nکه غارت می کند هوش لبیبان\r\nنشستم با جوانمردان اوباش\r\nبشستم هر چه خواندم بر ادیبان\r\nکه می داند دوای درد سعدی\r\nکه رنجورند از این علت طبیبان",
