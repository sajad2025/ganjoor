    "sections": [
      {
        "id": 97280,
        "poemId": 9834,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 9,
        "ganjoorMetre": {
          "id": 9,
          "urlSlug": null,
          "rhythm": "فعلاتن مفاعلن فعلن (خفیف مسدس مخبون)",
          "name": null,
          "description": null,
          "verseCount": 114753
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "ایی",
        "plainText": "همه چشمیم تا برون آیی\r\nهمه گوشیم تا چه فرمایی\r\nتو نه آن صورتی که بی رویت\r\nمتصور شود شکیبایی\r\nمن ز دست تو خویشتن بکشم\r\nتا تو دستم به خون نیآلایی\r\nگفته بودی قیامتم بینند\r\nاین گروهی محب سودایی\r\nوین چنین روی دل ستان که تو راست\r\nخود قیامت بود که بنمایی\r\nما تماشاکنان کوته دست\r\nتو درخت بلندبالایی\r\nسر ما و آستان خدمت تو\r\nگر برانی و گر ببخشایی\r\nجان به شکرانه دادن از من خواه\r\nگر به انصاف با میان آیی\r\nعقل باید که با صلابت عشق\r\nنکند پنجه توانایی\r\nتو چه دانی که بر تو نگذشته ست\r\nشب هجران و روز تنهایی\r\nروشنت گردد این حدیث چو روز\r\nگر چو سعدی شبی بپیمایی",
