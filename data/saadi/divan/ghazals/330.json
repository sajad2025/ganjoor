        "htmlComment": "<p>واله از سعدیند سخندانان</p>\r\n<p>عاقل وعاشقند حیرانش</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": "e04ac35f-bae3-4eda-b014-08dc9f0d3f97",
        "replies": [],
