        "authorUrl": null,
        "commentDate": "2023-09-03T20:14:24.7934521",
        "htmlComment": "<p>ما دل دوستان به جان بخریم...</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": "aebb26fe-a5f7-4e35-b989-08db8cec567f",
        "replies": [],
        "myComment": false,
