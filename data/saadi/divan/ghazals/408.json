      },
      {
        "id": 127548,
        "authorName": "جلال ارغوانی",
        "authorUrl": null,
        "commentDate": "2025-01-03T23:46:31.2654839",
        "htmlComment": "<p>سعدی زگفته لطیفت</p>\r\n<p>دادی تو شربت زلالم</p>\r\n<p>جز تو سخن کسی نگویم</p>\r\n<p>جز تو به دیگری نبالم</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": "e04ac35f-bae3-4eda-b014-08dc9f0d3f97",
        "replies": [],
        "myComment": false,
