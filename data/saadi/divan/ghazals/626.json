    "sections": [
      {
        "id": 97394,
        "poemId": 9948,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 13,
        "ganjoorMetre": {
          "id": 13,
          "urlSlug": null,
          "rhythm": "مفعول مفاعلن فعولن (هزج مسدس اخرب مقبوض محذوف)",
          "name": null,
          "description": null,
          "verseCount": 40158
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "وی",
        "plainText": "امروز چنانی ای پری روی\r\nکز ماه به حسن می بری گوی\r\nمی آیی و در پی تو عشاق\r\nدیوانه شده دوان به هر سوی\r\nاینک من و زنگیان کافر\r\nوان ملعب لعبتان جادوی\r\nآورده ز غمزه سحر در چشم\r\nدر داده ز فتنه تاب در موی\r\nوز بهر شکار دل نهاده\r\nتیر مژه در کمان ابروی\r\nنرخ گل و گلشکر شکسته\r\nزآن چهره خوب و لعل دلجوی\r\nچاکر شده شاه اخترانت\r\nشیر فلکت شده سگ کوی\r\nبر بام سراچه جمالت\r\nکیوان شده پاسبان هندوی\r\nعارض به مثل چو برگ نسرین\r\nبالا به صفت چو سرو خودروی\r\nگویی به چه شانه کرده ای زلف\r\nیا خود به چه آب شسته ای روی\r\nکز روی به لاله می دهی رنگ\r\nوز زلف به مشک می دهی بوی\r\nچون سعدی صد هزار بلبل\r\nگلزار رخ تو را غزل گوی",
        "htmlText": "<div class=\"b\" id=\"bn1\"><div class=\"m1\"><p>امروز چنانی ای پری‌روی</p></div>\r\n<div class=\"m2\"><p>کز ماه به حسن می‌بری گوی</p></div></div>\r\n<div class=\"b\" id=\"bn2\"><div class=\"m1\"><p>می‌آیی و در پی تو عشاق</p></div>\r\n<div class=\"m2\"><p>دیوانه شده دوان به هر سوی</p></div></div>\r\n<div class=\"b\" id=\"bn3\"><div class=\"m1\"><p>اینک من و زنگیان کافر</p></div>\r\n<div class=\"m2\"><p>وان ملعب لعبتان جادوی</p></div></div>\r\n<div class=\"b\" id=\"bn4\"><div class=\"m1\"><p>آورده ز غمزه سحر در چشم</p></div>\r\n<div class=\"m2\"><p>در داده ز فتنه تاب در موی</p></div></div>\r\n<div class=\"b\" id=\"bn5\"><div class=\"m1\"><p>وز بهر شکار دل نهاده</p></div>\r\n<div class=\"m2\"><p>تیر مژه در کمان ابروی</p></div></div>\r\n<div class=\"b\" id=\"bn6\"><div class=\"m1\"><p>نرخ گل و گلشکر شکسته</p></div>\r\n<div class=\"m2\"><p>زآن چهره خوب و لعل دلجوی</p></div></div>\r\n<div class=\"b\" id=\"bn7\"><div class=\"m1\"><p>چاکر شده شاه اخترانت</p></div>\r\n<div class=\"m2\"><p>شیر فلکت شده سگ کوی</p></div></div>\r\n<div class=\"b\" id=\"bn8\"><div class=\"m1\"><p>بر بام سراچهٔ جمالت</p></div>\r\n<div class=\"m2\"><p>کیوان شده پاسبان هندوی</p></div></div>\r\n<div class=\"b\" id=\"bn9\"><div class=\"m1\"><p>عارض به مثل چو برگ نسرین</p></div>\r\n<div class=\"m2\"><p>بالا به صفت چو سرو خودروی</p></div></div>\r\n<div class=\"b\" id=\"bn10\"><div class=\"m1\"><p>گویی به چه شانه کرده‌ای زلف</p></div>\r\n<div class=\"m2\"><p>یا خود به چه آب شسته‌ای روی</p></div></div>\r\n<div class=\"b\" id=\"bn11\"><div class=\"m1\"><p>کز روی به لاله می‌دهی رنگ</p></div>\r\n<div class=\"m2\"><p>وز زلف به مشک می‌دهی بوی</p></div></div>\r\n<div class=\"b\" id=\"bn12\"><div class=\"m1\"><p>چون سعدی، صد هزار بلبل</p></div>\r\n<div class=\"m2\"><p>گلزار رخ تو را غزل‌گوی</p></div></div>",
