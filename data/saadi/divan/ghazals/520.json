        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شب و روز آرزومندم به خوابی",
        "languageId": null,
        "coupletSummary": null
