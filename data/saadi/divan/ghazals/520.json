        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که باز آید به جوی رفته آبی",
        "languageId": null,
        "coupletSummary": null
      },
