      },
      {
        "id": 89303,
        "authorName": "محسن",
        "authorUrl": null,
        "commentDate": "2021-10-03T11:48:18.627313",
        "htmlComment": "<p>با تشکر از سایت خیلی خوبتون&nbsp;<br />شعر بی نظری بود&nbsp;<br />ده ها بار خوندمش<br />میشه لطفاً معنی بیت آخر رو هم کسی بگه&nbsp;<br />ممنونم</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": "aa3fa485-b533-4bc3-ea3c-08d986223988",
        "replies": [],
        "myComment": false,
        "coupletIndex": -1,
        "coupletSummary": "",
        "isBookmarked": false
      },
      {
        "id": 89304,
        "authorName": "رضا از کرمان",
        "authorUrl": null,
        "commentDate": "2021-10-03T12:15:31.4252274",
        "htmlComment": "<p>&nbsp;اقا محسن سلام&nbsp;</p>\r\n<p>&nbsp;با توجه به معنی کلی این غزل برای بیت آخر که فرمودی میشه این معنی را در نظر گرفت&nbsp; با توجه به فراق و محنتی که داره ازش در غزل صحبت میشه میگه من با توجه به همه سختی ودرد ورنج پا پس نمیکشم وبه عشق معشوق وفا دارم&nbsp; واز پیش تو نمیرم چون من مقید به عشقم&nbsp; وپابسته وگرفتارم&nbsp; وقادر به رفتن نیستم&nbsp; ( پا بسته ومسمار شده قادر به&nbsp; رفتن نیست)&nbsp;</p>\r\n<p>&nbsp;با درود شاد باشی</p>\r\n<p>&nbsp;</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": "ab86b6c8-607c-4f91-a3db-08d96a3cfa27",
        "replies": [
          {
