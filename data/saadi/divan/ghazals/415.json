    "sections": [
      {
        "id": 97183,
        "poemId": 9737,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 31,
        "ganjoorMetre": {
          "id": 31,
          "urlSlug": null,
          "rhythm": "مفعول مفاعلن مفاعیلن (هزج مسدس اخرب مقبوض)",
          "name": null,
          "description": null,
          "verseCount": 6363
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "انم",
        "plainText": "ای مرهم ریش و مونس جانم\r\nچندین به مفارقت مرنجانم\r\nای راحت اندرون مجروحم\r\nجمعیت خاطر پریشانم\r\nگویند بدار دستش از دامن\r\nتا دست بدارد از گریبانم\r\nآن کس که مرا به باغ می خواند\r\nبی روی تو می برد به زندانم\r\nوین طرفه که ره نمی برم پیشت\r\nوز پیش تو ره به در نمی دانم\r\nیک روز به بندگی قبولم کن\r\nروز دگرم ببین که سلطانم\r\nای گلبن بوستان روحانی\r\nمشغول بکردی از گلستانم\r\nزان روز که سرو قامتت دیدم\r\nاز یاد برفت سرو بستانم\r\nآن در دو رسته در حدیث آمد\r\nوز دیده بیوفتاد مرجانم\r\nگویند صبور باش از او سعدی\r\nبارش بکشم که صبر نتوانم\r\nای کاش که جان در آستین بودی\r\nتا بر سر مونس دل افشانم",
