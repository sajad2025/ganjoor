    "sections": [
      {
        "id": 97359,
        "poemId": 9913,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 6,
        "ganjoorMetre": {
          "id": 6,
          "urlSlug": null,
          "rhythm": "فاعلاتن فاعلاتن فاعلن (رمل مسدس محذوف یا وزن مثنوی)",
          "name": null,
          "description": null,
          "verseCount": 148935
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "ارگی",
        "plainText": "سخت زیبا می روی یک بارگی\r\nدر تو حیران می شود نظارگی\r\nاین چنین رخ با پری باید نمود\r\nتا بیاموزد پری رخسارگی\r\nهرکه را پیش تو پای از جای رفت\r\nزیر بارش برنخیزد بارگی\r\nچشم های نیم خوابت سال و ماه\r\nهمچو من مستند بی میخوارگی\r\nخستگانت را شکیبایی نماند\r\nیا دوا کن یا بکش یک بارگی\r\nدوست تا خواهی به جای ما نکوست\r\nدر حسودان اوفتاد آوارگی\r\nسعدیا تسلیم فرمان شو که نیست\r\nچاره عاشق به جز بیچارگی",
        "htmlText": "<div class=\"b\" id=\"bn1\"><div class=\"m1\"><p>سخت زیبا می‌روی یک‌بارگی</p></div>\r\n<div class=\"m2\"><p>در تو حیران می‌شود نظّارگی</p></div></div>\r\n<div class=\"b\" id=\"bn2\"><div class=\"m1\"><p>این‌چنین رخ با پری باید نمود</p></div>\r\n<div class=\"m2\"><p>تا بیاموزد پری رخسارگی</p></div></div>\r\n<div class=\"b\" id=\"bn3\"><div class=\"m1\"><p>هرکه را پیش تو پای از جای رفت</p></div>\r\n<div class=\"m2\"><p>زیر بارش برنخیزد بارگی</p></div></div>\r\n<div class=\"b\" id=\"bn4\"><div class=\"m1\"><p>چشم‌های نیم‌خوابت سال و ماه</p></div>\r\n<div class=\"m2\"><p>همچو من مَستند بی میخوارگی</p></div></div>\r\n<div class=\"b\" id=\"bn5\"><div class=\"m1\"><p>خستگانت را شکیبایی نماند</p></div>\r\n<div class=\"m2\"><p>یا دوا کن یا بکُش یک‌بارگی</p></div></div>\r\n<div class=\"b\" id=\"bn6\"><div class=\"m1\"><p>دوست تا خواهی به‌جای ما نکوست</p></div>\r\n<div class=\"m2\"><p>در حسودان اوفتاد آوارگی</p></div></div>\r\n<div class=\"b\" id=\"bn7\"><div class=\"m1\"><p>سعدیا تسلیم فرمان شو که نیست</p></div>\r\n<div class=\"m2\"><p>چارهٔ عاشق به‌جز بیچارگی</p></div></div>",
        "poemFormat": 1,
        "cachedFirstCoupletIndex": 0,
