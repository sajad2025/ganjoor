      {
        "id": 2236782,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتم که نریزم آب رخ زین بیش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گفتم که دیگر بر خاک در خانه‌ات آب روی زیباترین چهره‌ام نریزم، چون تو خون من را نوشیدی."
      },
      {
        "id": 2236781,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر خاک درت که خون من خوردی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2236780,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وین عشق تو در من آفریدستند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عشق تو در وجود من جای گرفته است و هرگز از بین نمی‌رود، همان‌طور که زعفران زردش را فراموش نمی‌کنیم."
      },
      {
        "id": 2236779,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هرگز نرود ز زعفران زردی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2236778,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای ذره تو در مقابل خورشید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای ذره‌ی کوچولو، تو در برابر خورشید بزرگ چه کاری می‌توانی انجام دهی با این اندازه‌ی کوچک؟"
      },
      {
        "id": 2236777,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیچاره چه می‌کنی بدین خردی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2236776,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در حلقه کارزارْ جان دادن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در میدان نبرد، بهتر است که با شجاعت جان بدهی تا اینکه به خاطر ترس و cowardice فرار کنی."
      },
      {
        "id": 2236775,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بهتر که گریختن به نامردی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2236774,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سعدی سپر از جفا نیندازد",
        "languageId": null,
        "coupletSummary": "سعدی با ظلم و ستم تسلیم نمی‌شود و سپر نمی‌اندازد، (چون او می‌داند) که همراه گل علف هرز هست و با شراب صاف، دُرد. / صاف و درد: غزل 28 بیت 9 / (AI: سعدی می‌گوید کسی که در برابر ناملایمات و سختی‌ها خود را محافظت نمی‌کند، همچون گلی است که به راحتی آسیب می‌بیند. او می‌خواهد بگوید اگر کسی نسبت به درد و رنج بی‌توجه باشد، نمی‌تواند در زندگی پایدار بماند.)"
      },
      {
        "id": 2236773,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گل با گیه است و صاف با دردی",
        "languageId": null,
        "coupletSummary": null
      }
    ],
