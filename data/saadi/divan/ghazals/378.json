    "sections": [
      {
        "id": 97146,
        "poemId": 9700,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 13,
        "ganjoorMetre": {
          "id": 13,
          "urlSlug": null,
          "rhythm": "مفعول مفاعلن فعولن (هزج مسدس اخرب مقبوض محذوف)",
          "name": null,
          "description": null,
          "verseCount": 40158
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "ودم",
        "plainText": "من با تو نه مرد پنجه بودم\r\nافکندم و مردی آزمودم\r\nدیدم دل خاص و عام بردی\r\nمن نیز دلاوری نمودم\r\nدر حلقه کارزارم انداخت\r\nآن نیزه که حلقه می ربودم\r\nانگشت نمای خلق بودم\r\nو انگشت به هیچ برنسودم\r\nعیب دگران نگویم این بار\r\nکاندر حق خویشتن شنودم\r\nگفتم که برآرم از تو فریاد\r\nفریاد که نشنوی چه سودم\r\nاز چشم عنایتم مینداز\r\nکاول به تو چشم برگشودم\r\nگر سر برود فدای پایت\r\nمرگ آمدنیست دیر و زودم\r\nامروز چنانم از محبت\r\nکآتش به فلک رسید و دودم\r\nوان روز که سر برآرم از خاک\r\nمشتاق تو همچنان که بودم",
