    "sections": [
      {
        "id": 96940,
        "poemId": 9494,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 12,
        "ganjoorMetre": {
          "id": 12,
          "urlSlug": null,
          "rhythm": "مفاعیلن مفاعیلن فعولن (هزج مسدس محذوف یا وزن دوبیتی)",
          "name": null,
          "description": null,
          "verseCount": 155670
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "وریندارد",
        "plainText": "هر آن ناظر که منظوری ندارد\r\nچراغ دولتش نوری ندارد\r\nچه کار اندر بهشت آن مدعی را\r\nکه میل امروز با حوری ندارد\r\nچه ذوق از ذکر پیدا آید آن را\r\nکه پنهان شوق مذکوری ندارد\r\nمیان عارفان صاحب نظر نیست\r\nکه خاطر پیش منظوری ندارد\r\nاگر سیمرغی اندر دام زلفی\r\nبماند تاب عصفوری ندارد\r\nطبیب ما یکی نامهربان ست\r\nکه گویی هیچ رنجوری ندارد\r\nولیکن چون عسل بشناخت سعدی\r\nفغان از دست زنبوری ندارد",
