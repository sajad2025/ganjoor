    "sections": [
      {
        "id": 97373,
        "poemId": 9927,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 9,
        "ganjoorMetre": {
          "id": 9,
          "urlSlug": null,
          "rhythm": "فعلاتن مفاعلن فعلن (خفیف مسدس مخبون)",
          "name": null,
          "description": null,
          "verseCount": 114753
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "نی",
        "plainText": "سروقدی میان انجمنی\r\nبه که هفتاد سرو در چمنی\r\nجهل باشد فراق صحبت دوست\r\nبه تماشای لاله و سمنی\r\nای که هرگز ندیده ای به جمال\r\nجز در آیینه مثل خویشتنی\r\nتو که همتای خویشتن بینی\r\nلاجرم ننگری به مثل منی\r\nدر دهانت سخن نمی گویم\r\nکه نگنجد در آن دهن سخنی\r\nبدنت در میان پیرهنت\r\nهمچو روحیست رفته در بدنی\r\nوآن که بیند برهنه اندامت\r\nگوید این پرگل است پیرهنی\r\nبا وجودت خطا بود که نظر\r\nبه ختایی کنند یا ختنی\r\nباد اگر بر من اوفتد ببرد\r\nکه نمانده ست زیر جامه تنی\r\nچاره بیچارگی بود سعدی\r\nچون ندانند چاره ای و فنی",
        "htmlText": "<div class=\"b\" id=\"bn1\"><div class=\"m1\"><p>سروقدی میان انجمنی</p></div>\r\n<div class=\"m2\"><p>به که هفتاد سرو در چمنی</p></div></div>\r\n<div class=\"b\" id=\"bn2\"><div class=\"m1\"><p>جهل باشد فراق صحبت دوست</p></div>\r\n<div class=\"m2\"><p>به تماشای لاله و سمنی</p></div></div>\r\n<div class=\"b\" id=\"bn3\"><div class=\"m1\"><p>ای که هرگز ندیده‌ای به جمال</p></div>\r\n<div class=\"m2\"><p>جز در آیینه مثل خویشتنی</p></div></div>\r\n<div class=\"b\" id=\"bn4\"><div class=\"m1\"><p>تو که همتای خویشتن بینی</p></div>\r\n<div class=\"m2\"><p>لاجرم ننگری به مثل منی</p></div></div>\r\n<div class=\"b\" id=\"bn5\"><div class=\"m1\"><p>در دهانت سخن نمی‌گویم</p></div>\r\n<div class=\"m2\"><p>که نگنجد در آن دهن سخنی</p></div></div>\r\n<div class=\"b\" id=\"bn6\"><div class=\"m1\"><p>بدنت در میان پیرهنت</p></div>\r\n<div class=\"m2\"><p>همچو روحیست رفته در بدنی</p></div></div>\r\n<div class=\"b\" id=\"bn7\"><div class=\"m1\"><p>وآن که بیند برهنه اندامت</p></div>\r\n<div class=\"m2\"><p>گوید این پُرگل است پیرهنی</p></div></div>\r\n<div class=\"b\" id=\"bn8\"><div class=\"m1\"><p>با وجودت خطا بود که نظر</p></div>\r\n<div class=\"m2\"><p>به ختایی کنند یا ختنی</p></div></div>\r\n<div class=\"b\" id=\"bn9\"><div class=\"m1\"><p>باد اگر بر من اوفتد ببرد</p></div>\r\n<div class=\"m2\"><p>که نمانده‌ست زیر جامه تنی</p></div></div>\r\n<div class=\"b\" id=\"bn10\"><div class=\"m1\"><p>چاره بیچارگی بود سعدی</p></div>\r\n<div class=\"m2\"><p>چون ندانند چاره‌ای و فنی</p></div></div>",
        "poemFormat": 1,
        "cachedFirstCoupletIndex": 0,
        "language": null,
        "coupletsCount": 10,
        "top6RelatedSections": [
          {
