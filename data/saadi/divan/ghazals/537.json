    "sections": [
      {
        "id": 97305,
        "poemId": 9859,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 3,
        "ganjoorMetre": {
          "id": 3,
          "urlSlug": null,
          "rhythm": "مفاعلن فعلاتن مفاعلن فعلن (مجتث مثمن مخبون محذوف)",
          "name": null,
          "description": null,
          "verseCount": 136413
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "ندی",
        "plainText": "چه باز در دلت آمد که مهر برکندی\r\nچه شد که یار قدیم از نظر بیفکندی\r\nز حد گذشت جدایی میان ما ای دوست\r\nهنوز وقت نیامد که بازپیوندی\r\nبود که پیش تو میرم اگر مجال بود\r\nوگرنه بر سر کویت به آرزومندی\r\nدری به روی من ای یار مهربان بگشای\r\nکه هیچ کس نگشاید اگر تو در بندی\r\nمرا وگر همه آفاق خوبرویانند\r\nبه هیچ روی نمی باشد از تو خرسندی\r\nهزار بار بگفتم که چشم نگشایم\r\nبه روی خوب ولیکن تو چشم می بندی\r\nمگر در آینه بینی وگرنه در آفاق\r\nبه هیچ خلق نپندارمت که مانندی\r\nحدیث سعدی اگر کاینات بپسندند\r\nبه هیچ کار نیاید گرش تو نپسندی\r\nمرا چه بندگی از دست و پای برخیزد\r\nمگر امید به بخشایش خداوندی",
