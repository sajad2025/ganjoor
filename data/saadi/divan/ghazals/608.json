    "sections": [
      {
        "id": 97376,
        "poemId": 9930,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 13,
        "ganjoorMetre": {
          "id": 13,
          "urlSlug": null,
          "rhythm": "مفعول مفاعلن فعولن (هزج مسدس اخرب مقبوض محذوف)",
          "name": null,
          "description": null,
          "verseCount": 40158
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "انی",
        "plainText": "ای سرو حدیقه معانی\r\nجانی و لطیفه جهانی\r\nپیش تو به اتفاق مردن\r\nخوشتر که پس از تو زندگانی\r\nچشمان تو سحر اولین اند\r\nتو فتنه آخرالزمانی\r\nچون اسم تو در میان نباشد\r\nگویی که به جسم در میانی\r\nآن را که تو از سفر بیایی\r\nحاجت نبود به ارمغانی\r\nگر ز آمدنت خبر بیارند\r\nمن جان بدهم به مژدگانی\r\nدفع غم دل نمی توان کرد\r\nالا به امید شادمانی\r\nگر صورت خویشتن ببینی\r\nحیران وجود خود بمانی\r\nگر صلح کنی لطیف باشد\r\nدر وقت بهار و مهربانی\r\nسعدی خط سبز دوست دارد\r\nپیرامن خد ارغوانی\r\nاین پیر نگر که همچنانش\r\nاز یاد نمی رود جوانی",
