      {
        "id": 70965,
        "authorName": "سروش",
        "authorUrl": "",
        "commentDate": "2017-06-25T11:21:40",
        "htmlComment": "<p>نخدان به معنی چانه هست<br />و به نیز به معنی نیک...</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": null,
