    "sections": [
      {
        "id": 97261,
        "poemId": 9815,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 13,
        "ganjoorMetre": {
          "id": 13,
          "urlSlug": null,
          "rhythm": "مفعول مفاعلن فعولن (هزج مسدس اخرب مقبوض محذوف)",
          "name": null,
          "description": null,
          "verseCount": 40158
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "اده",
        "plainText": "سرمست بتی لطیف ساده\r\nدر دست گرفته جام باده\r\nدر مجلس بزم باده نوشان\r\nبسته کمر و قبا گشاده\r\nافتاده زمین به حضرت او\r\nگردونش به خدمت ایستاده\r\nخورشید و مهش ز خوبرویی\r\nسر بر خط بندگی نهاده\r\nخورشید که شاه آسمان است\r\nدر عرصه حسن او پیاده\r\nوه وه که بزرگوار حوریست\r\nاز روزن جنت اوفتاده\r\nلعلش چو عقیق گوهرآگین\r\nزلفش چو کمند تاب داده\r\nدر گلشن بوستان رویش\r\nزنگی بچگان ز ماه زاده\r\nسعدی نرسد به یار هرگز\r\nکاو شرمگن است و یار ساده",
        "htmlText": "<div class=\"b\" id=\"bn1\"><div class=\"m1\"><p>سرمست بتی لطیف ساده</p></div>\r\n<div class=\"m2\"><p>در دست گرفته جام باده</p></div></div>\r\n<div class=\"b\" id=\"bn2\"><div class=\"m1\"><p>در مجلس بزم باده‌نوشان</p></div>\r\n<div class=\"m2\"><p>بسته کمر و قبا گشاده</p></div></div>\r\n<div class=\"b\" id=\"bn3\"><div class=\"m1\"><p>افتاده زمین به حضرت او</p></div>\r\n<div class=\"m2\"><p>گردونش به خدمت ایستاده</p></div></div>\r\n<div class=\"b\" id=\"bn4\"><div class=\"m1\"><p>خورشید و مهش ز خوبرویی</p></div>\r\n<div class=\"m2\"><p>سر بر خط بندگی نهاده</p></div></div>\r\n<div class=\"b\" id=\"bn5\"><div class=\"m1\"><p>خورشید که شاه آسمان است</p></div>\r\n<div class=\"m2\"><p>در عرصه حسن او پیاده</p></div></div>\r\n<div class=\"b\" id=\"bn6\"><div class=\"m1\"><p>وه وه که بزرگوار حوریست</p></div>\r\n<div class=\"m2\"><p>از روزن جنت اوفتاده</p></div></div>\r\n<div class=\"b\" id=\"bn7\"><div class=\"m1\"><p>لعلش چو عقیق گوهرآگین</p></div>\r\n<div class=\"m2\"><p>زلفش چو کمند تاب داده</p></div></div>\r\n<div class=\"b\" id=\"bn8\"><div class=\"m1\"><p>در گلشن بوستان رویش</p></div>\r\n<div class=\"m2\"><p>زنگی بچگان ز ماه زاده</p></div></div>\r\n<div class=\"b\" id=\"bn9\"><div class=\"m1\"><p>سعدی نرسد به یار هرگز</p></div>\r\n<div class=\"m2\"><p>کاو شرمگن است و یار ساده</p></div></div>",
        "poemFormat": 1,
        "cachedFirstCoupletIndex": 0,
        "language": null,
        "coupletsCount": 9,
        "top6RelatedSections": [
