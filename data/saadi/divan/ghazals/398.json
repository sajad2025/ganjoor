    "sections": [
      {
        "id": 97166,
        "poemId": 9720,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 7,
        "ganjoorMetre": {
          "id": 7,
          "urlSlug": null,
          "rhythm": "فعلاتن فعلاتن فعلاتن فعلن (رمل مثمن مخبون محذوف)",
          "name": null,
          "description": null,
          "verseCount": 94655
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "ازم",
        "plainText": "نظر از مدعیان بر تو نمی اندازم\r\nتا نگویند که من با تو نظر می بازم\r\nآرزو می کندم در همه عالم صیدی\r\nکه نباشند رفیقان حسود انبازم\r\nدرد پنهان فراقم ز تحمل بگذشت\r\nور نه از دل نرسیدی به زبان آوازم\r\nچون کبوتر بگرفتیم به دام سر زلف\r\nدیده بردوختی از خلق جهان چون بازم\r\nبه سرانگشت بخواهی دل مسکینان برد\r\nدست واپوش که من پنجه نمی اندازم\r\nمطرب آهنگ بگردان که دگر هیچ نماند\r\nکه از این پرده که گفتی به درافتد رازم\r\nکس ننالید در این عهد چو من در غم دوست\r\nکه به آفاق نظر می رود از شیرازم\r\nچند گفتند که سعدی نفسی باز خود آی\r\nگفتم از دوست نشاید که به خود پردازم",
        "htmlText": "<div class=\"b\" id=\"bn1\"><div class=\"m1\"><p>نظر از مدعیان بر تو نمی‌اندازم</p></div>\r\n<div class=\"m2\"><p>تا نگویند که من با تو نظر می‌بازم</p></div></div>\r\n<div class=\"b\" id=\"bn2\"><div class=\"m1\"><p>آرزو می‌کندم در همه عالم صیدی</p></div>\r\n<div class=\"m2\"><p>که نباشند رفیقان حسود انبازم</p></div></div>\r\n<div class=\"b\" id=\"bn3\"><div class=\"m1\"><p>درد پنهان فراقم ز تحمل بگذشت</p></div>\r\n<div class=\"m2\"><p>ور نه از دل نرسیدی به زبان آوازم</p></div></div>\r\n<div class=\"b\" id=\"bn4\"><div class=\"m1\"><p>چون کبوتر بگرفتیم به دام سر زلف</p></div>\r\n<div class=\"m2\"><p>دیده بردوختی از خلق جهان چون بازم</p></div></div>\r\n<div class=\"b\" id=\"bn5\"><div class=\"m1\"><p>به سرانگشت بخواهی دل مسکینان برد</p></div>\r\n<div class=\"m2\"><p>دست واپوش که من پنجه نمی‌اندازم</p></div></div>\r\n<div class=\"b\" id=\"bn6\"><div class=\"m1\"><p>مطرب آهنگ بگردان که دگر هیچ نماند</p></div>\r\n<div class=\"m2\"><p>که از این پرده که گفتی به درافتد رازم</p></div></div>\r\n<div class=\"b\" id=\"bn7\"><div class=\"m1\"><p>کس ننالید در این عهد چو من در غم دوست</p></div>\r\n<div class=\"m2\"><p>که به آفاق نظر می‌رود از شیرازم</p></div></div>\r\n<div class=\"b\" id=\"bn8\"><div class=\"m1\"><p>چند گفتند که سعدی نفسی باز خود آی</p></div>\r\n<div class=\"m2\"><p>گفتم از دوست نشاید که به خود پردازم</p></div></div>",
        "poemFormat": 1,
