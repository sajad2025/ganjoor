    "comments": [
      {
        "id": 81072,
        "authorName": "سمیرا خدابخش",
        "authorUrl": "",
        "commentDate": "2018-06-18T20:04:17",
        "htmlComment": "<p>چه زیبا توصیف کرده<br />داستانی بود در نرسیدن به معشوق که <br />در وداع آخرین عاشق گفت : میگن عاشق دوست داره با عشقش قدم بزنه و راه بره و دست در دست هم برن،و عاشق چشمهاشو میگیره و میگه..اما من این حسرت و درد رو با خود نگه میدارم..<br />در حالیکه عاشق چشمانش بسته است میگوید <br />سرو بالایی به صحرا می رود..<br />و میگوید انتخاب با خودته میتونی بری میتونی بمونی...<br />و می رود...<br />گفتم اینجا هم بیان کنم..زیبا هست این توصیف...</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": null,
        "replies": [],
        "myComment": false,
        "coupletIndex": -1,
        "coupletSummary": "",
        "isBookmarked": false
      },
      {
        "id": 126146,
        "authorName": "جلال ارغوانی",
        "authorUrl": null,
        "commentDate": "2024-11-20T23:24:20.1713533",
        "htmlComment": "<p>شعر سعدی ازلطیفی سخن</p>\n<p>از زمین بگذشت ثریا می رود</p>\n<p>کس نداند غایت اشعار او</p>\n<p>بی نهایت سوی بالا می رود</p>\n<p>از درون جان برآمد گفته اش</p>\n<p>لاجرم در جان دلها می رود</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": "e04ac35f-bae3-4eda-b014-08dc9f0d3f97",
        "replies": [],
        "myComment": false,
        "coupletIndex": -1,
        "coupletSummary": "",
        "isBookmarked": false
      }
    ],
    "sections": [
      {
        "id": 97035,
        "poemId": 9589,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 6,
        "ganjoorMetre": {
          "id": 6,
          "urlSlug": null,
          "rhythm": "فاعلاتن فاعلاتن فاعلن (رمل مسدس محذوف یا وزن مثنوی)",
          "name": null,
          "description": null,
          "verseCount": 148935
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "امیرود",
        "plainText": "سروبالایی به صحرا می رود\r\nرفتنش بین تا چه زیبا می رود\r\nتا کدامین باغ از او خرمترست\r\nکاو به رامش کردن آنجا می رود\r\nمی رود در راه و در اجزای خاک\r\nمرده می گوید مسیحا می رود\r\nاین چنین بیخود نرفتی سنگدل\r\nگر بدانستی چه بر ما می رود\r\nاهل دل را گو نگه دارید چشم\r\nکان پری پیکر به یغما می رود\r\nهر که را در شهر دید از مرد و زن\r\nدل ربود اکنون به صحرا می رود\r\nآفتاب و سرو غیرت می برند\r\nکآفتابی سروبالا می رود\r\nباغ را چندان بساط افکنده اند\r\nکآدمی بر فرش دیبا می رود\r\nعقل را با عشق زور پنجه نیست\r\nکار مسکین از مدارا می رود\r\nسعدیا دل در سرش کردی و رفت\r\nبلکه جانش نیز در پا می رود",
