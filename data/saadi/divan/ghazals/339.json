        "authorUrl": "",
        "commentDate": "2016-08-08T13:12:40",
        "htmlComment": "<p>سلام...دستان اندیش یعنی چه؟</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": null,
        "replies": [],
        "myComment": false,
        "coupletIndex": -1,
        "coupletSummary": "",
