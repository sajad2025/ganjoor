        "isBookmarked": false
      }
    ],
    "sections": [
      {
        "id": 97073,
        "poemId": 9627,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 19,
        "ganjoorMetre": {
          "id": 19,
          "urlSlug": null,
          "rhythm": "مفتعلن مفتعلن فاعلن (سریع مطوی مکشوف)",
          "name": null,
          "description": null,
          "verseCount": 19851
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "یر",
        "plainText": "از همه باشد به حقیقت گزیر\r\nوز تو نباشد که نداری نظیر\r\nمشرب شیرین نبود بی زحام\r\nدعوت منعم نبود بی فقیر\r\nآن عرق است از بدنت یا گلاب\r\nآن نفس است از دهنت یا عبیر\r\nبذل تو کردم تن و هوش و روان\r\nوقف تو کردم دل و چشم و ضمیر\r\nدل چه بود جان که بدو زنده ام\r\nگو بده ای دوست که گویم بگیر\r\nراحت جان باشد از آن قبضه تیغ\r\nمرهم دل باشد از آن جعبه تیر\r\nدرد نهانی به که گویم که نیست\r\nباخبر از درد من الا خبیر\r\nعیب کنندم که چه دیدی در او\r\nکور نداند که چه بیند بصیر\r\nچون نرود در پی صاحب کمند\r\nآهوی بیچاره به گردن اسیر\r\nهر که دل شیفته دارد چو من\r\nبس که بگوید سخن دلپذیر\r\nناله سعدی به چه دانی خوش است\r\nبوی خوش آید چو بسوزد عبیر",
