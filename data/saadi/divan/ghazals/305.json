      },
      {
        "id": 125473,
        "authorName": "جلال ارغوانی",
        "authorUrl": null,
        "commentDate": "2024-10-27T02:46:18.3004295",
        "htmlComment": "<p>&nbsp;</p>\n<p>از ره دل گشت چوسعدی اسیر</p>\n<p>در سخن عشق بگشتا امیر</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": "e04ac35f-bae3-4eda-b014-08dc9f0d3f97",
        "replies": [],
        "myComment": false,
