    "sections": [
      {
        "id": 97167,
        "poemId": 9721,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 7,
        "ganjoorMetre": {
          "id": 7,
          "urlSlug": null,
          "rhythm": "فعلاتن فعلاتن فعلاتن فعلن (رمل مثمن مخبون محذوف)",
          "name": null,
          "description": null,
          "verseCount": 94655
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "اناندازم",
        "plainText": "خنک آن روز که در پای تو جان اندازم\r\nعقل در دمدمه خلق جهان اندازم\r\nنامه حسن تو بر عالم و جاهل خوانم\r\nنامت اندر دهن پیر و جوان اندازم\r\nتا کی این پرده جان سوز پس پرده زنم\r\nتا کی این ناوک دلدوز نهان اندازم\r\nدردنوشان غمت را چو شود مجلس گرم\r\nخویشتن را به طفیلی به میان اندازم\r\nتا نه هر بی خبری وصف جمالت گوید\r\nسنگ تعظیم تو در راه بیان اندازم\r\nگر به میدان محاکای تو جولان یابم\r\nگوی دل در خم چوگان زبان اندازم\r\nگردنان را به سرانگشت قبولت ره نیست\r\nچون قلم هستی خود را سر از آن اندازم\r\nیاد سعدی کن و جان دادن مشتاقان بین\r\nحق علیم است که لبیک زنان اندازم",
        "htmlText": "<div class=\"b\" id=\"bn1\"><div class=\"m1\"><p>خنک آن روز که در پای تو جان اندازم</p></div>\r\n<div class=\"m2\"><p>عقل در دمدمه خلق جهان اندازم</p></div></div>\r\n<div class=\"b\" id=\"bn2\"><div class=\"m1\"><p>نامه حسن تو بر عالم و جاهل خوانم</p></div>\r\n<div class=\"m2\"><p>نامت اندر دهن پیر و جوان اندازم</p></div></div>\r\n<div class=\"b\" id=\"bn3\"><div class=\"m1\"><p>تا کی این پرده جان سوز پس پرده زنم</p></div>\r\n<div class=\"m2\"><p>تا کی این ناوک دلدوز نهان اندازم</p></div></div>\r\n<div class=\"b\" id=\"bn4\"><div class=\"m1\"><p>دردنوشان غمت را چو شود مجلس گرم</p></div>\r\n<div class=\"m2\"><p>خویشتن را به طفیلی به میان اندازم</p></div></div>\r\n<div class=\"b\" id=\"bn5\"><div class=\"m1\"><p>تا نه هر بی‌خبری وصف جمالت گوید</p></div>\r\n<div class=\"m2\"><p>سنگ تعظیم تو در راه بیان اندازم</p></div></div>\r\n<div class=\"b\" id=\"bn6\"><div class=\"m1\"><p>گر به میدان محاکای تو جولان یابم</p></div>\r\n<div class=\"m2\"><p>گوی دل در خم چوگان زبان اندازم</p></div></div>\r\n<div class=\"b\" id=\"bn7\"><div class=\"m1\"><p>گردنان را به سرانگشت قبولت ره نیست</p></div>\r\n<div class=\"m2\"><p>چون قلم هستی خود را سر از آن اندازم</p></div></div>\r\n<div class=\"b\" id=\"bn8\"><div class=\"m1\"><p>یاد سعدی کن و جان دادن مشتاقان بین</p></div>\r\n<div class=\"m2\"><p>حق علیم است که لبیک زنان اندازم</p></div></div>",
