      },
      {
        "id": 2242440,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر اجابت کنی و گر نکنی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر دعایم مورد قبول قرار گیرد یا نه، در هر حال تنها راه حل من دعا کردن است و من ادامه خواهم داد."
      },
      {
        "id": 2242439,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چارهٔ من دعاست، می‌خوانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2242438,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سهل باشد صعوبت ظلمات",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر آب حیات در دسترس باشد، سختی و تاریکی‌ها برایم آسان می‌شود."
      },
      {
        "id": 2242437,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر به دست آید آب حیوانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2242436,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا کی آخر جفا بری سعدی؟",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تا کی باید به من ظلم و بی‌احترامی شود، سعدی؟ من که خود را به نیکوکاری و احسان پایبند کرده‌ام، چه باید بکنم؟"
      },
      {
        "id": 2242435,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه کنم؟ پایبند احسانم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2242434,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کار مردان تحمل است و سکون",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کار مردان، صبوری و آرامش است، و من هم تنها خاک پای آن مردان بزرگ هستم."
      },
      {
        "id": 2242433,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من کی‌ام؟ خاک پای مردانم",
        "languageId": null,
        "coupletSummary": null
      }
