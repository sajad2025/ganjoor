        "id": 49183,
        "authorName": "محسن",
        "authorUrl": "",
        "commentDate": "2019-04-07T23:45:52",
        "htmlComment": "<p>بیت آخر فوق العاده ست، درود بر سعدی که زبان حال عشاقه</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": null,
        "replies": [],
        "myComment": false,
        "coupletIndex": -1,
