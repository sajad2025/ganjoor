    "sections": [
      {
        "id": 97087,
        "poemId": 9641,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 9,
        "ganjoorMetre": {
          "id": 9,
          "urlSlug": null,
          "rhythm": "فعلاتن مفاعلن فعلن (خفیف مسدس مخبون)",
          "name": null,
          "description": null,
          "verseCount": 114753
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "ابش",
        "plainText": "هر که بی دوست می برد خوابش\r\nهمچنان صبر هست و پایابش\r\nخواب از آن چشم چشم نتوان داشت\r\nکه ز سر برگذشت سیلابش\r\nنه به خود می رود گرفته عشق\r\nدیگری می برد به قلابش\r\nچه کند پای بند مهر کسی\r\nکه نبیند جفای اصحابش\r\nهر که حاجت به درگهی دارد\r\nلازمست احتمال بوابش\r\nناگزیرست تلخ و شیرینش\r\nخار و خرما و زهر و جلابش\r\nسایرست این مثل که مستسقی\r\nنکند رود دجله سیرابش\r\nشب هجران دوست ظلمانیست\r\nور برآید هزار مهتابش\r\nبرود جان مستمند از تن\r\nنرود مهر مهر احبابش\r\nسعدیا گوسفند قربانی\r\nبه که نالد ز دست قصابش",
        "htmlText": "<div class=\"b\" id=\"bn1\"><div class=\"m1\"><p>هر که بی‌دوست می‌برد خوابش</p></div>\r\n<div class=\"m2\"><p>همچنان صبر هست و پایابش</p></div></div>\r\n<div class=\"b\" id=\"bn2\"><div class=\"m1\"><p>خواب از آن چشم چشم نتوان داشت</p></div>\r\n<div class=\"m2\"><p>که ز سر برگذشت سیلابش</p></div></div>\r\n<div class=\"b\" id=\"bn3\"><div class=\"m1\"><p>نه به خود می‌رود گرفته عشق</p></div>\r\n<div class=\"m2\"><p>دیگری می‌برد به قلابش</p></div></div>\r\n<div class=\"b\" id=\"bn4\"><div class=\"m1\"><p>چه کند پای‌بند مهر کسی</p></div>\r\n<div class=\"m2\"><p>که نبیند جفای اصحابش</p></div></div>\r\n<div class=\"b\" id=\"bn5\"><div class=\"m1\"><p>هر که حاجت به درگهی دارد</p></div>\r\n<div class=\"m2\"><p>لازمست احتمال بوابش</p></div></div>\r\n<div class=\"b\" id=\"bn6\"><div class=\"m1\"><p>ناگزیرست تلخ و شیرینش</p></div>\r\n<div class=\"m2\"><p>خار و خرما و زهر و جلابش</p></div></div>\r\n<div class=\"b\" id=\"bn7\"><div class=\"m1\"><p>سایرست این مثل که مستسقی</p></div>\r\n<div class=\"m2\"><p>نکند رود دجله سیرابش</p></div></div>\r\n<div class=\"b\" id=\"bn8\"><div class=\"m1\"><p>شب هجران دوست ظلمانیست</p></div>\r\n<div class=\"m2\"><p>ور برآید هزار مهتابش</p></div></div>\r\n<div class=\"b\" id=\"bn9\"><div class=\"m1\"><p>برود جان مستمند از تن</p></div>\r\n<div class=\"m2\"><p>نرود مُهر مِهر احبابش</p></div></div>\r\n<div class=\"b\" id=\"bn10\"><div class=\"m1\"><p>سعدیا گوسفند قربانی</p></div>\r\n<div class=\"m2\"><p>به که نالد ز دست قصابش</p></div></div>",
        "poemFormat": 1,
        "cachedFirstCoupletIndex": 0,
        "language": null,
        "coupletsCount": 10,
        "top6RelatedSections": [
          {
