            "poetId": 6,
            "relationOrder": 2,
            "poetName": "نظامی",
            "poetImageUrl": "/api/ganjoor/poet/image/nezami.gif",
            "fullUrl": "/nezami/5ganj/7peykar/sh25#bn25",
