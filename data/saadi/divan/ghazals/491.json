      {
        "id": 2237609,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از عنبر و بنفشهٔ تر بر سر آمده‌ست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: موی خوشبو و مشکین او مانند عطر عنبر و گل بنفشه است و به زیبایی در کنار پای تو قرار دارد."
      },
      {
        "id": 2237608,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن موی مشکبوی که در پای هشته‌ای",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2237607,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من در بیان وصف تو حیران بمانده‌ام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من در توصیف زیبایی‌ات درمانده‌ام، زیرا زیبایی حد و مرزی دارد و تو فراتر از آن حدی."
      },
      {
        "id": 2237606,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حدّیست حسن را و تو از حد گذشته‌ای",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2237605,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سر می‌نهند پیش خطت عارفان پارس",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عارفان بزرگی برای تو زمینه‌ساز می‌شوند و شعر و اندیشه‌هات را مورد توجه قرار می‌دهند، گویی در پی پیدا کردن شعری از سعدی هستند که به تو مربوط شود."
      },
      {
        "id": 2237604,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیتی مگر ز گفته سعدی نبشته‌ای؟",
        "languageId": null,
        "coupletSummary": null
      }
