        "authorUrl": null,
        "commentDate": "2022-12-08T10:53:29.0421227",
        "htmlComment": "<p>این حکایت بی نظیره واقعا ممنون از شیخ عجل</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": "bdf45a57-6f2d-46f8-d61e-08daac207166",
