        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من فتاده به دستِ شاگردان",
        "languageId": null,
        "coupletSummary": "اما من همیشه در دست سربازانن و همواره در سفر و سرگردان هستم"
      },
      {
        "id": 2261501,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به سفر پای‌بند و سرگردان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2261500,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفت: من سر بر آستان دارم",
        "languageId": null,
        "coupletSummary": "پرده پاسخ داد: من سرِ تسلیم بر درگاهِ پادشاه نهاده‌ام نه چون تو به گردن‌کشی قد بر آسمان افراشته‌ام،"
      },
      {
        "id": 2261499,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه چو تو سر بر آسمان دارم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2261498,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر که بیهوده گردن افرازد",
        "languageId": null,
        "coupletSummary": "هر کس به باطل و ناحق گردن کشد و فخر فروشد خود را به سر به خاکِ ذلّت افکنَد."
      },
      {
        "id": 2261504,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خویشتن را به گردن اندازد",
        "languageId": null,
        "coupletSummary": null
      }
