      },
      {
        "id": 23774,
        "authorName": "ظریف",
        "authorUrl": "",
        "commentDate": "2013-02-14T07:34:15",
        "htmlComment": "<p>به فکر ما رایت بیرقست وسراپر ده پرده ء درودیوار آستانه ء سلطان است</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": null,
        "replies": [],
