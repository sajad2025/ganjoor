        "commentDate": "2022-12-16T03:08:40.3692619",
        "htmlComment": "<p>من او را&nbsp; بهل /پهل کردم&nbsp; پهل واژی پارسی است</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": "4d04cc00-ab74-4d9b-5a00-08d920e92d10",
        "replies": [],
