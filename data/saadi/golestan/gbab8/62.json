            "authorUrl": null,
            "commentDate": "2024-11-21T00:08:00.5424934",
            "htmlComment": "<p>فرض خدا گزاردن&nbsp; مثل نماز گزاردن&nbsp; با ز درست هست&nbsp;&nbsp;</p>",
            "publishStatus": "",
            "inReplyToId": 94421,
            "userId": "98a79e10-3418-4408-eff6-08d9ce1d2d10",
            "replies": [],
