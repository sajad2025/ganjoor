        "authorName": "مبارکه عابدپور",
        "authorUrl": null,
        "commentDate": "2024-11-21T00:22:52.8672863",
        "htmlComment": "<p>ترب به معنی پرورش یا غذا دادن کودک هست</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": "98a79e10-3418-4408-eff6-08d9ce1d2d10",
        "replies": [],
