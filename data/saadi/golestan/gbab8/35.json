        "ganjoorMetre": {
          "id": 9,
          "urlSlug": null,
          "rhythm": "فعلاتن مفاعلن فعلن (خفیف مسدس مخبون)",
          "name": null,
          "description": null,
          "verseCount": 114753
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "اری",
        "plainText": "چون نداری کمال فضل آن به\r\nکه زبان در دهان نگه داری\r\nآدمی را زبان فضیحه کند\r\nجوز بی مغز را سبکساری",
        "htmlText": "<div class=\"b\" id=\"bn1\"><div class=\"m1\"><p>چون نداری کمالِ فضل آن به</p></div>\r\n<div class=\"m2\"><p>که زبان در دهان نگه داری</p></div></div>\r\n<div class=\"b\" id=\"bn2\"><div class=\"m1\"><p>آدمی را زبان فضیحه کند</p></div>\r\n<div class=\"m2\"><p>جوزِ بی‌مغز را سبکساری</p></div></div>",
        "poemFormat": 7,
        "cachedFirstCoupletIndex": 0,
        "language": null,
        "coupletsCount": 2,
        "top6RelatedSections": [
          {
            "id": 91131717,
            "poemId": 41510,
            "poem": null,
            "sectionIndex": 0,
            "poetId": 45,
            "relationOrder": 1,
            "poetName": "کسایی",
            "poetImageUrl": "/api/ganjoor/poet/image/kesayee.gif",
            "fullUrl": "/kesayee/divank/sh50",
            "fullTitle": "کسایی » دیوان اشعار » عزت نفس",
            "htmlExcerpt": "<p>به خدایی که آفرین کرده ست</p>\r\n<p>زیرکان را به خویشتن داری</p>\r\n<p>که نیرزد به نزد همت من</p>\r\n<p>ملک هر دو جهان به یک خواری</p>",
            "targetPoemId": 41637,
            "targetSectionIndex": 0,
            "poetMorePoemsLikeThisCount": 0
          },
          {
            "id": 91131718,
            "poemId": 41510,
            "poem": null,
            "sectionIndex": 0,
            "poetId": 17,
            "relationOrder": 2,
            "poetName": "مسعود سعد سلمان",
            "poetImageUrl": "/api/ganjoor/poet/image/masood.gif",
            "fullUrl": "/masood/divan-masood/ghasidemk/sh290",
            "fullTitle": "مسعود سعد سلمان » دیوان اشعار » قصاید » شمارهٔ ۲۹۰ - مدیح دیگر از آن پادشاه و شمه ای از روزگار سیاه خویش",
            "htmlExcerpt": "<p>ای فلک نیک دانمت آری</p>\r\n<p>کس ندیدست چون تو غداری</p>\r\n<p>جامه ای بافیم همی هر روز</p>\r\n<p>از بلا پود و از عنا تاری</p>\r\n<p>گر دری یابیم زنی بندی</p>\r\n<p>[...]</p>",
            "targetPoemId": 63840,
            "targetSectionIndex": 0,
            "poetMorePoemsLikeThisCount": 5
          },
          {
            "id": 91131719,
            "poemId": 41510,
            "poem": null,
            "sectionIndex": 0,
            "poetId": 10,
            "relationOrder": 3,
            "poetName": "سنایی",
            "poetImageUrl": "/api/ganjoor/poet/image/sanaee.gif",
            "fullUrl": "/sanaee/tariq/sh15#bn12",
            "fullTitle": "سنایی » طریق التحقیق » بخش ۱۵ - فی قدوم الخضر",
            "htmlExcerpt": "<p> گفت خضرم ز راه غمخواری</p>\r\n<p> کای فرو مانده در گرفتاری‌</p>",
            "targetPoemId": 39336,
            "targetSectionIndex": 13,
            "poetMorePoemsLikeThisCount": 50
          },
          {
            "id": 91131720,
            "poemId": 41510,
            "poem": null,
            "sectionIndex": 0,
            "poetId": 58,
            "relationOrder": 4,
            "poetName": "وطواط",
            "poetImageUrl": "/api/ganjoor/poet/image/vatvat.gif",
            "fullUrl": "/vatvat/ghasv/sh194",
            "fullTitle": "وطواط » قصاید » شمارهٔ ۱۹۴ - در مدح شمس الدین وزیر",
            "htmlExcerpt": "<p>تا کی از عشق تو کشم خواری؟</p>\r\n<p>تا کی از هجر تو کنم زاری ؟</p>\r\n<p>چند با من جفا کنی آخر ؟</p>\r\n<p>شرم بادت ازین جفا گاری </p>\r\n<p>زان دو زلف چو ابر پیوسته </p>\r\n<p>[...]</p>",
            "targetPoemId": 65286,
