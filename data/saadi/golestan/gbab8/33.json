    "verses": [
      {
        "id": 2262863,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": -1,
        "sectionIndex1": null,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر چه زود بر آید دیر نپاید.",
        "languageId": null,
        "coupletSummary": "هر چیزی که زود به دست بیاید زود هم از بین می‌رود"
      },
      {
        "id": 2262848,
        "vOrder": 2,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خاکِ مشرق شنیده‌ام که کنند",
        "languageId": null,
        "coupletSummary": "شنیده‌‌ام که در مشرق‌زمین کاسه‌ی چینی را در چهل سال می‌سازند [که بسیار گران‌بها است]"
      },
      {
        "id": 2262831,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به چهل سال کاسه‌ای چینی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2262818,
        "vOrder": 4,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صد به روزی کنند در مَردَشت",
        "languageId": null,
        "coupletSummary": "در مردشت صد کاسه را فقط در یک روز می‌سازند. در نتیجه، قیمتش این‌چنین که می‌بینی ارزان است."
      },
      {
        "id": 2262819,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لاجَرَم قیمتش همی‌بینی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2262820,
        "vOrder": 6,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 7,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرغک از بیضه برون آید و روزی طلبد",
        "languageId": null,
        "coupletSummary": "جوجه وقتی از تخم بیرون می‌آید در همان روزهای اول به دنبال روزی می‌رود در حالی که نوزاد انسان تا چند سال اصلا عقل و دانش و آگاهی ندارد و نمی‌تواند حتی خوب و بد را تشخیص دهد. "
      },
      {
        "id": 2262821,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 7,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "و آدمی‌بچه ندارد خبر و عقل و تمیز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2262822,
        "vOrder": 8,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 7,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن که ناگاه کسی گشت، به چیزی نرسید",
        "languageId": null,
        "coupletSummary": "کسی که به طور ناگهانی و بدون تلاش به هدفی رسید، در واقع به موفقیتی نرسیده است. اما کسی که به آرامی و با فضیلت پیش می‌رود، از همه چیز برتر می‌شود."
      },
      {
        "id": 2262823,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 7,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وین به تمکین و فضیلت بگذشت از همه چیز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2262824,
        "vOrder": 10,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 7,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آبگینه همه جا یابی از آن قدرش نیست",
        "languageId": null,
        "coupletSummary": "شیشه و بلور چون همه‌جا هستند و زود به دست می‌آیند کم‌ارزش هستند اما سنگ‌های جواهر، چون به‌سختی به‌دست می‌آیند و کمیاب هستند عزیز و باارزش هستند. "
      },
      {
        "id": 2262825,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 7,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لعل دشخوار به دست آید از آن است عزیز",
        "languageId": null,
        "coupletSummary": null
      }
