        "languageId": null,
        "coupletSummary": "پدرم وقتی که عمرش به آخر رسید این یک نصیحت را به من کرد و از دنیا رفت."
      },
      {
        "id": 2262871,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 7,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرا این یک نصیحت کرد و بُگذشت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2262872,
        "vOrder": 6,
