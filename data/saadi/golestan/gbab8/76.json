        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "یل",
        "plainText": "پیش درویشان بود خونت مباح\r\nگر نباشد در میان مالت سبیل\r\nیا مرو با یار ازرق پیرهن\r\nیا بکش بر خان و مان انگشت نیل\r\nدوستی با پیلبانان یا مکن\r\nیا طلب کن خانه ای در خورد پیل",
        "htmlText": "<div class=\"b\" id=\"bn1\"><div class=\"m1\"><p>پیش درویشان بود خونت مباح</p></div>\r\n<div class=\"m2\"><p>گر نباشد در میان مالت سبیل</p></div></div>\r\n<div class=\"b\" id=\"bn2\"><div class=\"m1\"><p>یا مرو با یار ازرق‌پیرهن</p></div>\r\n<div class=\"m2\"><p>یا بکش بر خان و مان انگشت نیل</p></div></div>\r\n<div class=\"b\" id=\"bn3\"><div class=\"m1\"><p>دوستی با پیلبانان یا مکن</p></div>\r\n<div class=\"m2\"><p>یا طلب کن خانه‌ای در خورد پیل</p></div></div>",
        "poemFormat": 7,
