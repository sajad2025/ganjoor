        "id": 247361,
        "poemId": 41326,
        "poem": null,
        "poetId": 7,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 9,
        "ganjoorMetre": {
          "id": 9,
          "urlSlug": null,
          "rhythm": "فعلاتن مفاعلن فعلن (خفیف مسدس مخبون)",
          "name": null,
          "description": null,
          "verseCount": 114753
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "",
        "plainText": "ﺗﺎ دل دوﺳﺘﺎن ﺑﻪ دﺳﺖ ﺁری\r\nﺑﻮﺳﺘﺎن ﭘﺪر ﻓﺮوﺧﺘﻪ ﺑﻪ\r\nپختن دیگ نیکخواهان را \r\nهر چه رخت سراست سوخته به\r\nﺑﺎ ﺑﺪاﻧﺪﻳﺶ هم ﻧﻜﻮﻳﻰ کن\r\nدهن ﺳﮓ ﺑﻪ ﻟﻘﻤﻪ دوﺧﺘﻪ ﺑﻪ",
        "htmlText": "<div class=\"b\" id=\"bn1\"><div class=\"m1\"><p>ﺗﺎ دلِ دوﺳﺘﺎن ﺑﻪ دﺳﺖ ﺁری</p></div>\r\n<div class=\"m2\"><p>ﺑﻮﺳﺘﺎنِ ﭘﺪر ﻓﺮوﺧﺘﻪ ﺑﻪ</p></div></div>\r\n<div class=\"b\" id=\"bn2\"><div class=\"m1\"><p>پختنِ دیگِ نیکخواهان را </p></div>\r\n<div class=\"m2\"><p>هر چه رختِ سراست سوخته به</p></div></div>\r\n<div class=\"b\" id=\"bn3\"><div class=\"m1\"><p>ﺑﺎ ﺑﺪاﻧﺪﻳﺶ هم ﻧﻜﻮﻳﻰ کن</p></div>\r\n<div class=\"m2\"><p>دهنِ ﺳﮓ ﺑﻪ ﻟﻘﻤﻪْ دوﺧﺘﻪ ﺑﻪ</p></div></div>",
        "poemFormat": 3,
        "cachedFirstCoupletIndex": 0,
        "language": null,
        "coupletsCount": 3,
        "top6RelatedSections": [
          {
            "id": 51538490,
            "poemId": 41326,
