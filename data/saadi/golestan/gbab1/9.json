        "authorUrl": null,
        "commentDate": "2023-03-29T06:29:10.6988991",
        "htmlComment": "<p>سلام دوستان، معنای بیت اول چیه؟</p>\r\n<p>&nbsp;</p>\r\n<p>&nbsp;</p>",
        "publishStatus": "",
        "inReplyToId": null,
