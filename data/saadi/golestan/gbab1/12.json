      },
      {
        "id": 97562,
        "authorName": "نورا کاور",
        "authorUrl": null,
        "commentDate": "2022-06-05T12:55:35.7700808",
        "htmlComment": "<p>فقط خانم بذرگران درست خوندند</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": "8f35503f-fc55-45c3-8a0a-08da0e347b48",
        "replies": [],
