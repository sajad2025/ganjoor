    "previous": {
      "id": 41304,
      "title": "حکایت شمارهٔ ۱۱",
      "urlSlug": "sh11",
      "excerpt": "درویشی مُسْتَجاب‌الدَّعوة در بغداد پدید آمد. حَجّاجِ یوسف را خبر کردند. بخواندش و گفت: دعایِ خیری بر من بکن. گفت: خدایا! جانش بستان. گفت: از بهرِ خدای این چه دعاست؟ گفت: این دعایِ خیر است تو را و جملهْ مسلمانان را.",
      "mainSections": null
    },
    "verses": [
      {
        "id": 2260565,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": -1,
        "sectionIndex1": null,
