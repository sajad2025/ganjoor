      {
        "id": 13030,
        "authorName": "حسین صابری",
        "authorUrl": "http://talant.ir",
        "commentDate": "2016-12-07T00:07:34",
        "htmlComment": "<p>سلام و عرض ادب<br />این سایت مرجع بسیار خوبی برای اهل ادب و شعر فارسی است. اما پای طاووس آن همین متون منثور است که ابیات موجود در آن به تفاریق (مخصوصاً در مورد اثر فخیم گلستان سعدی) حذف شده اند<br />امیدوارم که این ایراد کوچک (در مقابل خدمات انجام شده سایت) نیز سریعتر برطرف گردد</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": null,
        "replies": [],
        "myComment": false,
        "coupletIndex": -1,
        "coupletSummary": "",
        "isBookmarked": false
      },
