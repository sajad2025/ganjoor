        "id": 2245452,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 7,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که دلها ز ریشت بنالد همی؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2245453,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تو ما را همی چاه کندی به راه",
        "languageId": null,
        "coupletSummary": "تو بر سر راه ما چاه کندی، ولی خودت با سر در چاه افتادی"
      },
      {
        "id": 2245454,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به سر لاجرم در فتادی به چاه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2245455,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دو کس چَه کنند از پی خاص و عام",
        "languageId": null,
        "coupletSummary": "دو گروه هستند که برای مردم چاه میکنند، آدم‌های خوب و دیگری بدنامان"
      },
      {
        "id": 2245456,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 9,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یکی نیک‌محضر، دگر زشت‌نام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2245457,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یکی تشنه را تا کند تازه حلق",
        "languageId": null,
        "coupletSummary": "یکی چاه را برای سیراب کردن مردم می‌کند و آن دیگری برای گرفتار کردن مردم"
      },
      {
        "id": 2245458,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 10,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دگر تا به گردن در افتند خلق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2245459,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر بد کنی چشم نیکی مدار",
        "languageId": null,
        "coupletSummary": "اگر بدی کردی، چشم نیکوکاری نداشته باش چرا که درخت گز ، انگور نمی‌دهد"
      },
      {
        "id": 2245460,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که هرگز نیارد گز انگور بار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2245461,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نپندارم ای در خزان کشته جو",
        "languageId": null,
        "coupletSummary": "فکر نکنم کسی که در پاییز جو کاشته، بتواند  زمان درو گندم برداشت کند"
      },
      {
        "id": 2245462,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که گندم ستانی به وقت درو",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2245463,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درخت زقوم ار به جان پروری",
        "languageId": null,
        "coupletSummary": "وقتی درون جانت را پر از تلخی و پلیدی و بدخواهی (مانند زقوم) کردی، چشم نتیجه خوب از آن را نداشته باش. "
      },
      {
        "id": 2245464,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مپندار هرگز کز او بر خوری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2245465,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رطب ناورد چوب خرزهره بار",
        "languageId": null,
        "coupletSummary": "درخت خرزهره به تو خرمای شیرین نمی‌دهد. پس مراقب باش که چه می‌کاری، چون همان را برداشت خواهی کرد."
      },
      {
        "id": 2245466,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 14,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو تخم افکنی، بر همان چشم دار",
        "languageId": null,
        "coupletSummary": null
      }
    ],
