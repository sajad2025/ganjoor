        "vOrder": 31,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نیمهٔ آتش به بر",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 3261237,
        "vOrder": 32,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می چکدش بر جگر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گل‌های شبنم در صبح زود با اشک‌های خود بر دل انسان تأثیر می‌گذارند و حالتی از لطافت و زیبایی را به وجود می‌آورند."
      },
