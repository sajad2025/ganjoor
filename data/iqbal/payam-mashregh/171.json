        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هیچ ندارد ثبات",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هیچ چیز در این دنیا پایدار نیست."
      },
      {
        "id": 3261245,
        "vOrder": 42,
        "coupletIndex": 29,
        "versePosition": 2,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خاک چمن وانمود راز دل کائنات",
