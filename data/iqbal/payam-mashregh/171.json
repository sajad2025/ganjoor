    "sections": [
      {
        "id": 243999,
        "poemId": 39870,
        "poem": null,
        "poetId": 42,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 15,
        "ganjoorMetre": {
          "id": 15,
          "urlSlug": null,
          "rhythm": "مفتعلن فاعلن مفتعلن فاعلن (منسرح مطوی مکشوف)",
          "name": null,
          "description": null,
          "verseCount": 12359
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": null,
        "plainText": "خیز که در کوه و دشت خیمه زد ابر بهار\r\nمست ترنم هزار\r\nطوطی و دراج و سار\r\nبر طرف جویبار\r\nکشت گل و لاله زار\r\nچشم تماشا بیار\r\nخیز که در کوه و دشت خیمه زد ابر بهار\r\nخیز که در باغ و راغ قافله گل رسید\r\nباد بهاران وزید\r\nمرغ نوا آفرید\r\nلاله گریبان درید\r\nحسن گل تازه چید\r\nعشق غم نو خرید\r\nخیز که در باغ و راغ قافله گل رسید\r\nبلبلگان در صفیر  صلصلگان در خروش\r\nخون چمن گرم جوش\r\nای که نشینی خموش\r\nدر شکن آیین هوش\r\nباده معنی بنوش\r\nنغمه سرا گل بپوش\r\nبلبلگان در صفیر  صلصلگان در خروش\r\nحجره نشینی گذار گوشه صحرا گزین\r\nبر لب جویی نشین \r\nآب روان را ببین\r\nنرگس ناز آفرین\r\nلخت دل فرودین\r\nبوسه زنش بر جبین\r\nحجره نشینی گذار گوشه صحرا گزین\r\nدیده معنی گشا ای ز عیان بیخبر\r\nلاله کمر در کمر\r\nنیمه آتش به بر\r\nمی چکدش بر جگر\r\nشبنم اشک سحر\r\nدر شفق انجم نگر\r\nدیده معنی گشا  ای ز عیان بیخبر\r\nخاک چمن وانمود راز دل کاینات\r\nبود و نبود صفات\r\nجلوه گریهای ذات\r\nآنچه تو دانی حیات۔\r\nآنچه تو خوانی ممات\r\nهیچ ندارد ثبات\r\nخاک چمن وانمود راز دل کاینات",
        "htmlText": "<div class=\"b2\" id=\"bn1\"><p>خیز که در کوه و دشت خیمه زد ابر بهار</p></div>\r\n<div class=\"b\" id=\"bn2\"><div class=\"m1\"><p>مست ترنم هزار</p></div>\r\n<div class=\"m2\"><p>طوطی و دراج و سار</p></div></div>\r\n<div class=\"b\" id=\"bn3\"><div class=\"m1\"><p>بر طرف جویبار</p></div>\r\n<div class=\"m2\"><p>کشت گل و لاله زار</p></div></div>\r\n<div class=\"b2\" id=\"bn4\"><p>چشم تماشا بیار</p></div>\r\n<div class=\"b2\" id=\"bn5\"><p>خیز که در کوه و دشت خیمه زد ابر بهار</p></div>\r\n<div class=\"b2\" id=\"bn6\"><p>خیز که در باغ و راغ قافلهٔ گل رسید</p></div>\r\n<div class=\"b\" id=\"bn7\"><div class=\"m1\"><p>باد بهاران وزید</p></div>\r\n<div class=\"m2\"><p>مرغ نوا آفرید</p></div></div>\r\n<div class=\"b\" id=\"bn8\"><div class=\"m1\"><p>لاله گریبان درید</p></div>\r\n<div class=\"m2\"><p>حسن گل تازه چید</p></div></div>\r\n<div class=\"b2\" id=\"bn9\"><p>عشق غم نو خرید</p></div>\r\n<div class=\"b2\" id=\"bn10\"><p>خیز که در باغ و راغ قافلهٔ گل رسید</p></div>\r\n<div class=\"b2\" id=\"bn11\"><p>بلبلگان در صفیر ، صلصلگان در خروش</p></div>\r\n<div class=\"b\" id=\"bn12\"><div class=\"m1\"><p>خون چمن گرم جوش</p></div>\r\n<div class=\"m2\"><p>ای که نشینی خموش</p></div></div>\r\n<div class=\"b\" id=\"bn13\"><div class=\"m1\"><p>در شکن آئین هوش</p></div>\r\n<div class=\"m2\"><p>بادهٔ معنی بنوش</p></div></div>\r\n<div class=\"b2\" id=\"bn14\"><p>نغمه سرا گل بپوش</p></div>\r\n<div class=\"b2\" id=\"bn15\"><p>بلبلگان در صفیر ، صلصلگان در خروش</p></div>\r\n<div class=\"b2\" id=\"bn16\"><p>حجره نشینی گذار گوشهٔ صحرا گزین</p></div>\r\n<div class=\"b\" id=\"bn17\"><div class=\"m1\"><p>بر لب جوئی نشین </p></div>\r\n<div class=\"m2\"><p>آب روان را ببین</p></div></div>\r\n<div class=\"b\" id=\"bn18\"><div class=\"m1\"><p>نرگس ناز آفرین</p></div>\r\n<div class=\"m2\"><p>لخت دل فرودین</p></div></div>\r\n<div class=\"b2\" id=\"bn19\"><p>بوسه زنش بر جبین</p></div>\r\n<div class=\"b2\" id=\"bn20\"><p>حجره نشینی گذار گوشهٔ صحرا گزین</p></div>\r\n<div class=\"b2\" 