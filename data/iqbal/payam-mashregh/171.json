        "vOrder": 33,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شبنم اشک سحر",
        "languageId": null,
        "coupletSummary": null
      },
