        "vOrder": 30,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لاله کمر در کمر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گل لاله به شکل کمر در آمده و در آغوش شعله‌های آتش جا گرفته است."
      },
