        "id": 3261229,
        "vOrder": 40,
        "coupletIndex": 27,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنچه تو خوانی ممات",
        "languageId": null,
        "coupletSummary": null
