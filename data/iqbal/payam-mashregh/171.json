        "vOrder": 26,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لخت دل فرودین",
        "languageId": null,
        "coupletSummary": null
      },
      {
