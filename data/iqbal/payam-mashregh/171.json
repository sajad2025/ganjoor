        "vOrder": 27,
        "coupletIndex": 18,
        "versePosition": 2,
        "sectionIndex1": 0,
        "sectionIndex2": 8,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بوسه زنش بر جبین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بوسه‌ای که او بر پیشانی او زد."
