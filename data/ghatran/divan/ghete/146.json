    "verses": [
      {
        "id": 4470886,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کجائی تو این راحت جان کجائی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کجایی، ای آرامش جانم؟ هر بار که صدایت می‌زنم، تو نمی‌آیی."
      },
      {
        "id": 4470887,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کجائی که هر چند خوانم نیائی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4470888,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بریدم همه آشنائی ز وصلت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من تمام روابط و آشنایی‌های خود را به خاطر جدایی تو قطع کرده‌ام و از شادی و سرور آشنایی دیگر خبری نیست."
      },
      {
        "id": 4470889,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فراقت برد از طرب آشنائی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4470890,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرا هر زمانی هوایت بپرسد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر زمان که از من بپرسی که چرا در غم و دوری آن ماه زیبا هستم، دلم برای تو تنگ می‌شود."
      },
      {
        "id": 4470891,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که در هجر آن ماه خامش چرائی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4470892,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ایا یوسف حسن تا تو برفتی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای یوسف زیبایی، وقتی تو رفتی من مانند یعقوب در اندوه و غم غرق شده‌ام."
      },
      {
        "id": 4470893,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چو یعقوبم اندر غم مبتلائی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4470894,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بجانت خریدار بوده است عاشق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عاشق تو کسی است که جانش را فدای تو کرده و در عشق تو به خوبی تو را می‌بیند، اما تو به خاطر زیبایی‌های وجودت از او دوری می‌کنی."
      },
      {
        "id": 4470895,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که هستی چو یوسف ز خوبی جدائی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4470896,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه از سنگ بشکست دست وصالت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دستی که به عشق تو رسیده، از سنگ هم سخت‌تر است و نمی‌تواند بشکند؛ تو ای محبوب، باید مانند مومیایی، جان تازه‌ای به من ببخشی."
      },
      {
        "id": 4470897,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که دارو شود ای صنم مومیائی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4470898,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چراغ وصالت میان باد کشتست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چراغ عشق تو در میان باد به خشم افتاده است و از آن، روشنی من تیره و تار شده است."
      },
      {
        "id": 4470899,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کز او تیره باشد مرا روشنائی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4470900,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه سود است هجر و وصالت که ما را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از جدایی و وصال چه فایده‌ای دارد وقتی که زمان ما را به زور از هم جدا کرده است؟"
      },
      {
        "id": 4470901,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زمانه کشیده است تیغ جدائی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4470902,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جدائیت حکم خدایست بر من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: جدایی تو، برای من حکم خداوند است. چطور می‌توانم از این حکم الهی سرپیچی کنم؟"
      },
      {
        "id": 4470903,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حذر چون کنم من ز حکم خدائی",
        "languageId": null,
        "coupletSummary": null
      }
