    "verses": [
      {
        "id": 4470574,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای بگرد روز از شب قمر آورده",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای شب، روز را بموش کن و زیبایی‌ات را نشان بده، مانند قمر که در آسمان می‌درخشد. گرد و غبار مشکی را به دور خود بپیچان و جلوه‌گری کن."
      },
      {
        "id": 4470575,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گرد مشگین بگرد قمر آورده",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4470576,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زان لعل شکر گفتار زهر آورده",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این بیت به این معناست که برخی افراد با ظاهری زیبا و کلام شیرین، ممکن است نیت‌های بدی داشته باشند. به عبارتی، گاهی اوقات چیزهایی که به نظر خوشایند و بی‌ضرر می‌آیند، ممکن است حاوی خطر باشند. در واقع، این شعر به ما هشدار می‌دهد که باید مراقب ظاهر و زبان دیگران باشیم، زیرا ممکن است حقیقی نباشند."
      },
      {
        "id": 4470577,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هیچکس دیدی زهر از شکر آورده",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4470578,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سرو را مانی گلبرگ بر او رسته",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: سرو، درختی است با قامت بلند و خوش‌فرم، و گلبرگ‌ها به آن زیبایی خاصی می‌بخشند. آیا تا به حال سرو را دیده‌ای که به جای زیبایی و شکوه خودش، گلبرگ‌هایی به بر داشته باشد؟ این تصویر نشان‌دهنده تضاد بین زیبایی طبیعی یک درخت و ظاهری غیرمعمول است."
      },
      {
        "id": 4470579,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سرو کی دیدی گلبرگ برآورده",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4470580,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای ستم کرده و زنهار وفا خورده",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تویی که به من ظلم کرده‌ای و در عین حال خود را وفادار نشان می‌دهی، قلب من را ربوده‌ای و به مسافرت رفته‌ای."
      },
      {
        "id": 4470581,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل من برده و رای سفر آورده",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4470582,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این بران وزن که استاد همی خواند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این شعر به زیبایی و لطافت لاله اشاره دارد که در نتیجه هنر و استادی ایجاد شده است. لاله به عنوان نمادی از زیبایی، گویی از عطر مشک به وجود آمده و احساسات دلنشینی را در ذهن تداعی می‌کند."
      },
      {
        "id": 4470583,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لاله را دیدی از مشک برآورده",
        "languageId": null,
        "coupletSummary": null
      }
