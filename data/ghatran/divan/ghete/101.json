    "verses": [
      {
        "id": 4470250,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آرامش جان من آرام روان من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آرامش روح من، آرامش روان من، با تو چشمانم روشن و شاداب است و جانم سرشار از شادی توست."
      },
      {
        "id": 4470251,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "روشن بتو چشم من شادان بتو جان من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4470252,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بالات چو تیر من مژگان چو سنان من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چشم‌هایت مانند تیر، مژگان‌هایت شبیه نیزه، موهایت مانند کمند و ابروهایت همچون کمان هستند."
      },
      {
        "id": 4470253,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گیسو چو کمند من ابرو چو کمان من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4470254,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیهوده چرا داری ای سرو روان من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چرا بی‌جهت نگران هستی؟ ای سرو زیبا، چرا از پیوند با من ناامید هستی؟"
      },
      {
        "id": 4470255,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نومید چرا داری از وصل روان من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4470256,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از بس که همی جویی از هجر زیان من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به خاطر اینکه مدام به دنبال معشوق هستی، درد و رنج من در دل پنهان است و در ظاهر، حال و روز ناخوشی دارم."
      },
      {
        "id": 4470257,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ریش است نهان من زار است عیان من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4470258,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دانیم بهر حالی ای جان جهان من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: می‌دانیم هر حالتی که باشد، ای جان جهانی من، من خود را نمی‌شناسم و تو هم رازهای نهان من را نمی‌دانی."
      },
      {
        "id": 4470259,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من راز نهان تو تو راز نهان من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 4470260,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هستم ز دل آن تو هستی ز دل آن من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من از دل خودم به تو وابسته‌ام و تو نیز از دل خودت به من. اما زبان تو به شیرینی زبان من نیست."
      },
      {
        "id": 4470261,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بل نیست زبان تو شیرین چو زبان من",
        "languageId": null,
        "coupletSummary": null
      }
    ],
