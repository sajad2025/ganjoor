        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بهنگام خویش آنچه من کرده ام",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در زمان خود من، آنچه من انجام داده‌ام، خسرو در زمان خود انجام نداده است."
