        "coupletSummary": null
      },
      {
        "id": 4470748,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جد تو گرچه جهان بپیری بگشاد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگرچه جدت به سن و سالی بزرگ برسد و در دنیا قدم بگذارد، اما تو با جوانی و نشاط خود، درهای همه جهان را به روی خود باز کردی."
      },
      {
        "id": 4470749,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
