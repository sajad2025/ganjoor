        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تنت پالود کردگار ز درد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بدن تو توسط آفریدگار از رنج‌ها پاک شده و به زودی به حالتی سالم و شاداب می‌رسد."
      },
      {
        "id": 4469227,
        "vOrder": 18,
        "coupletIndex": 8,
