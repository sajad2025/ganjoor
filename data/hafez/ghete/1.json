      {
        "id": 77346,
        "authorName": "سیدمسعود",
        "authorUrl": "",
        "commentDate": "2018-12-05T23:02:35",
        "htmlComment": "<p>جناب تبکم <br />با سلام <br />شکل صحیح شعر همین است که گنجور نوشته <br />البته حافظ بنا به ضرورت رعایت وزن شعر کلمه \" مَخرَجاً \" را بالاجبار از آیه حذف کرده<br />و این شعر را حافظ از آیات 2 و 3 سوره طلاق درقرآن کریم اقتباس کرده <br />وَمَن یَتَّقِ اللَّهَ یَجْعَل لَّهُ مَخْرَجًا وَیَرْزُقْهُ مِنْ حَیْثُ لَا یَحْتَسِبُ وَمَن یَتَوَکَّلْ عَلَی اللَّهِ فَهُوَ حَسْبُهُ إِنَّ اللَّهَ بَالِغُ أَمْرِهِ قَدْ جَعَلَ اللَّهُ لِکُلِّ شَیْءٍ قَدْرًا» (قرآن کریم سوره طلاق آیات 2و3)؛</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": null,
        "replies": [],
        "myComment": false,
        "coupletIndex": -1,
        "coupletSummary": "",
        "isBookmarked": false
      },
