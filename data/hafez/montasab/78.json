        "sectionIndex4": null,
        "text": "جز شیفتگی و بیقراری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254034,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای جان عزیز بر ضعیفان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254035,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا چند کنی جفا و خواری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254036,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر چند که سوختی به جور",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254037,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کردم من خسته سازگاری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254038,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتم مگر از سر ترحم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254039,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دست از ستم و جفا بداری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254040,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون نیست امید آنکه روزی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254041,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر عاشق خسته رحم آری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254042,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 2,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": 7,
        "sectionIndex4": null,
        "text": "آن به که ز صبر رخ نتابم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254043,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 3,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": 7,
        "sectionIndex4": null,
        "text": "باشد که مراد دل بیابم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254044,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در سختی عشق گر بمیرم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254045,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من دل ز غم تو برنگیرم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254046,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی شک دل ماه خور بگیرد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254047,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر سوی فلک رسد نفیرم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254048,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پیوسته کمان ابروانش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254049,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از غمزه همی زند به تیرم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254050,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نتوان بقلم نوشت شوقش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254051,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر پیر فلک شود دبیرم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254052,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پیر غم عشقم ار چه طفلم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254053,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "طفل غم عشقم ار چه پیرم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254054,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دارم سر انکه همچو سعدی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254055,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بنشینم و صبر پیش گیرم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254056,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون کرد زمانه ی ستمگار",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254057,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دور از تو به بند غم اسیرم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254058,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 2,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": 8,
        "sectionIndex4": null,
        "text": "آن به که ز صبر رخ نتابم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254059,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 3,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": 8,
        "sectionIndex4": null,
        "text": "باشد که مراد دل بیابم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254060,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای راحت جان بیقرارم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254061,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "امید دل امید دارم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254062,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شادم بغمت که در همه",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254063,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سوز غم توست سازگارم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254064,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا رفته ی از کنارم ایدوست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254065,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یکباره ز خویش بر کنارم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254066,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در آرزوی وصال حالی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254067,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عمری بفراق میگذارم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254068,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا مرگ نگیردم گریبان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254069,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من دست زدامنت ندارم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254070,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون هیچ نشد بسعی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254071,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کام خسته ی فگارم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254072,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 2,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": 9,
        "sectionIndex4": null,
        "text": "آن به که ز صبر رخ نتابم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254073,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 3,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": 9,
        "sectionIndex4": null,
        "text": "باشد که مراد دل بیابم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254074,
        "vOrder": 47,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای زخم غم تو مرهم دل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254075,
        "vOrder": 48,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عشق تو انیس و محرم دل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254076,
        "vOrder": 49,
        "coupletIndex": 24,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زلف تو کمند گردن جان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254077,
        "vOrder": 50,
        "coupletIndex": 24,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لعل تو نگین خاتم دل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254078,
        "vOrder": 51,
        "coupletIndex": 25,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ابروی تو بود شحنه ی جان",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254079,
        "vOrder": 52,
        "coupletIndex": 25,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون چشم تو گشت حاکم دل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254080,
        "vOrder": 53,
        "coupletIndex": 26,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "او در دل ما و ما در آتش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254081,
        "vOrder": 54,
        "coupletIndex": 26,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ما را غم اوست نی غم دل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254082,
        "vOrder": 55,
        "coupletIndex": 27,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نزدیک شد آنکه من بدوری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254083,
        "vOrder": 56,
        "coupletIndex": 27,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گیرم سر خویش یا کم دل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254084,
        "vOrder": 57,
        "coupletIndex": 28,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حافظ چو شود اگر بیابی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254085,
        "vOrder": 58,
        "coupletIndex": 28,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نوری ز حضور عالم دل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254086,
        "vOrder": 59,
        "coupletIndex": 29,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون ملک وصال او نگردد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254087,
        "vOrder": 60,
        "coupletIndex": 29,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 4,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آسان آسان مسلم دل",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254088,
        "vOrder": 61,
        "coupletIndex": 30,
        "versePosition": 2,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": 10,
        "sectionIndex4": null,
        "text": "آن به که ز صبر رخ نتابم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 5254089,
        "vOrder": 62,
        "coupletIndex": 30,
        "versePosition": 3,
        "sectionIndex1": 0,
        "sectionIndex2": 6,
        "sectionIndex3": 10,
        "sectionIndex4": null,
        "text": "باشد که مراد دل بیابم",
        "languageId": null,
        "coupletSummary": null
      }
