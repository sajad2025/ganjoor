        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کاین عالم خاک خاک ارزد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این دنیا به اندازه‌ای ارزش ندارد که در آن دچار مشکلات و دردسرها شویم."
      },
      {
