        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زان دلبرکش بگو که دانی",
        "languageId": null,
        "coupletSummary": null
      },
      {
