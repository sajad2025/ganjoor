        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر ستیزه کند فلک با ما",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر آسمان با ما دشمنی کند، ما به خواسته‌اش نمی‌رسیم و با او مقابله نمی‌کنیم."
      },
      {
        "id": 2051017,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
