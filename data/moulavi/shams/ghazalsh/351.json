        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر عقلست پس دیوانگی چیست",
        "languageId": null,
        "coupletSummary": "عقل نمیتواند دوای این درد باشد، چون فقط یک حیطه محدودی را شامل میشود. جان نمیتواند علاج این مرض باشد، اگر باشد جانان چه کسی است؟!"
      },
      {
        "id": 2089085,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
