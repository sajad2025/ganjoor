        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر مرگم از او است مرگ من باد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر مرگ من به دست او باشد، پس مرگ من همان مرگ است که بهتر از لحظه‌ی جوانی‌ام است."
      },
      {
        "id": 2072904,
        "vOrder": 8,
