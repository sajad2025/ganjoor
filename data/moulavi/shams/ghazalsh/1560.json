        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از تو دل من نمی‌شکیبد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل من نمی‌تواند از تو دل بکند، با اینکه صد بار امتحان کرده‌ام."
      },
      {
        "id": 2098740,
        "vOrder": 8,
