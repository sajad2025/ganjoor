    "verses": [
      {
        "id": 2100323,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیخود شده‌ام لیکن بیخودتر از این خواهم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من بی‌خود شده‌ام، اما مطمئنم که بیشتر از این هم بی‌خود خواهم شد. من از چشمان تو می‌گویم که در این حالت مستی، این‌گونه خواهم بود."
      },
      {
        "id": 2100338,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با چشم تو می گویم من مست چنین خواهم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2100324,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "من تاج نمی‌خواهم من تخت نمی‌خواهم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من به دنبال ریاست و مقام نیستم، فقط می‌خواهم در خدمت تو باشم و حتی اگر در راهت به زمین بیفتم، از این موضوع ناراضی نیستم."
      },
      {
        "id": 2100325,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در خدمتت افتاده بر روی زمین خواهم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2100326,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن یار نکوی من بگرفت گلوی من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دوست نیکوکار من پرچم عواطف مرا به دست گرفت و از من پرسید که چه آرزویی دارم. من هم در پاسخ گفتم که همین را می‌خواهم."
      },
      {
        "id": 2100327,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتا که چه می خواهی گفتم که همین خواهم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2100328,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با باد صبا خواهم تا دم بزنم لیکن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: می‌خواهم با نسیم صبح صحبت کنم، اما چون خودم حرفی برای گفتن دارم، می‌خواهم با کسی هم‌صحبت شوم که بزرگ و معتبر باشد."
      },
      {
        "id": 2100329,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون من دم خود دارم همراز مهین خواهم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2100330,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در حلقه میقاتم ایمن شده ز آفاتم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من در گردونه میقات بی‌خطر شده‌ام و از آسیب‌ها در امانم. به خاطر رسیدن به کمال و هدف نهایی‌ام، به دنبال نشانی از آن حقیقت هستم."
      },
      {
        "id": 2100331,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مومم ز پی ختمت زان نقش نگین خواهم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2100332,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ماهی دگر است ای جان اندر دل مه پنهان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای جان، داخل دل ماه، روشنی و زیبایی پنهانی وجود دارد که از این علم و یقین فراتر است. من می‌خواهم به آن عین یقین دست یابم."
      },
      {
        "id": 2100333,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زین علم یقینستم آن عین یقین خواهم",
        "languageId": null,
