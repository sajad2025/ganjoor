        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بازرهیدیم ز بالا و پست",
        "languageId": null,
        "coupletSummary": null
