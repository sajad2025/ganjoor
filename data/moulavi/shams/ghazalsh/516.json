        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جمله مستان خوش و رقصان شدند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: همهٔ عاشقان شاد و در حال رقص هستند، ای زیبارویان، دست‌هایتان را به هم بزنید."
      },
      {
        "id": 2076999,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دست زنید ای صنمان دست دست",
        "languageId": null,
        "coupletSummary": null
      },
