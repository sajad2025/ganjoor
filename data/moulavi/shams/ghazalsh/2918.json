        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا به گوشش دردمیم افسانه‌ای",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2062985,
        "vOrder": 9,
