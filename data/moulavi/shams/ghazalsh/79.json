        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درکش قدحی با من بگذار ملامت را",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2090411,
        "vOrder": 9,
