        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صدر صدور جاء الینا",
        "languageId": 2,
        "coupletSummary": "هوش مصنوعی: یک چهره درخشان به ما روی آورد، مانند ماه که در شب‌های پرنور می‌درخشد و در کنار ما اقامت گزید."
      },
