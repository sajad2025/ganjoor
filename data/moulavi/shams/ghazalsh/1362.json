        "id": 2094010,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 11,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بدر بدور بات لدینا",
        "languageId": 2,
        "coupletSummary": null
      },
      {
        "id": 2093996,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دنب خری تو ای خر ملعون",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای خر ملعون، تو نه کم می‌آوری و نه بر تعداد خود می‌افزایی."
      },
      {
        "id": 2093997,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 12,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نی کم گردی نی شوی افزون",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2093998,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای دل و جانم از کژی تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای دل و جانم، من از ناپسندی و ترفندهای تو خسته و رنجیده‌ام."
      },
      {
        "id": 2093999,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 13,
