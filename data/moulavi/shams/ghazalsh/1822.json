      "excerpt": "آب حیات عشق را در رگ ما روانه کن",
      "mainSections": null
    },
    "verses": [
      {
        "id": 2052615,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای شده از جفای تو جانب چرخ دود من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای چرخ زمان که به خاطر ستمگری‌های تو مضطرب و غمگینم، این کار را نکن که حسودان از خوشحالی من باخبر شوند و شاد شوند."
      },
      {
        "id": 2052616,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جور مکن که بشنود شاد شود حسود من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2052617,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیش مکن تو دود را شاد مکن حسود را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زیاد در مورد دود و آتش صحبت نکن و حسودها را خوشحال نکن، زیرا آنها از نابودی من بسیار خوشحال می‌شوند."
      },
      {
        "id": 2052618,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وه که چه شاد می شود از تلف وجود من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2052619,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تلخ مکن امید من ای شکر سپید من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای شکر سفید، امید من را تلخ نکن، چون اگر این کار را کنی، من از دست تو پیراهن کبود خود را از دست می‌دهم."
      },
      {
        "id": 2052620,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا ندرم ز دست تو پیرهن کبود من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2052621,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلبر و یار من تویی رونق کار من تویی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: محبوب و همراه من، تو باعث شکوفایی کارهایم هستی. تو همانند باغ و بهاری برای من هستی و وجودم تنها برای توست."
      },
      {
        "id": 2052622,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "باغ و بهار من تویی بهر تو بود بود من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2052623,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خواب شبم ربوده‌ای مونس من تو بوده‌ای",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای مونس من! خواب شبانه‌ام را از من گرفته‌ای و تو شده‌ای درد و رنج من. هیچ‌کس دیگری برای من سودی ندارد جز تو."
      },
      {
        "id": 2052593,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درد توام نموده‌ای غیر تو نیست سود من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2052608,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جان من و جهان من زهره آسمان من",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: روح من و دنیای من، زهره‌ی آسمان من است. آتش تو نشانه‌ای از وجود من در دل همچون عود است."
      },
      {
        "id": 2052592,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آتش تو نشان من در دل همچو عود من",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2052574,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جسم نبود و جان بدم با تو بر آسمان بدم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بدن وجود نداشت و روح خود را با تو به آسمان بردم. هیچ چیزی در میانه‌ی گفت‌وگو وجود نداشت، جز من و تو که صحبت می‌کردیم و می‌شنیدیم."
      },
      {
        "id": 2052560,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هیچ نبود در میان گفت من و شنود من",
        "languageId": null,
        "coupletSummary": null
      }
    ],
