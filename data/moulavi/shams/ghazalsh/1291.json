        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گه پلنگش کنی و گاهی موش",
        "languageId": null,
        "coupletSummary": null
      },
