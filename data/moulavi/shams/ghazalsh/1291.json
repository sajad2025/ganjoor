        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لب ببسته همی‌زنیم خروش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2097632,
        "vOrder": 7,
