        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیخودی خوش ولایتیست ولی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بی‌دلیل خوشحالی در ولایت وجود دارد، اما هیچ‌کس زیر بار فرمان کسی نمی‌رود."
      },
      {
        "id": 2104573,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
