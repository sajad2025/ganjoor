        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نِعمَ التَّلاقی قم فاسقنیها",
        "languageId": null,
        "coupletSummary": null
      },
      {
