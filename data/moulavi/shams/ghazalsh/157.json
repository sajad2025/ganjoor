        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "غافلم نی عاقلم باری بیا رویی نما",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2091626,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شه صلاح الدین که تو هم حاضری هم غایبی",
