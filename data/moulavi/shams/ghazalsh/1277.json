        "authorUrl": "",
        "commentDate": "2013-07-22T16:45:06",
        "htmlComment": "<p>ویا شاید هم سست به معنی کند مد نظر بوده و سنگین در آنصورت شاید بشود سنگین زبان یا کند زبان معنی کرد</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": null,
        "replies": [],
        "myComment": false,
        "coupletIndex": -1,
