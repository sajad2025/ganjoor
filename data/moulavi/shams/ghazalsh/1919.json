    "sections": [
      {
        "id": 40212,
        "poemId": 4543,
        "poem": null,
        "poetId": 5,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 13,
        "ganjoorMetre": {
          "id": 13,
          "urlSlug": null,
          "rhythm": "مفعول مفاعلن فعولن (هزج مسدس اخرب مقبوض محذوف)",
          "name": null,
          "description": null,
          "verseCount": 40158
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "یدن",
        "plainText": "عشق است بر آسمان پریدن\r\nصد پرده به هر نفس دریدن\r\nاول نفس از نفس گسستن\r\nاول قدم از قدم بریدن\r\nنادیده گرفتن این جهان را\r\nمر دیده خویش را بدیدن\r\nگفتم که دلا مبارکت باد\r\nدر حلقه عاشقان رسیدن\r\nز آن سوی نظر نظاره کردن\r\nدر کوچه سینه ها دویدن\r\nای دل ز کجا رسید این دم\r\nای دل ز کجاست این طپیدن\r\nای مرغ بگو زبان مرغان\r\nمن دانم رمز تو شنیدن\r\nدل گفت به کار خانه بودم\r\nتا خانه آب و گل پریدن\r\nاز خانه صنع می پریدم\r\nتا خانه صنع آفریدن\r\nچون پای نماند می کشیدند\r\nچون گویم صورت کشیدن",
