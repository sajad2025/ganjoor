    "verses": [
      {
        "id": 2090014,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از بهر خدا بنگر در رویِ چو زر جانا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به خاطر خدا به چهره‌ی دوست نگاه کن، که هر جا بروی ما را با خودت ببر، ای دوست عزیز."
      },
      {
        "id": 2090013,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر جا که روی ما را با خویش ببر جانا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2090012,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون در دل ما آیی تو دامن خود برکش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی که تو وارد دل ما می‌شوی، دامن خود را بالا بکش تا از خون دل معشوقه‌ام به لباس خود آغشته نشوی."
      },
      {
        "id": 2090011,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا جامه نیالایی از خون جگر جانا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2090010,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای ماه برآ آخر بر کوریِ مه‌رویان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای ماه، لطفاً به خاطر کوری چهره‌های زیبا، آخرین بار بر افراز و درخشش خود برافراز؛ که ابرهای تیره در چهره قمر جانم سایه افکنده‌اند."
      },
      {
        "id": 2090009,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ابری سیه اندرکش در روی قمر جانا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2090008,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زان روز که زادی تو ای لب‌شکر از مادر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از روزی که تو، ای لب شیرین، از مادر به دنیا آمدی، بازار شکر به شدت کساد شد، جانا."
      },
      {
        "id": 2090007,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آوه که چه کاسد شد بازار شکر جانا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2090006,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتی که سلام علیک بگرفت همه عالم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: گفتی که سلام بر تو باد، در نتیجه همه موجودات دل‌هایشان را به احترام تو خم کرده و جانشان را به تو تقدیم کرده‌اند."
      },
      {
        "id": 2090005,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل سجده درافتاده جان بسته کمر جانا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2090004,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون شمع بُدم سوزان هر شب به سحر کُشته",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من همچون شمعی در هر شب می‌سوزم و حالا که به dawn رسیده‌ام، نمی‌توانم شب را از صبح تشخیص دهم، ای عزیز."
      },
      {
        "id": 2090003,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "امروز بنشناسم شب را ز سحر جانا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2090002,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شمس الحق تبریزی شاهنشه خون‌ریزی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: شمس الحق تبریزی، که به عنوان پادشاهی در میان خونریزان شناخته می‌شود، ای دریای بسته به کمر، در پیش تو جواهرهای جان به نمایش درآمده‌اند."
      },
      {
        "id": 2090001,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای بحر کمربسته پیش تو گهر جانا",
        "languageId": null,
        "coupletSummary": null
      }
    ],
