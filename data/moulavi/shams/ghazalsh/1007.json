        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ماه وجودش ز غباری برست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ماه وجود او از غباری پاک شد و آب حیاتش به خاطر درد بیرون آمد."
      },
      {
        "id": 2103565,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آب حیاتش به درآمد ز درد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2103566,
        "vOrder": 7,
