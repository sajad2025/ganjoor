        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در دل سفر عراق خیزد",
        "languageId": null,
        "coupletSummary": null
      },
      {
