        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با دل گفتم چنین خوش استت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به دل گفتم که تو چقدر خوشحالی، دل هم با صدای بلند جواب داد که آری، من خوشحالم."
      },
      {
        "id": 2072771,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
