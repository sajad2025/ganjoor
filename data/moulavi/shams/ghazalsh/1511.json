    "verses": [
      {
        "id": 2102403,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیا ای آنک بردی تو قرارم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بیا، ای کسی که آرامشم را دزدیده‌ای، همان‌طور که شکر در ظرف تنگ جا دارد، تو هم در کنارم قرار بگیر."
      },
      {
        "id": 2102389,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درآ چون تنگ شکر در کنارم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2102390,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل سنگین خود را بر دلم نه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل سنگین و پر از غم من را نمی‌بینی، در حالی که از احساسات تلخ و دردناک، به شدت شکنجه‌ام می‌دهند."
      },
      {
        "id": 2102391,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نمی‌بینی که از غم سنگسارم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2102392,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیا نزدیک و بر رویم نظر کن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نزدیک بیا و به چهره‌ام نگاه کن، نشانه‌هایی را ببین که از عشق در وجودم است."
      },
      {
        "id": 2102393,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نشانی‌ها نگر کز عشق دارم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2102394,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بسوزم پرده هفت آسمان را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر از شدت درد و سوز دل من دودی برآید، پرده‌های هفت آسمان را هم می‌سوزانم."
      },
      {
        "id": 2102395,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اگر از سوز دل دودی برآرم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2102396,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خزان گر باغ و بستان را بسوزد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر پاییز باغ و بوستان را بسوزاند، من بهاری هستم که جهان را شاداب می‌کند."
      },
      {
        "id": 2102397,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بخنداند جهان را نوبهارم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2102398,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جهان گوید که بازآ ای بهاران",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: جهان از بهاران دعوت می‌کند که برگردد، زیرا دلش پر از زخم‌هایی است که ناشی از ظلم و ستم فصل خزانی است که گذشته."
      },
      {
        "id": 2102399,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که از ظلم خزان صد داغ دارم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2102400,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بگردان ساقیا جام خزانی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای ساقی، لطفاً جامی از شراب خنک و دل‌انگیز بده که من به خاطر عشق، در حالتی از غم و اندوه به سر می‌برم."
      },
      {
        "id": 2102401,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که از عشق بهار اندر خمارم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2102402,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بده چیزی که پنهان است چون جان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به من چیزی بده که در دل پنهان است، چون نمی‌توانم بیشتر از این صبر کنم و انتظار بکشم."
      },
      {
