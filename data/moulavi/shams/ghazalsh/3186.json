        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ترا وهمی پژولاند، پژولی",
        "languageId": null,
        "coupletSummary": null
      },
      {
