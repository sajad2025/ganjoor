      },
      {
        "id": 2097185,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن رفتن راهوار عاشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2097186,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای بند تو دلگشای عاشق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو دل‌گشای عاشق هستی و نصیحت تو مانند گوشواره‌ای برای اوست."
      },
      {
        "id": 2097187,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وی پند تو گوشوار عاشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2097188,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیرست که خواب شب نمانده است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مدت زیادی است که عشق در دل عاشق بیدار است و خواب شب را در چشمان او باقی نگذاشته است."
      },
      {
        "id": 2097189,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در دیده شرمسار عاشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2097208,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیرست که اشتها برفتست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی است که شور و اشتیاق برای غذا از معده عاشق تمام شده است."
      },
      {
        "id": 2097225,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از معده لقمه خوار عاشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2097226,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیرست که زعفران برستست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مدت زیادی است که زعفران از چهره لاله‌زار عاشق، جلوه‌گری نمی‌کند."
      },
      {
        "id": 2097227,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از چهره لاله زار عاشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2097262,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیرست کز آب‌های دیده",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: مدت زیادی است که به خاطر عشق، اشک‌های خود را به دریا ریخته‌ای و دیگر نتوانسته‌ای از عشق دور شوی."
      },
      {
        "id": 2097263,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دریا کردی کنار عاشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2097264,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زین‌ها چه زیانش چون تو باشی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر تو راه‌گشا و دلدار عاشق باشی، چه ضرری به حال عاشق می‌رسد؟"
      },
      {
        "id": 2097265,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چاره گر و غمگسار عاشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2097266,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صد گنج فروشیش به دانگی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر تو قصد داری که عشق را با ارزش بدانید، حتی به اندازه یک دانه، باید همه گنج‌های خود را به عشق نثار کنی."
      },
      {
        "id": 2097267,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وان دانگ کنی نثار عاشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2097268,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای لاف ابیت عند ربی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای دلبر، در حضور خداوند، تو زینت و سربلندی عاشق هستی."
      },
      {
        "id": 2097269,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آرایش و افتخار عاشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2097270,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لو لاک لما خلقت الافلاک",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر تو نبودی، افلاک و جهان به وجود نمی‌آمدند. عشق بدون تو، چرخش خود را از دست می‌دهد."
      },
      {
        "id": 2097271,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نه چرخ به اختیار عاشق",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2097272,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بس کن که عنایتش بسنده است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بس کن که مهربانی و توجه او برای عاشق کافی است، نیازی به دلیل و صحبت نیست."
      },
      {
        "id": 2097273,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
