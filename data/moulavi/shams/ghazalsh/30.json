      },
      {
        "id": 38088,
        "authorName": "امین کیخا",
        "authorUrl": "",
        "commentDate": "2013-04-28T02:36:59",
        "htmlComment": "<p>نام یعقوب در گنجور مرا یاد یعقوب لیث می اندازد که پارسی امروز وامدار اوست گویند کسی شعری برایش به غیر فارسی خواند او گفت چرا باید شعری گفت که من اندر نیابم ؟ و محمد بن وصیف سگزی شعری به پارسی سرود و اورا خوش امد و به رگ پارسی خون شتافت  جا دارد نام بزرگان بردن و درود گفتن</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": "daf486d1-009f-4cd4-6a24-08d9c24d89b3",
        "replies": [],
        "myComment": false,
        "coupletIndex": -1,
        "coupletSummary": "",
        "isBookmarked": false
      },
