    "verses": [
      {
        "id": 2105455,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای آن که از عزیزی در دیده جات کردند",
        "languageId": null,
        "coupletSummary": "ای کسی که آنقدر عزیزهستی که مردمان تو را در دیده خود جای داده بودند، دیدی که همه تو را ترک کرده و تنهایت گذاشتند"
      },
      {
        "id": 2105456,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیدی که جمله رفتند تنها رهات کردند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2105457,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای یوسف امانت آخر برادرانت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای یوسف، برادرانت به راحتی تو را فروختند و بهایت را کم و ناچیز شمردند."
      },
      {
        "id": 2105458,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بفروختندت ارزان و اندک بهات کردند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2105459,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن‌ها که این جهان را بس بی‌وفا بدیدند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کسانی که این دنیا را بسیار بی‌وفا و ناپایدار دیده‌اند، تصمیم گرفته‌اند که آن را رها کنند و از زندگی دست بکشند."
      },
      {
        "id": 2105460,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "راه اختیار کردند ترک حیات کردند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2105461,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بسیار خصم داری پنهان و می‌نبینی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بسیاری از دشمنان تو در خفا وجود دارند و تو از وجود آنها بی‌خبری. آنها با زیرکی و نیرنگ خود تو را در زمین نبرد شکست داده‌اند."
      },
      {
        "id": 2105462,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کاین جمله حیله کردی ویشانت مات کردند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2105463,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شاهان که نابدیدند چون حال تو بدیدند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که شاهان حال تو را دیدند و متوجه محبت و توجه تو شدند، همه به دعا و طلب از خدا پرداختند."
      },
      {
        "id": 2105464,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از مهر و از عنایت جمله دعات کردند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2105466,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با ساکنان سینه بنشین که اهل کینه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: با افرادی که در دلشان محبت و دوستی دارند، همراه شو، زیرا کسانی که کینه‌ورزند مانند کودکی هستند که بدون دست و پا می‌شود."
      },
      {
        "id": 2105481,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مانند طفل دینه بی‌دست و پات کردند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2105467,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن‌ها نهفتگانند وین‌ها که اهل رازند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آن‌ها پنهان هستند و این‌ها که اهل معرفت‌اند، از رنگ و ظواهر مانند چنگی هستند که دو تارش را به هم بافته‌اند."
      },
      {
        "id": 2105468,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از رنگ همچو چنگی باری دوتات کردند",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2105469,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اندیشه کن از آن‌ها کاندیشه‌هات دانند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به فکر کسانی باش که به اندیشه‌های تو ارزش می‌دهند. از این‌ها انتظار وفاداری نداشته باش، چون خودشان بی‌وفا هستند."
