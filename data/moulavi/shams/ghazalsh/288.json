        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مر الفراقٖ لا تظلمونا",
        "languageId": 2,
        "coupletSummary": null
      },
      {
