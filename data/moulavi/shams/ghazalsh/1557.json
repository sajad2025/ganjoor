      },
      {
        "id": 2098758,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وز لقمه دهان چرا نبستم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2098759,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر وسوسه کرد گرد پیچم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر وسوسه‌ام کند و در دام پیچیدگی‌های او بیفتم، پس چرا همچنان در سکون و آرامش نشسته‌ام؟"
      },
      {
        "id": 2098760,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در پیچش او چرا نشستم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2098761,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آخر دیدم به عقل موضع",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در نهایت متوجه شدم که برای درک و عقل خود بارها و بارها تلاش کرده‌ام."
      },
      {
        "id": 2098762,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صد بار و هزار بار رستم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2098763,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از بندگی خدا ملولم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من از خدمت به خدا خسته‌ام، چون جانم را برای محبت چیزی دیگر فدای می‌کنم."
      },
      {
        "id": 2098764,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زیرا که به جان گلوپرستم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2098766,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خود من جعل الهموم هما",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من خودم از کلمه \"پیامبر\" به عنوان یک عنوان استفاده کرده‌ام."
      },
      {
        "id": 2098781,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از لفظ رسول خوانده استم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2098767,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون بر دل من نشسته دودی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دودی که بر دل من نشسته، حالتی است که به سرعت مانند گرد و غبار اطرافم را فرا گرفته است."
      },
      {
        "id": 2098768,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون زود چو گرد برنجستم",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2098769,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "این‌ها که نبشتم از ندامت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این جملات به نوعی اشاره به احساس پشیمانی و ندامت دارند، به این معنا که نوشته‌ها و افکاری که در گذشته به آنها پرداخته شده، در حال حاضر نتیجه‌ی ندامت و پشیمانی را به همراه دارند. به نوعی، گوینده از اقداماتی که در گذشته انجام داده ابراز ندامت می‌کند و این احساس را به روشنی بیان می‌کند."
      },
