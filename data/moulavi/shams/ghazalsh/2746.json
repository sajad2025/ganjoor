    "sections": [
      {
        "id": 41186,
        "poemId": 5370,
        "poem": null,
        "poetId": 5,
        "poet": null,
        "index": 0,
        "number": 1,
        "sectionType": 0,
        "verseType": 1,
        "ganjoorMetreId": 13,
        "ganjoorMetre": {
          "id": 13,
          "urlSlug": null,
          "rhythm": "مفعول مفاعلن فعولن (هزج مسدس اخرب مقبوض محذوف)",
          "name": null,
          "description": null,
          "verseCount": 40158
        },
        "ganjoorMetreRefSectionIndex": null,
        "rhymeLetters": "اری",
        "plainText": "آن را که به لطف سر بخاری\r\nاز عقل و معامله برآری\r\nاز یک نظرت قیامتی خاست\r\nیا رب تو در آن نظر چه داری\r\nاز لعل تو دل دری بدزدید\r\nدزد است از آنش می فشاری\r\nبفشار به غم تو دزد خود را\r\nغم نیست چو هم تو غمگساری\r\nبفشار که رخت مؤمنان را\r\nپنهان کرده است از عیاری\r\nیا من نعش العبید فضلا\r\nمن کل مواقع العثار\r\nبالفضل اعاد ما فقدنا\r\nبعد الحولان و التواری\r\nفجرت من الهوا عیونا\r\nفی مرج قلوبنا جواری\r\nتخضر بمایها غصون\r\nفی الروح لذیذه الثمار\r\nیا من غصب القلوب جهرا\r\nثم اکرمهن فی السرار\r\nدی رفت و پریر رفت و امروز\r\nجان منتظر است تا چه آری\r\nهر روز ز تو وظیفه دارد\r\nاین باز هزار گون شکاری\r\nبرگیر کلاه از سر باز\r\nتا پر بزند در این صحاری\r\nزان پیش که می دهد مرا دوست\r\nآن لطف نمود و بردباری\r\nکه مست شدم ز باده ماندم\r\nاندر بر لطف و حق گزاری\r\nآید از باغ لطف و سبزی\r\nآید ز بهار هم بهاری\r\nای باد بهار عشق و سودا\r\nبر خسته دلان چه سازگاری\r\nاسکت و افتح جناح عشق\r\nحان الجولان فی المطار\r\nخاموش که غیر حرف و آواز\r\nبی صد لغت دگر سواری",
        "htmlText": "<div class=\"b\" id=\"bn1\"><div class=\"m1\"><p>آن را که به لطف سر بخاری</p></div>\r\n<div class=\"m2\"><p>از عقل و معامله برآری</p></div></div>\r\n<div class=\"b\" id=\"bn2\"><div class=\"m1\"><p>از یک نظرت قیامتی خاست</p></div>\r\n<div class=\"m2\"><p>یا رب تو در آن نظر چه داری</p></div></div>\r\n<div class=\"b\" id=\"bn3\"><div class=\"m1\"><p>از لعل تو دل دری بدزدید</p></div>\r\n<div class=\"m2\"><p>دزد است از آنش می‌فشاری</p></div></div>\r\n<div class=\"b\" id=\"bn4\"><div class=\"m1\"><p>بفشار به غم تو دزد خود را</p></div>\r\n<div class=\"m2\"><p>غم نیست چو هم تو غمگساری</p></div></div>\r\n<div class=\"b\" id=\"bn5\"><div class=\"m1\"><p>بفشار که رخت مؤمنان را</p></div>\r\n<div class=\"m2\"><p>پنهان کرده است از عیاری</p></div></div>\r\n<div class=\"b\" id=\"bn6\"><div class=\"m1\"><p>یا من نعش العبید فضلا</p></div>\r\n<div class=\"m2\"><p>من کل مواقع العثار</p></div></div>\r\n<div class=\"b\" id=\"bn7\"><div class=\"m1\"><p>بالفضل اعاد ما فقدنا</p></div>\r\n<div class=\"m2\"><p>بعد الحولان و التواری</p></div></div>\r\n<div class=\"b\" id=\"bn8\"><div class=\"m1\"><p>فجرت من الهوا عیونا</p></div>\r\n<div class=\"m2\"><p>فی مرج قلوبنا جواری</p></div></div>\r\n<div class=\"b\" id=\"bn9\"><div class=\"m1\"><p>تخضر بمائها غصون</p></div>\r\n<div class=\"m2\"><p>فی الروح لذیذه الثمار</p></div></div>\r\n<div class=\"b\" id=\"bn10\"><div class=\"m1\"><p>یا من غصب القلوب جهرا</p></div>\r\n<div class=\"m2\"><p>ثم اکرمهن فی السرار</p></div></div>\r\n<div class=\"b\" id=\"bn11\"><div class=\"m1\"><p>دی رفت و پریر رفت و امروز</p></div>\r\n<div class=\"m2\"><p>جان منتظر است تا چه آری</p></div></div>\r\n<div class=\"b\" id=\"bn12\"><div class=\"m1\"><p>هر روز ز تو وظیفه دارد</p></div>\r\n<div class=\"m2\"><p>این باز هزار گون شکاری</p></div></div>\r\n<div class=\"b\" id=\"bn13\"><div class=\"m1\"><p>برگیر کلاه از سر باز</p></div>\r\n<div class=\"m2\"><p>تا پر بزند در این صحاری</p></div></div>\r\n<div class=\"b\" id=\"bn14\"><div class=\"m1\"><p>زان پیش که می‌دهد مرا دوست</p></div>\r\n<div class=\"m2\"><p>آن لطف نمود و بردباری</p></div></div>\r\n<div class=\"b\" id=\"bn15\"><div class=\"m1\"><p>که مست شدم ز باده ماندم</p></div>\r\n<div class=\"m2\"><p>اندر بر لطف و حق گزاری</p></div></div>\r\n<div class=\"b\" id=\"bn16\"><div class=\"m1\"><p>آید از باغ لطف و سبزی</p></div>\r\n<div class=\"m2\"><p>آید ز بهار هم بهاری</p></div></div>\r\n<div class=\"b\" id=\"bn17\"><div class=\"m1\"><p>ای باد بهار عشق و سودا</p></div>\r\n<div class=\"m2\"><p>بر خسته دلان چه سازگاری</p></div></div>\r\n<div class=\"b\" id=\"bn18\"><div class=\"m1\"><p>اسکت و افتح جناح عشق</p></div>\r\n<div class=\"m2\"><p>حان الجولان فی المطار</p></div></div>\r\n<div class=\"b\" id=\"bn19\"><div class=\"m1\"><p>خاموش که غیر حرف و آواز</p></div>\r\n<div class=\"m2\"><p>بی صد لغت دگر سواری</p></div></div>",
