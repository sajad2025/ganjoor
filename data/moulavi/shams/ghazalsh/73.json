        "authorName": "بهروز",
        "authorUrl": "http://trader.blogfa.com",
        "commentDate": "2016-11-14T04:24:26",
        "htmlComment": "<p>آفتابی کو مجرد آمد از برج حمل<br />آفتابی بی‌نظیر بی‌قرین خوش قران</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": null,
        "replies": [],
