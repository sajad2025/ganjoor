        "isBookmarked": false
      },
      {
        "id": 15038,
        "authorName": "بهروز",
        "authorUrl": "http://trader.blogfa.com",
        "commentDate": "2016-11-14T04:03:37",
        "htmlComment": "<p>شکر که خورشید عشق رفت به برج حمل<br />در دل و جان‌ها فکند پرورش نور خویش<br />شکر که موسی برست از همه فرعونیان<br />باز به میقات وصل آمد بر طور خویش</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": null,
        "replies": [],
        "myComment": false,
