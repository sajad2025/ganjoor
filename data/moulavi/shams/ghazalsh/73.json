        "commentDate": "2016-11-14T04:15:26",
        "htmlComment": "<p>گر تو ز خورشید حمل سر کشی<br />بفسری و برف زمستان شوی</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": null,
