        "text": "کامتزاج العبید بالارباب",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2088569,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دختران ضمیر سرمستند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دختران در دل و جان شاداب و سرخوشند، در میان باغ محبت و دنیای چرخشی زندگی."
      },
      {
        "id": 2088568,
        "vOrder": 14,
        "coupletIndex": 6,
