        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر شما محرم ضمیر نه‌اید",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر شما به دل‌ها راه ندارد، از آن‌ها سوال کنید پشت پرده."
      },
      {
        "id": 2088566,
        "vOrder": 16,
