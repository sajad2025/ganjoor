        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یک لحظه مبر ز بنده که نیست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: یک لحظه مرا رها نکن، زیرا بدون آب، کشتی نمی‌تواند حرکت کند."
      },
      {
        "id": 2072864,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی آب سفینه را روانی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2072865,
        "vOrder": 5,
        "coupletIndex": 2,
