        "sectionIndex4": null,
        "text": "ای وصل تو اصل شادمانی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وصال تو منبع تمام خوشحالی‌هاست، زیرا این شکل‌ها و ظاهرها تنها بازتابی از آن معانی عمیق هستند."
      },
      {
        "id": 2072896,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کان صورت‌هاست وین معانی",
        "languageId": null,
        "coupletSummary": null
