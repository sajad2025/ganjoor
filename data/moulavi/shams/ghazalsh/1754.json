        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بند خانه نیم که چون عیسی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من نیمه‌ای از خانه را دارم که مثل عیسی، به آسمان می‌خرامد."
      },
      {
        "id": 2054094,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
