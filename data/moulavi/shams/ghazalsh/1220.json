        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "باز روان شد از بصر تا به نظر بگیرمش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2108226,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
