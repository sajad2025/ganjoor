        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ور تن من خاک بدی این نفس",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر جسم من به خاک سپرده شود، این نفس من همه گل‌ها، عشق‌ها و خواسته‌ها را به همراه خود خواهد آورد."
      },
      {
        "id": 2063931,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
