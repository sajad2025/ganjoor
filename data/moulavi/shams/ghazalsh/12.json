    "verses": [
      {
        "id": 2090624,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای نوبهار عاشقان داری خبر از یار ما",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای فصل نو و بهار عاشقان، آیا از دوست ما خبری داری؟ تویی که چمن از وجود تو بارور می‌شود و باغ‌ها به واسطه تو سرسبز و شاداب‌اند."
      },
      {
        "id": 2090623,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای از تو آبستن چمن ، وِی از تو خندان باغ‌ها",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2090622,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای بادِ نایِ خوش نفس ، عشّاق را فریاد‌رس،",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای باد نای خوش، تو که به دل‌ها جان می‌بخشی و صدای عشاق را به گوش می‌رسانی، کجا بودی که حالا به یاد تو افتاده‌ام؟ تویی که از هر چیز دیگر پاک‌تر هستی، چرا از من دور بودی؟"
      },
      {
        "id": 2090621,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای پاک‌تر از جانِ جا‌ن ، آخر کجا بودی کجا‌؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2090620,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای فتنهٔ روم و حبش‌، حیران شدم کاین بوی خوش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای فتنهٔ سرزمین‌های روم و حبشه، من در astonishment مانده‌ام که آیا این عطر خوشی که حس می‌کنم، متعلق به پیراهن یوسف است یا اینکه خود ردای پیامبر است؟"
      },
      {
        "id": 2090619,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پیراهن یوسف بوَد یا خود ردایِ مصطفی‌؟!",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2090618,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای جویبار راستی از جوی یار ماستی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای جویبار حقیقت، تو از عشق محبوب سرچشمه می‌گیری. بر سینه‌ها جاری هستی و بر جان‌ها زندگی‌بخش و شاداب‌کننده‌ای."
      },
      {
        "id": 2090617,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر سینه‌ها سیناستی بر جان‌هایی جان فزا",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2090616,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای قیل و ای قال تو خوش‌، و ای جمله اَشکال تو خوش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای حرف و صحبت تو زیباست، و ای همه ظواهر تو دل‌نشین‌اند. ماه تو زیباست، سال تو خوشایند است. ای سال و ماه، من به خدمت تو آماده‌ام."
      },
      {
        "id": 2090615,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ماه تو خوش سال تو خوش ای سال و مه چاکر تو را",
        "languageId": null,
        "coupletSummary": null
      }
