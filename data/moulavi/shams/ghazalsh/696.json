    "verses": [
      {
        "id": 2085076,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیچاره کسی که زر ندارد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آه بیچاره کسی که نه طلا دارد و نه از معادن طلا چیزی می‌داند."
      },
      {
        "id": 2084978,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وز معدن زر خبر ندارد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2084977,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیچاره دلی که ماند بی‌تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دل بیچاره‌ای که بدون تو مانده، مانند طوطی‌ای است که زیبا و جذاب است اما شکر و شیرینی در دسترس ندارد."
      },
      {
        "id": 2084976,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "طوطیست ولی شکر ندارد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2084942,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دارد هنر و هزار دولت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: شخصی توانایی و قدرت زیادی دارد، اما متأسفانه دیگری از آن بهره‌مند نیست."
      },
      {
        "id": 2084877,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "افسوس که آن دگر ندارد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2084878,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "می‌گوید دست جام بخشش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: می‌گوید اگر کسی چیزی ندارد، ما باید دست او را با بخشش و مهربانی بگیریم و به او کمک کنیم."
      },
      {
        "id": 2084879,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ما بدهیمش اگر ندارد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2084880,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر وی ریزییم آب حیوان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر بر روی او آب حیات بپاشیم، باید بدانیم که اگر خود جگرش تحمل نداشته باشد، فایده‌ای نخواهد داشت."
      },
      {
        "id": 2084881,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر آب بر آن جگر ندارد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2084882,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی برگان را دهیم برگی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به بی‌برگ‌ها یک برگی می‌دهیم از همان برگی که شاخه‌ای ندارد."
      },
      {
        "id": 2084883,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زان برگ که شاخ تر ندارد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2084884,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن‌ها که ز ما خبر ندارند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: افرادی که از وضعیت ما بی‌خبرند، می‌گویند دعا هیچ تاثیری ندارد."
      },
      {
        "id": 2084885,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گویند دعا اثر ندارد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2084886,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نزدیک آمد که دیده بخشیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نزدیک شده‌ایم که آن کسی را ببخشیم که اصلاً به ما توجه نمی‌کند."
      },
      {
        "id": 2084887,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن را که به ما نظر ندارد",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2084888,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خاموش که مشکلات جان را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: سکوت کن، چرا که جز قدرت خداوند، هیچ‌کس نمی‌تواند بار مشکلات روح را بر دوش بکشد."
      },
