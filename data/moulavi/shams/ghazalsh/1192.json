      {
        "id": 2108680,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با آب شراب را میامیز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2108681,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یاد تو شراب و یاد ما آب",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: یاد تو برای من مانند شراب است و یاد ما مثل آب. ما مثل باغی هستیم و تو به مانند خرمی و سرسبزی آن باغ."
      },
      {
        "id": 2108682,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ما چون سرخر تو همچو پالیز",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2108683,
        "vOrder": 7,
