      },
      {
        "id": 2112941,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یا رب، چه لطیف و خوش، بلایی!",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2112951,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ما را ببری ز سر به عشوه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما را با جاذبه‌های خود به گونه‌ای مغلوب کن که دیوانه‌وار عاشق تو شویم و به حالت آشفته‌ای بیفتیم."
      },
      {
        "id": 2112940,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیوانه کنی، و های هایی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2112938,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ما را چه عدم، چه هست، چون تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ما را چه اهمیت دارد که وجود داریم یا نداریم، زیرا وقتی تو وجود نداری، حتی در نبودت نیز جلوه‌ای از وجود را به ما می‌دهی."
      },
      {
        "id": 2112937,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در نیست، وجود می‌نمایی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2112936,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دی کرده هزار گونه توبه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به هزار روش توبه کرده و راه پارسایی را در پیش گرفته است."
      },
      {
        "id": 2112935,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بگرفته طریق پارسایی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2112934,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چون بیند توبه روی خوبت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که دشمن و معاند تو beauty و زیبایی تو را ببیند، متوجه می‌شود که برای تو ارزشی قائل نیست."
      },
      {
        "id": 2112933,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "داند که عدوی تو بهایی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2112932,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بگریزد توبه و دل او را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: توبه از دل او فرار می‌کند و او با صدای بلند می‌گوید: بیا، کجایی؟"
      },
      {
        "id": 2112931,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فریادکنان، بیا، کجایی؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2112930,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گوید که: « رسید مرگ توبه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: می‌گوید: «مرگ به تو می‌رسد، پس از این تلاش برای توبه نکن، زیرا این آخرین فرصت توست.»"
      },
      {
        "id": 2112929,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از توبه دگر مجو کیایی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2113005,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "توبه اگر اژدهای نر بود",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر توبه به اندازه یک اژدهای نر بزرگ و قوی بود، ای عشق، می‌توان گفت که همچون زمردی از خود خداست."
      },
      {
        "id": 2113214,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 1,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای عشق، زمرد خدایی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2113215,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 2,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": 6,
        "sectionIndex4": null,
        "text": "ترجیع نهم به گوش قوال",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به قاری می‌گویم که نغمات زیبایم را بشنود و همزمان به ساز رَبَاب هم توجه کند."
      },
      {
        "id": 2113216,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 3,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": 6,
        "sectionIndex4": null,
        "text": "تو گوش رباب را همی مال",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2113499,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای بسته ز توبه بیست ترکش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای کسی که به خاطر توبه‌ات خود را محدود کرده‌ای، یک جام شراب خوش‌طعم بگیر و آن را بنوش."
      },
      {
        "id": 2113498,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بستان قدحی رحیق و درکش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2113497,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زیرا که فضای بی‌امانست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زیرا که آن زلف زیبا و افسونگر، همواره فضایی پرتنش و بی‌رحم را ایجاد می‌کند."
      },
      {
        "id": 2113496,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آن زلف معنبر مشوش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2113495,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای شاهد وقت، وقت شه رخ",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای معشوق زمان، زمان به زیباترین شکل، چهره نیکوی تو را رونق می‌بخشد."
      },
      {
        "id": 2113494,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سودت نیکند رخ مکرمش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2113493,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بینی کردن چه سود دارد؟",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چه فایده‌ای دارد که کسی را نصیحت کنی، وقتی خود او در عمل به اطلاعاتت توجهی نمی‌کند و همچنان به کار خود ادامه می‌دهد؟"
      },
      {
        "id": 2113492,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "با آن که دهان زنی چو گربش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2113491,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سجده کن و سر مکش چو ابلیس",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: سجده کن و سر را پایین بگذار، همچون ابلیس که در برابر زیبایی این معشوق سرکشی کرد."
      },
      {
        "id": 2113490,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پیش رخ این نگار مه‌وش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2113500,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از شش جهت است یار بیرون",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: یار من از همه جهات جلوه‌گری می‌کند و نورانی است، به طوری که از هر سوی روشنی‌اش دیده می‌شود."
      },
      {
        "id": 2113489,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پرنور شده ز روش هر شش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2113487,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دلدار امروز سخت مستست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: محبوب امروز در حالت مستی قرار دارد و در میان آشفتگی، غم و اندوه زندگی می‌کند."
      },
      {
        "id": 2113486,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پرفتنه و غصه و مخمش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2113485,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جان دارد صدهزار حیرت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این جمله به زیبایی و پیچیدگی جذابیت اشاره دارد. احساسات متنوع و شگفتی‌هایی که در مورد جذابیت و قلمرو زیبایی وجود دارد، به گونه‌ای است که جان انسان را پر از حیرت و شگفتی می‌کند. زیبایی که به وضوح و با جزئیات خاصی نمایان است، می‌تواند تأثیر عمیقی بر روح و ذهن انسان بگذارد."
      },
      {
        "id": 2113484,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از حسن منقش منقش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2113483,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از عشق زمین پر از شقایق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از عشق، زمین پر شده از گل‌های شقایق و در عشق آسمان، چنین جاذبه‌ای وجود دارد."
      },
      {
        "id": 2113482,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در عشق فلک چنین منعش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2113481,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خاموش و شراب عشق کم‌نوش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در سکوت و با نوشیدن کم از شراب عشق، خود را از دغدغه‌ها و نوسانات زندگی محفوظ نگه‌دار."
      },
      {
        "id": 2113480,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 2,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ایمن شو از ارتعاش و مرعش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2113479,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 2,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": 7,
        "sectionIndex4": null,
        "text": "چون لعل لبت نمود تلقین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: وقتی لب‌های تو رنگ لعل (گوهری) دارند، صحبت‌های دل را تحت تأثیر قرار می‌دهند و هیچ چیز نمی‌تواند آنها را از این تأثیر دور کند."
      },
      {
        "id": 2113478,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 3,
        "sectionIndex1": 0,
        "sectionIndex2": 5,
        "sectionIndex3": 7,
        "sectionIndex4": null,
        "text": "بر دل ننهیم بند لعلین",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2113488,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا ساقی ما توی بیاری",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تا زمانی که ساقی ما در میخانه بیاید، خودداری و هوشیاری کار درست و مناسبی نیست."
      },
      {
        "id": 2113501,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کفرست و حرام، هوشیاری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2113502,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای عقل، اگرچه بس عزیزی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای عقل، هرچند تو بسیار ارزشمندی، اما در حالت غفلت و مستی، خودت را کوچک و بی‌ارزش نکن."
      },
      {
        "id": 2113503,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در مست نظر مکن به خواری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2113526,
        "vOrder": 47,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر آن، داری، نکو نظر کن",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر چیزی خوب و ارزشمند داری، بهتر است به آن توجه کنی؛ چون کسی که آن را داراست، تو آن را نداری."
      },
      {
        "id": 2113525,
        "vOrder": 48,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کان کو دارد، تو آن نداری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2113524,
        "vOrder": 49,
        "coupletIndex": 24,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر پای ترا بتی بگیرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر پای تو را مجسمه‌ای بگیرد و یک لحظه تو را رها نکند، باید که سر به سختی و مشکلات بسپاری."
      },
      {
        "id": 2113523,
        "vOrder": 50,
        "coupletIndex": 24,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یکدم نهلد که سر به خاری",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2113522,
        "vOrder": 51,
        "coupletIndex": 25,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": 3,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دیوانه شوی که تو ز سودا",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر دیوانه شوی، در حالی که از نگرانی و دل‌شکستگی در شن‌های سیاه، دانه‌ای می‌کاری."
      },
      {
        "id": 2113521,
        "vOrder": 52,
