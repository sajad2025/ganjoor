        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آید ز فضل و فطنت من عارش",
        "languageId": null,
        "coupletSummary": null
      },
