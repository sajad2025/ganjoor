        "sectionIndex4": null,
        "text": "راز دارم مرا ز دست مده",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من را از رازهایم بی‌خبر نگذار و اجازه نده که خودخواهی دیگران بر من تأثیر بگذارد."
      },
      {
        "id": 2632260,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی‌خودان را به خودپرست مده",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2632261,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
