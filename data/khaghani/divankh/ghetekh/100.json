        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "درد ندهد صحاح بفرستد",
        "languageId": null,
        "coupletSummary": null
      },
