        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وقت هیجاست در خورد که علی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی مناسب است که علی به قنبر سلاح بفرستد."
