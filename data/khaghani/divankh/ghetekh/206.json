        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شهد تر چون شراب می‌چکدش",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2633570,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نم شبنم به گل رسد شب‌ها",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در شب‌ها، شبنم به گل می‌رسد، اما در روزها، آب از جوی به او نمی‌رسد."
      },
