        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "قطرها بر سراب می‌چکدش",
        "languageId": null,
        "coupletSummary": null
      },
