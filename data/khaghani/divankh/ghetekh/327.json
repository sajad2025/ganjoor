        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آویخته کی بُدی ترازو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر در سخن خود انصاف نداشته باشی، چطور می‌توانی انتظار داشته باشی که مورد سنجش و قضاوت دیگران قرار بگیری؟"
      },
      {
        "id": 2633123,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر زآنکه زبان بریده بودی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2633124,
        "vOrder": 19,
