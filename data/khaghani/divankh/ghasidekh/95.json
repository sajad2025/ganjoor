      {
        "id": 2610331,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خاطرم وصف او نداند گفت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: خاطرم نمی‌تواند به خوبی او را توصیف کند، هرچند گاهی درباره‌اش صحبت می‌کند."
      },
      {
        "id": 2610330,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گرچه هر چند گاه می‌گوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2610329,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "باز پرسید تا مناقب او",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دوباره سوال کرد که چرا مداحان در وصف او چه حرف‌هایی می‌زنند و چه راهی را دنبال می‌کنند."
      },
      {
        "id": 2610328,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مویه‌گر بر چه راه می‌گوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2610327,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نور پیغمبرش همی خواند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نور پیامبر به روشنی بر فراز است و سایهٔ خداوند همواره بر او ناظر است."
      },
      {
        "id": 2610326,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یاش سایهٔ الاه می‌گوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2610325,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مفتی مطلقش همی خواند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: داور دین که همواره به عنوان مرجع معتبر شناخته می‌شود، در حال خواندن فتوای مفتی مطلق است."
      },
      {
        "id": 2610324,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "داور دین پناه می‌گوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2610353,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "امتش دین فزای می‌خواند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اهل دیانت او به ایمان و دین می‌پردازند، اما مردم او به کفر و ناامیدی اشاره می‌کنند."
      },
      {
        "id": 2610355,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ملتش کفرگاه می‌گوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2610386,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آفتابش به صد هزار زبان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نور خورشید به طور وسیع و با شکوهی می‌گوید که سایه پادشاه به اندازه‌ی صدها زبان، حضور و قدرت او را اعلام می‌کند."
      },
      {
        "id": 2610356,
        "vOrder": 20,
        "coupletIndex": 9,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سایهٔ پادشاه می‌گوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2610385,
        "vOrder": 21,
        "coupletIndex": 10,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پشت دنیا ز مرگ او بشکست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: زمانی که مرگ او به وقوع بپیوندد، پشت دنیاست که از آن به زشت‌ترین حالت ممکن سقوط می‌کند و دینداری در این میان کنار می‌رود، در حالی که شخصی که جاه و مقام دارد، به سرزنش و بی‌خیالی نسبت به این موضوع می‌پردازد."
      },
      {
        "id": 2610384,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "روی دین ترک جاه می‌گوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2610383,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از سر دین کلاه عزت رفت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به خاطر دین و ایمان، کلاهی از سر عزت افتاد و افسوس که این کلاه به می‌سازد."
      },
      {
        "id": 2610382,
        "vOrder": 24,
        "coupletIndex": 11,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سر دریغا کلاه می‌گوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2610381,
        "vOrder": 25,
        "coupletIndex": 12,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چشم بیدار شرع شد در خواب",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چشم آگاه در حالت خواب، اسرار را با مکان خواب در میان می‌گذارد."
      },
      {
        "id": 2610380,
        "vOrder": 26,
        "coupletIndex": 12,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "راز با خوابگاه می‌گوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2610379,
        "vOrder": 27,
        "coupletIndex": 13,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "والله ار کس ثناش داند گفت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به خدا سوگند، اگر کسی ثنای او را بداند، هر کس که در این باره سخن بگوید، در حقیقت باطل می‌گوید."
      },
      {
        "id": 2610378,
        "vOrder": 28,
        "coupletIndex": 13,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر که گوید تباه می‌گوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2610377,
        "vOrder": 29,
        "coupletIndex": 14,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خاطرم نیز عذر می‌خواهد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: من از یادآوری خاطراتم نیز عذرخواهی می‌کنم که نمی‌توانم در جایگاه درست خود صحبت کنم."
      },
      {
        "id": 2610376,
        "vOrder": 30,
        "coupletIndex": 14,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که نه بر جایگاه می‌گوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2610375,
        "vOrder": 31,
        "coupletIndex": 15,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هر حدیثی گناه می‌شمرد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر گفتاری به شمارش گناه‌ها می‌پردازد، بنابراین سخن از گناه به میان می‌آید."
      },
      {
        "id": 2610374,
        "vOrder": 32,
        "coupletIndex": 15,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "پس حدیث از گناه می‌گوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2610373,
        "vOrder": 33,
        "coupletIndex": 16,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اشک من چون زبان خونین هم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چشم‌هایم که پر از اشک است، به زبان خود گویای درد و رنجی است که دارم و به نوعی از تو طلب بخشش می‌کند."
      },
      {
        "id": 2610372,
        "vOrder": 34,
        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حیلت عذرخواه می‌گوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2610371,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مرثیت‌های او مگر دل خاک",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: جای تأسف است که گل‌ها و گیاهان اجازه ندارند درد و غم خود را بازگو کنند؛ انگار دل زمین فقط به خاموشی و اندوه بسنده کرده است."
      },
      {
        "id": 2610370,
        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر زبان گیاه می‌گوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2610369,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "غم آن صبح صادق ملت",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: غم آن صبح روشنی بخش ملت، در دل آسمان شب به تصویر کشیده می‌شود."
      },
      {
        "id": 2610368,
        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آسمان شام گاه می‌گوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2610367,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر سوار از جگر سپه سازد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر سواری از دل خود غم و ناراحتی را به نمایش بگذارد، با سپاه خود این موضوع را بیان می‌کند."
      },
      {
        "id": 2610366,
        "vOrder": 40,
        "coupletIndex": 19,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "غم دل با سپاه می‌گوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2610365,
        "vOrder": 41,
        "coupletIndex": 20,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چشم خور اشک ران به خون شفق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چشم خورشید، اشک‌ها را به رنگ خون آسمان می‌ریزد و در دل چاه، رازها را به تصویر می‌کشد."
      },
      {
        "id": 2610364,
        "vOrder": 42,
        "coupletIndex": 20,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "راز با قعر چاه می‌گوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2610363,
        "vOrder": 43,
        "coupletIndex": 21,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دانش من گواه عصمت اوست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دانش من شهادتی بر پاکی اوست. به آنچه که این گواه می‌گوید گوش کن."
      },
      {
        "id": 2610362,
        "vOrder": 44,
        "coupletIndex": 21,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بشنو آنچ این گواه می‌گوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2610361,
        "vOrder": 45,
        "coupletIndex": 22,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آه کز فرقت امام جهان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: آه، از دوری امام جهان، جان خاقانی ناله می‌زند."
      },
      {
        "id": 2610360,
        "vOrder": 46,
        "coupletIndex": 22,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جان خاقانی آه می‌گوید",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2610359,
        "vOrder": 47,
        "coupletIndex": 23,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تا شد از عالم اسعد بو عمرو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: این جمله به این معناست که بعد از آمدن شخصی به نام اسعد بو عمرو، حالتی از شادابی و سروری در جمع احساس می‌شود و او به شوق و شادی می‌گوید: \"به شدت خوشحالم!\""
      },
      {
        "id": 2610358,
        "vOrder": 48,
        "coupletIndex": 23,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "عالونم وا اسعداه می‌گوید",
        "languageId": null,
        "coupletSummary": null
      }
    ],
