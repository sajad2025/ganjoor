        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یک دانهٔ آفتاب بی‌تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: یک دانهٔ آفتاب را بدون تو، بر گردن آسمان نمی‌توانم ببینم."
      },
