        "coupletIndex": 16,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کاین در ورق گمان مبینام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2619827,
        "vOrder": 35,
        "coupletIndex": 17,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بی‌تو من و عیش حاش‌للّه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بدون تو، زندگی برای من خوشی ندارد و از خواب و خیال تو هم چیزی نمی‌بینم."
      },
