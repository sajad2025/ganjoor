        "vOrder": 36,
        "coupletIndex": 17,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کز خواب خیال آن مبینام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2619825,
        "vOrder": 37,
        "coupletIndex": 18,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خاقانی را ز دل چه پرسی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: خاقانی را از دل چه می‌پرسی، که او را هیچ‌کس به آن شکلی که هست نمی‌بیند."
      },
