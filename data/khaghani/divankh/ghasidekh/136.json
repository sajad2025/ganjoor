        "vOrder": 38,
        "coupletIndex": 18,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کانست که کس چنان مبینام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2619823,
        "vOrder": 39,
        "coupletIndex": 19,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "حالی که به دشمنان نخواهم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در زمانی که نمی‌خواهم دشمنان را ببینم، به دل دوستان نیز توجه نمی‌کنم."
      },
