        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جز نام تو در میان مبینام",
        "languageId": null,
        "coupletSummary": null
      },
