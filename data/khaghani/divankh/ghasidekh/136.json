        "id": 2619844,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر گردن آسمان مبینام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2619843,
        "vOrder": 19,
        "coupletIndex": 9,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از دانهٔ دل ز کشت شادی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از دل خود دانهٔ عشق را می‌کاشتم و در سال‌ها خوشه‌ای از شادی برداشت می‌کنم."
      },
      {
