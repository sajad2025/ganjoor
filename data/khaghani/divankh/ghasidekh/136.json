        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در دل خود، وقتی به تصویر تو نگاه می‌کنم، جز چهرهٔ جانم را نمی‌بینم."
      },
      {
        "id": 2619840,
        "vOrder": 22,
        "coupletIndex": 10,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جز صورت جان عیان مبینام",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2619839,
        "vOrder": 23,
        "coupletIndex": 11,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
