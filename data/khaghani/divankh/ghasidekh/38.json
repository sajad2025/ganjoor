        "isBookmarked": false
      },
      {
        "id": 47314,
        "authorName": "دکتر امین لو",
        "authorUrl": "",
        "commentDate": "2019-04-30T11:53:39",
        "htmlComment": "<p>در نوشته بالا الرحمن درست است و همچنین شدت صحیح است.</p>",
        "publishStatus": "",
        "inReplyToId": null,
        "userId": "bb2b663c-aea1-4371-1285-08d96c199cea",
        "replies": [],
        "myComment": false,
        "coupletIndex": -1,
