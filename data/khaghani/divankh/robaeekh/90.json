        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گلخن ابلیس و چه هاروت است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2623699,
        "vOrder": 3,
