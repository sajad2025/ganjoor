        "sectionIndex4": null,
        "text": "نازت بَرَمی گر، نه چنین کافریی",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2624473,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گر با دل من به دوستی درخوریی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: اگر تو با دل من دوستی می‌کنی، از این چشم‌ها، چشم باارزش‌تری وجود ندارد."
      },
