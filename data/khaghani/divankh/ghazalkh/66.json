    "verses": [
      {
        "id": 2603213,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مِی‌ خور که جهان حریف‌جوی است",
        "languageId": null,
        "coupletSummary": "شراب بنوش ، زیرا اینگونه میتوانی در برابر جهانی که مانند جنگجویی که حریف میطلبد بایستی. و شراب بنوش زیرا بهار می آید و روی دنیا سبز میشود."
      },
      {
        "id": 2603214,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آفاق ز سبزه تازه‌روی است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2603215,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر عیش زدند ناف عالم",
        "languageId": null,
        "coupletSummary": "هم اکنون که بهار بوی خوش سبزه و گل میدهد ،بین دنیا و زندگی کردن با هم پیوندی ناگسستنی بوجود آمده است."
      },
      {
        "id": 2603216,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "اکنون که بهار نافه‌بوی است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2603217,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از زهد کنار جوی کاین وقت",
        "languageId": null,
        "coupletSummary": "از پرهیزگاری و تقوا کناره گیری کن زیرا که وقت خوشی و عشرت و شراب نوشیدن است."
      },
      {
        "id": 2603218,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وقت طرب و کنارِ جوی است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2603219,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شو خوانچه کن و چمانه درخواه",
        "languageId": null,
        "coupletSummary": "شب ، بساط مهمانی و عیش و نوش برپا کن و از آن یار ما که چهره اش مانند یوسف زیبا است ولی اخلاق گرگ گونه دارد ، طلب شراب بکن."
      },
      {
        "id": 2603220,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "زان یوسف ما که گرگ‌خوی است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2603221,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گرگ آشتی است روز و شب را",
        "languageId": null,
        "coupletSummary": "روز و شب مانند جنگجویانی هست که به قصد فریب دادن هم ، با یکدیگر و صلح میکنند ( گرگ آشتی ) ولی آن یار زیباروی من همواره با من میجنگد و حتی وانمود به صلح هم نمیکند."
      },
      {
        "id": 2603249,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "و آن بت شب و روز جنگ‌جوی است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2603251,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خاقانی گفت خاک اویم",
        "languageId": null,
        "coupletSummary": "خاقانی گفت که من خاک پای او هستم ( در برابرش خوار و ذلیلم ) و به جان و سر او قسم میخورم که خاقانی راست گو است و سخنش حقیقت است."
      },
      {
        "id": 2603302,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جان و سر او که راست‌گوی است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2603252,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "گفتی ز سگان کیست افضل",
        "languageId": null,
        "coupletSummary": "تو گفتی که : افضل الدین ( نام خاقانی ) از سگ های کیست؟ ( به زبان امروزی همان « سگ کی باشه » است ) .اگر هم خاقانی سگ باشد، از سگ های او ( معشوق ) است."
      },
