    "verses": [
      {
        "id": 2604422,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "لاله‌رخا! سمن‌برا! سروِ روان کیستی؟",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چهره‌ات مانند لاله است، بوی تو چون سمن می‌باشد و مانند سرو، با طراوت و زنده‌ای. اما تو کی هستی، ای سنگدل و ستم‌جو که آفت جان من شده‌ای؟"
      },
      {
        "id": 2604423,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سنگ‌دلا! ستم‌گرا! آفتِ جانِ کیستی؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2604424,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "تیرقدی، کمان‌کِشی، زُهره‌رُخی و مه‌وشی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای کسی که قدت بلند و کمانت افسون‌گر است، با چهره زیبا و روی ماهی که داری، جانم را فدای تو می‌کنم. تو بسیار دلنشینی، پس تو که هستی که این‌قدر جلب توجه می‌کنی؟"
      },
      {
        "id": 2604425,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جانْت فدا که بس خوشی، جان و جهانِ کیستی؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2604426,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از گُل سرخ رسته‌ای، نرگس دسته بسته‌ای",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو از گل سرخی روییده‌ای، همچون نرگسی که در دسته‌ای جمع شده است. همچنان که قیمت شکر افت کرده، تو نیز چون پسته‌ای هستی که دندان به آن می‌زنی؛ اما تو که هستی و چه کنشی داری؟"
      },
      {
        "id": 2604427,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نرخِ شکر شکسته‌ای، پسته‌دهانِ کیستی؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2604428,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ای تو به دلبری سَمَر، شیفتهٔ رُخَت قَمَر",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ای دل‌بر کامرانی، کسی که زیبایی‌ات مانند ماه است و دل‌ها را می‌رباید، درختان بر کمر کوه بسته شده‌اند، تو که هستی و موی تو در میان است؟"
      },
      {
        "id": 2604430,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بسته به کوه بر کمر، موی‌میانِ کیستی؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2604441,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دام‌نهاده می‌روی، مست ز باده می‌روی",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: تو با حالت خماری از شراب، در حال حرکت هستی و در حالی که مشت‌هایت را باز کرده‌ای، به کدامین کمان و تیر می‌روی؟"
      },
      {
        "id": 2604431,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مشت‌گشاده می‌روی، سخت‌کمانِ کیستی؟",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2604432,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "شهد و شکر، لبانِ تو، جمله جهان، از آنِ تو",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: عسل و شکر، لب‌های تو را توصیف می‌کنند و می‌گویم که همه‌ی زیبایی‌های دنیا در وجود تو خلاصه شده است. من در حیرتم که تو چه کسی هستی که این‌همه جذابیت و راز داری!"
      },
      {
        "id": 2604433,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در عجبم به جانِ تو، تا خود از آنِ کیستی؟",
        "languageId": null,
        "coupletSummary": null
      }
    ],
