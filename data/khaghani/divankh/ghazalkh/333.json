      {
        "id": 2603321,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دل بیش کند ز جان‌سپاری",
        "languageId": null,
        "coupletSummary": null
