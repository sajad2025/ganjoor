        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دین و دنیا حجاب همت ماست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دین و دنیا مانع پیشرفت و تلاش ما هستند، هر دوی آن‌ها را فدای محبت معشوق کنیم."
      },
      {
        "id": 2606288,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
