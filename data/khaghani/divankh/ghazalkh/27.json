    "verses": [
      {
        "id": 2601737,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در این عهد از وفا بوئی نمانده است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در این زمان، دیگر نشانه‌ای از وفاداری باقی نمانده و در جهان، هیچ دوستی که از همدیگر آشنا باشند، وجود ندارد."
      },
      {
        "id": 2601765,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به عالم آشنارویی نمانده است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2601767,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "جهان دست جفا بگشاد آوخ",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: دنیا به ما سختی‌ها و ظلم‌های زیادی نشان داده و افسوس که دیگر قدرتی برای وفا و وفاداری باقی نمانده است."
      },
      {
        "id": 2601818,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وفا را زورِ بازویی نمانده است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2601768,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه آتش سوخت بستان وفا را",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: درختان وفا به شدت آسیب دیده‌اند و دیگر هیچ نشانه‌ای از زندگی در آنها باقی نمانده است."
      },
      {
        "id": 2601795,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که از خشک و ترش بویی نمانده است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2601796,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "فلک جائی به موی آویخت جانم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: 天地 به موهایی که آویزان شده، جانم وابسته است و از آنجا تا زمانی که زندگی‌ام به پایان برسد، هیچ مویی باقی نخواهد ماند."
      },
      {
        "id": 2601797,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کز آنجا تا اجل مویی نمانده است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2601798,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "به که نالم که اندر نسل آدم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چه کسی را صدا بزنم؟ در این نسل آدم، دیگر نشانی از انسانیت و خوبی نمانده است."
      },
      {
        "id": 2601799,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بدیدم آدمی‌خویی نمانده است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2601800,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "نظر بردار خاقانی ز دونان",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به خاقانی نگاه کن و از افراد پست دوری کن؛ زیرا هیچ دلجویی و تسلی وجود ندارد."
      },
