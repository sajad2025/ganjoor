      },
      {
        "id": 2606202,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "وای زلف تو سایبان نسرین",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2606203,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چشم تو ز نیم زهر غمزه",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نگاه تو با ناز و غمزه هزاران دل شاد را به درد آورد و جان‌ها را به گریه انداخت."
      },
      {
        "id": 2606204,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خون کرد هزار جان شیرین",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2606205,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صد عیسی دردمند را بیش",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: بسیاری از بیمارانی که در رنج و درد به سر می‌برند، زیر سایهٔ موهای زیبای محبوب، آرامش و سرپناه یافته‌اند."
      },
      {
        "id": 2606206,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در سایهٔ زلف کرده بالین",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2606207,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از چشم بد ایمنی که دارد",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: چشم‌های زیبا و شفافی که همچون دندانه و لب تو، به خصوصیات یاسین (یکی از نام‌های رسول خدا) آراسته‌اند، از آسیب و گزند دور هستند."
      },
      {
        "id": 2606208,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "دندان و لب تو شکل یاسین",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2606209,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آهسته‌تر ای سوار چالاک",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: به آرامی حرکت کن، ای سوار چابک، که ما از تو به دقت نظاره می‌کنیم."
      },
      {
