        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر دیدهٔ ما متاز چندین",
        "languageId": null,
        "coupletSummary": null
      },
      {
