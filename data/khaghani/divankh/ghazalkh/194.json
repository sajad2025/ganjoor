        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آخر آبم ز جگر بازمگیر",
        "languageId": null,
        "coupletSummary": null
      },
