        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "سنگ سازی، سبوی ما شکنی",
        "languageId": null,
        "coupletSummary": null
