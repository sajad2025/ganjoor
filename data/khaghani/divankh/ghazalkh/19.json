        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "در زمانه کار کار عشق توست",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: در این دنیا، همه کارها به عشق تو مربوط می‌شود و نمی‌توان از آن ساده گذشت."
      },
      {
        "id": 2602293,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از سر این کار نتوان درگذشت",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2602294,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
