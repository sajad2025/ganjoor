    "verses": [
      {
        "id": 2601952,
        "vOrder": 1,
        "coupletIndex": 0,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "چه نشینم که فتنه برپای است",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: نشستن و سکوت کردن در این زمان که مشکلات و فتنه‌ها در حال وقوع است، مناسب نیست. اما در عوض باید بر عشق و ایمان خود استوار بایستیم و پایدار باشیم."
      },
      {
        "id": 2601951,
        "vOrder": 2,
        "coupletIndex": 0,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "رایت عشق پای برجای است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2601938,
        "vOrder": 3,
        "coupletIndex": 1,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هرچه بایست داشتم الحق",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: هر چیزی که لازم بود تا داشته باشم، واقعاً باید سختی و زحمت عشق را هم می‌داشتم."
      },
      {
        "id": 2601928,
        "vOrder": 4,
        "coupletIndex": 1,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "محنت عشق نیز می‌بایست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2601929,
        "vOrder": 5,
        "coupletIndex": 2,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "صبر با این بلا ندارد پای",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: صبر در برابر این سختی نمی‌تواند فرار کند، زیرا هیچ بندی بر پای او نیست."
      },
      {
        "id": 2601930,
        "vOrder": 6,
        "coupletIndex": 2,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بگریزد نه بند بر پای است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2601931,
        "vOrder": 7,
        "coupletIndex": 3,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "راستی به، که صبر معذور است",
        "languageId": null,
        "coupletSummary": "راستش، شکیبایی هم معذور است. [آخر] چگونه می‌توان روی تیغ دوام آورد؟"
      },
      {
        "id": 2601932,
        "vOrder": 8,
        "coupletIndex": 3,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بر سر تیغ، چون توانْ پایَست",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2601933,
        "vOrder": 9,
        "coupletIndex": 4,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "بیخ امید من ز بن برکند",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کسی که امید و آرزوهایم را از ریشه قطع کرد، همان کسی است که زیبایی‌های زمانه را تزیین می‌کند."
      },
      {
        "id": 2601934,
        "vOrder": 10,
        "coupletIndex": 4,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "آنکه شاخ زمانه پیرای است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2601935,
        "vOrder": 11,
        "coupletIndex": 5,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "کار من بد شده است و بدتر ازین",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: کاری که من انجام می‌دهم به شدت خراب شده و احتمالاً اوضاع از این هم بدتر خواهد شد، زیرا تقدیر چنین است."
      },
      {
        "id": 2601936,
        "vOrder": 12,
        "coupletIndex": 5,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "هم شود، تا فلک بر این رای است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2601937,
        "vOrder": 13,
        "coupletIndex": 6,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "از که نالم بگو ز کارگزار",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: از کی شکایت کنم؟ از کارگزاران یا از کسی که آن‌ها را به کار گماشته است؟"
      },
      {
        "id": 2601939,
        "vOrder": 14,
        "coupletIndex": 6,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "یا از آن کس که کارفرمای است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2601950,
        "vOrder": 15,
        "coupletIndex": 7,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "ناله دارد ز زخم، مار سلیم",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: ناله این مار زخم‌خورده به خاطر آسیب‌هایی است که از آن کسی خورده که به ما آزار می‌رساند."
      },
      {
        "id": 2601940,
        "vOrder": 16,
        "coupletIndex": 7,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "مار از آن کس که ماراَفسای است",
        "languageId": null,
        "coupletSummary": null
      },
      {
        "id": 2601941,
        "vOrder": 17,
        "coupletIndex": 8,
        "versePosition": 0,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "خیز خاقانی از نشیمن خاک",
        "languageId": null,
        "coupletSummary": "هوش مصنوعی: برخیز و از محل زندگی مادی خود فاصله بگیر، چرا که اینجا جایگاه راحتی نیست و تو را به پیشرفت و آرامش نمی‌رساند."
      },
      {
        "id": 2601942,
        "vOrder": 18,
        "coupletIndex": 8,
        "versePosition": 1,
        "sectionIndex1": 0,
        "sectionIndex2": null,
        "sectionIndex3": null,
        "sectionIndex4": null,
        "text": "که نه بس جای راحت‌افزای است",
        "languageId": null,
